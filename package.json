{
  "name": "simpeg-cibitung",
  "version": "2.0.0",
  "description": "Sistem Informasi Manajemen Pegawai Korwil Cibitung 2.0 (Non-Google Stack)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "postinstall": "prisma generate",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "build:ts": "tsc --project tsconfig.json --skipLibCheck",
    "build": "prisma generate && npm run build:css",
    "start": "node dist/server.js"
  },
  "keywords": [
    "simpeg",
    "absensi",
    "e-kinerja",
    "express",
    "ejs",
    "tailwind"
  ],
  "author": "Korwil Cibitung",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.4",
    "alpinejs": "^3.16.3",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "lucide": "^1.34.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@vercel/node": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.x"
  }
}
