<%- include('../partials/head') %>
<%- include('../partials/public-nav') %>

<!-- Safe JSON Data Script -->
<script type="application/json" id="sheet-data">
  <%- JSON.stringify({
    sheetId: sheet.id,
    slug: sheet.slug,
    accessMode: sheet.accessMode,
    targetType: sheet.targetType,
    initialUnlockedRowId: unlockedRowId || "",
    columns: columns,
    allSheetColumns: (sheet.columns || []).map(c => ({ key: c.key, label: c.label, hidden: !!c.hidden })),
    initialRows: rows
  }).replace(/</g, '\\u003c') %>
</script>

<main class="min-h-screen bg-slate-50/70 py-6 sm:py-10 px-4 sm:px-6 lg:px-8 font-sans"
      x-data="publicSpreadsheetViewer()">

  <div class="max-w-[1400px] mx-auto space-y-6">

    <!-- Top Card: Header & Description -->
    <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xs p-5 sm:p-6 space-y-3 relative overflow-hidden">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Title & Details -->
        <div class="space-y-1">
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              <%= sheet.title %>
            </h1>
            <% if (sheet.status !== 'ACTIVE') { %>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200">
                Pengisian Ditutup
              </span>
            <% } %>
          </div>
          <% if (sheet.description) { %>
            <p class="text-slate-600 text-xs sm:text-sm max-w-3xl leading-relaxed whitespace-pre-line">
              <%= sheet.description %>
            </p>
          <% } %>
        </div>

        <!-- Sync indicator & Quick Actions Toolbar -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <!-- Sync indicator -->
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 text-xs font-semibold text-slate-500">
            <template x-if="isSaving">
              <div class="flex items-center gap-1.5 text-amber-600">
                <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                <span>Menyimpan...</span>
              </div>
            </template>
            <template x-if="!isSaving && saveStatus">
              <div class="flex items-center gap-1.5 text-emerald-600">
                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                <span x-text="saveStatus"></span>
              </div>
            </template>
            <template x-if="!isSaving && !saveStatus">
              <div class="flex items-center gap-1.5 text-slate-400">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Tersinkron</span>
              </div>
            </template>
          </div>

          <!-- Button Verify NIP (Only if PROTECTED_NIP and sheet is ACTIVE) -->
          <% if (sheet.accessMode === 'PROTECTED_NIP' && sheet.status === 'ACTIVE') { %>
            <template x-if="!unlockedRow">
              <button type="button"
                      @click="showVerifyModal = true"
                      class="btn-primary py-2 px-3 text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white rounded-xl shadow-xs flex items-center gap-1.5">
                <i data-lucide="key" class="w-3.5 h-3.5"></i>
                <span>Verifikasi NIP</span>
              </button>
            </template>
          <% } %>

          <!-- Export Excel (If enabled) -->
          <% if (sheet.allowExport) { %>
            <a href="/sheet/<%= sheet.slug %>/export"
               class="py-2 px-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-bold flex items-center gap-1.5 transition-colors shadow-2xs"
               title="Download seluruh data spreadsheet ke Excel">
              <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5 text-emerald-600"></i>
              <span>Unduh Excel</span>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Unlocked Row Banner (if user verified NIP) -->
      <template x-if="accessMode === 'PROTECTED_NIP' && unlockedRow">
        <div class="p-3.5 rounded-2xl bg-indigo-50/80 border border-indigo-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center shrink-0">
              <i data-lucide="unlock" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Akses Baris Anda Terbuka</div>
              <div class="font-bold text-slate-900 text-xs" x-text="unlockedRow.label"></div>
              <div class="text-[11px] text-slate-500 font-mono" x-text="unlockedRow.identifier ? ('NIP: ' + unlockedRow.identifier) : ''"></div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="button"
                    @click="scrollToUnlockedRow()"
                    class="btn-primary py-1.5 px-3 text-xs bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold flex items-center gap-1.5">
              <i data-lucide="crosshair" class="w-3.5 h-3.5"></i>
              <span>Ke Baris Saya</span>
            </button>
            <button type="button"
                    @click="lockRow()"
                    class="py-1.5 px-3 text-xs bg-white border border-slate-200 hover:bg-slate-100 text-slate-600 rounded-xl font-bold transition-colors">
              Kunci Selesai
            </button>
          </div>
        </div>
      </template>
    </div>

    <!-- Search Toolbar & Pagination & Column Visibility Controls -->
    <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-2xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-1 max-w-2xl">
        <div class="relative flex-1">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
          <input type="text"
                 x-model="searchQuery"
                 @input="currentPage = 1"
                 placeholder="Cari nama, NIP, nama sekolah, dll..."
                 class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all outline-none">
        </div>

        <!-- Active Filter / Sort Indicator Pill -->
        <template x-if="hasActiveFiltersOrSort">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-indigo-50 border border-indigo-200 text-xs font-semibold text-indigo-900 shadow-2xs shrink-0">
            <div class="flex items-center gap-1.5">
              <i data-lucide="filter" class="w-3.5 h-3.5 text-indigo-600"></i>
              <span class="font-extrabold text-indigo-800" x-text="activeFilterSummary"></span>
            </div>
            <button type="button" @click="resetAllFilters()" class="text-[11px] font-bold text-rose-600 hover:text-rose-800 hover:underline cursor-pointer ml-1" title="Hapus seluruh filter & pengurutan kolom">
              Reset
            </button>
          </div>
        </template>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 self-stretch sm:self-center justify-between sm:justify-end">
        
        <!-- Baris Per Halaman -->
        <div class="flex items-center gap-1.5">
          <span>Baris:</span>
          <select x-model="pageSize" @change="currentPage = 1"
                  class="px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 outline-none">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="all">Semua</option>
          </select>
        </div>


        <span>Menampilkan <b class="text-slate-800" x-text="startRowNumber"></b> - <b class="text-slate-800" x-text="endRowNumber"></b> dari <b class="text-slate-800" x-text="filteredRows.length"></b></span>
      </div>
    </div>

    <!-- Spreadsheet Data Table Grid -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
      <div class="overflow-x-auto max-h-[700px] relative scrollbar-thin">
        <table class="w-full border-collapse text-left text-xs" @paste="handlePublicPaste($event)">
          <!-- Table Header -->
          <thead class="bg-slate-100/90 sticky top-0 z-20 text-[11px] font-black text-slate-600 uppercase tracking-wider border-b border-slate-300 select-none shadow-2xs">
            <tr>
              <th class="py-3 px-3 w-12 text-center border-r border-slate-200 bg-slate-100">#</th>
              
              <!-- Fallback Identitas Columns if not explicitly defined in sheet -->
              <template x-if="!isFieldDefinedInSheet('nama') && !isFieldDefinedInSheet('label')">
                <th class="py-2.5 px-3 min-w-[200px] border-r border-slate-200 bg-slate-100">
                  <div class="flex items-center justify-between gap-1.5">
                    <span class="truncate font-bold text-slate-800"><%= sheet.targetType === 'UNIT' ? 'Nama Unit Sekolah' : (sheet.targetType === 'PEGAWAI' ? 'Nama Pegawai' : 'Label Baris') %></span>
                    <button type="button"
                            @click.stop="openFilterDropdown('nama', '<%= sheet.targetType === 'UNIT' ? 'Nama Unit' : 'Nama Pegawai' %>', $event)"
                            class="p-1 rounded transition-colors cursor-pointer relative shrink-0"
                            :class="isColumnFilteredOrSorted('nama') ? 'bg-indigo-600 text-white shadow-xs' : 'hover:bg-slate-200 text-slate-400 hover:text-slate-600'"
                            title="Filter & Urutkan kolom ini">
                      <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                      <template x-if="isColumnFilteredOrSorted('nama')">
                        <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-400 ring-2 ring-white"></span>
                      </template>
                    </button>
                  </div>
                </th>
              </template>

              <template x-if="!isFieldDefinedInSheet('nip') && !isFieldDefinedInSheet('identifier') && ('<%= sheet.targetType %>' === 'PEGAWAI' || '<%= sheet.targetType %>' === 'UNIT')">
                <th class="py-2.5 px-3 min-w-[150px] border-r border-slate-200 bg-slate-100">
                  <div class="flex items-center justify-between gap-1.5">
                    <span class="truncate font-bold text-slate-800"><%= sheet.targetType === 'PEGAWAI' ? 'NIP' : 'Kode' %></span>
                    <button type="button"
                            @click.stop="openFilterDropdown('nip', '<%= sheet.targetType === 'PEGAWAI' ? 'NIP' : 'Kode' %>', $event)"
                            class="p-1 rounded transition-colors cursor-pointer relative shrink-0"
                            :class="isColumnFilteredOrSorted('nip') ? 'bg-indigo-600 text-white shadow-xs' : 'hover:bg-slate-200 text-slate-400 hover:text-slate-600'"
                            title="Filter & Urutkan kolom ini">
                      <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                      <template x-if="isColumnFilteredOrSorted('nip')">
                        <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-400 ring-2 ring-white"></span>
                      </template>
                    </button>
                  </div>
                </th>
              </template>

              <template x-if="!isFieldDefinedInSheet('unitKerja') && !isFieldDefinedInSheet('subLabel') && !isFieldDefinedInSheet('jabatan')">
                <th class="py-2.5 px-3 min-w-[150px] border-r border-slate-200 bg-slate-100">
                  <div class="flex items-center justify-between gap-1.5">
                    <span class="truncate font-bold text-slate-800"><%= sheet.targetType === 'PEGAWAI' ? 'Jabatan / Instansi' : 'Keterangan' %></span>
                    <button type="button"
                            @click.stop="openFilterDropdown('unitKerja', '<%= sheet.targetType === 'PEGAWAI' ? 'Jabatan / Instansi' : 'Keterangan' %>', $event)"
                            class="p-1 rounded transition-colors cursor-pointer relative shrink-0"
                            :class="isColumnFilteredOrSorted('unitKerja') ? 'bg-indigo-600 text-white shadow-xs' : 'hover:bg-slate-200 text-slate-400 hover:text-slate-600'"
                            title="Filter & Urutkan kolom ini">
                      <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                      <template x-if="isColumnFilteredOrSorted('unitKerja')">
                        <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-400 ring-2 ring-white"></span>
                      </template>
                    </button>
                  </div>
                </th>
              </template>

              <!-- Dynamic Custom Columns (Filtered by Column Visibility) -->
              <template x-for="col in visibleColumns" :key="col.key">
                <th class="py-2.5 px-3 min-w-[170px] border-r border-slate-200 bg-slate-100">
                  <div class="flex items-center justify-between gap-1.5">
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="truncate font-bold text-slate-800" :title="col.label" x-text="col.label"></span>
                      <template x-if="col.isProtected">
                        <span class="text-[9px] px-1.5 py-0.5 rounded font-extrabold bg-amber-100 text-amber-800 border border-amber-300 shrink-0 flex items-center gap-0.5" title="Kolom ini diproteksi (Read-Only)">
                          <i data-lucide="lock" class="w-2.5 h-2.5 text-amber-700"></i>
                          <span>Protected</span>
                        </span>
                      </template>
                    </div>

                    <div class="flex items-center gap-1 shrink-0">
                      <span class="text-[9px] px-1.5 py-0.2 rounded font-mono uppercase"
                            :class="{
                              'bg-blue-100 text-blue-700': col.type === 'number' || col.type === 'currency',
                              'bg-purple-100 text-purple-700': col.type === 'select',
                              'bg-emerald-100 text-emerald-700': col.type === 'checkbox',
                              'bg-amber-100 text-amber-700': col.type === 'date',
                              'bg-slate-200 text-slate-700': col.type === 'text' || col.type === 'textarea'
                            }"
                            x-text="col.type">
                      </span>

                      <!-- TOMBOL FILTER DI HEADER (jika filterable !== false) -->
                      <template x-if="col.filterable !== false">
                        <button type="button"
                                @click.stop="openFilterDropdown(col.key, col.label, $event)"
                                class="p-1 rounded transition-colors cursor-pointer relative"
                                :class="isColumnFilteredOrSorted(col.key) ? 'bg-indigo-600 text-white shadow-xs' : 'hover:bg-slate-200 text-slate-400 hover:text-slate-600'"
                                :title="isColumnFilteredOrSorted(col.key) ? 'Filter / Urutan aktif pada kolom ini' : 'Filter & Urutkan kolom ini'">
                          <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                          <template x-if="isColumnFilteredOrSorted(col.key)">
                            <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-400 ring-2 ring-white"></span>
                          </template>
                        </button>
                      </template>
                    </div>
                  </div>
                </th>
              </template>

              <!-- Status Kolom Akses -->
              <% if (sheet.accessMode === 'PROTECTED_NIP') { %>
                <th class="py-3 px-3 w-28 text-center bg-slate-100">Aksi / Status</th>
              <% } %>
            </tr>
          </thead>

          <!-- Table Body (Paginated) -->
          <tbody class="divide-y divide-slate-200 bg-white font-normal text-slate-700">
            <template x-for="(row, rowIdx) in paginatedRows" :key="row.id">
              <tr :id="`row-${row.id}`"
                  class="transition-colors group"
                  :class="{
                    'bg-indigo-50/70 ring-2 ring-indigo-500 ring-inset': isRowUnlocked(row),
                    'bg-emerald-50/35 hover:bg-emerald-50/60': !isRowUnlocked(row) && isRowFilled(row),
                    'hover:bg-slate-50/80': !isRowUnlocked(row) && !isRowFilled(row)
                  }">
                
                <!-- Index -->
                <td class="py-2.5 px-3 text-center border-r border-slate-200 font-mono text-[11px] text-slate-400 bg-slate-50/30"
                    x-text="getRowGlobalIndex(rowIdx)">
                </td>

                <!-- Fallback Identitas Cells -->
                <template x-if="!isFieldDefinedInSheet('nama') && !isFieldDefinedInSheet('label')">
                  <td class="py-2.5 px-4 border-r border-slate-200 font-bold text-slate-900"
                      x-text="row.label">
                  </td>
                </template>

                <template x-if="!isFieldDefinedInSheet('nip') && !isFieldDefinedInSheet('identifier') && ('<%= sheet.targetType %>' === 'PEGAWAI' || '<%= sheet.targetType %>' === 'UNIT')">
                  <td class="py-2.5 px-4 border-r border-slate-200 font-mono text-slate-600"
                      x-text="row.identifier || '-'">
                  </td>
                </template>

                <template x-if="!isFieldDefinedInSheet('unitKerja') && !isFieldDefinedInSheet('subLabel') && !isFieldDefinedInSheet('jabatan')">
                  <td class="py-2.5 px-4 border-r border-slate-200 text-slate-500"
                      x-text="row.subLabel || '-'">
                  </td>
                </template>

                <!-- Dynamic Columns (Filtered by Column Visibility) -->
                <template x-for="col in visibleColumns" :key="col.key">
                  <td class="py-1 px-2 border-r border-slate-200 relative transition-colors"
                      :class="{ 
                        'bg-amber-50/20': col.isProtected,
                        'bg-emerald-50/50': !col.isProtected && isCellFilled(row, col.key) 
                      }"
                      :data-row-id="row.id"
                      :data-col-key="col.key">

                    <!-- SCENARIO A: Row & Cell is EDITABLE (either OPEN_EDIT mode or verified PROTECTED_NIP and not protected column) -->
                    <template x-if="canEditCell(row, col)">
                      <div>
                        <!-- Checkbox -->
                        <template x-if="col.type === 'checkbox'">
                          <div class="flex items-center justify-center py-1">
                            <input type="checkbox"
                                   :checked="!!getCellValue(row, col.key)"
                                   @change="updateCell(row, col.key, $event.target.checked)"
                                   class="w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500 cursor-pointer">
                          </div>
                        </template>

                        <!-- Select -->
                        <template x-if="col.type === 'select'">
                          <select :value="getCellValue(row, col.key) || ''"
                                  @change="updateCell(row, col.key, $event.target.value)"
                                  class="w-full px-2 py-1.5 rounded-lg border text-xs outline-none transition-all cursor-pointer"
                                  :class="isCellFilled(row, col.key) 
                                    ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white' 
                                    : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                            <option value="">-- Pilih --</option>
                            <template x-for="opt in (col.options || [])" :key="opt">
                              <option :value="opt" x-text="opt" :selected="getCellValue(row, col.key) === opt"></option>
                            </template>
                          </select>
                        </template>

                        <!-- Number / Currency -->
                        <template x-if="col.type === 'number' || col.type === 'currency'">
                          <input type="number"
                                 :value="getCellValue(row, col.key) ?? ''"
                                 @change="updateCell(row, col.key, $event.target.value)"
                                 placeholder="0"
                                 class="w-full px-2 py-1.5 text-right font-mono rounded-lg border text-xs outline-none transition-all"
                                 :class="isCellFilled(row, col.key)
                                   ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white'
                                   : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                        </template>

                        <!-- Date -->
                        <template x-if="col.type === 'date'">
                          <input type="date"
                                 :value="getCellValue(row, col.key) || ''"
                                 @change="updateCell(row, col.key, $event.target.value)"
                                 class="w-full px-2 py-1.5 rounded-lg border text-xs outline-none transition-all"
                                 :class="isCellFilled(row, col.key)
                                   ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white'
                                   : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                        </template>

                        <!-- Text / Textarea -->
                        <template x-if="col.type === 'text' || col.type === 'textarea' || !['checkbox','select','number','currency','date'].includes(col.type)">
                          <input type="text"
                                 :value="getCellValue(row, col.key) || ''"
                                 @change="updateCell(row, col.key, $event.target.value)"
                                 :placeholder="col.placeholder || '-'"
                                 class="w-full px-2 py-1.5 rounded-lg border text-xs outline-none transition-all"
                                 :class="isCellFilled(row, col.key)
                                   ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white'
                                   : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                        </template>
                      </div>
                    </template>

                    <!-- SCENARIO B: READ-ONLY / PROTECTED / MASKED FOR UNVERIFIED ROWS -->
                    <template x-if="!canEditCell(row, col)">
                      <div class="px-2 py-1.5 min-h-[30px] flex items-center transition-colors"
                           :class="{
                             'justify-end font-mono': !shouldMaskCell(row, col) && (col.type === 'number' || col.type === 'currency'), 
                             'justify-center': shouldMaskCell(row, col) || col.type === 'checkbox'
                           }">
                        
                        <!-- KASUS 1: CELL DISAMARKAN (Spreadsheet Proteksi NIP, kolom isian pegawai, baris belum dibuka oleh pegawai bersangkutan) -->
                        <template x-if="shouldMaskCell(row, col)">
                          <div class="flex items-center justify-center">
                            <template x-if="isCellFilled(row, col.key)">
                              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-2xs select-none"
                                    title="Data telah terisi oleh pegawai">
                                <i data-lucide="check" class="w-3.5 h-3.5 stroke-[3] text-emerald-600"></i>
                                <span>Terisi</span>
                              </span>
                            </template>
                            <template x-if="!isCellFilled(row, col.key)">
                              <span class="text-slate-300 font-semibold text-xs select-none">-</span>
                            </template>
                          </div>
                        </template>

                        <!-- KASUS 2: NILAI DITAMPILKAN (Kolom diproteksi admin, atau kolom identitas, atau baris sedang dibuka) -->
                        <template x-if="!shouldMaskCell(row, col)">
                          <div>
                            <!-- Checkbox read-only badge -->
                            <template x-if="col.type === 'checkbox'">
                              <div class="flex items-center justify-center">
                                <span :class="getCellValue(row, col.key) ? 'text-emerald-800 bg-emerald-100/90 border border-emerald-300 px-2 py-0.5 rounded-md font-bold text-xs' : 'text-slate-300 font-semibold'">
                                  <span x-text="getCellValue(row, col.key) ? '✓ Ya' : '-'"></span>
                                </span>
                              </div>
                            </template>

                            <!-- Formatted Value: Nilai TETAP DITAMPILKAN dengan jelas -->
                            <template x-if="col.type !== 'checkbox'">
                              <div class="flex items-center gap-1.5 w-full"
                                   :class="{ 'justify-end': col.type === 'number' || col.type === 'currency' }">
                                <span class="text-xs truncate select-text"
                                      :class="{ 
                                        'font-mono': col.type === 'number' || col.type === 'currency',
                                        'text-slate-800 font-bold': getCellValue(row, col.key) && String(getCellValue(row, col.key)).trim() !== '' && String(getCellValue(row, col.key)).trim() !== '-',
                                        'text-slate-300 italic': !getCellValue(row, col.key) || String(getCellValue(row, col.key)).trim() === '' || String(getCellValue(row, col.key)).trim() === '-'
                                      }"
                                      x-text="(getCellValue(row, col.key) && String(getCellValue(row, col.key)).trim() !== '' && String(getCellValue(row, col.key)) !== '__FILLED__') ? getCellValue(row, col.key) : (getCellValue(row, col.key) === '__FILLED__' ? '✓ Terisi' : '-')"
                                      :title="getCellValue(row, col.key) || ''">
                                </span>
                              </div>
                            </template>
                          </div>
                        </template>

                      </div>
                    </template>

                  </td>
                </template>

                <!-- PROTECTED_NIP: Row Action / Lock status column -->
                <% if (sheet.accessMode === 'PROTECTED_NIP') { %>
                  <td class="py-2 px-2 text-center">
                    <template x-if="isRowUnlocked(row)">
                      <div class="flex items-center justify-center gap-1.5">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-indigo-600 text-white shadow-2xs">
                          <i data-lucide="edit-2" class="w-3 h-3"></i>
                          <span>Aktif Diedit</span>
                        </span>
                        <button type="button"
                                @click="lockRow(false)"
                                class="p-1 rounded-lg text-slate-400 hover:text-amber-700 hover:bg-amber-50 border border-slate-200 transition-colors"
                                title="Kunci Kembali Baris Ini">
                          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                        </button>
                      </div>
                    </template>
                    <template x-if="!isRowUnlocked(row)">
                      <button type="button"
                              @click="promptUnlockRow(row)"
                              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-bold text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 border border-indigo-200 transition-colors">
                        <i data-lucide="edit-3" class="w-3 h-3 text-indigo-500"></i>
                        <span>Isi Baris</span>
                      </button>
                    </template>
                  </td>
                <% } %>

              </tr>
            </template>

            <!-- Empty Search Results -->
            <template x-if="filteredRows.length === 0">
              <tr>
                <td :colspan="visibleColumns.length + 5" class="py-12 text-center text-slate-400">
                  <i data-lucide="inbox" class="w-8 h-8 mx-auto text-slate-300 mb-2"></i>
                  <p class="font-bold text-sm text-slate-600">Tidak ada baris yang cocok</p>
                  <p class="text-xs text-slate-400 mt-0.5">Silakan ketik kata kunci pencarian yang lain.</p>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Pagination Bar -->
      <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
        <div>
          Halaman <b class="text-slate-800" x-text="currentPage"></b> dari <b class="text-slate-800" x-text="totalPages"></b>
        </div>

        <div class="flex items-center gap-1.5" x-show="totalPages > 1">
          <button type="button"
                  @click="goToPage(1)"
                  :disabled="currentPage === 1"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            «
          </button>
          <button type="button"
                  @click="goToPage(currentPage - 1)"
                  :disabled="currentPage === 1"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            ‹ Sebelumnya
          </button>

          <span class="px-3 py-1 font-mono font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 rounded-lg">
            <span x-text="currentPage"></span> / <span x-text="totalPages"></span>
          </span>

          <button type="button"
                  @click="goToPage(currentPage + 1)"
                  :disabled="currentPage >= totalPages"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            Berikutnya ›
          </button>
          <button type="button"
                  @click="goToPage(totalPages)"
                  :disabled="currentPage >= totalPages"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            »
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL: Verifikasi NIP untuk Membuka Kunci Pengisian -->
  <div x-show="showVerifyModal"
       x-cloak
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 sm:p-7 shadow-2xl space-y-4 border border-slate-100"
         @click.away="showVerifyModal = false">
      
      <div class="text-center space-y-2">
        <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto shadow-inner">
          <i data-lucide="shield-alert" class="w-7 h-7"></i>
        </div>
        <h3 class="font-black text-slate-900 text-lg">Verifikasi Identitas</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Masukkan <b>NIP</b> Anda untuk membuka akses pengisian baris data Anda.
        </p>
      </div>

      <!-- Form Verify -->
      <div class="space-y-3 pt-2">
        <div>
          <label class="block font-bold text-slate-700 text-xs mb-1">
            Nomor Induk Pegawai (NIP):
          </label>
          <input type="text"
                 x-model="verifyInput.nip"
                 @keydown.enter="submitVerifyNip()"
                 placeholder="Contoh: 198501012010011005"
                 class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-mono font-bold text-sm focus:bg-white focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none transition-all">
        </div>

        <template x-if="verifyError">
          <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
            <span x-text="verifyError"></span>
          </div>
        </template>
      </div>

      <div class="pt-3 flex items-center justify-end gap-2 border-t border-slate-100">
        <button type="button"
                @click="showVerifyModal = false"
                class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold text-xs">
          Batal
        </button>
        <button type="button"
                @click="submitVerifyNip()"
                :disabled="!verifyInput.nip.trim() || isVerifying"
                class="btn-primary px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold text-xs shadow-sm flex items-center gap-1.5 disabled:opacity-50">
          <template x-if="isVerifying">
            <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
          </template>
          <span>Buka Baris Saya</span>
        </button>
      </div>

    </div>
  </div>

  <!-- FLOATING FILTER & SORT DROPDOWN (Fixed position to never get clipped by table bounds) -->
  <div x-show="activeFilterCol"
       x-cloak
       x-ref="filterDropdown"
       @click.away="activeFilterCol = null; activeFilterBtn = null"
       :style="`position: fixed; top: ${filterDropdownPos.top}px; left: ${filterDropdownPos.left}px; width: 280px; max-height: ${filterDropdownPos.maxHeight || '460px'}; z-index: 9999;`"
       class="bg-white rounded-2xl shadow-2xl border border-slate-200 p-3.5 space-y-3 text-xs overflow-y-auto scrollbar-thin animate-in fade-in zoom-in-95 duration-100 flex flex-col">
    
    <!-- Popover Header -->
    <div class="flex items-center justify-between pb-2 border-b border-slate-100 shrink-0">
      <div class="truncate pr-2">
        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Filter & Urutkan Kolom</span>
        <span class="font-extrabold text-slate-900 text-xs truncate block" x-text="activeFilterLabel"></span>
      </div>
      <button type="button" @click="activeFilterCol = null" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- 1. Sort Actions -->
    <div class="space-y-1">
      <div class="text-[10px] font-bold uppercase text-slate-400">Pengurutan (Sort)</div>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button"
                @click="applySort(activeFilterCol, 'asc')"
                class="py-1.5 px-2 rounded-xl border flex items-center justify-center gap-1.5 font-bold text-[11px] transition-colors cursor-pointer"
                :class="isSortActive(activeFilterCol, 'asc') ? 'bg-indigo-600 text-white border-indigo-600 shadow-2xs' : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100'">
          <i data-lucide="arrow-up-a-z" class="w-3.5 h-3.5"></i>
          <span>A → Z / 0 → 9</span>
        </button>
        <button type="button"
                @click="applySort(activeFilterCol, 'desc')"
                class="py-1.5 px-2 rounded-xl border flex items-center justify-center gap-1.5 font-bold text-[11px] transition-colors cursor-pointer"
                :class="isSortActive(activeFilterCol, 'desc') ? 'bg-indigo-600 text-white border-indigo-600 shadow-2xs' : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100'">
          <i data-lucide="arrow-down-z-a" class="w-3.5 h-3.5"></i>
          <span>Z → A / 9 → 0</span>
        </button>
      </div>
      <template x-if="activeSort.colKey === activeFilterCol">
        <button type="button"
                @click="clearSort()"
                class="w-full text-center text-[10px] font-bold text-slate-500 hover:text-rose-600 py-1 hover:underline cursor-pointer">
          ✕ Hapus Pengurutan Kolom Ini
        </button>
      </template>
    </div>

    <!-- 2. Value Filters -->
    <div class="space-y-1.5 pt-1.5 border-t border-slate-100">
      <div class="flex items-center justify-between text-[10px] font-bold uppercase text-slate-400">
        <span>Filter Nilai Sel</span>
        <div class="flex items-center gap-1.5 text-indigo-600">
          <button type="button" @click="selectAllFilterValues()" class="hover:underline cursor-pointer">Semua</button>
          <span>•</span>
          <button type="button" @click="clearFilterValuesSelection()" class="hover:underline cursor-pointer">Kosongkan</button>
        </div>
      </div>

      <!-- Search in filter values -->
      <div class="relative">
        <input type="text"
               x-model="filterSearchText"
               placeholder="Cari nilai..."
               class="w-full px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:border-indigo-500">
      </div>

      <!-- Distinct Value Checkboxes List -->
      <div class="max-h-40 overflow-y-auto space-y-1 scrollbar-thin border border-slate-100 rounded-xl p-1.5 bg-slate-50/50">
        <template x-for="item in currentColumnDistinctValues" :key="item.value">
          <label class="flex items-center justify-between p-1 hover:bg-white rounded-lg cursor-pointer text-xs select-none">
            <div class="flex items-center gap-2 truncate pr-1">
              <input type="checkbox"
                     :checked="isFilterValueSelected(item.value)"
                     @change="toggleFilterValue(item.value)"
                     class="rounded text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5 cursor-pointer">
              <span class="truncate font-semibold text-slate-800" x-text="item.value || '(Kosong / Belum Diisi)'"></span>
            </div>
            <span class="text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.2 rounded" x-text="item.count"></span>
          </label>
        </template>
        <template x-if="currentColumnDistinctValues.length === 0">
          <div class="text-[11px] text-slate-400 text-center py-2 italic">
            Tidak ada nilai cocok
          </div>
        </template>
      </div>
    </div>

    <!-- Popover Footer Action Buttons -->
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2 shrink-0">
      <button type="button"
              @click="resetColumnFilter(activeFilterCol)"
              class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline cursor-pointer">
        Reset Filter
      </button>
      <button type="button"
              @click="activeFilterCol = null"
              class="btn-primary py-1.5 px-3.5 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-xs cursor-pointer">
        Tutup
      </button>
    </div>

  </div>

  <!-- FLOATING SESSION CONTROLLER (Mode PROTECTED_NIP: Tampil saat baris dibuka untuk pengisian) -->
  <template x-if="accessMode === 'PROTECTED_NIP' && currentUnlockedRowId && unlockedRow">
    <div class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 max-w-lg w-[94%] sm:w-auto bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700/80 flex flex-wrap items-center justify-between gap-3.5 animate-in slide-in-from-bottom duration-200">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center shrink-0">
          <i data-lucide="shield-check" class="w-5 h-5"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-xs text-white" x-text="unlockedRow.label"></span>
            <span class="text-[10px] font-mono bg-slate-800 text-amber-300 px-1.5 py-0.5 rounded font-bold" x-text="unlockedRow.identifier"></span>
          </div>
          <div class="text-[11px] text-slate-400 flex items-center gap-1.5 mt-0.5">
            <span>Sisa waktu sesi:</span>
            <span class="font-mono font-black"
                  :class="sessionTimerSeconds <= 30 ? 'text-rose-400 animate-pulse text-xs' : 'text-emerald-400'"
                  x-text="formatTimer(sessionTimerSeconds)">
            </span>
            <button type="button" @click="extendSession(120)" class="text-[10px] text-indigo-300 hover:text-indigo-200 underline cursor-pointer ml-1">
              +2 Menit
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button type="button"
                @click="lockRow(false)"
                class="px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm transition-colors cursor-pointer">
          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
          <span>Selesai & Kunci</span>
        </button>
      </div>
    </div>
  </template>

</main>

<script>
  function publicSpreadsheetViewer() {
    let config = { sheetId: '', slug: '', accessMode: '', targetType: '', initialUnlockedRowId: '', columns: [], initialRows: [] };
    try {
      const el = document.getElementById('sheet-data');
      if (el) config = JSON.parse(el.textContent);
    } catch (e) {
      console.error('Failed to parse public sheet data:', e);
    }

    const initialColumns = (config.columns || []).map(c => ({
      ...c,
      isProtected: !!c.isProtected,
      filterable: c.filterable !== undefined ? !!c.filterable : true
    }));

    const storageKey = 'sheet_public_hidden_cols_' + config.sheetId;
    let savedHidden = [];
    try {
      savedHidden = JSON.parse(localStorage.getItem(storageKey) || '[]');
    } catch (e) {
      savedHidden = [];
    }

    return {
      sheetId: config.sheetId,
      slug: config.slug,
      accessMode: config.accessMode,
      targetType: config.targetType,
      currentUnlockedRowId: config.initialUnlockedRowId || '',
      columns: initialColumns,
      allDefinedColumns: config.allSheetColumns || [],
      hiddenColKeys: Array.isArray(savedHidden) ? savedHidden : [],
      rows: (config.initialRows || []).map(r => {
        let d = r.data;
        if (typeof d === 'string') {
          try { d = JSON.parse(d); } catch (e) { d = {}; }
        }
        return { ...r, data: d || {} };
      }),
      searchQuery: '',
      pageSize: '50',
      currentPage: 1,
      isSaving: false,
      saveStatus: '',
      showVerifyModal: false,
      isVerifying: false,
      verifyError: '',
      verifyInput: { nip: '' },

      // Session Timer State (PROTECTED_NIP mode)
      sessionTimerSeconds: 0,
      sessionTimerInterval: null,

      // Filter & Sort State
      activeSort: { colKey: null, direction: 'asc' },
      columnFilters: {}, // { [colKey]: string[] of allowed values }
      activeFilterCol: null,
      activeFilterBtn: null,
      activeFilterLabel: '',
      filterSearchText: '',
      filterDropdownPos: { top: 0, left: 0, maxHeight: '460px' },

      init() {
        if (window.lucide) {
          this.$nextTick(() => window.lucide.createIcons());
        }
        if (this.currentUnlockedRowId) {
          this.jumpToRow(this.currentUnlockedRowId);
          if (this.accessMode === 'PROTECTED_NIP') {
            this.startSessionTimer(180);
          }
        }

        // Reposition filter popover dynamically on scroll (window or table container) and window resize
        window.addEventListener('scroll', () => {
          if (this.activeFilterCol) this.repositionFilterDropdown();
        }, { passive: true, capture: true });

        window.addEventListener('resize', () => {
          if (this.activeFilterCol) this.repositionFilterDropdown();
        }, { passive: true });
      },

      isIdentityColumn(col) {
        if (!col) return false;
        const k = (col.key || '').toLowerCase();
        const l = (col.label || '').toLowerCase();
        return ['nama', 'label', 'namalengkap', 'namapegawai', 'nama_lengkap', 'nip', 'identifier', 'kode', 'unitkerja', 'sublabel', 'jabatan'].includes(k)
          || l.includes('nama pegawai') || l.includes('nama lengkap') || l === 'nip';
      },

      shouldMaskCell(row, col) {
        if (this.accessMode !== 'PROTECTED_NIP') return false;
        if (!col) return false;
        if (col.isProtected) return false;
        if (this.isIdentityColumn(col)) return false;
        if (this.isRowUnlocked(row)) return false;
        return true;
      },

      get visibleColumns() {
        return this.columns.filter(c => !this.hiddenColKeys.includes(c.key));
      },

      isColumnVisible(key) {
        return !this.hiddenColKeys.includes(key);
      },

      toggleColumnVisibility(key) {
        if (this.hiddenColKeys.includes(key)) {
          this.hiddenColKeys = this.hiddenColKeys.filter(k => k !== key);
        } else {
          this.hiddenColKeys.push(key);
        }
        localStorage.setItem(storageKey, JSON.stringify(this.hiddenColKeys));
        this.$nextTick(() => window.lucide?.createIcons());
      },

      showAllColumns() {
        this.hiddenColKeys = [];
        localStorage.setItem(storageKey, JSON.stringify([]));
      },

      isFieldDefinedInSheet(field) {
        const q = field.toLowerCase();
        return this.allDefinedColumns.some(c => (c.key && c.key.toLowerCase() === q) || (c.label && c.label.toLowerCase() === q));
      },

      hasCustomColumnFor(field) {
        return this.columns.some(c => c.key === field || c.label.toLowerCase() === field.toLowerCase());
      },

      get unlockedRow() {
        if (!this.currentUnlockedRowId) return null;
        return this.rows.find(r => r.id === this.currentUnlockedRowId) || null;
      },

      // --- FILTER & SORT METHODS ---
      get hasActiveFiltersOrSort() {
        return Object.keys(this.columnFilters).length > 0 || !!this.activeSort.colKey;
      },

      get activeFilterSummary() {
        const parts = [];
        if (this.activeSort.colKey) {
          const col = this.columns.find(c => c.key === this.activeSort.colKey);
          let name = col ? col.label : this.activeSort.colKey;
          if (this.activeSort.colKey === 'nama') name = 'Nama Lengkap';
          if (this.activeSort.colKey === 'nip') name = 'NIP';
          if (this.activeSort.colKey === 'unitKerja') name = 'Unit Sekolah';
          parts.push(`Urut: ${name} (${this.activeSort.direction === 'asc' ? 'A-Z' : 'Z-A'})`);
        }
        const filteredColCount = Object.keys(this.columnFilters).length;
        if (filteredColCount > 0) {
          parts.push(`${filteredColCount} kolom difilter`);
        }
        return parts.join(', ');
      },

      isColumnFilteredOrSorted(key) {
        const isSorted = this.activeSort.colKey === key;
        const isFiltered = this.columnFilters[key] !== undefined && this.columnFilters[key] !== null;
        return isSorted || isFiltered;
      },

      isSortActive(key, direction) {
        return this.activeSort.colKey === key && this.activeSort.direction === direction;
      },

      openFilterDropdown(colKey, colLabel, event) {
        if (this.activeFilterCol === colKey) {
          this.activeFilterCol = null;
          this.activeFilterBtn = null;
          return;
        }
        this.activeFilterCol = colKey;
        this.activeFilterLabel = colLabel || colKey;
        this.filterSearchText = '';
        this.activeFilterBtn = event.currentTarget;

        this.repositionFilterDropdown();

        this.$nextTick(() => {
          this.repositionFilterDropdown();
          if (window.lucide) window.lucide.createIcons();
        });
      },

      repositionFilterDropdown() {
        if (!this.activeFilterCol || !this.activeFilterBtn) return;
        const rect = this.activeFilterBtn.getBoundingClientRect();
        
        // If button is completely off screen, close the dropdown
        if (rect.bottom < 40 || rect.top > window.innerHeight - 20) {
          this.activeFilterCol = null;
          this.activeFilterBtn = null;
          return;
        }

        const popoverWidth = 280;
        let left = rect.left;
        if (left + popoverWidth > window.innerWidth - 16) {
          left = window.innerWidth - popoverWidth - 16;
        }
        if (left < 16) left = 16;

        const popoverEl = this.$refs.filterDropdown;
        const popoverHeight = popoverEl ? popoverEl.offsetHeight : 360;
        const margin = 6;
        
        const spaceBelow = window.innerHeight - rect.bottom - margin - 12;
        const spaceAbove = rect.top - margin - 12;

        let top;
        let maxHeight;

        // If there is enough space below (at least 260px) or space below is greater than space above
        if (spaceBelow >= Math.min(popoverHeight, 260) || spaceBelow >= spaceAbove) {
          top = rect.bottom + margin;
          maxHeight = Math.max(180, spaceBelow);
        } else {
          // Open upwards
          top = Math.max(12, rect.top - popoverHeight - margin);
          maxHeight = Math.max(180, spaceAbove);
        }

        // Safety check to ensure bottom never overflows viewport
        if (top + Math.min(popoverHeight, maxHeight) > window.innerHeight - 12) {
          top = Math.max(12, window.innerHeight - Math.min(popoverHeight, maxHeight) - 12);
        }

        this.filterDropdownPos = {
          top: Math.round(top),
          left: Math.round(left),
          maxHeight: `${Math.round(maxHeight)}px`
        };
      },

      applySort(colKey, direction) {
        this.activeSort = { colKey, direction };
        this.currentPage = 1;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      clearSort() {
        this.activeSort = { colKey: null, direction: 'asc' };
        this.currentPage = 1;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      get currentColumnDistinctValues() {
        if (!this.activeFilterCol) return [];
        const key = this.activeFilterCol;
        const counts = new Map();
        
        for (const r of this.rows) {
          const val = String(this.getCellValue(r, key) || '').trim();
          counts.set(val, (counts.get(val) || 0) + 1);
        }

        let list = Array.from(counts.entries()).map(([value, count]) => ({ value, count }));
        
        list.sort((a, b) => {
          if (!a.value) return 1;
          if (!b.value) return -1;
          return a.value.localeCompare(b.value, undefined, { numeric: true, sensitivity: 'base' });
        });

        if (this.filterSearchText.trim()) {
          const q = this.filterSearchText.toLowerCase();
          list = list.filter(item => (item.value || '(kosong / belum diisi)').toLowerCase().includes(q));
        }

        return list;
      },

      isFilterValueSelected(val) {
        if (!this.activeFilterCol) return true;
        const selected = this.columnFilters[this.activeFilterCol];
        if (!selected) return true;
        return selected.includes(val);
      },

      toggleFilterValue(val) {
        if (!this.activeFilterCol) return;
        const key = this.activeFilterCol;
        
        if (!this.columnFilters[key]) {
          const allVals = this.currentColumnDistinctValues.map(i => i.value);
          this.columnFilters[key] = allVals.filter(v => v !== val);
        } else {
          if (this.columnFilters[key].includes(val)) {
            this.columnFilters[key] = this.columnFilters[key].filter(v => v !== val);
          } else {
            this.columnFilters[key].push(val);
          }
        }
        this.currentPage = 1;
      },

      selectAllFilterValues() {
        if (!this.activeFilterCol) return;
        delete this.columnFilters[this.activeFilterCol];
        this.currentPage = 1;
      },

      clearFilterValuesSelection() {
        if (!this.activeFilterCol) return;
        this.columnFilters[this.activeFilterCol] = [];
        this.currentPage = 1;
      },

      resetColumnFilter(key) {
        if (key) {
          delete this.columnFilters[key];
          if (this.activeSort.colKey === key) {
            this.activeSort = { colKey: null, direction: 'asc' };
          }
        }
        this.currentPage = 1;
      },

      resetAllFilters() {
        this.columnFilters = {};
        this.activeSort = { colKey: null, direction: 'asc' };
        this.searchQuery = '';
        this.currentPage = 1;
      },

      get filteredRows() {
        let result = this.rows;

        // 1. Global Search Query
        if (this.searchQuery && this.searchQuery.trim()) {
          const q = this.searchQuery.toLowerCase();
          result = result.filter(r => {
            if (r.label && r.label.toLowerCase().includes(q)) return true;
            if (r.identifier && r.identifier.toLowerCase().includes(q)) return true;
            if (r.subLabel && r.subLabel.toLowerCase().includes(q)) return true;
            const d = r.data || {};
            return Object.values(d).some(v => v !== null && v !== undefined && String(v).toLowerCase().includes(q));
          });
        }

        // 2. Column-specific value filters
        for (const [colKey, selectedValues] of Object.entries(this.columnFilters)) {
          if (selectedValues && Array.isArray(selectedValues)) {
            result = result.filter(r => {
              const cellVal = String(this.getCellValue(r, colKey) || '').trim();
              return selectedValues.includes(cellVal);
            });
          }
        }

        // 3. Active Column Sorting
        if (this.activeSort && this.activeSort.colKey) {
          const key = this.activeSort.colKey;
          const dir = this.activeSort.direction === 'desc' ? -1 : 1;

          result = [...result].sort((a, b) => {
            let valA = this.getCellValue(a, key);
            let valB = this.getCellValue(b, key);

            if (valA === undefined || valA === null) valA = '';
            if (valB === undefined || valB === null) valB = '';

            valA = String(valA).trim();
            valB = String(valB).trim();

            if (!valA && !valB) return 0;
            if (!valA) return 1;
            if (!valB) return -1;

            // Check if both values are pure numbers or currency (e.g. "123", "Rp 50.000", "10%") without full words
            const isPureNumA = /^[+-]?(Rp\.?\s*)?[\d.,]+%?$/i.test(valA);
            const isPureNumB = /^[+-]?(Rp\.?\s*)?[\d.,]+%?$/i.test(valB);
            if (isPureNumA && isPureNumB) {
              const cleanA = Number(valA.replace(/[^0-9.-]+/g, ''));
              const cleanB = Number(valB.replace(/[^0-9.-]+/g, ''));
              if (!isNaN(cleanA) && !isNaN(cleanB)) {
                return (cleanA - cleanB) * dir;
              }
            }

            return valA.localeCompare(valB, 'id', { numeric: true, sensitivity: 'base' }) * dir;
          });
        }

        return result;
      },

      get totalPages() {
        if (this.pageSize === 'all') return 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return Math.max(1, Math.ceil(this.filteredRows.length / size));
      },

      get paginatedRows() {
        if (this.pageSize === 'all') return this.filteredRows;
        const size = parseInt(this.pageSize, 10) || 50;
        const start = (this.currentPage - 1) * size;
        return this.filteredRows.slice(start, start + size);
      },

      get startRowNumber() {
        if (this.filteredRows.length === 0) return 0;
        if (this.pageSize === 'all') return 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return (this.currentPage - 1) * size + 1;
      },

      get endRowNumber() {
        if (this.filteredRows.length === 0) return 0;
        if (this.pageSize === 'all') return this.filteredRows.length;
        const size = parseInt(this.pageSize, 10) || 50;
        return Math.min(this.currentPage * size, this.filteredRows.length);
      },

      getRowGlobalIndex(rowIdx) {
        if (this.pageSize === 'all') return rowIdx + 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return (this.currentPage - 1) * size + rowIdx + 1;
      },

      goToPage(p) {
        if (p < 1) p = 1;
        if (p > this.totalPages) p = this.totalPages;
        this.currentPage = p;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      jumpToRow(rowId) {
        const idx = this.filteredRows.findIndex(r => r.id === rowId);
        if (idx !== -1 && this.pageSize !== 'all') {
          const size = parseInt(this.pageSize, 10) || 50;
          this.currentPage = Math.floor(idx / size) + 1;
        }
        this.$nextTick(() => {
          this.scrollToUnlockedRow();
        });
      },

      get filledCount() {
        return this.rows.filter(r => {
          const d = r.data || {};
          return this.columns.some(col => d[col.key] !== undefined && d[col.key] !== '' && d[col.key] !== null);
        }).length;
      },

      get fillPercentage() {
        if (this.rows.length === 0) return 0;
        return Math.round((this.filledCount / this.rows.length) * 100);
      },

      getCellValue(row, key) {
        if (!row) return '';
        // 1. Direct match in row.data if non-empty
        if (row.data && row.data[key] !== undefined && row.data[key] !== null && String(row.data[key]).trim() !== '') {
          return row.data[key];
        }

        // 2. Case-insensitive key match in row.data if non-empty
        if (row.data && typeof row.data === 'object') {
          const lKey = String(key || '').toLowerCase();
          for (const [k, v] of Object.entries(row.data)) {
            if (k.toLowerCase() === lKey && v !== undefined && v !== null && String(v).trim() !== '') {
              return v;
            }
          }
        }

        // 3. Fallback to entity row fields
        const lk = String(key || '').toLowerCase();
        if (['nama', 'label', 'namalengkap', 'namapegawai', 'nama_lengkap', 'namaunit'].includes(lk)) {
          return row.label || (row.data && (row.data.nama || row.data.namaUnit || row.data.label)) || '';
        }
        if (['nip', 'identifier', 'kode', 'nip_baru', 'nik'].includes(lk)) {
          return row.identifier || (row.data && (row.data.nip || row.data.identifier)) || '';
        }
        if (['unitkerja', 'sublabel', 'unit', 'instansi', 'sekolah', 'unitsekolah', 'jabatan'].includes(lk)) {
          return row.subLabel || (row.data && (row.data.unitKerja || row.data.jabatan || row.data.subLabel)) || '';
        }

        // 4. Return raw row.data[key] if present even if empty
        if (row.data && row.data[key] !== undefined && row.data[key] !== null) {
          return row.data[key];
        }

        return '';
      },

      isRowFilled(row) {
        const d = row.data || {};
        return this.columns.some(col => {
          if (col.isProtected) return false;
          const val = this.getCellValue(row, col.key);
          return val !== undefined && val !== null && String(val).trim() !== '' && String(val).trim() !== '-';
        });
      },

      isCellFilled(row, colKey) {
        const val = this.getCellValue(row, colKey);
        if (val === undefined || val === null) return false;
        if (typeof val === 'boolean') return val;
        const str = String(val).trim();
        return str !== '' && str !== '-';
      },

      canEditRow(row) {
        if (this.accessMode === 'OPEN_EDIT') return true;
        if (this.accessMode === 'PROTECTED_NIP') {
          return row.id === this.currentUnlockedRowId;
        }
        return false;
      },

      canEditCell(row, col) {
        if (col && col.isProtected) return false;
        return this.canEditRow(row);
      },

      isRowUnlocked(row) {
        return this.accessMode === 'PROTECTED_NIP' && row.id === this.currentUnlockedRowId;
      },

      promptUnlockRow(row) {
        this.verifyInput.nip = row.identifier || (row.data && row.data.nip) || '';
        this.verifyError = '';
        this.showVerifyModal = true;
        this.$nextTick(() => window.lucide?.createIcons());
      },

      startSessionTimer(durationSeconds = 180) {
        this.stopSessionTimer();
        this.sessionTimerSeconds = durationSeconds;
        this.sessionTimerInterval = setInterval(() => {
          if (this.sessionTimerSeconds > 0) {
            this.sessionTimerSeconds--;
            if (this.sessionTimerSeconds === 0) {
              this.stopSessionTimer();
              this.handleSessionExpired();
            }
          }
        }, 1000);
      },

      stopSessionTimer() {
        if (this.sessionTimerInterval) {
          clearInterval(this.sessionTimerInterval);
          this.sessionTimerInterval = null;
        }
      },

      extendSession(extraSeconds = 120) {
        this.sessionTimerSeconds = Math.min(600, this.sessionTimerSeconds + extraSeconds);
        this.$nextTick(() => window.lucide?.createIcons());
      },

      formatTimer(sec) {
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      },

      async handleSessionExpired() {
        const currentId = this.currentUnlockedRowId;
        const targetRow = this.rows.find(r => r.id === currentId);
        const empName = targetRow ? (targetRow.label || targetRow.identifier) : 'Anda';

        await this.lockRow(true);

        alert(`Sesi pengisian untuk ${empName} telah berakhir. Baris Anda telah otomatis dikunci kembali demi keamanan data. Silakan masukkan NIP kembali jika ingin melihat atau mengedit data.`);
      },

      async lockRow(isExpired = false) {
        this.stopSessionTimer();
        const lockedId = this.currentUnlockedRowId;
        this.currentUnlockedRowId = '';

        if (lockedId) {
          const row = this.rows.find(r => r.id === lockedId);
          if (row && row.data && this.accessMode === 'PROTECTED_NIP') {
            for (const c of this.columns) {
              if (!c.isProtected && !this.isIdentityColumn(c)) {
                if (row.data[c.key] !== undefined && row.data[c.key] !== null && String(row.data[c.key]).trim() !== '' && String(row.data[c.key]).trim() !== '-') {
                  row.data[c.key] = '__FILLED__';
                }
              }
            }
          }
        }

        this.$nextTick(() => window.lucide?.createIcons());

        try {
          await fetch(`/sheet/${this.slug}/lock-row`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
        } catch (e) {
          console.error('Failed to notify server of lock-row:', e);
        }
      },

      scrollToUnlockedRow() {
        if (!this.currentUnlockedRowId) return;
        const el = document.getElementById(`row-${this.currentUnlockedRowId}`);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      },

      async submitVerifyNip() {
        const nip = this.verifyInput.nip.trim();
        if (!nip) return;

        this.isVerifying = true;
        this.verifyError = '';

        try {
          const res = await fetch(`/sheet/${this.slug}/verify-nip`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nip })
          });

          const result = await res.json();
          if (result.success) {
            // Update row data with actual unmasked data from server
            const targetRow = this.rows.find(r => r.id === result.rowId);
            if (targetRow && result.data) {
              targetRow.data = { ...(targetRow.data || {}), ...result.data };
            }

            this.currentUnlockedRowId = result.rowId;
            this.showVerifyModal = false;
            this.startSessionTimer(180); // 3 menit countdown
            this.jumpToRow(result.rowId);
            this.$nextTick(() => window.lucide?.createIcons());
          } else {
            this.verifyError = result.message || 'NIP tidak ditemukan dalam spreadsheet ini.';
          }
        } catch (e) {
          console.error('Verify error:', e);
          this.verifyError = 'Terjadi kesalahan jaringan.';
        } finally {
          this.isVerifying = false;
        }
      },

      async updateCell(row, key, value) {
        const colObj = this.columns.find(c => c.key === key);
        if (colObj && colObj.isProtected) return;
        if (!this.canEditRow(row)) return;

        // Keep session active for at least 2 more minutes on edit
        if (this.accessMode === 'PROTECTED_NIP' && this.sessionTimerSeconds < 60) {
          this.sessionTimerSeconds = 120;
        }

        if (!row.data) row.data = {};
        row.data[key] = value;
        if (key === 'nama' || key === 'label') row.label = value;
        if (key === 'nip' || key === 'identifier') row.identifier = value;
        if (key === 'unitKerja' || key === 'subLabel') row.subLabel = value;

        this.isSaving = true;
        this.saveStatus = 'Menyimpan...';

        try {
          const res = await fetch(`/sheet/${this.slug}/save-row`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              rowId: row.id,
              data: row.data,
              updatedBy: row.label || row.identifier || 'User'
            })
          });

          const result = await res.json();
          if (result.success) {
            this.saveStatus = 'Tersimpan otomatis';
            setTimeout(() => { this.saveStatus = ''; }, 2500);
          } else {
            alert('Gagal menyimpan: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Auto-save error:', err);
          alert('Terjadi kesalahan koneksi saat menyimpan.');
        } finally {
          this.isSaving = false;
        }
      },

      // Handle Excel paste in Open Edit mode
      async handlePublicPaste(event) {
        if (this.accessMode !== 'OPEN_EDIT') return;

        const clipboard = (event.clipboardData || window.clipboardData).getData('text');
        if (!clipboard || (!clipboard.includes('\t') && !clipboard.includes('\n'))) return;

        event.preventDefault();

        const targetTd = event.target.closest('td[data-col-key]');
        if (!targetTd) return;

        const startRowId = targetTd.getAttribute('data-row-id');
        const startColKey = targetTd.getAttribute('data-col-key');

        const startRowIndex = this.filteredRows.findIndex(r => r.id === startRowId);
        const startColIndex = this.visibleColumns.findIndex(c => c.key === startColKey);

        if (startRowIndex === -1 || startColIndex === -1) return;

        const pasteRows = clipboard.split(/\r?\n/).filter(line => line.trim().length > 0);
        const updates = [];

        for (let rIdx = 0; rIdx < pasteRows.length; rIdx++) {
          const targetRow = this.filteredRows[startRowIndex + rIdx];
          if (!targetRow) break;

          const cellValues = pasteRows[rIdx].split('\t');
          if (!targetRow.data) targetRow.data = {};

          for (let cIdx = 0; cIdx < cellValues.length; cIdx++) {
            const targetCol = this.visibleColumns[startColIndex + cIdx];
            if (!targetCol) break;
            if (targetCol.isProtected) continue; // Kolom terproteksi tidak boleh di-overwrite via paste

            let val = cellValues[cIdx].trim();
            if (targetCol.type === 'number' || targetCol.type === 'currency') {
              val = val === '' ? null : Number(val.replace(/[^0-9.-]+/g,""));
            } else if (targetCol.type === 'checkbox') {
              val = ['true', '1', 'ya', 'yes', 'v', 'x'].includes(val.toLowerCase());
            }

            targetRow.data[targetCol.key] = val;
            if (targetCol.key === 'nama' || targetCol.key === 'label') targetRow.label = val;
            if (targetCol.key === 'nip' || targetCol.key === 'identifier') targetRow.identifier = val;
            if (targetCol.key === 'unitKerja' || targetCol.key === 'subLabel') targetRow.subLabel = val;
          }

          updates.push({
            rowId: targetRow.id,
            data: targetRow.data
          });
        }

        if (updates.length > 0) {
          this.isSaving = true;
          this.saveStatus = `Menyimpan ${updates.length} baris...`;

          try {
            const res = await fetch(`/sheet/${this.slug}/bulk-save`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates, updatedBy: 'Kolaborator' })
            });

            const result = await res.json();
            if (result.success) {
              this.saveStatus = `Berhasil simpan ${updates.length} baris!`;
              setTimeout(() => { this.saveStatus = ''; }, 3000);
            } else {
              alert('Gagal menyimpan hasil paste: ' + (result.message || 'Kesalahan server'));
            }
          } catch (e) {
            console.error('Bulk save error:', e);
            alert('Terjadi kesalahan saat memproses paste dari Excel.');
          } finally {
            this.isSaving = false;
          }
        }
      }
    };
  }
</script>

