<%- include('../partials/head') %>
<%- include('../partials/public-nav') %>

<!-- Safe JSON Data Script -->
<script type="application/json" id="sheet-data">
  <%- JSON.stringify({
    sheetId: sheet.id,
    slug: sheet.slug,
    accessMode: sheet.accessMode,
    targetType: sheet.targetType,
    initialUnlockedRowId: unlockedRowId || "",
    columns: columns,
    allSheetColumns: (sheet.columns || []).map(c => ({ key: c.key, label: c.label, hidden: !!c.hidden })),
    initialRows: rows
  }).replace(/</g, '\\u003c') %>
</script>

<main class="min-h-screen bg-slate-50/70 py-6 sm:py-10 px-4 sm:px-6 lg:px-8 font-sans"
      x-data="publicSpreadsheetViewer()">

  <div class="max-w-[1400px] mx-auto space-y-6">

    <!-- Top Card: Header & Description -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 sm:p-8 space-y-4 relative overflow-hidden">
      <!-- Top Badges & Meta -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-indigo-50 text-indigo-700 border border-indigo-100 flex items-center gap-1.5">
            <i data-lucide="sheet" class="w-3.5 h-3.5"></i>
            <span>Spreadsheet Kolaboratif</span>
          </span>

          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold
            <%= sheet.targetType === 'UNIT' ? 'bg-indigo-100 text-indigo-800' : (sheet.targetType === 'PEGAWAI' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700') %>">
            <%= sheet.targetType === 'UNIT' ? 'Target: Unit Sekolah' : (sheet.targetType === 'PEGAWAI' ? 'Target: Pegawai' : 'Target: Umum') %>
          </span>

          <!-- Mode badge -->
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold
            <%= sheet.accessMode === 'PROTECTED_NIP' ? 'bg-amber-50 text-amber-800 border border-amber-200' : (sheet.accessMode === 'OPEN_EDIT' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-600 border border-slate-200') %>">
            <i data-lucide="<%= sheet.accessMode === 'PROTECTED_NIP' ? 'lock' : (sheet.accessMode === 'OPEN_EDIT' ? 'edit-3' : 'eye') %>" class="w-3 h-3 inline mr-1"></i>
            <%= sheet.accessMode === 'PROTECTED_NIP' ? 'Diisi Per-Baris dengan NIP' : (sheet.accessMode === 'OPEN_EDIT' ? 'Kolaboratif Bebas (Semua Sel)' : 'Publik Hanya Lihat') %>
          </span>

          <% if (sheet.status !== 'ACTIVE') { %>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700 border border-rose-200">
              Pengisian Ditutup (Arsip)
            </span>
          <% } %>
        </div>

        <!-- Sync indicator -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 text-xs font-semibold">
          <template x-if="isSaving">
            <div class="flex items-center gap-1.5 text-amber-600">
              <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
              <span>Menyimpan data...</span>
            </div>
          </template>
          <template x-if="!isSaving && saveStatus">
            <div class="flex items-center gap-1.5 text-emerald-600">
              <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
              <span x-text="saveStatus"></span>
            </div>
          </template>
          <template x-if="!isSaving && !saveStatus">
            <div class="flex items-center gap-1.5 text-slate-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Data tersinkron otomatis</span>
            </div>
          </template>
        </div>
      </div>

      <!-- Title & Details -->
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          <%= sheet.title %>
        </h1>
        <% if (sheet.description) { %>
          <p class="text-slate-600 text-xs sm:text-sm mt-2 max-w-4xl leading-relaxed whitespace-pre-line">
            <%= sheet.description %>
          </p>
        <% } %>
      </div>

      <!-- Unlocked Row Banner (if user verified NIP) -->
      <template x-if="accessMode === 'PROTECTED_NIP' && unlockedRow">
        <div class="p-4 rounded-2xl bg-indigo-50/80 border border-indigo-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0">
              <i data-lucide="unlock" class="w-5 h-5"></i>
            </div>
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-indigo-600">Akses Baris Anda Terbuka</div>
              <div class="font-extrabold text-slate-900 text-sm" x-text="unlockedRow.label"></div>
              <div class="text-xs text-slate-500 font-mono" x-text="unlockedRow.identifier ? ('NIP: ' + unlockedRow.identifier) : ''"></div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="button"
                    @click="scrollToUnlockedRow()"
                    class="btn-primary py-2 px-3 text-xs bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold flex items-center gap-1.5">
              <i data-lucide="crosshair" class="w-3.5 h-3.5"></i>
              <span>Ke Baris Saya</span>
            </button>
            <button type="button"
                    @click="lockRow()"
                    class="py-2 px-3 text-xs bg-white border border-slate-200 hover:bg-slate-100 text-slate-600 rounded-xl font-bold transition-colors">
              Kunci Selesai
            </button>
          </div>
        </div>
      </template>

      <!-- Stats & Quick Actions Toolbar -->
      <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <!-- Progress Bar Summary -->
        <div class="flex items-center gap-4">
          <div>
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Progress Terisi</div>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="text-lg font-black text-slate-800" x-text="`${filledCount} / ${rows.length}`"></span>
              <span class="text-xs font-bold text-emerald-600" x-text="`(${fillPercentage}%)`"></span>
            </div>
          </div>
          <div class="w-32 bg-slate-100 h-2 rounded-full overflow-hidden hidden sm:block">
            <div class="bg-emerald-500 h-2 rounded-full transition-all duration-500" :style="`width: ${fillPercentage}%`"></div>
          </div>
        </div>

        <!-- Buttons: Verify NIP & Export Excel -->
        <div class="flex items-center gap-2.5">
          <!-- Button Verify NIP (Only if PROTECTED_NIP and sheet is ACTIVE) -->
          <% if (sheet.accessMode === 'PROTECTED_NIP' && sheet.status === 'ACTIVE') { %>
            <template x-if="!unlockedRow">
              <button type="button"
                      @click="showVerifyModal = true"
                      class="btn-primary py-2.5 px-4 text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white rounded-xl shadow-xs flex items-center gap-2">
                <i data-lucide="key" class="w-4 h-4"></i>
                <span>Verifikasi NIP Pengisian</span>
              </button>
            </template>
          <% } %>

          <!-- Export Excel (If enabled) -->
          <% if (sheet.allowExport) { %>
            <a href="/sheet/<%= sheet.slug %>/export"
               class="py-2.5 px-3.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-bold flex items-center gap-1.5 transition-colors shadow-2xs"
               title="Download seluruh data spreadsheet ke Excel">
              <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-600"></i>
              <span>Unduh Excel</span>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Search Toolbar & Pagination & Column Visibility Controls -->
    <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="relative w-full sm:max-w-md">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        <input type="text"
               x-model="searchQuery"
               @input="currentPage = 1"
               placeholder="Cari nama, NIP, nama sekolah, dll..."
               class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all outline-none">
      </div>

      <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 self-stretch sm:self-center justify-between sm:justify-end">
        
        <!-- Baris Per Halaman -->
        <div class="flex items-center gap-1.5">
          <span>Baris:</span>
          <select x-model="pageSize" @change="currentPage = 1"
                  class="px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 outline-none">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="all">Semua</option>
          </select>
        </div>

        <!-- ATUR KOLOM (Sembunyikan / Tampilkan Kolom) -->
        <div class="relative" x-data="{ openCols: false }">
          <button type="button"
                  @click="openCols = !openCols"
                  class="py-1.5 px-3 text-xs font-bold gap-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 flex items-center transition-colors">
            <i data-lucide="eye" class="w-3.5 h-3.5 text-indigo-600"></i>
            <span>Atur Kolom (<span x-text="visibleColumns.length"></span>/<span x-text="columns.length"></span>)</span>
            <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400"></i>
          </button>

          <div x-show="openCols"
               x-cloak
               @click.away="openCols = false"
               class="absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-xl border border-slate-200 p-3 z-30 space-y-2">
            <div class="flex items-center justify-between pb-1.5 border-b border-slate-100">
              <span class="text-xs font-black text-slate-900">Kolom Ditampilkan</span>
              <button type="button" @click="showAllColumns()" class="text-[10px] font-bold text-indigo-600 hover:underline">Semua</button>
            </div>
            <div class="max-h-56 overflow-y-auto space-y-1 scrollbar-thin">
              <template x-for="col in columns" :key="col.key">
                <label class="flex items-center justify-between p-1 hover:bg-slate-50 rounded-lg cursor-pointer text-xs select-none">
                  <div class="flex items-center gap-2 truncate">
                    <input type="checkbox"
                           :checked="isColumnVisible(col.key)"
                           @change="toggleColumnVisibility(col.key)"
                           class="rounded text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5">
                    <span class="font-semibold text-slate-800 truncate" x-text="col.label"></span>
                  </div>
                  <span class="text-[9px] font-mono text-slate-400 uppercase" x-text="col.type"></span>
                </label>
              </template>
            </div>
          </div>
        </div>

        <span>Menampilkan <b class="text-slate-800" x-text="startRowNumber"></b> - <b class="text-slate-800" x-text="endRowNumber"></b> dari <b class="text-slate-800" x-text="filteredRows.length"></b></span>
      </div>
    </div>

    <!-- Spreadsheet Data Table Grid -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
      <div class="overflow-x-auto max-h-[700px] relative scrollbar-thin">
        <table class="w-full border-collapse text-left text-xs" @paste="handlePublicPaste($event)">
          <!-- Table Header -->
          <thead class="bg-slate-100/90 sticky top-0 z-20 text-[11px] font-black text-slate-600 uppercase tracking-wider border-b border-slate-300 select-none shadow-2xs">
            <tr>
              <th class="py-3 px-3 w-12 text-center border-r border-slate-200 bg-slate-100">#</th>
              
              <!-- Fallback Identitas Columns if not explicitly defined in sheet -->
              <template x-if="!isFieldDefinedInSheet('nama') && !isFieldDefinedInSheet('label')">
                <th class="py-3 px-4 min-w-[200px] border-r border-slate-200 bg-slate-100">
                  <%= sheet.targetType === 'UNIT' ? 'Nama Unit Sekolah' : (sheet.targetType === 'PEGAWAI' ? 'Nama Pegawai' : 'Label Baris') %>
                </th>
              </template>

              <template x-if="!isFieldDefinedInSheet('nip') && !isFieldDefinedInSheet('identifier') && ('<%= sheet.targetType %>' === 'PEGAWAI' || '<%= sheet.targetType %>' === 'UNIT')">
                <th class="py-3 px-4 min-w-[150px] border-r border-slate-200 bg-slate-100">
                  <%= sheet.targetType === 'PEGAWAI' ? 'NIP' : 'Kode' %>
                </th>
              </template>

              <template x-if="!isFieldDefinedInSheet('unitKerja') && !isFieldDefinedInSheet('subLabel') && !isFieldDefinedInSheet('jabatan')">
                <th class="py-3 px-4 min-w-[150px] border-r border-slate-200 bg-slate-100">
                  <%= sheet.targetType === 'PEGAWAI' ? 'Jabatan / Instansi' : 'Keterangan' %>
                </th>
              </template>

              <!-- Dynamic Custom Columns (Filtered by Column Visibility) -->
              <template x-for="col in visibleColumns" :key="col.key">
                <th class="py-3 px-4 min-w-[170px] border-r border-slate-200 bg-slate-100">
                  <div class="flex items-center justify-between gap-1.5">
                    <span class="truncate font-bold text-slate-800" :title="col.label" x-text="col.label"></span>
                    <span class="text-[9px] px-1.5 py-0.5 rounded font-mono shrink-0 uppercase"
                          :class="{
                            'bg-blue-100 text-blue-700': col.type === 'number' || col.type === 'currency',
                            'bg-purple-100 text-purple-700': col.type === 'select',
                            'bg-emerald-100 text-emerald-700': col.type === 'checkbox',
                            'bg-amber-100 text-amber-700': col.type === 'date',
                            'bg-slate-200 text-slate-700': col.type === 'text' || col.type === 'textarea'
                          }"
                          x-text="col.type">
                    </span>
                  </div>
                </th>
              </template>

              <!-- Status Kolom Akses -->
              <% if (sheet.accessMode === 'PROTECTED_NIP') { %>
                <th class="py-3 px-3 w-28 text-center bg-slate-100">Aksi / Status</th>
              <% } %>
            </tr>
          </thead>

          <!-- Table Body (Paginated) -->
          <tbody class="divide-y divide-slate-200 bg-white font-normal text-slate-700">
            <template x-for="(row, rowIdx) in paginatedRows" :key="row.id">
              <tr :id="`row-${row.id}`"
                  class="transition-colors group"
                  :class="{
                    'bg-indigo-50/70 ring-2 ring-indigo-500 ring-inset': isRowUnlocked(row),
                    'bg-emerald-50/35 hover:bg-emerald-50/60': !isRowUnlocked(row) && isRowFilled(row),
                    'hover:bg-slate-50/80': !isRowUnlocked(row) && !isRowFilled(row)
                  }">
                
                <!-- Index -->
                <td class="py-2.5 px-3 text-center border-r border-slate-200 font-mono text-[11px] text-slate-400 bg-slate-50/30"
                    x-text="getRowGlobalIndex(rowIdx)">
                </td>

                <!-- Fallback Identitas Cells -->
                <template x-if="!isFieldDefinedInSheet('nama') && !isFieldDefinedInSheet('label')">
                  <td class="py-2.5 px-4 border-r border-slate-200 font-bold text-slate-900"
                      x-text="row.label">
                  </td>
                </template>

                <template x-if="!isFieldDefinedInSheet('nip') && !isFieldDefinedInSheet('identifier') && ('<%= sheet.targetType %>' === 'PEGAWAI' || '<%= sheet.targetType %>' === 'UNIT')">
                  <td class="py-2.5 px-4 border-r border-slate-200 font-mono text-slate-600"
                      x-text="row.identifier || '-'">
                  </td>
                </template>

                <template x-if="!isFieldDefinedInSheet('unitKerja') && !isFieldDefinedInSheet('subLabel') && !isFieldDefinedInSheet('jabatan')">
                  <td class="py-2.5 px-4 border-r border-slate-200 text-slate-500"
                      x-text="row.subLabel || '-'">
                  </td>
                </template>

                <!-- Dynamic Columns (Filtered by Column Visibility) -->
                <template x-for="col in visibleColumns" :key="col.key">
                  <td class="py-1 px-2 border-r border-slate-200 relative transition-colors"
                      :class="{ 'bg-emerald-50/50': isCellFilled(row, col.key) }"
                      :data-row-id="row.id"
                      :data-col-key="col.key">

                    <!-- SCENARIO A: Row is EDITABLE (either OPEN_EDIT mode or verified PROTECTED_NIP) -->
                    <template x-if="canEditRow(row)">
                      <div>
                        <!-- Checkbox -->
                        <template x-if="col.type === 'checkbox'">
                          <div class="flex items-center justify-center py-1">
                            <input type="checkbox"
                                   :checked="!!getCellValue(row, col.key)"
                                   @change="updateCell(row, col.key, $event.target.checked)"
                                   class="w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500 cursor-pointer">
                          </div>
                        </template>

                        <!-- Select -->
                        <template x-if="col.type === 'select'">
                          <select :value="getCellValue(row, col.key) || ''"
                                  @change="updateCell(row, col.key, $event.target.value)"
                                  class="w-full px-2 py-1.5 rounded-lg border text-xs outline-none transition-all cursor-pointer"
                                  :class="isCellFilled(row, col.key) 
                                    ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white' 
                                    : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                            <option value="">-- Pilih --</option>
                            <template x-for="opt in (col.options || [])" :key="opt">
                              <option :value="opt" x-text="opt" :selected="getCellValue(row, col.key) === opt"></option>
                            </template>
                          </select>
                        </template>

                        <!-- Number / Currency -->
                        <template x-if="col.type === 'number' || col.type === 'currency'">
                          <input type="number"
                                 :value="getCellValue(row, col.key) ?? ''"
                                 @change="updateCell(row, col.key, $event.target.value)"
                                 placeholder="0"
                                 class="w-full px-2 py-1.5 text-right font-mono rounded-lg border text-xs outline-none transition-all"
                                 :class="isCellFilled(row, col.key)
                                   ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white'
                                   : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                        </template>

                        <!-- Date -->
                        <template x-if="col.type === 'date'">
                          <input type="date"
                                 :value="getCellValue(row, col.key) || ''"
                                 @change="updateCell(row, col.key, $event.target.value)"
                                 class="w-full px-2 py-1.5 rounded-lg border text-xs outline-none transition-all"
                                 :class="isCellFilled(row, col.key)
                                   ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white'
                                   : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                        </template>

                        <!-- Text / Textarea -->
                        <template x-if="col.type === 'text' || col.type === 'textarea' || !['checkbox','select','number','currency','date'].includes(col.type)">
                          <input type="text"
                                 :value="getCellValue(row, col.key) || ''"
                                 @change="updateCell(row, col.key, $event.target.value)"
                                 :placeholder="col.placeholder || '-'"
                                 class="w-full px-2 py-1.5 rounded-lg border text-xs outline-none transition-all"
                                 :class="isCellFilled(row, col.key)
                                   ? 'bg-emerald-100/80 border-emerald-300 text-emerald-950 font-bold focus:bg-white'
                                   : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 focus:border-indigo-500'">
                        </template>
                      </div>
                    </template>

                    <!-- SCENARIO B: READ-ONLY (Cell cannot be edited by this user) -->
                    <template x-if="!canEditRow(row)">
                      <div class="px-2 py-1.5 min-h-[30px] flex items-center transition-colors"
                           :class="{
                             'justify-end font-mono': col.type === 'number' || col.type === 'currency', 
                             'justify-center': col.type === 'checkbox'
                           }">
                        
                        <!-- Checkbox read-only badge -->
                        <template x-if="col.type === 'checkbox'">
                          <span :class="getCellValue(row, col.key) ? 'text-emerald-800 bg-emerald-100/90 border border-emerald-300 px-2 py-0.5 rounded-md font-bold' : 'text-slate-300'">
                            <span x-text="getCellValue(row, col.key) ? '✓ Ya' : '-'"></span>
                          </span>
                        </template>

                        <!-- Formatted Value -->
                        <template x-if="col.type !== 'checkbox'">
                          <template x-if="isCellFilled(row, col.key)">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-100/90 text-emerald-900 border border-emerald-300/80 font-bold text-xs shadow-2xs"
                                  x-text="getCellValue(row, col.key)">
                            </span>
                          </template>
                          <template x-if="!isCellFilled(row, col.key)">
                            <span class="text-slate-300 italic text-xs">-</span>
                          </template>
                        </template>
                      </div>
                    </template>

                  </td>
                </template>

                <!-- PROTECTED_NIP: Row Action / Lock status column -->
                <% if (sheet.accessMode === 'PROTECTED_NIP') { %>
                  <td class="py-2 px-2 text-center">
                    <template x-if="isRowUnlocked(row)">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-indigo-600 text-white">
                        <i data-lucide="edit-2" class="w-3 h-3"></i>
                        <span>Aktif Diedit</span>
                      </span>
                    </template>
                    <template x-if="!isRowUnlocked(row)">
                      <button type="button"
                              @click="promptUnlockRow(row)"
                              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-bold text-slate-500 hover:text-amber-700 hover:bg-amber-50 border border-slate-200 transition-colors">
                        <i data-lucide="lock" class="w-3 h-3 text-slate-400"></i>
                        <span>Isi Baris</span>
                      </button>
                    </template>
                  </td>
                <% } %>

              </tr>
            </template>

            <!-- Empty Search Results -->
            <template x-if="filteredRows.length === 0">
              <tr>
                <td :colspan="visibleColumns.length + 5" class="py-12 text-center text-slate-400">
                  <i data-lucide="inbox" class="w-8 h-8 mx-auto text-slate-300 mb-2"></i>
                  <p class="font-bold text-sm text-slate-600">Tidak ada baris yang cocok</p>
                  <p class="text-xs text-slate-400 mt-0.5">Silakan ketik kata kunci pencarian yang lain.</p>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Pagination Bar -->
      <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
        <div>
          Halaman <b class="text-slate-800" x-text="currentPage"></b> dari <b class="text-slate-800" x-text="totalPages"></b>
        </div>

        <div class="flex items-center gap-1.5" x-show="totalPages > 1">
          <button type="button"
                  @click="goToPage(1)"
                  :disabled="currentPage === 1"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            «
          </button>
          <button type="button"
                  @click="goToPage(currentPage - 1)"
                  :disabled="currentPage === 1"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            ‹ Sebelumnya
          </button>

          <span class="px-3 py-1 font-mono font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 rounded-lg">
            <span x-text="currentPage"></span> / <span x-text="totalPages"></span>
          </span>

          <button type="button"
                  @click="goToPage(currentPage + 1)"
                  :disabled="currentPage >= totalPages"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            Berikutnya ›
          </button>
          <button type="button"
                  @click="goToPage(totalPages)"
                  :disabled="currentPage >= totalPages"
                  class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold">
            »
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL: Verifikasi NIP untuk Membuka Kunci Pengisian -->
  <div x-show="showVerifyModal"
       x-cloak
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 sm:p-7 shadow-2xl space-y-4 border border-slate-100"
         @click.away="showVerifyModal = false">
      
      <div class="text-center space-y-2">
        <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto shadow-inner">
          <i data-lucide="shield-alert" class="w-7 h-7"></i>
        </div>
        <h3 class="font-black text-slate-900 text-lg">Verifikasi Identitas</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Masukkan <b>NIP</b> Anda untuk membuka akses pengisian baris data Anda.
        </p>
      </div>

      <!-- Form Verify -->
      <div class="space-y-3 pt-2">
        <div>
          <label class="block font-bold text-slate-700 text-xs mb-1">
            Nomor Induk Pegawai (NIP):
          </label>
          <input type="text"
                 x-model="verifyInput.nip"
                 @keydown.enter="submitVerifyNip()"
                 placeholder="Contoh: 198501012010011005"
                 class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-mono font-bold text-sm focus:bg-white focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none transition-all">
        </div>

        <template x-if="verifyError">
          <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
            <span x-text="verifyError"></span>
          </div>
        </template>
      </div>

      <div class="pt-3 flex items-center justify-end gap-2 border-t border-slate-100">
        <button type="button"
                @click="showVerifyModal = false"
                class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold text-xs">
          Batal
        </button>
        <button type="button"
                @click="submitVerifyNip()"
                :disabled="!verifyInput.nip.trim() || isVerifying"
                class="btn-primary px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold text-xs shadow-sm flex items-center gap-1.5 disabled:opacity-50">
          <template x-if="isVerifying">
            <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
          </template>
          <span>Buka Baris Saya</span>
        </button>
      </div>

    </div>
  </div>

</main>

<script>
  function publicSpreadsheetViewer() {
    let config = { sheetId: '', slug: '', accessMode: '', targetType: '', initialUnlockedRowId: '', columns: [], initialRows: [] };
    try {
      const el = document.getElementById('sheet-data');
      if (el) config = JSON.parse(el.textContent);
    } catch (e) {
      console.error('Failed to parse public sheet data:', e);
    }

    const storageKey = 'sheet_public_hidden_cols_' + config.sheetId;
    let savedHidden = [];
    try {
      savedHidden = JSON.parse(localStorage.getItem(storageKey) || '[]');
    } catch (e) {
      savedHidden = [];
    }

    return {
      sheetId: config.sheetId,
      slug: config.slug,
      accessMode: config.accessMode,
      targetType: config.targetType,
      currentUnlockedRowId: config.initialUnlockedRowId || '',
      columns: config.columns || [],
      allDefinedColumns: config.allSheetColumns || [],
      hiddenColKeys: Array.isArray(savedHidden) ? savedHidden : [],
      rows: (config.initialRows || []).map(r => {
        let d = r.data;
        if (typeof d === 'string') {
          try { d = JSON.parse(d); } catch (e) { d = {}; }
        }
        return { ...r, data: d || {} };
      }),
      searchQuery: '',
      pageSize: '50',
      currentPage: 1,
      isSaving: false,
      saveStatus: '',
      showVerifyModal: false,
      isVerifying: false,
      verifyError: '',
      verifyInput: { nip: '' },

      init() {
        if (window.lucide) {
          this.$nextTick(() => window.lucide.createIcons());
        }
        if (this.currentUnlockedRowId) {
          this.jumpToRow(this.currentUnlockedRowId);
        }
      },

      get visibleColumns() {
        return this.columns.filter(c => !this.hiddenColKeys.includes(c.key));
      },

      isColumnVisible(key) {
        return !this.hiddenColKeys.includes(key);
      },

      toggleColumnVisibility(key) {
        if (this.hiddenColKeys.includes(key)) {
          this.hiddenColKeys = this.hiddenColKeys.filter(k => k !== key);
        } else {
          this.hiddenColKeys.push(key);
        }
        localStorage.setItem(storageKey, JSON.stringify(this.hiddenColKeys));
        this.$nextTick(() => window.lucide?.createIcons());
      },

      showAllColumns() {
        this.hiddenColKeys = [];
        localStorage.setItem(storageKey, JSON.stringify([]));
      },

      isFieldDefinedInSheet(field) {
        const q = field.toLowerCase();
        return this.allDefinedColumns.some(c => (c.key && c.key.toLowerCase() === q) || (c.label && c.label.toLowerCase() === q));
      },

      hasCustomColumnFor(field) {
        return this.columns.some(c => c.key === field || c.label.toLowerCase() === field.toLowerCase());
      },

      get unlockedRow() {
        if (!this.currentUnlockedRowId) return null;
        return this.rows.find(r => r.id === this.currentUnlockedRowId) || null;
      },

      get filteredRows() {
        if (!this.searchQuery.trim()) return this.rows;
        const q = this.searchQuery.toLowerCase();
        return this.rows.filter(r => {
          if (r.label && r.label.toLowerCase().includes(q)) return true;
          if (r.identifier && r.identifier.toLowerCase().includes(q)) return true;
          if (r.subLabel && r.subLabel.toLowerCase().includes(q)) return true;
          const d = r.data || {};
          return Object.values(d).some(v => v !== null && v !== undefined && String(v).toLowerCase().includes(q));
        });
      },

      get totalPages() {
        if (this.pageSize === 'all') return 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return Math.max(1, Math.ceil(this.filteredRows.length / size));
      },

      get paginatedRows() {
        if (this.pageSize === 'all') return this.filteredRows;
        const size = parseInt(this.pageSize, 10) || 50;
        const start = (this.currentPage - 1) * size;
        return this.filteredRows.slice(start, start + size);
      },

      get startRowNumber() {
        if (this.filteredRows.length === 0) return 0;
        if (this.pageSize === 'all') return 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return (this.currentPage - 1) * size + 1;
      },

      get endRowNumber() {
        if (this.filteredRows.length === 0) return 0;
        if (this.pageSize === 'all') return this.filteredRows.length;
        const size = parseInt(this.pageSize, 10) || 50;
        return Math.min(this.currentPage * size, this.filteredRows.length);
      },

      getRowGlobalIndex(rowIdx) {
        if (this.pageSize === 'all') return rowIdx + 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return (this.currentPage - 1) * size + rowIdx + 1;
      },

      goToPage(p) {
        if (p < 1) p = 1;
        if (p > this.totalPages) p = this.totalPages;
        this.currentPage = p;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      jumpToRow(rowId) {
        const idx = this.filteredRows.findIndex(r => r.id === rowId);
        if (idx !== -1 && this.pageSize !== 'all') {
          const size = parseInt(this.pageSize, 10) || 50;
          this.currentPage = Math.floor(idx / size) + 1;
        }
        this.$nextTick(() => {
          this.scrollToUnlockedRow();
        });
      },

      get filledCount() {
        return this.rows.filter(r => {
          const d = r.data || {};
          return this.columns.some(col => d[col.key] !== undefined && d[col.key] !== '' && d[col.key] !== null);
        }).length;
      },

      get fillPercentage() {
        if (this.rows.length === 0) return 0;
        return Math.round((this.filledCount / this.rows.length) * 100);
      },

      getCellValue(row, key) {
        if (row.data && row.data[key] !== undefined && row.data[key] !== null) {
          return row.data[key];
        }
        if (key === 'nama' || key === 'label') return row.label || '';
        if (key === 'nip' || key === 'identifier') return row.identifier || '';
        if (key === 'unitKerja' || key === 'subLabel') return row.subLabel || '';
        return '';
      },

      isRowFilled(row) {
        const d = row.data || {};
        return this.columns.some(col => {
          if (['nama', 'nip', 'unitKerja', 'label', 'identifier', 'subLabel'].includes(col.key)) return false;
          const val = d[col.key];
          return val !== undefined && val !== null && String(val).trim() !== '' && String(val).trim() !== '-';
        });
      },

      isCellFilled(row, colKey) {
        if (['nama', 'nip', 'unitKerja', 'label', 'identifier', 'subLabel'].includes(colKey)) {
          return false;
        }
        const val = this.getCellValue(row, colKey);
        if (val === undefined || val === null) return false;
        if (typeof val === 'boolean') return val;
        const str = String(val).trim();
        return str !== '' && str !== '-';
      },

      canEditRow(row) {
        if (this.accessMode === 'OPEN_EDIT') return true;
        if (this.accessMode === 'PROTECTED_NIP') {
          return row.id === this.currentUnlockedRowId;
        }
        return false;
      },

      isRowUnlocked(row) {
        return this.accessMode === 'PROTECTED_NIP' && row.id === this.currentUnlockedRowId;
      },

      promptUnlockRow(row) {
        this.verifyInput.nip = row.identifier || (row.data && row.data.nip) || '';
        this.verifyError = '';
        this.showVerifyModal = true;
        this.$nextTick(() => window.lucide?.createIcons());
      },

      async submitVerifyNip() {
        const nip = this.verifyInput.nip.trim();
        if (!nip) return;

        this.isVerifying = true;
        this.verifyError = '';

        try {
          const res = await fetch(`/sheet/${this.slug}/verify-nip`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nip })
          });

          const result = await res.json();
          if (result.success) {
            this.currentUnlockedRowId = result.rowId;
            this.showVerifyModal = false;
            this.jumpToRow(result.rowId);
          } else {
            this.verifyError = result.message || 'NIP tidak ditemukan dalam spreadsheet ini.';
          }
        } catch (e) {
          console.error('Verify error:', e);
          this.verifyError = 'Terjadi kesalahan jaringan.';
        } finally {
          this.isVerifying = false;
        }
      },

      lockRow() {
        this.currentUnlockedRowId = '';
      },

      scrollToUnlockedRow() {
        if (!this.currentUnlockedRowId) return;
        const el = document.getElementById(`row-${this.currentUnlockedRowId}`);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      },

      async updateCell(row, key, value) {
        if (!this.canEditRow(row)) return;

        if (!row.data) row.data = {};
        row.data[key] = value;
        if (key === 'nama' || key === 'label') row.label = value;
        if (key === 'nip' || key === 'identifier') row.identifier = value;
        if (key === 'unitKerja' || key === 'subLabel') row.subLabel = value;

        this.isSaving = true;
        this.saveStatus = 'Menyimpan...';

        try {
          const res = await fetch(`/sheet/${this.slug}/save-row`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              rowId: row.id,
              data: row.data,
              updatedBy: row.label || row.identifier || 'User'
            })
          });

          const result = await res.json();
          if (result.success) {
            this.saveStatus = 'Tersimpan otomatis';
            setTimeout(() => { this.saveStatus = ''; }, 2500);
          } else {
            alert('Gagal menyimpan: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Auto-save error:', err);
          alert('Terjadi kesalahan koneksi saat menyimpan.');
        } finally {
          this.isSaving = false;
        }
      },

      // Handle Excel paste in Open Edit mode
      async handlePublicPaste(event) {
        if (this.accessMode !== 'OPEN_EDIT') return;

        const clipboard = (event.clipboardData || window.clipboardData).getData('text');
        if (!clipboard || (!clipboard.includes('\t') && !clipboard.includes('\n'))) return;

        event.preventDefault();

        const targetTd = event.target.closest('td[data-col-key]');
        if (!targetTd) return;

        const startRowId = targetTd.getAttribute('data-row-id');
        const startColKey = targetTd.getAttribute('data-col-key');

        const startRowIndex = this.filteredRows.findIndex(r => r.id === startRowId);
        const startColIndex = this.visibleColumns.findIndex(c => c.key === startColKey);

        if (startRowIndex === -1 || startColIndex === -1) return;

        const pasteRows = clipboard.split(/\r?\n/).filter(line => line.trim().length > 0);
        const updates = [];

        for (let rIdx = 0; rIdx < pasteRows.length; rIdx++) {
          const targetRow = this.filteredRows[startRowIndex + rIdx];
          if (!targetRow) break;

          const cellValues = pasteRows[rIdx].split('\t');
          if (!targetRow.data) targetRow.data = {};

          for (let cIdx = 0; cIdx < cellValues.length; cIdx++) {
            const targetCol = this.visibleColumns[startColIndex + cIdx];
            if (!targetCol) break;

            let val = cellValues[cIdx].trim();
            if (targetCol.type === 'number' || targetCol.type === 'currency') {
              val = val === '' ? null : Number(val.replace(/[^0-9.-]+/g,""));
            } else if (targetCol.type === 'checkbox') {
              val = ['true', '1', 'ya', 'yes', 'v', 'x'].includes(val.toLowerCase());
            }

            targetRow.data[targetCol.key] = val;
            if (targetCol.key === 'nama' || targetCol.key === 'label') targetRow.label = val;
            if (targetCol.key === 'nip' || targetCol.key === 'identifier') targetRow.identifier = val;
            if (targetCol.key === 'unitKerja' || targetCol.key === 'subLabel') targetRow.subLabel = val;
          }

          updates.push({
            rowId: targetRow.id,
            data: targetRow.data
          });
        }

        if (updates.length > 0) {
          this.isSaving = true;
          this.saveStatus = `Menyimpan ${updates.length} baris...`;

          try {
            const res = await fetch(`/sheet/${this.slug}/bulk-save`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates, updatedBy: 'Kolaborator' })
            });

            const result = await res.json();
            if (result.success) {
              this.saveStatus = `Berhasil simpan ${updates.length} baris!`;
              setTimeout(() => { this.saveStatus = ''; }, 3000);
            } else {
              alert('Gagal menyimpan hasil paste: ' + (result.message || 'Kesalahan server'));
            }
          } catch (e) {
            console.error('Bulk save error:', e);
            alert('Terjadi kesalahan saat memproses paste dari Excel.');
          } finally {
            this.isSaving = false;
          }
        }
      }
    };
  }
</script>

<%- include('../partials/footer') %>
