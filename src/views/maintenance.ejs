<%- include('partials/head') %>

<main class="min-h-screen flex flex-col justify-between bg-gradient-to-b from-slate-50 via-slate-100 to-indigo-50/40 text-slate-800">
  
  <!-- Header Bar -->
  <header class="w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img src="/img/logo-emblem.png?v=4" alt="Logo Korwil Cibitung" class="w-10 h-10 object-contain drop-shadow-sm shrink-0">
        <div class="flex flex-col">
          <span class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 leading-tight">KORWIL CIBITUNG</span>
          <span class="text-[11px] sm:text-xs font-medium text-slate-500 line-clamp-1">Dinas Pendidikan Kab. Bekasi</span>
        </div>
      </div>

      <div>
        <a href="/admin/login" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-600 hover:text-indigo-600 hover:border-indigo-200 text-xs font-semibold shadow-2xs transition-all">
          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
          <span>Portal Admin</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Maintenance Content -->
  <div class="flex-1 flex items-center justify-center p-4 sm:p-6 lg:p-8">
    <div class="w-full max-w-xl text-center space-y-6">
      
      <!-- Icon / Graphic Seal -->
      <div class="relative inline-block">
        <div class="w-24 h-24 sm:w-28 sm:h-28 mx-auto rounded-3xl bg-gradient-to-tr from-amber-500 via-amber-400 to-yellow-300 p-0.5 shadow-xl shadow-amber-500/20 flex items-center justify-center">
          <div class="w-full h-full bg-slate-900 rounded-[22px] flex items-center justify-center">
            <i data-lucide="wrench" class="w-12 h-12 text-amber-400 animate-bounce"></i>
          </div>
        </div>
        <span class="absolute -bottom-2 -right-2 px-3 py-1 rounded-full bg-rose-600 text-white text-[10px] font-black uppercase tracking-wider shadow-md border-2 border-white">
          Maintenance
        </span>
      </div>

      <!-- Badge & Target Page -->
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold border border-amber-200">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
          <span><%= typeof pageName !== 'undefined' ? pageName : 'Layanan Sistem' %></span>
        </div>
        
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
          <%= typeof maintenanceTitle !== 'undefined' && maintenanceTitle ? maintenanceTitle : 'Sedang Dalam Pemeliharaan' %>
        </h1>
      </div>

      <!-- Message Card -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/40 text-left space-y-4">
        <div class="flex items-start gap-3">
          <div class="p-2 rounded-xl bg-indigo-50 text-indigo-600 shrink-0 mt-0.5">
            <i data-lucide="info" class="w-5 h-5"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Pemberitahuan Resmi Administrator</h3>
            <p class="text-sm text-slate-700 leading-relaxed font-medium">
              <%= typeof maintenanceMessage !== 'undefined' && maintenanceMessage ? maintenanceMessage : 'Halaman ini sedang ditutup sementara untuk proses pemeliharaan dan audit data oleh tim pengelola Korwil Cibitung. Mohon untuk kembali beberapa saat lagi.' %>
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-500"></i>
            <span>SIMPEG Korwil Cibitung 3.0</span>
          </div>
          <span class="text-[11px] text-slate-400">Data Anda tetap aman tersimpan</span>
        </div>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <% if (typeof currentPath !== 'undefined' && currentPath !== '/') { %>
          <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-200 active:scale-[0.98] transition-all">
            <i data-lucide="home" class="w-4 h-4"></i>
            <span>Kembali ke Beranda</span>
          </a>
        <% } %>

        <a href="/admin/login" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-bold shadow-2xs transition-all">
          <i data-lucide="user-cog" class="w-4 h-4 text-slate-500"></i>
          <span>Masuk Sebagai Admin</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Footer -->
  <footer class="w-full border-t border-slate-200/80 bg-white py-4 text-center text-xs text-slate-400">
    <p>&copy; <%= new Date().getFullYear() %> Korwil Bidik Kecamatan Cibitung. Sistem Informasi Manajemen Pegawai.</p>
  </footer>

</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.lucide) {
      window.lucide.createIcons();
    }
  });
</script>
</body>
</html>
