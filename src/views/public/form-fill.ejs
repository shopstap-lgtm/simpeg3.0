<%- include('../partials/head') %>
<%- include('../partials/public-nav') %>

<% 
  let fieldsList = [];
  try {
    fieldsList = Array.isArray(form.fields) ? form.fields : (typeof form.fields === 'string' ? JSON.parse(form.fields) : []);
  } catch (e) {
    fieldsList = [];
  }
%>

<div class="min-h-screen bg-slate-50/70 py-8 sm:py-12 px-4 sm:px-6 lg:px-8 flex justify-center items-start font-sans">
  <div class="w-full max-w-2xl space-y-6">

    <% if (typeof toast !== 'undefined' && toast) { %>
      <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold flex items-center gap-3 shadow-xs">
        <i data-lucide="alert-circle" class="w-5 h-5 text-rose-500 shrink-0"></i>
        <span><%= toast %></span>
      </div>
    <% } %>

    <!-- =========================================================
         STATE 1: FORM CLOSED / EXPIRED
         ========================================================= -->
    <% if (isExpired) { %>
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xl p-8 sm:p-10 text-center space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
          <i data-lucide="lock" class="w-8 h-8"></i>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900"><%= form.title %></h1>
          <p class="text-xs sm:text-sm text-slate-500 mt-2">
            Formulir ini saat ini telah ditutup dan tidak lagi menerima respon pengisian baru.
          </p>
        </div>
        <div class="pt-4">
          <a href="/" class="btn-secondary py-2.5 px-6 text-xs gap-2">
            <i data-lucide="home" class="w-4 h-4"></i>
            <span>Kembali ke Beranda</span>
          </a>
        </div>
      </div>

    <!-- =========================================================
         STATE 2: FORM NOT YET STARTED
         ========================================================= -->
    <% } else if (isNotStarted) { %>
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xl p-8 sm:p-10 text-center space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto">
          <i data-lucide="clock" class="w-8 h-8"></i>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900"><%= form.title %></h1>
          <p class="text-xs sm:text-sm text-slate-500 mt-2">
            Formulir ini belum dibuka untuk pengisian.
            <% if (form.startDate) { %>
              Pengisian akan dibuka mulai tanggal <strong class="text-slate-800"><%= new Date(form.startDate).toLocaleDateString('id-ID', { dateStyle: 'long' }) %></strong>.
            <% } %>
          </p>
        </div>
        <div class="pt-4">
          <a href="/" class="btn-secondary py-2.5 px-6 text-xs gap-2">
            <i data-lucide="home" class="w-4 h-4"></i>
            <span>Kembali ke Beranda</span>
          </a>
        </div>
      </div>

    <!-- =========================================================
         STATE 3: FORM ACTIVE / FILLABLE
         ========================================================= -->
    <% } else { %>

      <script id="form-data-employees" type="application/json">
        <%- JSON.stringify(typeof employees !== 'undefined' && employees ? employees : []) %>
      </script>
      <script id="form-data-units" type="application/json">
        <%- JSON.stringify(typeof units !== 'undefined' && units ? units : []) %>
      </script>
      <script id="form-data-fields" type="application/json">
        <%- JSON.stringify(typeof fieldsList !== 'undefined' && fieldsList ? fieldsList : []) %>
      </script>

      <script>
        function initPublicForm() {
          const employeesData = JSON.parse(document.getElementById('form-data-employees')?.textContent || '[]');
          const unitsData = JSON.parse(document.getElementById('form-data-units')?.textContent || '[]');
          const fieldsListData = JSON.parse(document.getElementById('form-data-fields')?.textContent || '[]');

          return {
            isSubmitting: false,
            isPegawaiMode: <%= form.targetAudience === 'PEGAWAI' ? 'true' : 'false' %>,
            selectedEmployeeId: '',
            selectedEmployee: null,
            selectedUnit: '',
            hasUnitField: fieldsListData.some(f => f.type === 'unit'),
            employees: employeesData,
            units: unitsData,
            fieldsList: fieldsListData,
            empSearch: '',
            showEmpDropdown: false,
            fileNames: {},
            
            // Dynamic fields state
            fieldEmp: {},
            fieldEmpSearch: {},
            fieldEmpDropdown: {},

            onUnitChange(val) {
              this.selectedUnit = val || '';
              
              // Sync all unit select elements in the form
              this.fieldsList.forEach(f => {
                if (f.type === 'unit') {
                  const sel = document.getElementById('select_unit_' + f.id);
                  if (sel) sel.value = this.selectedUnit;
                }
              });

              // If an employee was previously selected but belongs to a different school, clear it
              if (this.selectedEmployee && this.selectedUnit && this.selectedEmployee.unitNama !== this.selectedUnit) {
                this.clearEmp();
              }
              this.fieldsList.forEach(f => {
                if (f.type === 'employee' && this.fieldEmp[f.id] && this.selectedUnit && this.fieldEmp[f.id].unitNama !== this.selectedUnit) {
                  this.clearFieldEmp(f.id);
                }
              });

              this.$nextTick(() => {
                if (window.lucide) lucide.createIcons();
              });
            },

            selectEmp(emp) {
              this.selectedEmployee = emp;
              this.selectedEmployeeId = emp.id;
              this.showEmpDropdown = false;
              this.empSearch = '';

              // Auto-sync unit if not selected
              if (emp.unitNama && !this.selectedUnit) {
                this.selectedUnit = emp.unitNama;
              }

              // Auto-sync into any dynamic employee or unit fields in the form
              this.fieldsList.forEach(f => {
                if (f.type === 'employee' && !this.fieldEmp[f.id]) {
                  this.fieldEmp[f.id] = emp;
                }
                if (f.type === 'unit') {
                  const sel = document.getElementById('select_unit_' + f.id);
                  if (sel && emp.unitNama) {
                    sel.value = emp.unitNama;
                  }
                }
              });

              this.$nextTick(() => {
                if (window.lucide) lucide.createIcons();
              });
            },

            clearEmp() {
              this.selectedEmployee = null;
              this.selectedEmployeeId = '';
              this.empSearch = '';
              this.$nextTick(() => {
                if (window.lucide) lucide.createIcons();
              });
            },

            get filteredEmployees() {
              let list = this.employees;
              if (this.selectedUnit) {
                list = list.filter(e => e.unitNama === this.selectedUnit || (e.unitNama && e.unitNama.toLowerCase().trim() === this.selectedUnit.toLowerCase().trim()));
              }
              const q = this.empSearch.toLowerCase().trim();
              if (q) {
                list = list.filter(e => 
                  (e.nama && e.nama.toLowerCase().includes(q)) || 
                  (e.nip && e.nip.includes(q))
                );
              }
              return list.slice(0, 30);
            },

            selectFieldEmp(fId, emp) {
              this.fieldEmp[fId] = emp;
              this.fieldEmpDropdown[fId] = false;
              this.fieldEmpSearch[fId] = '';

              // Auto-sync unit if not selected
              if (emp.unitNama && !this.selectedUnit) {
                this.selectedUnit = emp.unitNama;
              }

              // Auto-sync identity at the top if in Pegawai mode and not selected yet
              if (this.isPegawaiMode && !this.selectedEmployee) {
                this.selectedEmployee = emp;
                this.selectedEmployeeId = emp.id;
              }

              // Auto-sync unit dropdown if present
              this.fieldsList.forEach(f => {
                if (f.type === 'unit') {
                  const sel = document.getElementById('select_unit_' + f.id);
                  if (sel && emp.unitNama && !sel.value) {
                    sel.value = emp.unitNama;
                  }
                }
              });

              this.$nextTick(() => {
                if (window.lucide) lucide.createIcons();
              });
            },

            clearFieldEmp(fId) {
              this.fieldEmp[fId] = null;
              this.fieldEmpSearch[fId] = '';
              this.$nextTick(() => {
                if (window.lucide) lucide.createIcons();
              });
            },

            getFieldFilteredEmployees(fId) {
              let list = this.employees;
              if (this.selectedUnit) {
                list = list.filter(e => e.unitNama === this.selectedUnit || (e.unitNama && e.unitNama.toLowerCase().trim() === this.selectedUnit.toLowerCase().trim()));
              }
              const search = (this.fieldEmpSearch[fId] || '').toLowerCase().trim();
              if (search) {
                list = list.filter(e => 
                  (e.nama && e.nama.toLowerCase().includes(search)) || 
                  (e.nip && e.nip.includes(search))
                );
              }
              return list.slice(0, 30);
            },

            handleFileChange(fieldId, event) {
              const files = event.target.files;
              if (files && files.length > 0) {
                this.fileNames[fieldId] = files[0].name + ' (' + (files[0].size / 1024 / 1024).toFixed(2) + ' MB)';
              } else {
                delete this.fileNames[fieldId];
              }
            },

            validateSubmit(e) {
              for (const f of this.fieldsList) {
                if (f.type === 'employee' && f.required && !this.fieldEmp[f.id]) {
                  alert('Pertanyaan \"' + f.label + '\" wajib memilih nama pegawai!');
                  e.preventDefault();
                  this.isSubmitting = false;
                  return false;
                }
              }

              this.isSubmitting = true;
              return true;
            }
          };
        }
      </script>

      <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden"
           x-data="initPublicForm()">

        <!-- Form Top Banner & Header -->
        <div class="p-6 sm:p-8 pb-6 border-b border-slate-100 space-y-4">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <img src="/img/logo-emblem.png?v=4" alt="Logo" class="w-10 h-10 object-contain shrink-0">
              <div>
                <span class="font-extrabold text-xs uppercase tracking-wider text-indigo-700 block">KORWIL CIBITUNG</span>
                <span class="text-[11px] text-slate-400">Dinas Pendidikan Kab. Bekasi</span>
              </div>
            </div>

            <% if (form.targetAudience === 'PEGAWAI') { %>
              <span class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[10.5px] font-extrabold border border-indigo-100">
                <i data-lucide="user-check" class="w-3 h-3 inline mr-1"></i>Khusus Pegawai
              </span>
            <% } else { %>
              <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-[10.5px] font-bold border border-slate-200">
                <i data-lucide="globe" class="w-3 h-3 inline mr-1"></i>Umum / Publik
              </span>
            <% } %>
          </div>

          <div>
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug"><%= form.title %></h1>
            <% if (form.description) { %>
              <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed whitespace-pre-line">
                <%= form.description %>
              </p>
            <% } %>
          </div>

          <div class="flex items-center gap-2 pt-1 text-[11px] text-slate-400">
            <i data-lucide="info" class="w-3.5 h-3.5 text-indigo-500"></i>
            <span>Tanda bintang (<span class="text-rose-500 font-bold">*</span>) menandakan pertanyaan wajib diisi.</span>
          </div>
        </div>

        <!-- Form Submission Form -->
        <form action="/form/<%= form.slug %>/submit" 
              method="POST" 
              enctype="multipart/form-data" 
              @submit="validateSubmit($event)"
              class="p-6 sm:p-8 space-y-6">

          <!-- =====================================================
               DAFTAR PERTANYAAN FORMULIR
               ===================================================== -->
          <div class="space-y-6">
            <% fieldsList.forEach((field, fIdx) => { %>
              <div class="space-y-2 p-5 rounded-2xl bg-slate-50/50 border border-slate-200/80 transition-all hover:border-indigo-200">
                <label class="block text-xs sm:text-sm font-bold text-slate-900">
                  <span class="text-slate-400 mr-1"><%= fIdx + 1 %>.</span>
                  <span><%= field.label %></span>
                  <% if (field.required) { %>
                    <span class="text-rose-500 font-bold ml-0.5">*</span>
                  <% } %>
                </label>

                <% if (field.helpText) { %>
                  <p class="text-[11px] text-slate-500"><%= field.helpText %></p>
                <% } %>

                <!-- 1. Text Input -->
                <% if (field.type === 'text') { %>
                  <input type="text" name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>
                    placeholder="<%= field.placeholder || 'Tuliskan jawaban Anda...' %>"
                    class="w-full h-11 px-3.5 text-xs font-medium text-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 shadow-2xs transition-all">

                <!-- 2. Textarea -->
                <% } else if (field.type === 'textarea') { %>
                  <textarea name="field_<%= field.id %>" rows="3" <%= field.required ? 'required' : '' %>
                    placeholder="<%= field.placeholder || 'Tuliskan jawaban Anda secara lengkap...' %>"
                    class="w-full p-3.5 text-xs font-medium text-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 shadow-2xs transition-all resize-none"></textarea>

                <!-- 3. Number -->
                <% } else if (field.type === 'number') { %>
                  <input type="number" name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>
                    placeholder="<%= field.placeholder || '0' %>"
                    class="w-full h-11 px-3.5 text-xs font-medium text-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 shadow-2xs transition-all">

                <!-- 4. Date -->
                <% } else if (field.type === 'date') { %>
                  <input type="date" name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>
                    class="w-full h-11 px-3.5 text-xs font-medium text-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 shadow-2xs transition-all">

                <!-- 5. Radio Buttons -->
                <% } else if (field.type === 'radio') { %>
                  <div class="space-y-2 pt-1">
                    <% (field.options || []).forEach((opt, optIdx) => { %>
                      <label class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/40 transition-all cursor-pointer select-none">
                        <input type="radio" name="field_<%= field.id %>" value="<%= opt %>" <%= field.required && optIdx === 0 ? 'required' : '' %>
                          class="w-4 h-4 text-indigo-600 focus:ring-indigo-500 border-slate-300">
                        <span class="text-xs font-semibold text-slate-800"><%= opt %></span>
                      </label>
                    <% }) %>
                  </div>

                <!-- 6. Checkboxes -->
                <% } else if (field.type === 'checkbox') { %>
                  <div class="space-y-2 pt-1">
                    <% (field.options || []).forEach(opt => { %>
                      <label class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/40 transition-all cursor-pointer select-none">
                        <input type="checkbox" name="field_<%= field.id %>" value="<%= opt %>"
                          class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300">
                        <span class="text-xs font-semibold text-slate-800"><%= opt %></span>
                      </label>
                    <% }) %>
                  </div>

                <!-- 7. Select Dropdown -->
                <% } else if (field.type === 'select') { %>
                  <select name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>
                    class="w-full h-11 px-3.5 text-xs font-semibold text-slate-800 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 shadow-2xs transition-all cursor-pointer">
                    <option value="">-- Pilih salah satu pilihan --</option>
                    <% (field.options || []).forEach(opt => { %>
                      <option value="<%= opt %>"><%= opt %></option>
                    <% }) %>
                  </select>

                <!-- 8. File Upload Dropzone -->
                <% } else if (field.type === 'file') { 
                     let acceptAttr = '.pdf,.png,.jpg,.jpeg,.xlsx,.xls,.docx,.doc';
                     let formatHelp = 'Format didukung: PDF, Gambar, Dokumen (Maksimal 10MB)';
                     const ft = field.fileType || 'all';
                     if (ft === 'pdf') {
                       acceptAttr = '.pdf,application/pdf';
                       formatHelp = 'Khusus Dokumen PDF (.pdf) • Maksimal 10MB';
                     } else if (ft === 'image') {
                       acceptAttr = 'image/*,.jpg,.jpeg,.png';
                       formatHelp = 'Khusus Gambar / Foto (.jpg, .jpeg, .png) • Maksimal 10MB';
                     } else if (ft === 'office') {
                       acceptAttr = '.pdf,.docx,.doc,.xlsx,.xls';
                       formatHelp = 'Khusus Dokumen Office (.pdf, .docx, .xlsx) • Maksimal 10MB';
                     } else if (ft === 'custom' && field.customExtensions) {
                       acceptAttr = field.customExtensions;
                       formatHelp = `Format diterima: ${field.customExtensions} • Maksimal 10MB`;
                     }
                %>
                  <div class="relative">
                    <input type="file" id="input_<%= field.id %>" name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>
                      @change="handleFileChange('<%= field.id %>', $event)"
                      accept="<%= acceptAttr %>"
                      class="hidden">
                    
                    <label for="input_<%= field.id %>"
                      class="flex flex-col items-center justify-center p-5 border-2 border-dashed border-slate-300 hover:border-indigo-400 bg-white hover:bg-indigo-50/30 rounded-2xl cursor-pointer transition-all text-center">
                      <i data-lucide="upload-cloud" class="w-7 h-7 text-indigo-500 mb-1.5"></i>
                      <span class="text-xs font-bold text-slate-800" x-text="fileNames['<%= field.id %>'] || 'Klik untuk memilih berkas lampiran'"></span>
                      <span class="text-[10.5px] text-slate-400 mt-0.5"><%= formatHelp %></span>
                    </label>
                  </div>

                <!-- 9. SIMPEG Unit Kerja Dropdown -->
                <% } else if (field.type === 'unit') { %>
                  <div class="relative">
                    <select id="select_unit_<%= field.id %>" name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>
                      @change="onUnitChange($event.target.value)"
                      class="w-full h-11 px-3.5 text-xs font-semibold text-slate-800 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-violet-500 shadow-2xs transition-all cursor-pointer">
                      <option value="">-- Pilih Unit Kerja / Sekolah --</option>
                      <% (typeof units !== 'undefined' ? units : []).forEach(u => { %>
                        <option value="<%= u.namaUnit %>" :selected="selectedUnit === '<%= u.namaUnit %>'"><%= u.namaUnit %></option>
                      <% }) %>
                    </select>
                  </div>

                <!-- 10. SIMPEG Employee Searchable Picker -->
                <% } else if (field.type === 'employee') { %>
                  <div class="space-y-3">
                    <!-- Unit notice if unit not yet selected -->
                    <div x-show="hasUnitField && !selectedUnit" class="p-3.5 rounded-xl bg-amber-50 border border-amber-200/80 text-xs text-amber-800 flex items-center gap-2">
                      <i data-lucide="info" class="w-4 h-4 text-amber-600 shrink-0"></i>
                      <span>Silakan pilih <strong>Unit Kerja / Asal Sekolah</strong> di atas terlebih dahulu agar nama pegawai tersaring otomatis.</span>
                    </div>

                    <!-- Hidden inputs sent on form submit (clean name for answer, background data preserved) -->
                    <input type="hidden" name="field_<%= field.id %>" 
                      :value="fieldEmp['<%= field.id %>'] ? fieldEmp['<%= field.id %>'].nama : ''">
                    <input type="hidden" name="field_<%= field.id %>_id" 
                      :value="fieldEmp['<%= field.id %>'] ? fieldEmp['<%= field.id %>'].id : ''">
                    <input type="hidden" name="field_<%= field.id %>_nip" 
                      :value="fieldEmp['<%= field.id %>'] ? fieldEmp['<%= field.id %>'].nip : ''">
                    <input type="hidden" name="field_<%= field.id %>_unit" 
                      :value="fieldEmp['<%= field.id %>'] ? fieldEmp['<%= field.id %>'].unitNama : ''">

                    <!-- Selected Employee Card: Clean name only (no NIP/unit clutter) -->
                    <template x-if="fieldEmp['<%= field.id %>']">
                      <div class="p-3.5 bg-emerald-50/80 rounded-xl border border-emerald-200 shadow-2xs flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5 truncate">
                          <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 font-bold text-xs">
                            <i data-lucide="user-check" class="w-4 h-4"></i>
                          </div>
                          <p class="font-bold text-xs text-slate-900 truncate" x-text="fieldEmp['<%= field.id %>'].nama"></p>
                        </div>
                        <button type="button" @click="clearFieldEmp('<%= field.id %>')" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors shrink-0" title="Ganti Pegawai">
                          <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                      </div>
                    </template>

                    <!-- Not Selected: Search Input -->
                    <template x-if="!fieldEmp['<%= field.id %>']">
                      <div class="relative" @click.away="fieldEmpDropdown['<%= field.id %>'] = false">
                        <div class="relative">
                          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                          <input type="text" 
                            x-model="fieldEmpSearch['<%= field.id %>']" 
                            @focus="fieldEmpDropdown['<%= field.id %>'] = true"
                            :placeholder="selectedUnit ? 'Pilih nama guru ' + selectedUnit + '...' : '<%= field.placeholder || 'Pilih nama atau ketik untuk mencari...' %>'"
                            class="w-full h-11 pl-9 pr-4 text-xs font-semibold text-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500 shadow-2xs">
                        </div>

                        <!-- Dropdown Search Results: Clean name only -->
                        <div x-show="fieldEmpDropdown['<%= field.id %>']"
                          class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-1.5 max-h-56 overflow-y-auto custom-scrollbar"
                          style="display: none;">
                          <template x-for="emp in getFieldFilteredEmployees('<%= field.id %>')" :key="emp.id">
                            <button type="button" @click="selectFieldEmp('<%= field.id %>', emp)"
                              class="w-full text-left p-2.5 rounded-xl hover:bg-emerald-50 transition-colors cursor-pointer flex items-center justify-between gap-2">
                              <p class="text-xs font-bold text-slate-800" x-text="emp.nama"></p>
                              <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-300"></i>
                            </button>
                          </template>
                          <div x-show="getFieldFilteredEmployees('<%= field.id %>').length === 0" class="p-4 text-center text-xs text-slate-400 italic">
                            Nama tidak ditemukan di unit kerja ini
                          </div>
                        </div>
                      </div>
                    </template>
                  </div>

                <% } %>
              </div>
            <% }) %>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 border-t border-slate-100">
            <button type="submit" :disabled="isSubmitting"
              class="btn-primary w-full py-3.5 px-6 text-sm font-bold gap-2 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 shadow-lg shadow-indigo-600/20 disabled:opacity-50 cursor-pointer">
              <template x-if="!isSubmitting">
                <span class="flex items-center gap-2">
                  <i data-lucide="send" class="w-4 h-4"></i>
                  <span>Kirim Formulir</span>
                </span>
              </template>
              <template x-if="isSubmitting">
                <span class="flex items-center gap-2">
                  <i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>
                  <span>Sedang Mengirimkan Data...</span>
                </span>
              </template>
            </button>
          </div>

        </form>

      </div>
    <% } %>

  </div>
