<%- include('partials/head') %>
<%- include('partials/public-nav') %>
<%- include('partials/toast') %>

<script id="cuti-data-raw" type="application/json">
  <%- JSON.stringify(cutiList || []) %>
</script>

<script>
  function publicCutiApp() {
    let cutiData = [];
    try {
      cutiData = JSON.parse(document.getElementById('cuti-data-raw')?.textContent || '[]');
    } catch (e) {
      cutiData = [];
    }
    return {
      items: cutiData,
      nip: '<%= nipQuery || "" %>',
      
      // PDF Preview Modal
      pdfModal: false,
      pdfUrl: '',
      pdfTitle: '',
      pdfFileName: '',

      // Detail Modal
      detailModal: false,
      selectedCuti: null,

      openDetailById(id) {
        const found = this.items.find(i => String(i.id) === String(id));
        if (found) {
          this.selectedCuti = found;
          this.detailModal = true;
          this.$nextTick(() => {
            if (window.lucide) {
              lucide.createIcons();
            }
          });
        }
      },

      closeDetail() {
        this.detailModal = false;
        this.selectedCuti = null;
      },

      openPdf(url, title, filename) {
        this.pdfUrl = url;
        this.pdfTitle = title || 'Dokumen Surat Cuti Resmi';
        this.pdfFileName = filename || 'Surat_Cuti.pdf';
        this.pdfModal = true;
      },

      closePdf() {
        this.pdfModal = false;
        this.pdfUrl = '';
      }
    };
  }
</script>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-6" x-data="publicCutiApp()">
  
  <!-- Page Header Sederhana & Ringkas -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
        <i data-lucide="calendar-check-2" class="w-6 h-6 text-indigo-600"></i>
        <span>Rekap Cuti Pegawai</span>
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Rekapitulasi berkas dan pengajuan cuti pegawai se-Korwil Cibitung
      </p>
    </div>
    <% if (isAdmin) { %>
      <div class="flex items-center gap-2">
        <a href="/admin/cuti" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold border border-indigo-200 transition-colors">
          <i data-lucide="settings" class="w-3.5 h-3.5"></i>
          <span>Panel Admin Cuti</span>
        </a>
      </div>
    <% } %>
  </div>

  <!-- Form Pencarian NIP Pegawai (Untuk Publik atau saat NIP dimasukkan) -->
  <% if (!isAdmin || employee) { %>
    <div class="bg-white p-3 sm:p-4 rounded-2xl border border-slate-200/80 shadow-xs">
      <form method="GET" action="/cuti" class="flex flex-col sm:flex-row items-center gap-2.5 max-w-2xl">
        <div class="relative flex-1 w-full">
          <i data-lucide="user" class="w-4 h-4 text-indigo-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
          <input type="text" 
                 name="nip" 
                 x-model="nip"
                 value="<%= nipQuery %>" 
                 placeholder="Masukkan 18 Digit NIP Pegawai..." 
                 class="w-full bg-slate-50 text-slate-900 pl-10 pr-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 focus:outline-none focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 shadow-2xs"
                 required>
        </div>

        <button type="submit" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-xs sm:text-sm font-bold rounded-xl shadow-xs transition-colors shrink-0">
          <i data-lucide="search" class="w-4 h-4"></i>
          <span>Cek Riwayat Cuti</span>
        </button>

        <% if (employee || nipQuery) { %>
          <a href="/cuti" 
             class="w-full sm:w-auto inline-flex items-center justify-center gap-1 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold rounded-xl transition-colors shrink-0">
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            <span>Reset</span>
          </a>
        <% } %>
      </form>
    </div>
  <% } %>

  <!-- ======================================================== -->
  <!-- KONDISI 1: NIP TIDAK DITEMUKAN -->
  <!-- ======================================================== -->
  <% if (employeeNotFound) { %>
    <div class="bg-rose-50 border border-rose-200 rounded-2xl p-6 text-center space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center mx-auto">
        <i data-lucide="user-x" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="text-base font-bold text-rose-900">Data Pegawai Tidak Ditemukan</h3>
        <p class="text-xs sm:text-sm text-rose-700 max-w-md mx-auto mt-1">
          NIP <strong class="font-mono text-rose-900"><%= nipQuery %></strong> tidak terdaftar sebagai pegawai aktif di lingkungan Korwil Cibitung. Silakan pastikan digit NIP sudah benar atau hubungi admin sekolah/unit kerja Anda.
        </p>
      </div>
      <div class="pt-2">
        <a href="/cuti" class="inline-flex items-center gap-1.5 px-4 py-2 bg-rose-600 text-white text-xs font-semibold rounded-xl hover:bg-rose-700 transition-colors">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          <span>Reset Pencarian</span>
        </a>
      </div>
    </div>
  <% } %>

  <!-- ======================================================== -->
  <!-- SUMMARY CARDS: KECIL, SEDERHANA & SATU BARIS RAPI -->
  <!-- Ditampilkan jika ada data (pegawai spesifik ATAU admin mode) -->
  <!-- ======================================================== -->
  <% if (employee || (isAdmin && !employeeNotFound)) { %>
    <div class="bg-white p-2.5 rounded-2xl border border-slate-200/80 shadow-xs">
      <div class="flex items-center gap-2 overflow-x-auto py-0.5 custom-scrollbar">
        
        <!-- Total Cuti -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100/90 border border-slate-200 text-slate-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="layers" class="w-3.5 h-3.5 text-slate-600"></i>
          <span class="font-medium text-slate-600 text-[11px]">Total Cuti:</span>
          <span class="font-black text-slate-900 text-xs"><%= stats.total %></span>
        </div>

        <!-- Tahunan -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-blue-50/80 border border-blue-200/80 text-blue-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="sun" class="w-3.5 h-3.5 text-blue-600"></i>
          <span class="font-medium text-blue-700 text-[11px]">Tahunan:</span>
          <span class="font-black text-blue-900 text-xs"><%= stats.tahunan %></span>
        </div>

        <!-- Sakit -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-rose-50/80 border border-rose-200/80 text-rose-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="activity" class="w-3.5 h-3.5 text-rose-600"></i>
          <span class="font-medium text-rose-700 text-[11px]">Sakit:</span>
          <span class="font-black text-rose-900 text-xs"><%= stats.sakit %></span>
        </div>

        <!-- Melahirkan -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-pink-50/80 border border-pink-200/80 text-pink-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="heart" class="w-3.5 h-3.5 text-pink-600"></i>
          <span class="font-medium text-pink-700 text-[11px]">Melahirkan:</span>
          <span class="font-black text-pink-900 text-xs"><%= stats.melahirkan %></span>
        </div>

        <!-- Haji / Lainnya -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-purple-50/80 border border-purple-200/80 text-purple-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="award" class="w-3.5 h-3.5 text-purple-600"></i>
          <span class="font-medium text-purple-700 text-[11px]">Haji/Lainnya:</span>
          <span class="font-black text-purple-900 text-xs"><%= (stats.haji || 0) + (stats.lainnya || 0) %></span>
        </div>

        <!-- Surat Terbit (CT) -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50/80 border border-emerald-200/80 text-emerald-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-600"></i>
          <span class="font-medium text-emerald-700 text-[11px]">Surat Terbit (CT):</span>
          <span class="font-black text-emerald-900 text-xs"><%= stats.suratTerbit %></span>
        </div>

        <!-- Menunggu Surat -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-amber-50/80 border border-amber-200/80 text-amber-800 shrink-0 text-xs shadow-2xs">
          <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-600"></i>
          <span class="font-medium text-amber-700 text-[11px]">Menunggu Surat:</span>
          <span class="font-black text-amber-900 text-xs"><%= stats.suratMenunggu %></span>
        </div>

      </div>
    </div>
  <% } %>

  <!-- ======================================================== -->
  <!-- KONDISI 2: DATA PEGAWAI SPESIFIK DIPILIH -->
  <!-- ======================================================== -->
  <% if (employee) { %>
    
    <!-- Profil Identitas Pegawai -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 text-white flex items-center justify-center text-lg font-extrabold shadow-sm shrink-0">
          <%= employee.nama ? employee.nama.charAt(0).toUpperCase() : 'P' %>
        </div>
        <div class="space-y-0.5">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-base sm:text-lg font-bold text-slate-900"><%= employee.nama %></h2>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
              <i data-lucide="check-circle" class="w-3 h-3 text-emerald-600"></i>
              <span>Pegawai Aktif</span>
            </span>
          </div>
          <div class="flex items-center gap-2 text-xs text-slate-500 flex-wrap">
            <span class="font-mono font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">NIP: <%= employee.nip %></span>
            <span>•</span>
            <span class="font-medium text-slate-700"><%= employee.unit ? employee.unit.namaUnit : '-' %></span>
          </div>
        </div>
      </div>

      <!-- Quick Action / Reset -->
      <div class="flex items-center gap-2 self-start md:self-auto">
        <% if (isAdmin) { %>
          <a href="/cuti" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-xl transition-colors border border-indigo-200">
            <i data-lucide="users" class="w-3.5 h-3.5"></i>
            <span>Semua Pegawai</span>
          </a>
        <% } %>
        <a href="/cuti" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
          <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
          <span>Ganti Pegawai</span>
        </a>
      </div>
    </div>

    <!-- Filter Periode Pegawai (1 Baris Ringkas) -->
    <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-2.5">
      <div class="text-xs text-slate-600 font-semibold flex items-center gap-2">
        <i data-lucide="filter" class="w-4 h-4 text-indigo-600"></i>
        <span>Filter Periode Cuti:</span>
      </div>

      <form method="GET" action="/cuti" class="flex items-center gap-2 flex-wrap">
        <input type="hidden" name="nip" value="<%= nipQuery %>">
        
        <select name="bulan" onchange="this.form.submit()" class="text-xs rounded-xl border-slate-300 py-1.5 px-3 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50 shadow-2xs font-medium text-slate-700">
          <option value="all" <%= filterBulan === 'all' ? 'selected' : '' %>>Semua Bulan</option>
          <% for (let b = 1; b <= 12; b++) { %>
            <option value="<%= b %>" <%= String(filterBulan) === String(b) ? 'selected' : '' %>><%= BULAN_NAMES[b] %></option>
          <% } %>
        </select>

        <select name="tahun" onchange="this.form.submit()" class="text-xs rounded-xl border-slate-300 py-1.5 px-3 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50 shadow-2xs font-medium text-slate-700">
          <option value="all" <%= filterTahun === 'all' ? 'selected' : '' %>>Semua Tahun</option>
          <% availableYears.forEach(y => { %>
            <option value="<%= y %>" <%= String(filterTahun) === String(y) ? 'selected' : '' %>><%= y %></option>
          <% }) %>
        </select>

        <select name="jenisCuti" onchange="this.form.submit()" class="text-xs rounded-xl border-slate-300 py-1.5 px-3 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50 shadow-2xs font-medium text-slate-700">
          <option value="ALL" <%= filterJenisCuti === 'ALL' ? 'selected' : '' %>>Semua Jenis Cuti</option>
          <% JENIS_CUTI_LIST.forEach(jc => { %>
            <option value="<%= jc %>" <%= filterJenisCuti === jc ? 'selected' : '' %>><%= jc %></option>
          <% }) %>
        </select>
      </form>
    </div>

    <!-- Tabel / Daftar Riwayat Cuti Pegawai -->
    <div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 overflow-hidden">
      
      <div class="p-4 border-b border-slate-200/80 flex items-center justify-between bg-slate-50/60">
        <div class="flex items-center gap-2">
          <i data-lucide="calendar-check" class="w-4 h-4 text-indigo-600"></i>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Daftar Pengajuan Cuti</span>
        </div>
        <div class="text-xs text-slate-500">
          Total: <span class="font-bold text-slate-900"><%= cutiList.length %></span> pengajuan
        </div>
      </div>

      <% if (cutiList.length === 0) { %>
        <div class="py-12 px-4 text-center">
          <div class="w-12 h-12 mx-auto mb-2 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center">
            <i data-lucide="calendar-x" class="w-6 h-6"></i>
          </div>
          <h4 class="text-sm font-bold text-slate-800">Tidak Ada Catatan Cuti</h4>
          <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">
            Belum ada riwayat cuti yang tercatat untuk periode yang dipilih.
          </p>
        </div>
      <% } else { %>

        <!-- Desktop Table -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50/80 text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
                <th class="py-3 px-4 w-12 text-center">No</th>
                <th class="py-3 px-4">Tanggal Cuti & Durasi</th>
                <th class="py-3 px-4">Jenis Cuti</th>
                <th class="py-3 px-4">Keterangan / Keperluan</th>
                <th class="py-3 px-4 text-center">Status Surat</th>
                <th class="py-3 px-4 text-center">Aksi & Dokumen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% cutiList.forEach((item, index) => { %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="py-3.5 px-4 text-center font-medium text-slate-400"><%= index + 1 %></td>

                  <!-- Tanggal Cuti Rapi & Durasi -->
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-slate-900 text-xs"><%= item.tanggalRapi %></span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80 text-[10px]">
                        <%= item.jumlahHari %> Hari
                      </span>
                    </div>
                  </td>

                  <!-- Jenis Cuti -->
                  <td class="py-3.5 px-4">
                    <% 
                      let bColor = 'bg-slate-100 text-slate-700 border-slate-200';
                      const jl = (item.jenisCuti || '').toLowerCase();
                      if (jl.includes('tahunan')) bColor = 'bg-blue-50 text-blue-700 border-blue-200';
                      else if (jl.includes('sakit')) bColor = 'bg-rose-50 text-rose-700 border-rose-200';
                      else if (jl.includes('melahirkan')) bColor = 'bg-pink-50 text-pink-700 border-pink-200';
                      else if (jl.includes('haji')) bColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                      else if (jl.includes('penting')) bColor = 'bg-amber-50 text-amber-700 border-amber-200';
                      else if (jl.includes('besar')) bColor = 'bg-purple-50 text-purple-700 border-purple-200';
                    %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold border <%= bColor %>">
                      <%= item.jenisCuti %>
                    </span>
                  </td>

                  <!-- Alasan -->
                  <td class="py-3.5 px-4 max-w-sm">
                    <div class="text-slate-700 truncate max-w-xs" title="<%= item.alasan %>"><%= item.alasan || '-' %></div>
                    <% if (item.catatanAdmin && item.catatanAdmin !== '-') { %>
                      <div class="text-[10px] text-indigo-600 mt-0.5">Catatan: <%= item.catatanAdmin %></div>
                    <% } %>
                  </td>

                  <!-- Status Surat -->
                  <td class="py-3.5 px-4 text-center">
                    <% if (item.fileSuratUrl || item.statusSurat === 'TERBIT') { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span>Surat Terbit</span>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200">
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-500"></i>
                        <span>Menunggu</span>
                      </span>
                    <% } %>
                  </td>

                  <!-- Aksi & Dokumen -->
                  <td class="py-3.5 px-4 text-center">
                    <div class="inline-flex items-center gap-1.5 justify-center">
                      <!-- Tombol Detail Pengajuan Cuti -->
                      <button type="button" 
                              @click="openDetailById('<%= item.id %>')" 
                              class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors"
                              title="Lihat Detail Lengkap Pengajuan">
                        <i data-lucide="info" class="w-3.5 h-3.5 text-slate-600"></i>
                        <span>Detail</span>
                      </button>

                      <% if (item.fileSuratUrl) { %>
                        <button type="button" 
                                @click="openPdf('<%= item.fileSuratUrl %>', 'Surat Cuti <%= item.jenisCuti %> - <%= (item.employeeName || "").replace(/'/g, "\\'") %>', '<%= (item.fileSuratName || "Surat_Cuti.pdf").replace(/'/g, "\\'") %>')" 
                                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition-colors"
                                title="Lihat Berkas Surat">
                          <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                          <span>Lihat</span>
                        </button>

                        <a href="<%= item.fileSuratUrl %>" 
                           download="<%= item.fileSuratName || 'Surat_Cuti.pdf' %>" 
                           class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors"
                           title="Unduh Salinan Surat">
                          <i data-lucide="download" class="w-3.5 h-3.5"></i>
                          <span>Unduh</span>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Mobile Cards -->
        <div class="block md:hidden divide-y divide-slate-100">
          <% cutiList.forEach((item, index) => { %>
            <div class="p-4 space-y-2.5">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-900"><%= item.tanggalRapi %></span>
                  <span class="font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-md text-[10px]">
                    <%= item.jumlahHari %> Hari
                  </span>
                </div>

                <% 
                  let mCol = 'bg-slate-100 text-slate-700 border-slate-200';
                  const jlm = (item.jenisCuti || '').toLowerCase();
                  if (jlm.includes('tahunan')) mCol = 'bg-blue-50 text-blue-700 border-blue-200';
                  else if (jlm.includes('sakit')) mCol = 'bg-rose-50 text-rose-700 border-rose-200';
                  else if (jlm.includes('melahirkan')) mCol = 'bg-pink-50 text-pink-700 border-pink-200';
                  else if (jlm.includes('haji')) mCol = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                  else if (jlm.includes('penting')) mCol = 'bg-amber-50 text-amber-700 border-amber-200';
                  else if (jlm.includes('besar')) mCol = 'bg-purple-50 text-purple-700 border-purple-200';
                %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= mCol %>">
                  <%= item.jenisCuti %>
                </span>
              </div>

              <% if (item.alasan) { %>
                <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                  <span class="font-medium text-slate-700">Keperluan:</span> <%= item.alasan %>
                </p>
              <% } %>

              <!-- Mobile Actions -->
              <div class="pt-1 flex items-center gap-2 flex-wrap">
                <button type="button" 
                        @click="openDetailById('<%= item.id %>')" 
                        class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200">
                  <i data-lucide="info" class="w-3.5 h-3.5"></i>
                  <span>Detail Cuti</span>
                </button>

                <% if (item.fileSuratUrl) { %>
                  <button type="button" 
                          @click="openPdf('<%= item.fileSuratUrl %>', 'Surat Cuti - <%= (item.employeeName || "").replace(/'/g, "\\'") %>', '<%= (item.fileSuratName || "Surat_Cuti.pdf").replace(/'/g, "\\'") %>')" 
                          class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-xl bg-indigo-50 text-indigo-700 text-xs font-bold border border-indigo-200">
                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                    <span>Lihat</span>
                  </button>
                  <a href="<%= item.fileSuratUrl %>" 
                     download="<%= item.fileSuratName || 'Surat_Cuti.pdf' %>" 
                     class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold shadow-xs">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    <span>Unduh</span>
                  </a>
                <% } else { %>
                  <div class="flex items-center gap-1.5 py-2 px-3 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 text-xs font-medium">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-500"></i>
                    <span>Menunggu Surat</span>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

      <% } %>

    </div>

  <% } %>

  <!-- ======================================================== -->
  <!-- KONDISI 3: ADMIN MODE (MENAMPILKAN SEMUA PENGAJUAN CUTI) -->
  <!-- Seperti mekanisme tampilan Rekap Absensi -->
  <!-- ======================================================== -->
  <% if (isAdmin && !employee) { %>

    <!-- Filter Bar Admin (1 Baris Ringkas) -->
    <div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 p-3">
      <form method="GET" action="/cuti" class="flex flex-wrap lg:flex-nowrap items-center gap-2.5 w-full">
        
        <!-- Unit Kerja -->
        <div class="w-full sm:w-auto sm:flex-1 lg:max-w-xs min-w-[150px]">
          <select name="unit" onchange="this.form.submit()" class="w-full text-xs rounded-xl border-slate-300 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50/70 py-2 px-3 font-medium text-slate-700 shadow-2xs">
            <% units.forEach(u => { %>
              <option value="<%= u.id %>" <%= filterUnit === u.id ? 'selected' : '' %>><%= u.namaUnit %></option>
            <% }) %>
          </select>
        </div>

        <!-- Bulan -->
        <div class="w-full sm:w-auto min-w-[120px]">
          <select name="bulan" onchange="this.form.submit()" class="w-full text-xs rounded-xl border-slate-300 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50/70 py-2 px-3 font-medium text-slate-700 shadow-2xs">
            <option value="all" <%= filterBulan === 'all' ? 'selected' : '' %>>Semua Bulan</option>
            <% for (let b = 1; b <= 12; b++) { %>
              <option value="<%= b %>" <%= String(filterBulan) === String(b) ? 'selected' : '' %>><%= BULAN_NAMES[b] %></option>
            <% } %>
          </select>
        </div>

        <!-- Tahun -->
        <div class="w-full sm:w-auto min-w-[100px]">
          <select name="tahun" onchange="this.form.submit()" class="w-full text-xs rounded-xl border-slate-300 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50/70 py-2 px-3 font-medium text-slate-700 shadow-2xs">
            <option value="all" <%= filterTahun === 'all' ? 'selected' : '' %>>Semua Tahun</option>
            <% availableYears.forEach(y => { %>
              <option value="<%= y %>" <%= String(filterTahun) === String(y) ? 'selected' : '' %>><%= y %></option>
            <% }) %>
          </select>
        </div>

        <!-- Jenis Cuti -->
        <div class="w-full sm:w-auto min-w-[130px]">
          <select name="jenisCuti" onchange="this.form.submit()" class="w-full text-xs rounded-xl border-slate-300 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50/70 py-2 px-3 font-medium text-slate-700 shadow-2xs">
            <option value="ALL" <%= filterJenisCuti === 'ALL' ? 'selected' : '' %>>Semua Jenis Cuti</option>
            <% JENIS_CUTI_LIST.forEach(jc => { %>
              <option value="<%= jc %>" <%= filterJenisCuti === jc ? 'selected' : '' %>><%= jc %></option>
            <% }) %>
          </select>
        </div>

        <!-- Cari Nama / NIP -->
        <div class="w-full sm:flex-1 min-w-[140px] relative">
          <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input type="text" 
                 name="search" 
                 value="<%= search %>" 
                 placeholder="Cari Nama / NIP..." 
                 class="w-full text-xs rounded-xl border-slate-300 focus:border-indigo-500 focus:ring-indigo-500 bg-slate-50/70 py-2 pl-9 pr-3 font-medium placeholder-slate-400 shadow-2xs">
        </div>

        <!-- Tombol Aksi (Filter & Reset) -->
        <div class="flex items-center gap-1.5 shrink-0 w-full sm:w-auto justify-end">
          <button type="submit" class="px-3.5 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 rounded-xl shadow-xs transition-colors inline-flex items-center gap-1.5 shrink-0">
            <i data-lucide="filter" class="w-3.5 h-3.5"></i>
            <span>Filter</span>
          </button>
          <% if (filterUnit !== 'unit-all' || filterBulan !== 'all' || filterTahun !== String(new Date().getFullYear()) || filterJenisCuti !== 'ALL' || search) { %>
            <a href="/cuti" class="p-2 text-xs font-semibold text-slate-500 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors inline-flex items-center justify-center shrink-0" title="Reset Filter">
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
            </a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Tabel Seluruh Pengajuan Cuti Pegawai (Mode Admin) -->
    <div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 overflow-hidden">
      
      <div class="p-4 border-b border-slate-200/80 flex items-center justify-between bg-slate-50/60">
        <div class="flex items-center gap-2">
          <i data-lucide="layers" class="w-4 h-4 text-indigo-600"></i>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Rekapitulasi Seluruh Pengajuan Cuti</span>
        </div>
        <div class="text-xs text-slate-500">
          Ditemukan: <span class="font-bold text-slate-900"><%= cutiList.length %></span> pengajuan
        </div>
      </div>

      <% if (cutiList.length === 0) { %>
        <div class="py-14 px-4 text-center">
          <div class="w-12 h-12 mx-auto mb-2 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center">
            <i data-lucide="inbox" class="w-6 h-6"></i>
          </div>
          <h4 class="text-sm font-bold text-slate-800">Tidak Ada Pengajuan Cuti Ditemukan</h4>
          <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">
            Tidak ada riwayat cuti yang cocok dengan kriteria filter yang Anda pilih.
          </p>
        </div>
      <% } else { %>

        <!-- Desktop Table: Ada Kolom Pegawai & Unit Kerja -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50/80 text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
                <th class="py-3 px-4 w-12 text-center">No</th>
                <th class="py-3 px-4">Pegawai & Unit Kerja</th>
                <th class="py-3 px-4">Tanggal Cuti & Durasi</th>
                <th class="py-3 px-4">Jenis Cuti</th>
                <th class="py-3 px-4">Keterangan / Keperluan</th>
                <th class="py-3 px-4 text-center">Status Surat</th>
                <th class="py-3 px-4 text-center">Aksi & Dokumen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% cutiList.forEach((item, index) => { %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="py-3.5 px-4 text-center font-medium text-slate-400"><%= index + 1 %></td>

                  <!-- Pegawai & Unit Kerja -->
                  <td class="py-3.5 px-4">
                    <div class="space-y-0.5">
                      <div class="font-bold text-slate-900 text-xs hover:text-indigo-600 transition-colors">
                        <a href="/cuti?nip=<%= item.employeeNip %>" title="Lihat riwayat pegawai ini">
                          <%= item.employeeName %>
                        </a>
                      </div>
                      <div class="flex items-center gap-2 text-[11px] text-slate-500">
                        <span class="font-mono text-slate-600"><%= item.employeeNip %></span>
                        <span>•</span>
                        <span class="text-slate-600"><%= item.unitNama %></span>
                      </div>
                    </div>
                  </td>

                  <!-- Tanggal Cuti Rapi & Durasi -->
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-slate-900 text-xs"><%= item.tanggalRapi %></span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80 text-[10px]">
                        <%= item.jumlahHari %> Hari
                      </span>
                    </div>
                  </td>

                  <!-- Jenis Cuti -->
                  <td class="py-3.5 px-4">
                    <% 
                      let bColor = 'bg-slate-100 text-slate-700 border-slate-200';
                      const jl = (item.jenisCuti || '').toLowerCase();
                      if (jl.includes('tahunan')) bColor = 'bg-blue-50 text-blue-700 border-blue-200';
                      else if (jl.includes('sakit')) bColor = 'bg-rose-50 text-rose-700 border-rose-200';
                      else if (jl.includes('melahirkan')) bColor = 'bg-pink-50 text-pink-700 border-pink-200';
                      else if (jl.includes('haji')) bColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                      else if (jl.includes('penting')) bColor = 'bg-amber-50 text-amber-700 border-amber-200';
                      else if (jl.includes('besar')) bColor = 'bg-purple-50 text-purple-700 border-purple-200';
                    %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold border <%= bColor %>">
                      <%= item.jenisCuti %>
                    </span>
                  </td>

                  <!-- Alasan -->
                  <td class="py-3.5 px-4 max-w-xs">
                    <div class="text-slate-700 truncate max-w-xs" title="<%= item.alasan %>"><%= item.alasan || '-' %></div>
                    <% if (item.catatanAdmin && item.catatanAdmin !== '-') { %>
                      <div class="text-[10px] text-indigo-600 mt-0.5">Catatan: <%= item.catatanAdmin %></div>
                    <% } %>
                  </td>

                  <!-- Status Surat -->
                  <td class="py-3.5 px-4 text-center">
                    <% if (item.fileSuratUrl || item.statusSurat === 'TERBIT') { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span>Surat Terbit</span>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200">
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-500"></i>
                        <span>Menunggu</span>
                      </span>
                    <% } %>
                  </td>

                  <!-- Aksi & Dokumen -->
                  <td class="py-3.5 px-4 text-center">
                    <div class="inline-flex items-center gap-1.5 justify-center">
                      <!-- Tombol Detail Pengajuan Cuti -->
                      <button type="button" 
                              @click="openDetailById('<%= item.id %>')" 
                              class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors"
                              title="Lihat Detail Lengkap Pengajuan">
                        <i data-lucide="info" class="w-3.5 h-3.5 text-slate-600"></i>
                        <span>Detail</span>
                      </button>

                      <% if (item.fileSuratUrl) { %>
                        <button type="button" 
                                @click="openPdf('<%= item.fileSuratUrl %>', 'Surat Cuti <%= item.jenisCuti %> - <%= (item.employeeName || "").replace(/'/g, "\\'") %>', '<%= (item.fileSuratName || "Surat_Cuti.pdf").replace(/'/g, "\\'") %>')" 
                                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition-colors"
                                title="Lihat Berkas Surat">
                          <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                          <span>Lihat</span>
                        </button>

                        <a href="<%= item.fileSuratUrl %>" 
                           download="<%= item.fileSuratName || 'Surat_Cuti.pdf' %>" 
                           class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors"
                           title="Unduh Salinan Surat">
                          <i data-lucide="download" class="w-3.5 h-3.5"></i>
                          <span>Unduh</span>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Mobile Cards (Admin View) -->
        <div class="block md:hidden divide-y divide-slate-100">
          <% cutiList.forEach((item, index) => { %>
            <div class="p-4 space-y-2.5">
              
              <!-- Nama Pegawai & Unit -->
              <div class="border-b border-slate-100 pb-2">
                <div class="font-bold text-slate-900 text-sm"><%= item.employeeName %></div>
                <div class="text-[11px] text-slate-500 font-mono"><%= item.employeeNip %> • <%= item.unitNama %></div>
              </div>

              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-slate-900"><%= item.tanggalRapi %></span>
                  <span class="font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-md text-[10px]">
                    <%= item.jumlahHari %> Hari
                  </span>
                </div>

                <% 
                  let mCol = 'bg-slate-100 text-slate-700 border-slate-200';
                  const jlm = (item.jenisCuti || '').toLowerCase();
                  if (jlm.includes('tahunan')) mCol = 'bg-blue-50 text-blue-700 border-blue-200';
                  else if (jlm.includes('sakit')) mCol = 'bg-rose-50 text-rose-700 border-rose-200';
                  else if (jlm.includes('melahirkan')) mCol = 'bg-pink-50 text-pink-700 border-pink-200';
                  else if (jlm.includes('haji')) mCol = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                  else if (jlm.includes('penting')) mCol = 'bg-amber-50 text-amber-700 border-amber-200';
                  else if (jlm.includes('besar')) mCol = 'bg-purple-50 text-purple-700 border-purple-200';
                %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= mCol %>">
                  <%= item.jenisCuti %>
                </span>
              </div>

              <% if (item.alasan) { %>
                <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                  <span class="font-medium text-slate-700">Keperluan:</span> <%= item.alasan %>
                </p>
              <% } %>

              <!-- Mobile Actions -->
              <div class="pt-1 flex items-center gap-2 flex-wrap">
                <button type="button" 
                        @click="openDetailById('<%= item.id %>')" 
                        class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200">
                  <i data-lucide="info" class="w-3.5 h-3.5"></i>
                  <span>Detail Cuti</span>
                </button>

                <% if (item.fileSuratUrl) { %>
                  <button type="button" 
                          @click="openPdf('<%= item.fileSuratUrl %>', 'Surat Cuti - <%= (item.employeeName || "").replace(/'/g, "\\'") %>', '<%= (item.fileSuratName || "Surat_Cuti.pdf").replace(/'/g, "\\'") %>')" 
                          class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-xl bg-indigo-50 text-indigo-700 text-xs font-bold border border-indigo-200">
                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                    <span>Lihat</span>
                  </button>
                  <a href="<%= item.fileSuratUrl %>" 
                     download="<%= item.fileSuratName || 'Surat_Cuti.pdf' %>" 
                     class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold shadow-xs">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    <span>Unduh</span>
                  </a>
                <% } else { %>
                  <div class="flex items-center gap-1.5 py-2 px-3 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 text-xs font-medium">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-500"></i>
                    <span>Menunggu Surat</span>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

      <% } %>

    </div>

  <% } %>

  <!-- ======================================================== -->
  <!-- KONDISI 4: PENGUNJUNG PUBLIK BELUM MEMASUKKAN NIP -->
  <!-- ======================================================== -->
  <% if (!employee && !employeeNotFound && !isAdmin) { %>
    <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-xs text-center space-y-3 max-w-lg mx-auto my-6">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto">
        <i data-lucide="calendar-search" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-slate-900">Periksa Riwayat & Berkas Cuti Pegawai</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1 leading-relaxed">
          Silakan masukkan 18 digit NIP pegawai Anda pada kolom di atas untuk melihat rincian pengajuan cuti dan mengunduh berkas Surat Cuti resmi.
        </p>
      </div>
    </div>
  <% } %>

  <!-- ======================================================== -->
  <!-- MODAL: DETAIL LENGKAP PENGAJUAN CUTI -->
  <!-- ======================================================== -->
  <div x-cloak 
       x-show="detailModal" 
       class="fixed inset-0 z-50 overflow-y-auto"
       aria-labelledby="modal-detail-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div x-show="detailModal" 
           class="fixed inset-0 transition-opacity bg-slate-900/60 backdrop-blur-xs" 
           @click="closeDetail()"></div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div x-show="detailModal"
           class="inline-block w-full max-w-2xl p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-2xl rounded-3xl border border-slate-200/80">
        
        <!-- Header Modal -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shadow-2xs">
              <i data-lucide="calendar-check" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-900" id="modal-detail-title">Detail Pengajuan Cuti</h3>
              <p class="text-[11px] text-slate-400">Rincian lengkap riwayat dan status penerbitan berkas cuti resmi</p>
            </div>
          </div>

          <button @click="closeDetail()" class="text-slate-400 hover:text-slate-600 p-2 rounded-xl hover:bg-slate-100 transition-colors">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>

        <template x-if="selectedCuti">
          <div class="mt-5 space-y-4">
            
            <!-- Status Penerbitan Banner -->
            <div :class="(selectedCuti.fileSuratUrl || selectedCuti.statusSurat === 'TERBIT') ? 'bg-emerald-50/80 border-emerald-200/80 text-emerald-900' : 'bg-amber-50/80 border-amber-200/80 text-amber-900'"
                 class="p-4 rounded-2xl border flex items-center gap-3">
              <div :class="(selectedCuti.fileSuratUrl || selectedCuti.statusSurat === 'TERBIT') ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'"
                   class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0">
                <template x-if="selectedCuti.fileSuratUrl || selectedCuti.statusSurat === 'TERBIT'">
                  <i data-lucide="file-check-2" class="w-5 h-5"></i>
                </template>
                <template x-if="!(selectedCuti.fileSuratUrl || selectedCuti.statusSurat === 'TERBIT')">
                  <i data-lucide="clock" class="w-5 h-5"></i>
                </template>
              </div>
              <div>
                <div class="font-bold text-xs sm:text-sm">
                  <span x-text="(selectedCuti.fileSuratUrl || selectedCuti.statusSurat === 'TERBIT') ? 'Surat Cuti Resmi Telah Diterbitkan (CT)' : 'Menunggu Penerbitan Surat Cuti Resmi'"></span>
                </div>
                <div class="text-[11px] opacity-80 mt-0.5">
                  <span x-text="(selectedCuti.fileSuratUrl || selectedCuti.statusSurat === 'TERBIT') ? 'Salinan berkas PDF resmi sudah dapat dilihat dan diunduh di bawah.' : 'Pengajuan telah tercatat dan saat ini sedang menunggu antrean penerbitan surat cuti resmi oleh bagian kepegawaian.'"></span>
                </div>
              </div>
            </div>

            <!-- Identitas Pegawai -->
            <div class="bg-slate-50/80 rounded-2xl p-4 border border-slate-200/70 space-y-3">
              <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Identitas Pegawai</div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <span class="block text-[11px] text-slate-500">Nama Lengkap</span>
                  <span class="text-xs font-bold text-slate-900" x-text="selectedCuti.employeeName"></span>
                </div>
                <div>
                  <span class="block text-[11px] text-slate-500">NIP</span>
                  <span class="text-xs font-mono font-bold text-slate-800" x-text="selectedCuti.employeeNip"></span>
                </div>
                <div class="sm:col-span-2">
                  <span class="block text-[11px] text-slate-500">Unit Kerja / Sekolah</span>
                  <span class="text-xs font-semibold text-slate-800" x-text="selectedCuti.unitNama"></span>
                </div>
              </div>
            </div>

            <!-- Rincian Waktu Pelaksanaan & Jenis Cuti -->
            <div class="bg-white rounded-2xl p-4 border border-slate-200/70 space-y-3">
              <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Rincian Pengajuan Cuti</div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <span class="block text-[11px] text-slate-500">Jenis Cuti</span>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 mt-1"
                        x-text="selectedCuti.jenisCuti"></span>
                </div>

                <div>
                  <span class="block text-[11px] text-slate-500">Jumlah Durasi</span>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 mt-1">
                    <span x-text="selectedCuti.jumlahHari"></span> Hari Kerja
                  </span>
                </div>

                <div>
                  <span class="block text-[11px] text-slate-500">Rentang Pelaksanaan Cuti</span>
                  <span class="text-xs font-bold text-slate-900 mt-0.5 block" x-text="selectedCuti.tanggalRapi"></span>
                </div>

                <div>
                  <span class="block text-[11px] text-slate-500">Periode Rekapitulasi</span>
                  <span class="text-xs font-semibold text-slate-700 mt-0.5 block">
                    <span x-text="selectedCuti.namaBulan"></span> <span x-text="selectedCuti.tahun"></span>
                  </span>
                </div>

                <div>
                  <span class="block text-[11px] text-slate-500">Tanggal Mulai</span>
                  <span class="text-xs font-mono font-medium text-slate-700 mt-0.5 block" x-text="selectedCuti.tanggalMulai"></span>
                </div>

                <div>
                  <span class="block text-[11px] text-slate-500">Tanggal Selesai</span>
                  <span class="text-xs font-mono font-medium text-slate-700 mt-0.5 block" x-text="selectedCuti.tanggalSelesai"></span>
                </div>
              </div>

              <!-- Alasan / Keterangan -->
              <div class="pt-2 border-t border-slate-100">
                <span class="block text-[11px] text-slate-500 mb-1">Alasan / Keperluan Cuti</span>
                <div class="text-xs text-slate-800 bg-slate-50 p-3 rounded-xl border border-slate-200/70" x-text="selectedCuti.alasan || '-'"></div>
              </div>

              <!-- Catatan Verifikator / Admin -->
              <template x-if="selectedCuti.catatanAdmin && selectedCuti.catatanAdmin !== '-'">
                <div class="pt-2">
                  <span class="block text-[11px] text-slate-500 mb-1">Catatan Verifikator Kepegawaian</span>
                  <div class="text-xs text-indigo-700 bg-indigo-50/60 p-3 rounded-xl border border-indigo-100 font-medium" x-text="selectedCuti.catatanAdmin"></div>
                </div>
              </template>
            </div>

            <!-- Berkas Surat Cuti -->
            <div class="bg-slate-50/80 rounded-2xl p-4 border border-slate-200/70">
              <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Dokumen Surat Cuti Resmi</div>

              <template x-if="selectedCuti.fileSuratUrl">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-slate-200">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                      <i data-lucide="file-text" class="w-4 h-4"></i>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-slate-900" x-text="selectedCuti.fileSuratName || 'Surat_Cuti.pdf'"></div>
                      <div class="text-[10px] text-slate-400">Dokumen PDF Terverifikasi</div>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 shrink-0">
                    <button type="button" 
                            @click="openPdf(selectedCuti.fileSuratUrl, 'Surat Cuti ' + selectedCuti.jenisCuti + ' - ' + selectedCuti.employeeName, selectedCuti.fileSuratName)"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition-colors">
                      <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                      <span>Lihat Dokumen</span>
                    </button>

                    <a :href="selectedCuti.fileSuratUrl" 
                       :download="selectedCuti.fileSuratName || 'Surat_Cuti.pdf'" 
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors">
                      <i data-lucide="download" class="w-3.5 h-3.5"></i>
                      <span>Unduh PDF</span>
                    </a>
                  </div>
                </div>
              </template>

              <template x-if="!selectedCuti.fileSuratUrl">
                <div class="flex items-center gap-2 p-3 bg-amber-50 rounded-xl border border-amber-200 text-amber-800 text-xs">
                  <i data-lucide="info" class="w-4 h-4 text-amber-600 shrink-0"></i>
                  <span>Berkas fisik/digital surat cuti belum diunggah oleh pengelola kepegawaian.</span>
                </div>
              </template>
            </div>

            <!-- Footer Metadata -->
            <div class="flex items-center justify-between text-[11px] text-slate-400 px-1 pt-1">
              <span>Waktu Dicatat: <strong class="text-slate-600" x-text="selectedCuti.createdAt"></strong></span>
              <template x-if="selectedCuti.uploadedBy">
                <span>Oleh: <strong class="text-slate-600" x-text="selectedCuti.uploadedBy"></strong></span>
              </template>
            </div>

          </div>
        </template>

        <!-- Footer Modal -->
        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-end">
          <button type="button" 
                  @click="closeDetail()" 
                  class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors">
            Tutup
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: PREVIEW DOKUMEN SURAT CUTI (PDF VIEWER) -->
  <!-- ======================================================== -->
  <div x-cloak 
       x-show="pdfModal" 
       class="fixed inset-0 z-50 overflow-y-auto"
       aria-labelledby="modal-pdf-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div x-show="pdfModal" 
           class="fixed inset-0 transition-opacity bg-slate-900/60 backdrop-blur-xs" 
           @click="closePdf()"></div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div x-show="pdfModal"
           class="inline-block w-full max-w-4xl p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-2xl rounded-3xl border border-slate-200/80">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shadow-2xs">
              <i data-lucide="file-text" class="w-4 h-4"></i>
            </div>
            <div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900" x-text="pdfTitle"></h3>
              <p class="text-[11px] text-slate-500" x-text="pdfFileName"></p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <a :href="pdfUrl" 
               target="_blank" 
               class="p-2 text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors"
               title="Buka di Tab Baru">
              <i data-lucide="external-link" class="w-4 h-4"></i>
            </a>
            <a :href="pdfUrl" 
               :download="pdfFileName" 
               class="p-2 text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors"
               title="Unduh Berkas">
              <i data-lucide="download" class="w-4 h-4"></i>
            </a>
            <button @click="closePdf()" class="text-slate-400 hover:text-slate-600 p-2 rounded-lg hover:bg-slate-100">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>
        </div>

        <div class="mt-4 bg-slate-100 rounded-2xl overflow-hidden h-[65vh] flex items-center justify-center border border-slate-200">
          <template x-if="pdfUrl.toLowerCase().endsWith('.pdf')">
            <iframe :src="pdfUrl" class="w-full h-full border-0" frameborder="0"></iframe>
          </template>
          <template x-if="!pdfUrl.toLowerCase().endsWith('.pdf')">
            <img :src="pdfUrl" alt="Surat Cuti" class="max-w-full max-h-full object-contain p-2">
          </template>
        </div>

      </div>
    </div>
  </div>

</main>

<%- include('partials/footer') %>