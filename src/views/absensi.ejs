        <div class="max-h-96 overflow-y-auto space-y-3 custom-scrollbar pr-1">
          <% 
            const allClars = typeof clarifications !== 'undefined' ? clarifications : [];
          %>
          <% if (allClars.length === 0) { %>
            <div class="p-8 text-center text-slate-400">
              <p>Belum ada pengajuan klarifikasi.</p>
            </div>
          <% } %>

          <% allClars.forEach(function(c) { %>
            <div class="p-3.5 rounded-2xl border <%= c.statusVerifikasi === 'APPROVED' ? 'bg-emerald-50/50 border-emerald-200' : c.statusVerifikasi === 'REJECTED' ? 'bg-rose-50/50 border-rose-200' : 'bg-amber-50/50 border-amber-200' %> text-xs space-y-2">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-bold text-slate-900"><%= c.employeeName %></p>
                  <p class="text-slate-500 text-[11px]"><%= c.tanggalAbsen %> • Status: <%= c.statusAwal %> &rarr; <b><%= c.statusPengganti %></b></p>
                </div>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold <%= c.statusVerifikasi === 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : c.statusVerifikasi === 'REJECTED' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800' %>">
                  <%= c.statusVerifikasi === 'APPROVED' ? 'Disetujui' : c.statusVerifikasi === 'REJECTED' ? 'Ditolak' : 'Sedang Review' %>
                </span>
              </div>

              <!-- Bukti Dokumen PDF Link -->
              <% if (c.fileUrl) { %>
                <div class="pt-1.5 flex items-center justify-between border-t border-slate-200/60">
                  <span class="text-slate-500 text-[11px] font-medium">Surat Bukti / Tugas:</span>
                  <button type="button" @click="viewPdf('Bukti Surat Tugas - ' + '<%= c.employeeName %>', '<%= c.fileUrl %>', '<%= c.fileName %>')" class="inline-flex items-center gap-1 text-[11px] font-bold text-indigo-600 hover:text-indigo-800 hover:underline">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    <span class="truncate max-w-[200px]"><%= c.fileName || 'Lihat Dokumen PDF' %></span>
                  </button>
                </div>
              <% } %>

              <% if (c.statusVerifikasi === 'REJECTED' && c.catatanAdmin) { %>
                <div class="p-2 rounded-xl bg-white border border-rose-200 text-rose-900">
                  <span class="font-bold text-[10px] block uppercase">Alasan Penolakan Admin:</span>
                  <p class="mt-0.5 text-[11px]"><%= c.catatanAdmin %></p>
                </div>
              <% } %>

              <% if (c.statusVerifikasi === 'APPROVED' && c.catatanAdmin) { %>
                <div class="p-2 rounded-xl bg-white border border-emerald-200 text-emerald-900">
                  <span class="font-bold text-[10px] block uppercase">Catatan Admin:</span>
                  <p class="mt-0.5 text-[11px]"><%= c.catatanAdmin %></p>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>

        <div class="pt-2 flex justify-end">
          <button type="button" @click="statusHistoryModal = false" class="btn-secondary py-2 px-4 text-xs">
            Tutup
          </button>
        </div>

      </div>
    </div>
  </template>

  <!-- ALPINE.JS MODAL 5: PDF PREVIEW VIEWER MODAL -->
  <template x-teleport="body">
    <div x-show="pdfModal" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="pdfModal = false"
           class="bg-white rounded-3xl max-w-3xl w-full p-3 sm:p-4 shadow-2xl border border-slate-100 flex flex-col"
           style="height: 94vh !important; max-height: 94vh !important;">
        
        <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 shrink-0">
          <div class="flex items-center gap-2.5 min-w-0 pr-4">
            <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
              <i data-lucide="file-text" class="w-4 h-4"></i>
            </div>
            <div class="min-w-0">
              <h3 class="font-bold text-sm sm:text-base text-slate-900 truncate" x-text="pdfTitle"></h3>
              <p class="text-[10px] text-slate-400">Dokumen Bukti Surat Keterangan / Surat Tugas</p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a :href="pdfUrl" :download="pdfFileName || 'bukti-absensi.pdf'" class="btn-primary py-1.5 px-3 text-xs gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs" title="Unduh Berkas PDF Langsung">
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span class="hidden sm:inline">Download</span>
            </a>
            <a :href="pdfUrl" target="_blank" class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-slate-700 hover:text-slate-900" title="Buka Dokumen di Tab Baru Penuh">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
              <span class="hidden sm:inline">Tab Baru</span>
            </a>
            <button @click="pdfModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>
        </div>

        <!-- Inline PDF Viewer Container - Guaranteed maximum vertical view (94vh) -->
        <div class="w-full bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 my-2"
             style="flex: 1 1 auto; height: calc(94vh - 120px); min-height: 420px;">
          <iframe :src="pdfUrl ? (pdfUrl.includes('#') ? pdfUrl : pdfUrl + '#toolbar=1&navpanes=0&view=FitH') : ''" 
                  style="width: 100%; height: 100%; min-height: 100%; border: 0; display: block;" 
                  allowfullscreen></iframe>
        </div>

        <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 shrink-0">
          <div class="flex items-center gap-2">
            <a :href="pdfUrl" :download="pdfFileName || 'bukti-absensi.pdf'" class="text-indigo-600 hover:underline font-semibold flex items-center gap-1 sm:hidden">
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span>Download PDF</span>
            </a>
            <span class="hidden sm:inline text-slate-400">Gunakan tombol Tab Baru jika ingin melihat dokumen ukuran penuh.</span>
          </div>
          <button type="button" @click="pdfModal = false" class="btn-secondary py-2 px-4 text-xs font-semibold">
            Tutup
          </button>
        </div>

      </div>
    </div>
  </template>

</main>

<%- include('partials/footer') %>
