            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Pilih Status Baru *</label>
              <select name="status" x-model="directTargetStatus" class="form-select text-xs font-bold py-2">
                <option value="HADIR">Hadir (H)</option>
