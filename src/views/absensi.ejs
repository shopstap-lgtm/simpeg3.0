                  </button>
                  <button type="button" @click="isRentang = true" 
                          :class="isRentang ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:text-slate-900'" 
                          class="px-2.5 py-1 rounded-lg transition-all">
                    Rentang
                  </button>
                </div>
              </div>

              <!-- Tanggal & Status Seharusnya (2 Kolom di Layar sm+) -->
              <template x-if="!isRentang">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="tanggalAbsenSelect" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                      Pilih Tanggal Presensi *
                    </label>
                    <template x-if="!isAdmin">
                      <select name="tanggalAbsen" 
                              id="tanggalAbsenSelect" 
                              x-model="selectedDate" 
                              @change="onDateSelected($event.target.value)" 
                              required 
                              class="form-select text-xs font-semibold py-2">
                        <template x-for="item in eligibleDays" :key="item.dateStr">
                          <option :value="item.dateStr" x-text="item.label"></option>
                        </template>
                      </select>
                    </template>
                    <template x-if="isAdmin">
                      <input type="date" name="tanggalAbsen" id="tanggalAbsenAdmin" x-model="selectedDate" required class="form-input text-xs py-2">
                    </template>
                  </div>

                  <div>
                    <label for="statusPengganti" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                      Status Seharusnya *
                    </label>
                    <template x-if="!isAdmin">
                      <select name="statusPengganti" id="statusPenggantiPublik" x-model="selectedStatus" class="form-select text-xs font-semibold py-2">
                        <option value="HADIR">Hadir Normal / Penuh (H)</option>
                        <option value="DL">Dinas Luar Sesuai (DL)</option>
                        <option value="ST">Sakit (ST)</option>
                        <option value="CT">Cuti (CT)</option>
                      </select>
                    </template>
                    <template x-if="isAdmin">
                      <select name="statusPengganti" id="statusPenggantiAdmin" x-model="selectedStatus" class="form-select text-xs font-semibold py-2">
                        <option value="HADIR">Hadir (H)</option>
                        <option value="DL">Dinas Luar Sesuai (DL)</option>
                        <option value="DL_KUNING">Dinas Luar Belum Sesuai (DL Kuning)</option>
                        <option value="TL">Terlambat (TL)</option>
                        <option value="PC">Pulang Cepat (PC)</option>
                        <option value="ST">Sakit (ST)</option>
                        <option value="CT">Cuti (CT)</option>
                        <option value="TK">Tanpa Keterangan (TK)</option>
                      </select>
                    </template>
                  </div>
                </div>
              </template>

              <!-- If Rentang: Tanggal Mulai & Tanggal Selesai -->
              <template x-if="isRentang">
                <div class="space-y-3">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label for="tanggalMulaiSelect" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Tanggal Mulai *</label>
                      <template x-if="!isAdmin">
                        <select name="tanggalMulai" id="tanggalMulaiSelect" x-model="tanggalMulai" required class="form-select text-xs font-semibold py-2">
                          <template x-for="item in eligibleDays" :key="'start-' + item.dateStr">
                            <option :value="item.dateStr" x-text="item.label"></option>
                          </template>
                        </select>
                      </template>
                      <template x-if="isAdmin">
                        <input type="date" name="tanggalMulai" id="tanggalMulaiAdmin" x-model="tanggalMulai" required class="form-input text-xs py-2">
                      </template>
                    </div>

                    <div>
                      <label for="tanggalSelesaiSelect" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Tanggal Selesai *</label>
                      <template x-if="!isAdmin">
                        <select name="tanggalSelesai" id="tanggalSelesaiSelect" x-model="tanggalSelesai" required class="form-select text-xs font-semibold py-2">
                          <template x-for="item in eligibleDays" :key="'end-' + item.dateStr">
                            <option :value="item.dateStr" x-text="item.label"></option>
                          </template>
                        </select>
                      </template>
                      <template x-if="isAdmin">
                        <input type="date" name="tanggalSelesai" id="tanggalSelesaiAdmin" x-model="tanggalSelesai" required class="form-input text-xs py-2">
                      </template>
                    </div>
                  </div>

                  <div>
                    <label for="statusPenggantiRentang" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                      Status Seharusnya (Seluruh Rentang) *
                    </label>
                    <template x-if="!isAdmin">
                      <select name="statusPengganti" id="statusPenggantiRentang" x-model="selectedStatus" class="form-select text-xs font-semibold py-2">
                        <option value="HADIR">Hadir Normal / Penuh (H)</option>
                        <option value="DL">Dinas Luar Sesuai (DL)</option>
                        <option value="ST">Sakit (ST)</option>
                        <option value="CT">Cuti (CT)</option>
                      </select>
                    </template>
                    <template x-if="isAdmin">
                      <select name="statusPengganti" id="statusPenggantiRentangAdmin" x-model="selectedStatus" class="form-select text-xs font-semibold py-2">
                        <option value="HADIR">Hadir (H)</option>
                        <option value="DL">Dinas Luar Sesuai (DL)</option>
                        <option value="DL_KUNING">Dinas Luar Belum Sesuai (DL Kuning)</option>
                        <option value="TL">Terlambat (TL)</option>
                        <option value="PC">Pulang Cepat (PC)</option>
                        <option value="ST">Sakit (ST)</option>
                        <option value="CT">Cuti (CT)</option>
                        <option value="TK">Tanpa Keterangan (TK)</option>
                      </select>
                    </template>
                  </div>
                </div>
              </template>

              <!-- Alasan Klarifikasi -->
              <div>
                <label for="alasan" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Alasan Klarifikasi *</label>
                <textarea name="alasan" 
                          id="alasan" 
                          rows="2" 
                          required 
                          placeholder="Contoh: Mengikuti dinas luar / Surat tugas nomor 800/123/Disdik..." 
                          class="form-input text-xs py-2"></textarea>
              </div>

              <!-- Upload PDF File Proof (Compact Bar) -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                  Upload Bukti Surat / Keterangan (PDF) *
                </label>
                <div class="border-2 border-dashed border-slate-200 hover:border-indigo-400 rounded-2xl p-2.5 sm:p-3 text-center cursor-pointer transition-colors bg-slate-50 relative flex items-center justify-center gap-3">
                  <input type="file" 
                         name="file" 
                         id="fileProof" 
                         accept=".pdf" 
                         required
                         @change="
                           const f = $event.target.files[0];
                           if (f && f.size > 1024 * 1024) {
                             alert('Ukuran berkas bukti klarifikasi melebihi batas maksimal 1MB!');
                             $event.target.value = '';
                             fileName = '';
                             return;
                           }
                           fileName = f ? f.name : '';
                         "
                         class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                  <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                    <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                  </div>
                  <div class="text-left min-w-0">
                    <p class="text-xs font-semibold text-slate-700 truncate" x-text="fileName ? fileName : 'Pilih Berkas PDF (Maks 1MB)'"></p>
                    <p class="text-[10.5px] text-slate-400">Surat Tugas / Surat Dokter / SK Cuti</p>
                  </div>
                </div>
              </div>

            </div>

            <!-- Modal Actions (Fixed bottom) -->
            <div class="px-5 py-3 sm:px-6 sm:py-3.5 border-t border-slate-100 bg-slate-50/60 flex items-center justify-end gap-2.5 shrink-0">
              <button type="button" @click="klarifikasiModal = false" class="btn-secondary py-2 px-4 text-xs">
                Batal
              </button>
              <button type="submit" class="btn-primary py-2 px-5 text-xs gap-2">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>Kirim Klarifikasi</span>
              </button>
            </div>

          </form>
        </template>

      </div>
    </div>
  </template>

