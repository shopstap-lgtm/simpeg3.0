<%- include('partials/head') %>
<%- include('partials/public-nav') %>
<%- include('partials/toast') %>

<% 
  const isAdmin = typeof user !== 'undefined' && user !== null;
  const isSuperAdminOrDinas = typeof user !== 'undefined' && user !== null && (user.role === 'SUPER_ADMIN' || user.role === 'ADMIN_DINAS');
  const isDefaultPeriod = (bulan === activeDefaultMonth && tahun === activeDefaultYear);
%>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-6" 
      x-data="{
        isAdmin: <%= isAdmin ? 'true' : 'false' %>,
        isSuperAdminOrDinas: <%= isSuperAdminOrDinas ? 'true' : 'false' %>,
        isDefaultPeriod: <%= isDefaultPeriod ? 'true' : 'false' %>,
        klarifikasiConfig: <%= JSON.stringify(typeof klarifikasiConfig !== 'undefined' ? klarifikasiConfig : { nlEnabled: false, nlDates: 'ALL', pcEnabled: false, pcDates: 'ALL' }) %>,

        isStatusEligibleForKlarifikasi(status, dayNumber) {
          if (status === 'TK' || status === 'DL_KUNING') return true;

          // NL (HADIR / NL)
          if (status === 'HADIR' || status === 'NL') {
            if (!this.klarifikasiConfig.nlEnabled) return false;
            if (this.klarifikasiConfig.nlDates === 'ALL') return true;
            const allowed = this.klarifikasiConfig.nlDates.split(',').map(d => parseInt(d.trim())).filter(Boolean);
            return allowed.includes(dayNumber);
          }

          // PC (Pulang Cepat)
          if (status === 'PC') {
            if (!this.klarifikasiConfig.pcEnabled) return false;
            if (this.klarifikasiConfig.pcDates === 'ALL') return true;
            const allowed = this.klarifikasiConfig.pcDates.split(',').map(d => parseInt(d.trim())).filter(Boolean);
            return allowed.includes(dayNumber);
          }

          return false;
        },

        klarifikasiModal: false,
        adminDirectModal: false,
        bulkDateModal: false,
        bulkTargetDay: 1,
        bulkTargetStatus: 'HADIR',
        bulkKeterangan: '',
        statusHistoryModal: false,
        rejectedInfoModal: false,
        rejectedReason: '',
        rejectedEmployeeName: '',
        rejectedDate: '',
        selectedEmployee: null,
        eligibleDays: [],
        isRentang: false,
        selectedDate: '',
        selectedDay: 1,
        tanggalMulai: '',
        tanggalSelesai: '',
        currentStatus: 'TK',
        selectedStatus: 'DL',
        directTargetStatus: 'HADIR',
        directKeterangan: '',
        searchQuery: '<%= search %>',
        unitFilter: '<%= selectedUnit %>',
        fileName: '',
        currentAllDays: [],
        pdfModal: false,
        pdfTitle: '',
        pdfUrl: '',
        pdfFileName: '',

        isModalOpen() {
          return this.klarifikasiModal || this.adminDirectModal || this.bulkDateModal || this.statusHistoryModal || this.rejectedInfoModal || this.pdfModal;
        },

        viewPdf(title, url, fileName) {
          this.pdfTitle = title;
          this.pdfUrl = url;
          this.pdfFileName = fileName || 'bukti-dokumen.pdf';
          this.pdfModal = true;
        },

        openBulkDateModal(day) {
          this.bulkTargetDay = day;
          this.bulkTargetStatus = 'HADIR';
          this.bulkKeterangan = '';
          this.bulkDateModal = true;
        },

        handleCellClick(emp, dayObj, allDays) {
          this.selectedEmployee = emp;
          this.selectedDay = dayObj.tanggal;
          this.selectedDate = '<%= tahun %>-<%= String(bulan).padStart(2, '0') %>-' + String(dayObj.tanggal).padStart(2, '0');
          this.currentStatus = dayObj.status;
          this.currentAllDays = allDays;

          if (this.isAdmin) {
            // ADMIN: Tampilkan modal aksi (bisa Ubah Langsung atau Form Klarifikasi)
            this.directTargetStatus = dayObj.status !== 'EMPTY' ? dayObj.status : 'HADIR';
            this.directKeterangan = dayObj.keterangan || '';
            this.adminDirectModal = true;
          } else {
            // PUBLIK:
            if (!this.isDefaultPeriod) {
              alert('Pengajuan klarifikasi hanya dibuka untuk periode aktif (Bulan <%= activeDefaultMonth %> Tahun <%= activeDefaultYear %>). Periode lainnya hanya untuk dilihat.');
              return;
            }

            if (dayObj.clarificationStatus === 'REJECTED') {
              this.showRejectedDetail(emp.nama, '<%= tahun %>-<%= String(bulan).padStart(2, '0') %>-' + String(dayObj.tanggal).padStart(2, '0'), dayObj.clarificationNote || 'Bukti dokumen tidak memenuhi syarat / belum ditandatangani Kepala Sekolah.');
              return;
            }

            if (dayObj.clarificationStatus === 'PENDING') {
              alert('Presensi pada tanggal ' + dayObj.tanggal + ' sedang dalam proses review verifikasi oleh Admin Korwil (Status: Menunggu).');
              return;
            }

            if (this.isStatusEligibleForKlarifikasi(dayObj.status, dayObj.tanggal)) {
              const formattedDate = '<%= tahun %>-<%= String(bulan).padStart(2, '0') %>-' + String(dayObj.tanggal).padStart(2, '0');
              this.openKlarifikasiWithDays(emp, allDays, formattedDate, dayObj.status, false);
            } else if (dayObj.status === 'EMPTY') {
              alert('Belum ada data presensi untuk tanggal ' + dayObj.tanggal + '.');
            } else {
              let msg = 'Hanya presensi berstatus Tanpa Keterangan (TK) dan DL Belum Sesuai (DL Kuning)';
              if (this.klarifikasiConfig.nlEnabled) msg += ', serta Hadir Normal (NL) pada tanggal yang dibuka';
              if (this.klarifikasiConfig.pcEnabled) msg += ', serta Pulang Cepat (PC) pada tanggal yang dibuka';
              alert(msg + ' yang dapat diajukan klarifikasi.');
            }
          }
        },

        showRejectedDetail(empName, dateStr, note) {
          this.rejectedEmployeeName = empName;
          this.rejectedDate = dateStr;
          this.rejectedReason = note;
          this.rejectedInfoModal = true;
        },

        openKlarifikasiWithDays(emp, daysList, defaultDate = '', status = 'TK', isRange = false) {
          if (!this.isAdmin && !this.isDefaultPeriod) {
            alert('Pengajuan klarifikasi hanya dibuka untuk periode aktif (Bulan <%= activeDefaultMonth %> Tahun <%= activeDefaultYear %>).');
            return;
          }

          this.selectedEmployee = emp;
          this.isRentang = isRange;
          
          // Filter hari yang memenuhi syarat klarifikasi sesuai kebijakan admin (TK, DL Kuning, NL, PC)
          this.eligibleDays = daysList.filter(d => this.isStatusEligibleForKlarifikasi(d.status, d.tanggal)).map(d => {
            const padDay = String(d.tanggal).padStart(2, '0');
            const dateVal = '<%= tahun %>-<%= String(bulan).padStart(2, '0') %>-' + padDay;
            let labelStatus = d.status;
            if (d.status === 'TK') labelStatus = 'Tanpa Keterangan (TK)';
            else if (d.status === 'DL_KUNING') labelStatus = 'DL Belum Sesuai (DL Kuning)';
            else if (d.status === 'HADIR' || d.status === 'NL') labelStatus = 'Hadir Normal (NL)';
            else if (d.status === 'PC') labelStatus = 'Pulang Cepat (PC)';

            return {
              tanggal: d.tanggal,
              dateStr: dateVal,
              status: d.status,
              label: 'Tgl ' + d.tanggal + ' ' + '<%= bulan === 7 ? 'Juli' : 'Bulan ' + bulan %>' + ' (' + labelStatus + ')'
            };
          });

          if (!this.isAdmin && this.eligibleDays.length === 0) {
            let msg = 'Pegawai ' + emp.nama + ' tidak memiliki presensi berstatus TK atau DL Kuning';
            if (this.klarifikasiConfig.nlEnabled) msg += ' / NL';
            if (this.klarifikasiConfig.pcEnabled) msg += ' / PC';
            msg += ' pada tanggal yang dibuka untuk klarifikasi.';
            alert(msg);
            return;
          }

          const firstEligible = this.eligibleDays.length > 0 ? this.eligibleDays[0] : null;
          const initialDate = defaultDate || (firstEligible ? firstEligible.dateStr : '<%= tahun %>-<%= String(bulan).padStart(2, '0') %>-01');
          
          this.selectedDate = initialDate;
          this.tanggalMulai = initialDate;
          this.tanggalSelesai = initialDate;

          const matchedDay = this.eligibleDays.find(d => d.dateStr === initialDate);
          this.currentStatus = matchedDay ? matchedDay.status : status;
          this.selectedStatus = 'DL';
          this.fileName = '';
          this.klarifikasiModal = true;
        },

        onDateSelected(dateStr) {
          const matched = this.eligibleDays.find(d => d.dateStr === dateStr);
          if (matched) {
            this.currentStatus = matched.status;
          }
        }
      }">

  <!-- Page Header & Title -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider border border-indigo-100">Presensi Harian</span>
        <span class="text-xs text-slate-400">Periode Bulan <%= bulan %> / <%= tahun %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Rekap Absensi Pegawai</h1>
      <p class="text-xs sm:text-sm text-slate-500">
        <% if (isAdmin) { %>
          <span class="text-indigo-700 font-bold bg-indigo-50 px-2 py-0.5 rounded">Mode Admin:</span> Klik sel mana saja untuk langsung memperbarui presensi.
        <% } else if (isDefaultPeriod) { %>
          Pantau presensi harian 1–31. Klik kotak berstatus <span class="text-rose-600 font-bold">TK</span> atau <span class="text-amber-700 font-bold">DL Kuning</span> untuk mengajukan klarifikasi.
        <% } else { %>
          <span class="text-amber-800 font-bold bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Mode Arsip:</span> Periode ini hanya untuk dilihat. Pengajuan klarifikasi dibuka pada periode aktif (Bulan <%= activeDefaultMonth %> Tahun <%= activeDefaultYear %>).
        <% } %>
      </p>
    </div>

    <!-- Quick Notification Button -->
    <div class="flex items-center gap-2">
      <button @click="statusHistoryModal = true" class="btn-secondary py-2 px-3.5 text-xs gap-1.5 shadow-2xs">
        <i data-lucide="bell" class="w-3.5 h-3.5 text-indigo-600"></i>
        <span>Status Klarifikasi</span>
      </button>
    </div>
  </div>

  <!-- Non-Default Period Warning Banner for Public -->
  <% if (!isAdmin && !isDefaultPeriod) { %>
    <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-3 shadow-xs">
      <div class="p-1 rounded-lg bg-amber-200 text-amber-800 shrink-0 mt-0.5">
        <i data-lucide="info" class="w-4 h-4"></i>
      </div>
      <div>
        <span class="font-bold block">Periode Klarifikasi Terkunci:</span>
        <p class="text-amber-800 mt-0.5">
          Anda sedang melihat data presensi bulan <b><%= bulan %> / <%= tahun %></b>. Klarifikasi presensi publik hanya dapat diajukan pada periode default yang aktif, yaitu <b>Bulan <%= activeDefaultMonth %> Tahun <%= activeDefaultYear %></b>.
        </p>
      </div>
    </div>
  <% } %>



  <!-- Filter & Search Toolbar with Modern Rounded Searchable Dropdowns -->
  <div class="custom-card p-4 sm:p-5 bg-white shadow-xs">
    <form action="/absensi" method="GET" id="absensiFilterForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- 1. Unit Kerja Filter (Custom Searchable Dropdown) -->
      <div class="relative" 
           x-data="{
             open: false,
             search: '',
             selectedVal: '<%= selectedUnit %>',
             options: <%= JSON.stringify(units.map(u => ({ value: u.id, label: u.namaUnit }))) %>,
             get filteredOptions() {
               if (!this.search) return this.options;
               return this.options.filter(o => o.label.toLowerCase().includes(this.search.toLowerCase()));
             },
             get selectedLabel() {
               const found = this.options.find(o => o.value === this.selectedVal);
               return found ? found.label : 'Pilih Unit Kerja...';
             },
             selectOption(val) {
               this.selectedVal = val;
               this.open = false;
               $refs.unitInput.value = val;
               $nextTick(() => { $refs.unitInput.closest('form').submit(); });
             }
           }"
           @click.away="open = false">
        
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Unit Kerja</label>
        <input type="hidden" name="unit" x-ref="unitInput" :value="selectedVal">
        
        <button type="button" 
                @click="open = !open" 
                class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
          <span class="truncate pr-2" x-text="selectedLabel"></span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
        </button>

        <!-- Searchable Dropdown Menu (Max 7 Rows with scroll) -->
        <div x-show="open" 
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 translate-y-1 scale-98"
             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
             x-transition:leave-end="opacity-0 translate-y-1 scale-98"
             class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-1.5 min-w-[240px]"
             style="display: none;"
             @click.stop>
          
          <!-- Search input inside dropdown (Clean without icon, with X on far right) -->
          <div class="relative" style="position: relative;">
            <input type="text" 
                   x-model="search" 
                   placeholder="Ketik nama unit / sekolah..." 
                   class="w-full pl-3 pr-8 py-1.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50 text-slate-800 placeholder:text-slate-400"
                   @click.stop
                   @keydown.stop>
            <button type="button" 
                    x-show="search && search.length > 0" 
                    @click="search = ''" 
                    style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%);"
                    class="text-slate-400 hover:text-slate-600 p-1 flex items-center justify-center z-20">
              <i data-lucide="x" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <!-- Options List (Max 7 items with scrollbar) -->
          <div class="max-h-[230px] overflow-y-auto custom-scrollbar space-y-0.5 pt-1">
            <template x-for="item in filteredOptions" :key="item.value">
              <button type="button" 
                      @click="selectOption(item.value)" 
                      class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                      :class="selectedVal === item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                <span class="truncate" x-text="item.label"></span>
                <i data-lucide="check" x-show="selectedVal === item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
              </button>
            </template>
            <div x-show="filteredOptions.length === 0" class="py-3 text-center text-xs text-slate-400">
              Tidak ada unit yang cocok
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Bulan Filter (Custom Searchable Dropdown) -->
      <div class="relative" 
           x-data="{
             open: false,
             search: '',
             selectedVal: <%= bulan %>,
             options: [
               { value: 1, label: 'Januari' },
               { value: 2, label: 'Februari' },
               { value: 3, label: 'Maret' },
               { value: 4, label: 'April' },
               { value: 5, label: 'Mei' },
               { value: 6, label: 'Juni' },
               { value: 7, label: 'Juli' },
               { value: 8, label: 'Agustus' },
               { value: 9, label: 'September' },
               { value: 10, label: 'Oktober' },
               { value: 11, label: 'November' },
               { value: 12, label: 'Desember' }
             ],
             get filteredOptions() {
               if (!this.search || !this.search.trim()) return this.options;
               const term = this.search.trim().toLowerCase();
               return this.options.filter(o => o.label.toLowerCase().includes(term));
             },
             get selectedLabel() {
               const found = this.options.find(o => o.value == this.selectedVal);
               return found ? found.label : 'Pilih Bulan...';
             },
             selectOption(val) {
               this.selectedVal = val;
               this.open = false;
               $refs.bulanInput.value = val;
               $nextTick(() => { $refs.bulanInput.closest('form').submit(); });
             }
           }"
           @click.away="open = false">
        
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Bulan</label>
        <input type="hidden" name="bulan" x-ref="bulanInput" :value="selectedVal">
        
        <button type="button" 
                @click="open = !open" 
                class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
          <span class="truncate pr-2" x-text="selectedLabel"></span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
        </button>

        <!-- Dropdown Popover (Max 7 items with scroll) -->
        <div x-show="open" 
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 translate-y-1 scale-98"
             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
             x-transition:leave-end="opacity-0 translate-y-1 scale-98"
             class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-1.5 min-w-[200px]"
             style="display: none;"
             @click.stop>
          
          <!-- Search input inside month dropdown (Clean without icon, with X on far right) -->
          <div class="relative" style="position: relative;">
            <input type="text" 
                   x-model="search" 
                   placeholder="Ketik nama bulan..." 
                   class="w-full pl-3 pr-8 py-1.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50 text-slate-800 placeholder:text-slate-400"
                   @click.stop
                   @keydown.stop>
            <button type="button" 
                    x-show="search && search.length > 0" 
                    @click="search = ''" 
                    style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%);"
                    class="text-slate-400 hover:text-slate-600 p-1 flex items-center justify-center z-20">
              <i data-lucide="x" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <div class="max-h-[230px] overflow-y-auto custom-scrollbar space-y-0.5 pt-1">
            <template x-for="item in filteredOptions" :key="item.value">
              <button type="button" 
                      @click="selectOption(item.value)" 
                      class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                      :class="selectedVal == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                <span class="truncate" x-text="item.label"></span>
                <i data-lucide="check" x-show="selectedVal == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
              </button>
            </template>
            <div x-show="filteredOptions.length === 0" class="py-3 text-center text-xs text-slate-400">
              Tidak ada bulan yang cocok
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Tahun Filter (Custom Dropdown) -->
      <div class="relative" 
           x-data="{
             open: false,
             selectedVal: <%= tahun %>,
             options: [
               { value: 2026, label: '2026' },
               { value: 2025, label: '2025' }
             ],
             get selectedLabel() {
               const found = this.options.find(o => o.value == this.selectedVal);
               return found ? found.label : '2026';
             },
             selectOption(val) {
               this.selectedVal = val;
               this.open = false;
               $refs.tahunInput.value = val;
               $nextTick(() => { $refs.tahunInput.closest('form').submit(); });
             }
           }"
           @click.away="open = false">
        
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Tahun</label>
        <input type="hidden" name="tahun" x-ref="tahunInput" :value="selectedVal">
        
        <button type="button" 
                @click="open = !open" 
                class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
          <span class="truncate pr-2" x-text="selectedLabel"></span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
        </button>

        <div x-show="open" 
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 translate-y-1 scale-98"
             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
             x-transition:leave-end="opacity-0 translate-y-1 scale-98"
             class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-1 min-w-[150px]"
             style="display: none;">
          <template x-for="item in options" :key="item.value">
            <button type="button" 
                    @click="selectOption(item.value)" 
                    class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                    :class="selectedVal == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
              <span x-text="item.label"></span>
              <i data-lucide="check" x-show="selectedVal == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
            </button>
          </template>
        </div>
      </div>

      <!-- 4. Manual Search Input (Real-time auto search + Fixed Right 'X' Button) -->
      <div>
        <label for="search" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Cari Pegawai</label>
        <div class="relative" 
             style="position: relative;"
             x-data="{ 
               q: '<%= search ? search.replace(/'/g, "\\'") : '' %>',
               timer: null,
               searchRealtime() {
                 sessionStorage.setItem('search_input_active_absensi', '1');
                 clearTimeout(this.timer);
                 this.timer = setTimeout(() => {
                   this.$el.closest('form').submit();
                 }, 700);
               }
             }"
             x-init="
               if (sessionStorage.getItem('search_input_active_absensi') === '1' || (q && q.length > 0)) {
                 sessionStorage.removeItem('search_input_active_absensi');
                 $nextTick(() => {
                   const input = $refs.searchInput;
                   if (input) {
                     input.focus();
                     const len = input.value.length;
                     input.setSelectionRange(len, len);
                   }
                 });
               }
             ">
          <input type="text" 
                 name="search" 
                 id="search" 
                 x-ref="searchInput"
                 x-model="q"
                 @input="searchRealtime()"
                 @keydown.enter.prevent="sessionStorage.setItem('search_input_active_absensi', '1'); $el.closest('form').submit()"
                 autocomplete="off"
                 placeholder="Ketik Nama Pegawai..." 
                 style="padding-left: 18px;"
                 class="w-full pl-5 pr-10 py-2.5 text-xs font-medium text-slate-800 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 placeholder:text-slate-400 shadow-2xs transition-all">
          
          <!-- Clear Button 'X' (Pinned to far right with inline style) -->
          <button type="button" 
                  x-show="q && q.length > 0" 
                  @click="q = ''; sessionStorage.removeItem('search_input_active_absensi'); $nextTick(() => { $el.closest('form').submit(); })" 
                  style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%);"
                  class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors z-20 flex items-center justify-center"
                  title="Hapus pencarian">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>

    </form>

    <%# Status Legend (dinonaktifkan / disembunyikan)
    <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-3 sm:gap-4 text-[11px] text-slate-600">
      <span class="font-bold text-slate-700">Keterangan:</span>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-emerald-500 shadow-2xs"></span>
        <span>Hadir (Hijau Polos)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-rose-600 ring-1 ring-rose-300 flex items-center justify-center text-[8px] text-white font-bold">TK</span>
        <span class="font-bold text-rose-700">Tanpa Keterangan (TK) *</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-blue-600 flex items-center justify-center text-[8px] text-white font-bold">DL</span>
        <span>DL Sesuai (Biru)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-amber-400 ring-1 ring-amber-300 flex items-center justify-center text-[8px] text-amber-950 font-bold">DL</span>
        <span class="font-bold text-amber-800">DL Belum Sesuai (Kuning) *</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-orange-500 flex items-center justify-center text-[8px] text-white font-bold">TL</span>
        <span>Terlambat (TL)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-orange-500 flex items-center justify-center text-[8px] text-white font-bold">PC</span>
        <span>Pulang Cepat (PC)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-purple-600 flex items-center justify-center text-[8px] text-white font-bold">ST</span>
        <span>Sakit (ST)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded bg-purple-600 flex items-center justify-center text-[8px] text-white font-bold">CT</span>
        <span>Cuti (CT)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded bg-amber-300 ring-2 ring-amber-400 flex items-center justify-center text-[10px]">⏳</span>
        <span class="font-bold text-amber-800">Sedang Review</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded bg-rose-600 ring-2 ring-rose-500 flex items-center justify-center text-[10px] text-white font-bold">⚠️</span>
        <span class="font-bold text-rose-800">Ditolak</span>
      </div>
    </div>
    %>

    <% if (isSuperAdminOrDinas) { %>
      <div class="mt-2.5 pt-2 border-t border-slate-200/60 flex items-center gap-1.5 text-xs text-violet-800 font-medium">
        <i data-lucide="layers" class="w-3.5 h-3.5 text-violet-600 shrink-0"></i>
        <span><b>Fitur Super Admin & Admin Dinas:</b> Klik angka tanggal pada header tabel (1–31) untuk mengubah status seluruh pegawai secara vertikal sekaligus.</span>
      </div>
    <% } %>
  </div>

  <!-- MOBILE VIEW: Card list layout (sm and down) -->
  <div class="block lg:hidden space-y-4">
    <% if (recap.length === 0) { %>
      <div class="custom-card p-8 text-center text-slate-500">
        <i data-lucide="user-x" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
        <p class="font-bold text-slate-700">Tidak ada pegawai ditemukan</p>
      </div>
    <% } %>

    <% recap.forEach(function(item) { %>
      <div class="custom-card p-4 space-y-3 bg-white">
        
        <!-- Header Info (Full Uncut Name) -->
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-sm text-slate-900 leading-snug break-words"><%= item.employee.nama %></h3>
            <p class="text-[11px] text-indigo-600 font-medium truncate mt-0.5"><%= item.employee.unitNama %></p>
          </div>
          
          <div class="text-right shrink-0">
            <span class="inline-block px-2 py-1 rounded-lg text-xs font-extrabold <%= item.summary.totalEfektif === 0 ? 'bg-slate-100 text-slate-400' : (item.summary.persentase >= 85 ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700') %>">
              <%= item.summary.persentase %>%
            </span>
          </div>
        </div>

        <!-- Summary Stats (ONLY H, TK, and %) -->
        <div class="grid grid-cols-3 gap-2 bg-slate-50 p-2.5 rounded-xl text-center text-xs">
          <div class="p-1.5 rounded-lg bg-white border border-slate-100 shadow-2xs">
            <span class="text-[10px] text-slate-500 uppercase font-bold">Total Hadir (H)</span>
            <p class="font-extrabold text-emerald-600 text-sm mt-0.5"><%= item.summary.hadir %></p>
          </div>
          <div class="p-1.5 rounded-lg bg-white border border-slate-100 shadow-2xs">
            <span class="text-[10px] text-slate-500 uppercase font-bold">Tanpa Ket. (TK)</span>
            <p class="font-extrabold text-rose-600 text-sm mt-0.5"><%= item.summary.tk %></p>
          </div>
          <div class="p-1.5 rounded-lg bg-white border border-slate-100 shadow-2xs">
            <span class="text-[10px] text-slate-500 uppercase font-bold">Persentase</span>
            <p class="font-extrabold text-slate-800 text-sm mt-0.5"><%= item.summary.persentase %>%</p>
          </div>
        </div>

        <!-- Horizontal Scrollable Day Strip (Badges 1..31) -->
        <div class="pt-1">
          <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 mb-1">
            <span>Presensi Hari 1–31:</span>
            <span class="text-[10px] text-slate-400">
              <%= isAdmin ? 'Klik untuk Ubah Status Langsung' : 'Klik TK / DL Kuning' %>
            </span>
          </div>
          <div class="flex items-center gap-1.5 overflow-x-auto pb-2 custom-scrollbar">
            <% item.days.forEach(function(d) { 
                let badgeClass = '';
                let shortCode = '';
                let isWithoutBadge = (d.status === 'EMPTY' && !d.clarificationStatus);
                
                if (d.clarificationStatus === 'PENDING') {
                  badgeClass = 'cell-day-pending';
                  shortCode = '⏳';
                } else if (d.clarificationStatus === 'REJECTED') {
                  badgeClass = 'cell-day-rejected';
                  shortCode = '⚠️';
                } else if (d.status === 'HADIR') { badgeClass = 'cell-day-hadir'; shortCode = 'H'; }
                else if (d.status === 'TK') { badgeClass = 'cell-day-tk'; shortCode = 'TK'; }
                else if (d.status === 'DL') { badgeClass = 'cell-day-dl'; shortCode = 'DL'; }
                else if (d.status === 'DL_KUNING') { badgeClass = 'cell-day-dl-kuning'; shortCode = 'DL'; }
                else if (d.status === 'TL') { badgeClass = 'cell-day-tl'; shortCode = 'TL'; }
                else if (d.status === 'PC') { badgeClass = 'cell-day-pc'; shortCode = 'PC'; }
                else if (d.status === 'ST') { badgeClass = 'cell-day-st'; shortCode = 'ST'; }
                else if (d.status === 'CT') { badgeClass = 'cell-day-ct'; shortCode = 'CT'; }
                else if (d.status === 'LIBUR') { badgeClass = 'cell-day-weekend'; shortCode = 'L'; }
                else if (d.status === 'EMPTY') { badgeClass = 'bg-transparent text-transparent border-0'; shortCode = ''; }
            %>
              <div class="flex flex-col items-center shrink-0 w-7 relative">
                <span class="text-[9px] <%= isWithoutBadge ? 'text-slate-300' : 'text-slate-400' %> font-medium"><%= d.tanggal %></span>
                
                <% if (isWithoutBadge) { %>
                  <% if (isAdmin) { %>
                    <button type="button" 
                            class="w-7 h-7 rounded-lg flex items-center justify-center text-[10px] bg-transparent text-transparent border-0 hover:bg-slate-100 cursor-pointer transition-all"
                            title="Tgl <%= d.tanggal %>: Belum Ada Data (Klik untuk ubah)"
                            @click="handleCellClick(<%= JSON.stringify(item.employee) %>, <%= JSON.stringify(d) %>, <%= JSON.stringify(item.days) %>)">
                    </button>
                  <% } else { %>
                    <div class="w-7 h-7"></div>
                  <% } %>
                <% } else { %>
                  <button type="button" 
                          class="w-7 h-7 rounded-lg flex items-center justify-center text-[10px] <%= badgeClass %> shadow-xs cursor-pointer hover:scale-110 active:scale-95 transition-all"
                          title="Tgl <%= d.tanggal %>: <%= d.keterangan || d.status %><%= d.clarificationStatus === 'PENDING' ? ' (Sedang Dalam Review)' : d.clarificationStatus === 'REJECTED' ? ' (Ditolak: ' + d.clarificationNote + ')' : '' %>"
                          @click="handleCellClick(<%= JSON.stringify(item.employee) %>, <%= JSON.stringify(d) %>, <%= JSON.stringify(item.days) %>)">
                    <%= shortCode %>
                  </button>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Action Button for Consecutive Dates -->
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
          <span class="text-[11px] text-slate-500">Ajukan tanggal berturut-turut:</span>
          <% if (isAdmin || isDefaultPeriod) { %>
            <button @click="openKlarifikasiWithDays(<%= JSON.stringify(item.employee) %>, <%= JSON.stringify(item.days) %>, '', 'TK', true)" 
                    class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50 border-indigo-200">
              <i data-lucide="calendar-range" class="w-3.5 h-3.5"></i>
              <span>Rentang Tanggal</span>
            </button>
          <% } else { %>
            <span class="text-xs text-slate-400 italic">Periode Terkunci</span>
          <% } %>
        </div>

      </div>
    <% }); %>

    <!-- Mobile Pagination -->
    <div class="custom-card overflow-hidden">
      <%- include('partials/pagination') %>
    </div>
  </div>

  <!-- DESKTOP VIEW: ULTRA-COMPACT 31-DAY GRID (FREEZE HEADER + HORIZONTAL ALIGNMENT) -->
  <div class="hidden lg:block custom-card overflow-hidden bg-white shadow-sm border border-slate-200">
    <div class="overflow-x-auto overflow-y-auto max-h-[640px] xl:max-h-[720px] custom-scrollbar relative">
      <table class="w-full text-left text-xs border-collapse table-auto">
        <thead class="sticky top-0 z-30 bg-slate-100 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200 shadow-2xs">
          <tr class="h-9">
            <!-- Sticky Left: Nama Pegawai (Full Uncut Name) -->
            <th class="sticky left-0 top-0 z-40 bg-slate-100 px-3 py-2 min-w-[155px] max-w-[185px] sticky-shadow text-slate-800 font-bold align-middle" title="Nama Pegawai">
              Pegawai
            </th>
            <!-- Unit Kerja (Full Uncut Name) -->
            <th class="px-2.5 py-2 min-w-[110px] max-w-[130px] border-r border-slate-200 text-slate-700 font-bold align-middle" title="Unit Kerja">
              Unit Kerja
            </th>
            <!-- Days 1 to 31 (Ultra-compact 21.5px per column with National Holiday Indicator) -->
            <% for(let d = 1; d <= 31; d++) { 
                const holiName = typeof holidays !== 'undefined' && holidays[d] ? holidays[d] : null;
                const dDate = new Date(tahun, bulan - 1, d);
                const isWknd = (dDate.getDay() === 0 || dDate.getDay() === 6);
            %>
              <th class="p-0 text-center min-w-[21px] max-w-[22px] w-[21.5px] border-r border-slate-200/60 font-bold text-[9.5px] align-middle <%= holiName ? 'bg-rose-100 text-rose-700 font-extrabold' : (isWknd ? 'bg-slate-200/70 text-slate-500' : 'text-slate-600') %> <%= isSuperAdminOrDinas ? 'cursor-pointer hover:bg-violet-100 hover:text-violet-800 transition-colors group' : '' %>"
                  title="<%= holiName ? 'Tanggal ' + d + ' • Libur Nasional: ' + holiName : (isWknd ? 'Tanggal ' + d + ' (Akhir Pekan)' : 'Tanggal ' + d) %>"
                  <% if (isSuperAdminOrDinas) { %>
                    @click="openBulkDateModal(<%= d %>)"
                  <% } %>>
                <span class="inline-flex items-center justify-center w-full h-full py-2 <%= isSuperAdminOrDinas ? 'group-hover:scale-110 transition-transform' : '' %>">
                  <%= d %>
                </span>
              </th>
            <% } %>
            <!-- Summary Columns (H, TK, %) -->
            <th class="px-1.5 py-2 text-center text-emerald-700 bg-emerald-50/70 border-l border-slate-200 w-7 min-w-[28px] text-[10px] align-middle" title="Total Hadir">H</th>
            <th class="px-1.5 py-2 text-center text-rose-700 bg-rose-50/70 w-7 min-w-[28px] text-[10px] align-middle" title="Tanpa Keterangan">TK</th>
            <th class="px-1.5 py-2 text-center font-extrabold text-slate-800 bg-slate-200/60 border-r border-slate-200 w-8 min-w-[32px] text-[10px] align-middle">%</th>
            
            <!-- STICKY RIGHT COLUMN: Minimalis Icon Action Rentang Tanggal -->
            <th class="sticky right-0 top-0 z-40 bg-slate-100 px-1 py-2 text-center w-8 min-w-[32px] sticky-right-shadow align-middle" title="Aksi Rentang Tanggal">
              <i data-lucide="calendar-range" class="w-3.5 h-3.5 mx-auto text-slate-500"></i>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (recap.length === 0) { %>
            <tr>
              <td colspan="37" class="py-12 text-center text-slate-500">
                <i data-lucide="user-x" class="w-8 h-8 mx-auto text-slate-300 mb-2"></i>
                <p class="font-bold text-sm text-slate-700">Tidak ada pegawai ditemukan</p>
              </td>
            </tr>
          <% } %>

          <% recap.forEach(function(item) { %>
            <tr class="hover:bg-indigo-50/30 transition-colors h-[38px]">
              
              <!-- Sticky Left: Nama Pegawai (Full Uncut Name) -->
              <td class="sticky left-0 z-20 bg-white hover:bg-indigo-50/30 px-3 py-1.5 sticky-shadow border-r border-slate-100 min-w-[155px] max-w-[185px] align-middle">
                <div class="font-bold text-slate-900 text-xs leading-snug break-words">
                  <%= item.employee.nama %>
                </div>
              </td>

              <!-- Unit Kerja (Full Uncut Name) -->
              <td class="px-2.5 py-1.5 text-[10.5px] font-medium text-slate-600 border-r border-slate-100 min-w-[110px] max-w-[130px] leading-tight break-words align-middle" title="<%= item.employee.unitNama %>">
                <%= item.employee.unitNama %>
              </td>

              <!-- 31 Days Columns (Ultra-compact 21.5px with 20px button) -->
              <% item.days.forEach(function(d) { 
                  let bgCol = '';
                  let char = '';
                  let isWithoutBadge = (d.status === 'EMPTY' && !d.clarificationStatus);
                  
                  if (d.clarificationStatus === 'PENDING') {
                    bgCol = 'cell-day-pending';
                    char = '⏳';
                  } else if (d.clarificationStatus === 'REJECTED') {
                    bgCol = 'cell-day-rejected';
                    char = '⚠️';
                  } else if (d.status === 'HADIR') { bgCol = 'cell-day-hadir'; char = 'H'; }
                  else if (d.status === 'TK') { bgCol = 'cell-day-tk'; char = 'TK'; }
                  else if (d.status === 'DL') { bgCol = 'cell-day-dl'; char = 'DL'; }
                  else if (d.status === 'DL_KUNING') { bgCol = 'cell-day-dl-kuning'; char = 'DL'; }
                  else if (d.status === 'TL') { bgCol = 'cell-day-tl'; char = 'TL'; }
                  else if (d.status === 'PC') { bgCol = 'cell-day-pc'; char = 'PC'; }
                  else if (d.status === 'ST') { bgCol = 'cell-day-st'; char = 'ST'; }
                  else if (d.status === 'CT') { bgCol = 'cell-day-ct'; char = 'CT'; }
                  else if (d.status === 'LIBUR') { bgCol = 'cell-day-weekend'; char = 'L'; }
                  else if (d.status === 'EMPTY') { bgCol = 'bg-transparent text-transparent border-0'; char = ''; }
              %>
                <td class="p-0 text-center border-r border-slate-100/50 min-w-[21px] max-w-[22px] w-[21.5px] align-middle">
                  <% if (isWithoutBadge) { %>
                    <% if (isAdmin) { %>
                      <button type="button" 
                              class="inline-flex items-center justify-center w-5 h-5 rounded text-[8px] bg-transparent text-transparent hover:bg-slate-100/80 cursor-pointer transition-all"
                              title="Tgl <%= d.tanggal %>: Belum Ada Data (Klik untuk ubah)"
                              @click="handleCellClick(<%= JSON.stringify(item.employee) %>, <%= JSON.stringify(d) %>, <%= JSON.stringify(item.days) %>)">
                      </button>
                    <% } else { %>
                      <span class="inline-block w-5 h-5"></span>
                    <% } %>
                  <% } else { %>
                    <button type="button" 
                            class="inline-flex items-center justify-center w-5 h-5 rounded text-[8px] <%= bgCol %> cursor-pointer hover:scale-120 active:scale-95 transition-all shadow-2xs font-bold leading-none"
                            title="Tgl <%= d.tanggal %>: <%= d.keterangan || d.status %><%= d.clarificationStatus === 'PENDING' ? ' (Sedang Dalam Review)' : d.clarificationStatus === 'REJECTED' ? ' (Ditolak: ' + d.clarificationNote + ')' : '' %>"
                            @click="handleCellClick(<%= JSON.stringify(item.employee) %>, <%= JSON.stringify(d) %>, <%= JSON.stringify(item.days) %>)">
                      <%= char %>
                    </button>
                  <% } %>
                </td>
              <% }); %>

              <!-- Summary Cells (ONLY H, TK, %) -->
              <td class="px-1 py-1.5 text-center font-bold text-emerald-700 bg-emerald-50/40 border-l border-slate-100 text-[11px] w-7 min-w-[28px] align-middle">
                <%= item.summary.hadir %>
              </td>
              <td class="px-1 py-1.5 text-center font-bold text-rose-700 bg-rose-50/40 text-[11px] w-7 min-w-[28px] align-middle">
                <%= item.summary.tk %>
              </td>
              <td class="px-1 py-1.5 text-center font-extrabold <%= item.summary.totalEfektif === 0 ? 'text-slate-400' : 'text-slate-800' %> bg-slate-100/50 border-r border-slate-100 text-[11px] w-8 min-w-[32px] align-middle">
                <%= item.summary.persentase %>%
              </td>

              <!-- STICKY RIGHT: Ramping Icon-Only Button for Rentang Tanggal -->
              <td class="sticky right-0 z-20 bg-white hover:bg-indigo-50/30 px-1 py-1 text-center whitespace-nowrap sticky-right-shadow w-8 min-w-[32px] align-middle">
                <% if (isAdmin || isDefaultPeriod) { %>
                  <button @click="openKlarifikasiWithDays(<%= JSON.stringify(item.employee) %>, <%= JSON.stringify(item.days) %>, '', 'TK', true)" 
                          class="p-1 rounded-md text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 border border-indigo-200 transition-all inline-flex items-center justify-center shadow-2xs"
                          title="Ajukan Rentang Tanggal untuk <%= item.employee.nama %>">
                    <i data-lucide="calendar-range" class="w-3 h-3"></i>
                  </button>
                <% } else { %>
                  <span class="text-slate-300 text-[10px]">-</span>
                <% } %>
              </td>

            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Desktop Pagination -->
    <%- include('partials/pagination') %>
  </div>

  <!-- ALPINE.JS MODAL 1: KLARIFIKASI ABSENSI (KOMPAK, RAPI, PAS VH) -->
  <template x-teleport="body">
    <div x-show="klarifikasiModal" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="klarifikasiModal = false"
           class="bg-white rounded-3xl max-w-lg w-full shadow-2xl border border-slate-100 flex flex-col max-h-[90vh] overflow-hidden">
        
        <!-- Modal Header (Fixed top) -->
        <div class="flex items-center justify-between px-5 py-3.5 sm:px-6 sm:py-4 border-b border-slate-100 shrink-0 bg-slate-50/60">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
              <i data-lucide="file-text" class="w-4 h-4 sm:w-5 sm:h-5"></i>
            </div>
            <div>
              <h2 class="text-sm sm:text-base font-bold text-slate-900 leading-tight" x-text="isRentang ? 'Klarifikasi Rentang Tanggal' : 'Form Klarifikasi Presensi'"></h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Pengajuan berkas bukti kehadiran pegawai</p>
            </div>
          </div>
          <button @click="klarifikasiModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100">
            <i data-lucide="x" class="w-4 h-4 sm:w-5 sm:h-5"></i>
          </button>
        </div>

        <!-- Modal Form (Scrollable body) -->
        <template x-if="selectedEmployee">
          <form action="/absensi/klarifikasi" method="POST" enctype="multipart/form-data" class="flex flex-col flex-1 min-h-0 overflow-hidden">
            <input type="hidden" name="employeeId" :value="selectedEmployee.id">
            <input type="hidden" name="statusAwal" :value="currentStatus">
            <input type="hidden" name="isRentang" :value="isRentang ? 'true' : 'false'">

            <div class="flex-1 overflow-y-auto custom-scrollbar p-5 space-y-3.5">
              
              <!-- Pegawai & Mode Toggle (Compact Box) -->
              <div class="p-3 rounded-2xl bg-indigo-50/70 border border-indigo-100 flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Pegawai:</span>
                    <span class="text-xs font-bold text-slate-900 truncate" x-text="selectedEmployee.nama"></span>
                  </div>
                  <p class="text-[11px] text-slate-500 truncate mt-0.5" x-text="selectedEmployee.unitNama"></p>
                </div>

                <!-- Mode Toggle Pills -->
                <div class="inline-flex p-0.5 rounded-xl bg-white border border-indigo-100 text-[10.5px] shrink-0 font-medium shadow-2xs">
                  <button type="button" @click="isRentang = false" 
                          :class="!isRentang ? 'bg-indigo-600 text-white font-bold' : 'text-slate-600 hover:text-slate-900'" 
                          class="px-2.5 py-1 rounded-lg transition-all">
