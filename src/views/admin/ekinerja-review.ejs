                </td>

                <td class="px-3 py-3 text-right align-middle whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1">
                    <button @click="openReview(allArchiveItems[<%= aIdx %>])" class="p-1.5 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-colors" title="Buka Detail Review & Edit">
                      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    </button>
                    <button @click="openDelete(allArchiveItems[<%= aIdx %>])" class="p-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition-colors" title="Hapus dari Riwayat">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </div>

  </div>

  <!-- ALPINE.JS MODAL 1: UNIFIED REVIEW & SCORING MODAL -->
  <template x-teleport="body">
    <div x-show="reviewModal" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/80 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 lg:p-6"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
    
      <div @click.away="reviewModal = false"
           class="bg-white rounded-3xl max-w-6xl w-full p-4 sm:p-6 shadow-2xl border border-slate-100 flex flex-col max-h-[94vh]">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between gap-3 pb-3 mb-3 border-b border-slate-100 shrink-0">
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="font-extrabold text-base sm:text-lg text-slate-900 truncate" x-text="selectedReport ? selectedReport.employee.nama : '—'"></h3>
              <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100 shrink-0" 
                    x-show="selectedReport"
                    x-text="selectedReport ? ('Periode ' + selectedReport.bulan + '/' + selectedReport.tahun) : ''"></span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5 truncate" 
               x-show="selectedReport"
               x-text="selectedReport ? ('NIP: ' + selectedReport.employee.nip + ' • ' + selectedReport.employee.unitNama) : ''"></p>
          </div>

          <!-- Controls row -->
          <div class="flex items-center gap-2 shrink-0">
            <!-- Desktop Doc type switcher -->
            <div class="hidden lg:flex items-center bg-slate-100 p-1 rounded-xl">
              <button type="button" 
                      @click="switchDoc('harian')" 
                      :class="activeDocType === 'harian' ? 'bg-white text-indigo-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                      class="px-3 py-1.5 rounded-lg text-xs flex items-center gap-1.5 transition-all">
                <i data-lucide="file-text" class="w-3.5 h-3.5 text-indigo-600"></i>
                <span>Lap. Harian</span>
                <span x-show="selectedReport && selectedReport.fileHarianUrl" class="w-1.5 h-1.5 rounded-full bg-emerald-500" style="display:none;"></span>
              </button>
              <button type="button" 
                      @click="switchDoc('bulanan')" 
                      :class="activeDocType === 'bulanan' ? 'bg-white text-emerald-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                      class="px-3 py-1.5 rounded-lg text-xs flex items-center gap-1.5 transition-all">
                <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                <span>Lap. Bulanan</span>
                <span x-show="selectedReport && selectedReport.fileBulananUrl" class="w-1.5 h-1.5 rounded-full bg-emerald-500" style="display:none;"></span>
              </button>
            </div>

            <!-- Desktop Download & open-tab buttons -->
            <a x-show="currentPdfUrl" 
               :href="currentPdfUrl || '#'" 
               :download="currentPdfName"
               class="hidden lg:inline-flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-600 hover:bg-indigo-100 transition-colors" 
               title="Unduh Berkas PDF"
               style="display:none;">
              <i data-lucide="download" class="w-4 h-4"></i>
            </a>
            <a x-show="currentPdfUrl" 
               :href="currentPdfUrl || '#'" 
               target="_blank"
               class="hidden lg:inline-flex items-center justify-center w-8 h-8 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100 transition-colors" 
               title="Buka di Tab Baru"
               style="display:none;">
              <i data-lucide="external-link" class="w-4 h-4"></i>
            </a>

            <button @click="reviewModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100 ml-1">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>
        </div>

        <!-- Modal Body -->
        <div class="flex-1 overflow-y-auto lg:overflow-hidden flex flex-col min-h-0 custom-scrollbar">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 flex-1 lg:h-full lg:max-h-[76vh]">
            
            <!-- LEFT: Desktop PDF Viewer ONLY (hidden on mobile, visible on lg) -->
            <div class="hidden lg:flex lg:col-span-7 bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 relative flex-col items-center justify-between h-full">
              <!-- Desktop Native PDF Iframe -->
              <iframe x-show="currentPdfUrl" 
                      :src="currentPdfViewerUrl"
                      class="w-full h-full rounded-2xl border-0" 
                      allowfullscreen
                      style="display:none;"></iframe>

              <!-- Empty State when no PDF is uploaded -->
              <div x-show="!currentPdfUrl" class="p-8 text-center my-auto">
                <i data-lucide="file-x" class="w-12 h-12 mx-auto text-slate-300 mb-3"></i>
                <p class="font-bold text-sm text-slate-700">Berkas Belum Diunggah</p>
                <p class="text-xs text-slate-400 mt-1 max-w-xs mx-auto">
                  Pegawai belum melampirkan file PDF untuk 
                  <span class="font-bold text-slate-600" x-text="activeDocType === 'harian' ? 'Laporan Harian' : 'Laporan Bulanan'"></span>.
                </p>
              </div>
            </div>

            <!-- RIGHT: Scoring Form & Mobile Document Section (12 cols on mobile, 5 cols on desktop) -->
            <div class="lg:col-span-5 overflow-y-auto custom-scrollbar flex flex-col space-y-4">
              
              <!-- MOBILE DOCUMENT BUTTONS (Visible ONLY on mobile: block lg:hidden) -->
              <div class="block lg:hidden space-y-2.5">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Dokumen Laporan PDF</label>
                
                <!-- Lap. Harian Mobile Card -->
                <div class="p-3 rounded-2xl border transition-all"
                     :class="selectedReport && selectedReport.fileHarianUrl ? 'bg-indigo-50/70 border-indigo-200' : 'bg-slate-50 border-slate-200 text-slate-400'">
                  <div class="flex items-center justify-between gap-2">
                    <div class="min-w-0 flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 shadow-2xs"
                           :class="selectedReport && selectedReport.fileHarianUrl ? 'bg-indigo-600 text-white' : 'bg-slate-200 text-slate-400'">
                        <i data-lucide="file-text" class="w-4 h-4"></i>
                      </div>
                      <div class="min-w-0">
                        <span class="font-bold text-xs block text-slate-900">Laporan Harian</span>
                        <span class="text-[10px] text-slate-500 truncate block" 
                              x-text="selectedReport && selectedReport.fileHarianUrl ? (selectedReport.fileHarianName || 'Berkas PDF Terunggah') : 'Belum diunggah'"></span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0" x-show="selectedReport && selectedReport.fileHarianUrl">
                      <a :href="selectedReport ? selectedReport.fileHarianUrl : '#'" 
                         :download="selectedReport ? selectedReport.fileHarianName : 'Laporan-Harian.pdf'"
                         class="p-2 rounded-xl bg-white border border-indigo-200 text-indigo-600 hover:bg-indigo-100 shadow-2xs"
                         title="Unduh Berkas PDF">
                        <i data-lucide="download" class="w-4 h-4"></i>
                      </a>
                      <a :href="selectedReport ? selectedReport.fileHarianUrl : '#'" 
                         target="_blank"
                         rel="noopener noreferrer"
                         class="inline-flex items-center gap-1 py-1.5 px-3 rounded-xl bg-indigo-600 text-white font-bold text-xs hover:bg-indigo-700 shadow-xs"
                         title="Buka PDF Layar Penuh">
                        <span>Buka PDF</span>
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                      </a>
                    </div>
                  </div>
                </div>

                <!-- Lap. Bulanan Mobile Card -->
                <div class="p-3 rounded-2xl border transition-all"
                     :class="selectedReport && selectedReport.fileBulananUrl ? 'bg-emerald-50/70 border-emerald-200' : 'bg-slate-50 border-slate-200 text-slate-400'">
                  <div class="flex items-center justify-between gap-2">
                    <div class="min-w-0 flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 shadow-2xs"
                           :class="selectedReport && selectedReport.fileBulananUrl ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-400'">
                        <i data-lucide="file-check-2" class="w-4 h-4"></i>
                      </div>
                      <div class="min-w-0">
                        <span class="font-bold text-xs block text-slate-900">Laporan Bulanan</span>
                        <span class="text-[10px] text-slate-500 truncate block" 
                              x-text="selectedReport && selectedReport.fileBulananUrl ? (selectedReport.fileBulananName || 'Berkas PDF Terunggah') : 'Belum diunggah'"></span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0" x-show="selectedReport && selectedReport.fileBulananUrl">
                      <a :href="selectedReport ? selectedReport.fileBulananUrl : '#'" 
                         :download="selectedReport ? selectedReport.fileBulananName : 'Laporan-Bulanan.pdf'"
                         class="p-2 rounded-xl bg-white border border-emerald-200 text-emerald-600 hover:bg-emerald-100 shadow-2xs"
                         title="Unduh Berkas PDF">
                        <i data-lucide="download" class="w-4 h-4"></i>
                      </a>
                      <a :href="selectedReport ? selectedReport.fileBulananUrl : '#'" 
                         target="_blank"
                         rel="noopener noreferrer"
                         class="inline-flex items-center gap-1 py-1.5 px-3 rounded-xl bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-700 shadow-xs"
                         title="Buka PDF Layar Penuh">
                        <span>Buka PDF</span>
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                      </a>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Single Form for both Mobile & Desktop -->
              <form x-ref="reviewForm"
                    method="POST"
                    action="/admin/ekinerja-review/placeholder/review"
                    @submit.prevent="submitReview()"
                    class="space-y-4 p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80">

                <!-- Hidden status field -->
                <input type="hidden" name="statusReview" value="APPROVED">

                <!-- Decision Selector -->
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Keputusan Verifikator</label>
                  <div class="grid grid-cols-2 gap-2">
                    <button type="button" 
                            @click="reviewAction = 'approve'" 
                            :class="reviewAction === 'approve' ? 'bg-emerald-600 text-white font-bold ring-2 ring-emerald-400 shadow-sm' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 font-semibold'"
                            class="py-2.5 px-3 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                      <i data-lucide="check-circle" class="w-4 h-4"></i>
                      <span>Setujui &amp; Nilai</span>
                    </button>
                    <button type="button" 
                            @click="reviewAction = 'reject'" 
                            :class="reviewAction === 'reject' ? 'bg-rose-600 text-white font-bold ring-2 ring-rose-400 shadow-sm' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 font-semibold'"
                            class="py-2.5 px-3 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                      <i data-lucide="x-circle" class="w-4 h-4"></i>
                      <span>Tolak Laporan</span>
                    </button>
                  </div>
                </div>

                <!-- SECTION A: Approve — score inputs -->
                <div x-show="reviewAction === 'approve'" class="space-y-3">
                  <div class="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200/80 space-y-3">
                    <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-900">
                      <i data-lucide="award" class="w-4 h-4 text-emerald-600"></i>
                      <span>Penetapan Nilai Prestasi Kerja</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                      <div>
                        <label class="block text-[11px] font-bold uppercase text-emerald-900 mb-1">Nilai Harian (0–100)</label>
                        <input type="number" step="0.01" min="0" max="100" placeholder="-"
                               name="nilaiHarian" x-model="nilaiHarian"
                               class="form-input text-sm font-extrabold text-center text-emerald-800 bg-white">
                      </div>
                      <div>
                        <label class="block text-[11px] font-bold uppercase text-emerald-900 mb-1">Nilai Bulanan (0–100)</label>
                        <input type="number" step="0.01" min="0" max="100" placeholder="-"
                               name="nilaiBulanan" x-model="nilaiBulanan"
                               class="form-input text-sm font-extrabold text-center text-emerald-800 bg-white">
                      </div>
                    </div>
                  </div>
                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Catatan Evaluasi (Opsional)</label>
                    <input type="text" 
                           id="approveNoteInput"
                           name="catatanAdmin" 
                           x-model="catatanAdmin"
                           placeholder="Contoh: Laporan lengkap dan memenuhi target..." 
                           class="form-input text-xs">
                  </div>
                </div>

                <!-- SECTION B: Reject — mandatory reason -->
                <div x-show="reviewAction === 'reject'" class="space-y-3" style="display:none;">
                  <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-xs space-y-1.5">
                    <p class="font-bold flex items-center gap-1 text-rose-700">
                      <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-600"></i>
                      <span>Alasan penolakan wajib diisi</span>
                    </p>
                    <p class="text-[11px] text-rose-800 leading-relaxed">
                      Sampaikan poin yang perlu diperbaiki agar pegawai dapat segera mengunggah revisi.
                    </p>
                  </div>
                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                      Catatan / Alasan Penolakan <span class="text-rose-600">*</span>
                    </label>
                    <textarea id="rejectNoteInput"
                              name="catatanAdmin" 
                              rows="3" 
                              x-model="catatanAdmin"
                              class="form-input text-xs" 
                              placeholder="Contoh: Tanda tangan Kepala Sekolah belum tercantum pada lembar pengesahan bulanan..."></textarea>
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-4 border-t border-slate-200/80 flex items-center gap-2.5">
                  <button type="button" @click="reviewModal = false" 
                          class="btn-secondary py-2.5 px-4 text-xs font-semibold whitespace-nowrap">
                    Batal
                  </button>
                  <button type="submit" 
                          :class="reviewAction === 'approve' 
                            ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-200' 
                            : 'bg-rose-600 hover:bg-rose-700 text-white shadow-rose-200'"
                          class="btn-primary flex-1 py-2.5 px-4 text-xs font-bold flex items-center justify-center gap-2 shadow-md">
                    <i data-lucide="check-circle" x-show="reviewAction === 'approve'" class="w-4 h-4"></i>
                    <i data-lucide="x-circle" x-show="reviewAction === 'reject'" class="w-4 h-4" style="display:none;"></i>
                    <span x-text="reviewAction === 'approve' ? 'Simpan Nilai & Setujui' : 'Konfirmasi Tolak Laporan'"></span>
                  </button>
                </div>

              </form>
            </div><!-- end scoring column -->

          </div>
        </div>

      </div>
    </div>
  </template>

  <!-- ALPINE.JS MODAL 2: DELETE CONFIRMATION -->
  <template x-teleport="body">
    <div x-show="deleteModal" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="deleteModal = false"
           class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        
        <div class="flex items-center gap-2.5 text-rose-600 pb-3 border-b border-slate-100">
          <i data-lucide="trash-2" class="w-5 h-5"></i>
          <h3 class="font-bold text-base text-slate-900">Hapus Laporan E-Kinerja</h3>
        </div>

        <template x-if="selectedReport">
          <form :action="deleteActionUrl" method="POST" class="space-y-3">
            <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-xs space-y-1">
              <p class="font-bold text-slate-900" x-text="selectedReport.employee.nama"></p>
              <p class="text-slate-600" x-text="'Periode: ' + selectedReport.bulan + '/' + selectedReport.tahun"></p>
              <p class="text-rose-700 text-[11px] font-semibold mt-1">
                ⚠️ Peringatan: Menghapus laporan ini akan menghapus data pengajuan dan penilaian dari sistem.
              </p>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2">
              <button type="button" @click="deleteModal = false" class="btn-secondary py-2 px-3.5 text-xs">
                Batal
              </button>
              <button type="submit" class="btn-danger py-2 px-4 text-xs font-bold">
                Ya, Hapus Sekarang
              </button>
            </div>
          </form>
        </template>

      </div>
    </div>
  </template>

</main>

<%- include('../partials/admin-footer') %>
