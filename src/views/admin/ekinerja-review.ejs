<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<script>
  window.ekinerjaPendingData = <%- JSON.stringify(pendingList) %>;
  window.ekinerjaArchiveData = <%- JSON.stringify(archiveList) %>;
</script>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6"
      x-data="{
        activeTab: '<%= activeTab || 'pending' %>',
        filterUnit: '<%= filterUnit %>',
        filterStatus: '<%= filterStatus %>',
        search: '<%= search ? search.replace(/'/g, "\\'") : '' %>',
        allPendingItems: window.ekinerjaPendingData || [],
        allArchiveItems: window.ekinerjaArchiveData || [],
        mobilePendingPage: 1,
        mobilePendingPerPage: 10,
        get totalPendingCount() {
          return this.allPendingItems.length;
        },
        get mobileTotalPendingPages() {
          return Math.max(1, Math.ceil(this.totalPendingCount / this.mobilePendingPerPage));
        },
        get visiblePendingPageNumbers() {
          const cur = this.mobilePendingPage;
          const total = this.mobileTotalPendingPages;
          if (total <= 5) {
            return Array.from({ length: total }, (_, i) => i + 1);
          }
          if (cur <= 3) {
            return [1, 2, 3, 4, '...', total];
          }
          if (cur >= total - 2) {
            return [1, '...', total - 3, total - 2, total - 1, total];
          }
          return [1, '...', cur - 1, cur, cur + 1, '...', total];
        },
        isPendingVisible(idx) {
          if (this.mobilePendingPerPage >= this.totalPendingCount) return true;
          const start = (this.mobilePendingPage - 1) * this.mobilePendingPerPage;
          const end = start + this.mobilePendingPerPage;
          return idx >= start && idx < end;
        },
        nextPendingPage() {
          if (this.mobilePendingPage < this.mobileTotalPendingPages) {
            this.mobilePendingPage++;
            this.scrollMobileToTop('mobile-pending-list');
          }
        },
        prevPendingPage() {
          if (this.mobilePendingPage > 1) {
            this.mobilePendingPage--;
            this.scrollMobileToTop('mobile-pending-list');
          }
        },
        setPendingPage(p) {
          if (p !== '...' && p >= 1 && p <= this.mobileTotalPendingPages) {
            this.mobilePendingPage = p;
            this.scrollMobileToTop('mobile-pending-list');
          }
        },
        scrollMobileToTop(id) {
          const el = document.getElementById(id);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        },
        mobileArchivePage: 1,
        mobileArchivePerPage: 10,
        get totalArchiveCount() {
          return this.allArchiveItems.length;
        },
        get mobileTotalArchivePages() {
          return Math.max(1, Math.ceil(this.totalArchiveCount / this.mobileArchivePerPage));
        },
        get visibleArchivePageNumbers() {
          const cur = this.mobileArchivePage;
          const total = this.mobileTotalArchivePages;
          if (total <= 5) {
            return Array.from({ length: total }, (_, i) => i + 1);
          }
          if (cur <= 3) {
            return [1, 2, 3, 4, '...', total];
          }
          if (cur >= total - 2) {
            return [1, '...', total - 3, total - 2, total - 1, total];
          }
          return [1, '...', cur - 1, cur, cur + 1, '...', total];
        },
        isArchiveVisible(idx) {
          if (this.mobileArchivePerPage >= this.totalArchiveCount) return true;
          const start = (this.mobileArchivePage - 1) * this.mobileArchivePerPage;
          const end = start + this.mobileArchivePerPage;
          return idx >= start && idx < end;
        },
        nextArchivePage() {
          if (this.mobileArchivePage < this.mobileTotalArchivePages) {
            this.mobileArchivePage++;
            this.scrollMobileToTop('mobile-archive-list');
          }
        },
        prevArchivePage() {
          if (this.mobileArchivePage > 1) {
            this.mobileArchivePage--;
            this.scrollMobileToTop('mobile-archive-list');
          }
        },
        setArchivePage(p) {
          if (p !== '...' && p >= 1 && p <= this.mobileTotalArchivePages) {
            this.mobileArchivePage = p;
            this.scrollMobileToTop('mobile-archive-list');
          }
        },
        reviewModal: false,
        deleteModal: false,
        selectedReport: null,
        activeDocType: 'harian',
        reviewAction: 'approve',
        nilaiHarian: '',
        nilaiBulanan: '',
        catatanAdmin: '',

        get deleteActionUrl() {
          if (!this.selectedReport) return '#';
          const params = new URLSearchParams();
          params.set('tab', this.activeTab);
          if (this.filterUnit && this.filterUnit !== 'unit-all') params.set('unit', this.filterUnit);
          if (this.filterStatus && this.filterStatus !== 'ALL') params.set('status', this.filterStatus);
          if (this.search) params.set('search', this.search);
          return '/admin/ekinerja-review/' + this.selectedReport.id + '/delete?' + params.toString();
        },

        get currentPdfUrl() {
          if (!this.selectedReport) return '';
          return this.activeDocType === 'harian' ? this.selectedReport.fileHarianUrl : this.selectedReport.fileBulananUrl;
        },

        get currentPdfViewerUrl() {
          const url = this.currentPdfUrl;
          if (!url) return 'about:blank';
          return url.includes('#') ? url : (url + '#toolbar=1&navpanes=0&view=FitH');
        },

        get currentPdfName() {
          if (!this.selectedReport) return '';
          return this.activeDocType === 'harian' ? (this.selectedReport.fileHarianName || 'Laporan-Harian.pdf') : (this.selectedReport.fileBulananName || 'Laporan-Bulanan.pdf');
        },

        openReview(item, defaultDoc = 'harian') {
          this.selectedReport = item;
          if (defaultDoc === 'harian' && !item.fileHarianUrl && item.fileBulananUrl) {
            this.activeDocType = 'bulanan';
          } else if (defaultDoc === 'bulanan' && !item.fileBulananUrl && item.fileHarianUrl) {
            this.activeDocType = 'harian';
          } else {
            this.activeDocType = defaultDoc;
          }
          this.reviewAction = (item.statusReview === 'REJECTED') ? 'reject' : 'approve';
          this.nilaiHarian = (item.nilaiHarian !== undefined && item.nilaiHarian !== null && item.nilaiHarian !== '') ? item.nilaiHarian : '';
          this.nilaiBulanan = (item.nilaiBulanan !== undefined && item.nilaiBulanan !== null && item.nilaiBulanan !== '') ? item.nilaiBulanan : '';
          this.catatanAdmin = item.catatanAdmin || '';
          this.reviewModal = true;
          this.$nextTick(() => {
            if (window.lucide) window.lucide.createIcons();
          });
        },

        switchDoc(type) {
          this.activeDocType = type;
          this.$nextTick(() => {
            if (window.lucide) window.lucide.createIcons();
          });
        },

        openDelete(item) {
          this.selectedReport = item;
          this.deleteModal = true;
        },

        submitReview() {
          if (!this.selectedReport) return;
          const form = this.$refs.reviewForm;
          const params = new URLSearchParams();
          params.set('tab', this.activeTab || 'pending');
          if (this.filterUnit && this.filterUnit !== 'unit-all') params.set('unit', this.filterUnit);
          if (this.filterStatus && this.filterStatus !== 'ALL') params.set('status', this.filterStatus);
          if (this.search) params.set('search', this.search);

          form.action = '/admin/ekinerja-review/' + this.selectedReport.id + '/review?' + params.toString();
          const statusEl = form.querySelector('input[name=statusReview]');
          if (statusEl) statusEl.value = this.reviewAction === 'approve' ? 'APPROVED' : 'REJECTED';
          const approveNote = document.getElementById('approveNoteInput');
          const rejectNote = document.getElementById('rejectNoteInput');
          if (approveNote) approveNote.disabled = (this.reviewAction !== 'approve');
          if (rejectNote) rejectNote.disabled = (this.reviewAction !== 'reject');
          form.submit();
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider border border-indigo-100">Penilaian ASN</span>
        <span class="text-xs text-slate-400">Tim Penilai Korwil</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Review Laporan E-Kinerja</h1>
      <p class="text-xs sm:text-sm text-slate-500">Evaluasi dokumen PDF laporan pegawai, tetapkan nilai resmi, atau kirimkan alasan penolakan</p>
    </div>

    <!-- Status Counter -->
    <div class="flex items-center gap-2 text-xs">
      <div class="px-3.5 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 font-semibold flex items-center gap-2">
        <i data-lucide="clock" class="w-4 h-4 text-amber-600"></i>
        <span>Menunggu Review: <b><%= pendingCount %></b></span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-semibold flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
        <span>Disetujui: <b><%= approvedCount %></b></span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 font-semibold flex items-center gap-2">
        <i data-lucide="x-circle" class="w-4 h-4 text-rose-600"></i>
        <span>Ditolak: <b><%= rejectedCount %></b></span>
      </div>
    </div>
  </div>

  <!-- TABBED REVIEW & ARCHIVE QUEUE CARD -->
  <div class="custom-card p-5 sm:p-6 bg-white shadow-xs space-y-6">
    
    <!-- FILTER & PENCARIAN TOOLBAR (DI ATAS TAB) -->
    <div class="bg-slate-50/80 p-3.5 sm:p-4 rounded-2xl border border-slate-200/80 w-full overflow-visible">
      <form action="/admin/ekinerja-review" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 items-end w-full">
        <input type="hidden" name="tab" :value="activeTab">

        <!-- 1. Cari Nama / NIP Pegawai -->
        <div class="min-w-0">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Cari Pegawai</label>
          <div class="relative w-full">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
              <i data-lucide="search" class="w-4 h-4"></i>
            </div>
            <input type="text" 
                   name="search" 
                   value="<%= search %>" 
                   placeholder="Ketik nama atau NIP..." 
                   class="w-full pl-9 pr-8 h-[38px] rounded-xl text-xs font-medium bg-white border border-slate-200 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all shadow-2xs">
            <% if (search) { %>
              <a href="/admin/ekinerja-review?unit=<%= filterUnit %>&status=<%= filterStatus %>&tab=<%= activeTab %>" 
                 class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                 title="Hapus pencarian">
                <i data-lucide="x" class="w-3.5 h-3.5"></i>
              </a>
            <% } %>
          </div>
        </div>

        <!-- 2. Filter Unit Kerja (Searchable Alpine Dropdown) -->
        <div class="min-w-0 relative"
             x-data="{
               open: false,
               unitQuery: '',
               selectedVal: '<%= filterUnit %>',
               options: <%= JSON.stringify(units.map(u => ({ value: u.id, label: u.namaUnit }))) %>,
               get filteredOptions() {
                 if (!this.unitQuery) return this.options;
                 return this.options.filter(o => o.label.toLowerCase().includes(this.unitQuery.toLowerCase()));
               },
               get selectedLabel() {
                 const found = this.options.find(o => o.value === this.selectedVal);
                 return found ? found.label : 'Semua Unit Kerja';
               },
               selectOption(val) {
                 this.selectedVal = val;
                 this.open = false;
                 $refs.unitInput.value = val;
                 $nextTick(() => { $refs.unitInput.closest('form').submit(); });
               }
             }"
             @click.away="open = false">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Unit Kerja / Sekolah</label>
          <input type="hidden" name="unit" x-ref="unitInput" :value="selectedVal">
          
          <button type="button" 
                  @click="open = !open" 
                  :title="selectedLabel"
                  class="w-full flex items-center justify-between px-3.5 h-[38px] rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
            <span class="truncate pr-2" x-text="selectedLabel"></span>
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
          </button>

          <div x-show="open" 
               x-transition:enter="transition ease-out duration-150"
               x-transition:enter-start="opacity-0 translate-y-1 scale-98"
               x-transition:enter-end="opacity-100 translate-y-0 scale-100"
               x-transition:leave="transition ease-in duration-100"
               x-transition:leave-start="opacity-100 translate-y-0 scale-100"
               x-transition:leave-end="opacity-0 translate-y-1 scale-98"
               class="absolute left-0 right-0 w-full top-full mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-1.5"
               style="display: none; width: 100%; min-width: 100%; box-sizing: border-box;"
               @click.stop>
            
            <div class="relative">
              <input type="text" 
                     x-model="unitQuery" 
                     placeholder="Cari unit..." 
                     class="w-full pl-3 pr-7 py-1.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50 text-slate-800 placeholder:text-slate-400"
                     @click.stop
                     @keydown.stop>
              <button type="button" 
                      x-show="unitQuery && unitQuery.length > 0" 
                      @click="unitQuery = ''" 
                      class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-0.5 flex items-center justify-center">
                <i data-lucide="x" class="w-3.5 h-3.5"></i>
              </button>
            </div>

            <div class="max-h-[220px] overflow-y-auto custom-scrollbar space-y-0.5 pt-1">
              <template x-for="item in filteredOptions" :key="item.value">
                <button type="button" 
                        @click="selectOption(item.value)" 
                        :title="item.label"
                        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                        :class="selectedVal === item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                  <span class="truncate" x-text="item.label"></span>
                  <i data-lucide="check" x-show="selectedVal === item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                </button>
              </template>
              <div x-show="filteredOptions.length === 0" class="py-3 text-center text-xs text-slate-400">
                Tidak ada unit cocok
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Filter Status Review -->
        <div class="min-w-0">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Status Review</label>
          <select name="status" 
                  onchange="this.form.submit()" 
                  class="w-full px-3 h-[38px] rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all cursor-pointer">
            <option value="ALL" <%= (filterStatus === 'ALL' || !filterStatus) ? 'selected' : '' %>>Semua Status</option>
            <option value="PENDING" <%= filterStatus === 'PENDING' ? 'selected' : '' %>>Menunggu</option>
            <option value="APPROVED" <%= filterStatus === 'APPROVED' ? 'selected' : '' %>>Disetujui</option>
            <option value="REJECTED" <%= filterStatus === 'REJECTED' ? 'selected' : '' %>>Ditolak</option>
          </select>
        </div>

        <!-- 4. Tombol Aksi: Cari & Reset -->
        <div class="min-w-0">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 invisible select-none">Aksi</label>
          <div class="flex items-center gap-2 w-full">
            <button type="submit" 
                    class="flex-1 inline-flex items-center justify-center gap-1.5 px-3.5 h-[38px] rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition-colors shadow-2xs">
              <i data-lucide="search" class="w-3.5 h-3.5"></i>
              <span>Cari</span>
            </button>
            <% if (search || (filterUnit && filterUnit !== 'unit-all') || (filterStatus && filterStatus !== 'ALL')) { %>
              <a href="/admin/ekinerja-review" 
                 class="inline-flex items-center justify-center w-[38px] h-[38px] rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold text-xs transition-colors shrink-0"
                 title="Reset semua filter">
                <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
              </a>
            <% } %>
          </div>
        </div>
      </form>
    </div>

    <!-- TAB HEADERS (DI BAWAH FILTER) -->
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 pb-4 border-b border-slate-100">
      
      <!-- Tab Buttons -->
      <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-2xl w-full sm:w-auto">
        <button type="button" 
                @click="activeTab = 'pending'" 
                :class="activeTab === 'pending' ? 'bg-white text-indigo-600 shadow-sm font-bold' : 'text-slate-600 font-semibold hover:text-slate-900'"
                class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs transition-all">
          <i data-lucide="inbox" class="w-4 h-4"></i>
          <span>Antrean Menunggu</span>
          <span class="px-1.5 py-0.5 rounded-md text-[10px] <%= pendingList.length > 0 ? 'bg-amber-100 text-amber-800 font-bold' : 'bg-slate-200 text-slate-600' %>">
            <%= pendingList.length %>
          </span>
        </button>

        <button type="button" 
                @click="activeTab = 'history'" 
                :class="activeTab === 'history' ? 'bg-white text-indigo-600 shadow-sm font-bold' : 'text-slate-600 font-semibold hover:text-slate-900'"
                class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs transition-all">
          <i data-lucide="archive" class="w-4 h-4"></i>
          <span>Riwayat & Arsip Selesai</span>
          <span class="px-1.5 py-0.5 rounded-md text-[10px] bg-slate-200 text-slate-600">
            <%= archiveList.length %>
          </span>
        </button>
      </div>

      <% if (user && user.role !== 'ADMIN_DINAS') { %>
        <!-- Export Buttons (SUPER_ADMIN & ADMIN_KORWIL only) -->
        <div class="flex flex-wrap items-center gap-2" 
             x-data="{ exportBulan: new Date().getMonth() + 1, exportTahun: new Date().getFullYear() }">
          <a :href="`/admin/ekinerja-review/export/excel?bulan=${exportBulan}&tahun=${exportTahun}&unit=<%= filterUnit %>`"
             id="btn-export-excel"
             class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors shadow-xs">
            <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i>
            <span>Excel</span>
          </a>
          <a :href="`/admin/ekinerja-review/export/pdf?bulan=${exportBulan}&tahun=${exportTahun}&unit=<%= filterUnit %>`"
             id="btn-export-pdf"
             target="_blank"
             class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors shadow-xs">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            <span>PDF</span>
          </a>
          <!-- Month selector for export -->
          <select x-model.number="exportBulan"
                  class="px-2.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-white border border-slate-200 focus:outline-none focus:border-indigo-500 shadow-xs">
            <option value="1">Januari</option><option value="2">Februari</option><option value="3">Maret</option>
            <option value="4">April</option><option value="5">Mei</option><option value="6">Juni</option>
            <option value="7">Juli</option><option value="8">Agustus</option><option value="9">September</option>
            <option value="10">Oktober</option><option value="11">November</option><option value="12">Desember</option>
          </select>
          <select x-model.number="exportTahun"
                  class="px-2.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-white border border-slate-200 focus:outline-none focus:border-indigo-500 shadow-xs">
            <option value="2026">2026</option>
            <option value="2025">2025</option>
          </select>
        </div>
      <% } %>
    </div>

    <!-- TAB 1: ANTREAN MENUNGGU REVIEW (ONLY PENDING) -->
    <div x-show="activeTab === 'pending'" class="space-y-4">
      
      <!-- Mobile View with Pagination -->
      <div class="block lg:hidden space-y-4" id="mobile-pending-list">
        <% if (pendingList.length === 0) { %>
          <div class="p-8 text-center text-slate-400">
            <i data-lucide="check-check" class="w-8 h-8 mx-auto text-emerald-500 mb-2"></i>
            <p class="font-bold text-slate-700 text-sm">Semua antrean laporan telah dinilai!</p>
          </div>
        <% } %>

        <% pendingList.forEach(function(item, idx) { %>
          <div x-show="isPendingVisible(<%= idx %>)" class="p-4 rounded-2xl border border-amber-200 bg-amber-50/20 space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-bold text-sm text-slate-900"><%= item.employee.nama %></h3>
                <p class="text-xs text-slate-500">NIP: <%= item.employee.nip %></p>
                <p class="text-[11px] text-indigo-600 font-medium"><%= item.employee.unitNama %></p>
              </div>
              <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                Menunggu
              </span>
            </div>

            <!-- PDF Badges -->
            <div class="p-3 rounded-xl bg-white border border-slate-200/80 space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Laporan Harian:</span>
                <% if (item.fileHarianUrl) { %>
                  <button type="button" @click="openReview(allPendingItems[<%= idx %>], 'harian')" class="inline-flex items-center gap-1 text-indigo-600 font-bold hover:underline">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    <span class="truncate max-w-[140px]"><%= item.fileHarianName || 'Lihat & Nilai PDF' %></span>
                  </button>
                <% } else { %>
                  <span class="text-slate-300">-</span>
                <% } %>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Laporan Bulanan:</span>
                <% if (item.fileBulananUrl) { %>
                  <button type="button" @click="openReview(allPendingItems[<%= idx %>], 'bulanan')" class="inline-flex items-center gap-1 text-emerald-600 font-bold hover:underline">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    <span class="truncate max-w-[140px]"><%= item.fileBulananName || 'Lihat & Nilai PDF' %></span>
                  </button>
                <% } else { %>
                  <span class="text-slate-300">-</span>
                <% } %>
              </div>
            </div>

