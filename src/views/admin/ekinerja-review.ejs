                              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold text-[11px] transition-colors" title="Lihat & Nilai Laporan Harian">
                        <i data-lucide="file-text" class="w-3 h-3"></i>
                        <span>Harian</span>
                      </button>
                    <% } else { %>
                      <span class="text-slate-300 text-[11px]">-</span>
