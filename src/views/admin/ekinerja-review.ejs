<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6"
      x-data="{
        activeTab: '<%= activeTab || 'pending' %>',
        reviewModal: false,
        deleteModal: false,
        selectedReport: null,
        activeDocType: 'harian',
        reviewAction: 'approve',
        nilaiHarian: 85,
        nilaiBulanan: 90,
        catatanAdmin: '',

        get currentPdfUrl() {
          if (!this.selectedReport) return '';
          return this.activeDocType === 'harian' ? this.selectedReport.fileHarianUrl : this.selectedReport.fileBulananUrl;
        },

        get currentPdfName() {
          if (!this.selectedReport) return '';
          return this.activeDocType === 'harian' ? (this.selectedReport.fileHarianName || 'Laporan-Harian.pdf') : (this.selectedReport.fileBulananName || 'Laporan-Bulanan.pdf');
        },

        openReview(item, defaultDoc = 'harian') {
          this.selectedReport = item;
          if (defaultDoc === 'harian' && !item.fileHarianUrl && item.fileBulananUrl) {
            this.activeDocType = 'bulanan';
          } else if (defaultDoc === 'bulanan' && !item.fileBulananUrl && item.fileHarianUrl) {
            this.activeDocType = 'harian';
          } else {
            this.activeDocType = defaultDoc;
          }
          this.reviewAction = (item.statusReview === 'REJECTED') ? 'reject' : 'approve';
          this.nilaiHarian = (item.nilaiHarian !== undefined && item.nilaiHarian !== null) ? item.nilaiHarian : 85;
          this.nilaiBulanan = (item.nilaiBulanan !== undefined && item.nilaiBulanan !== null) ? item.nilaiBulanan : 90;
          this.catatanAdmin = item.catatanAdmin || '';
          this.reviewModal = true;
        },

        openDelete(item) {
          this.selectedReport = item;
          this.deleteModal = true;
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider border border-indigo-100">Penilaian ASN</span>
        <span class="text-xs text-slate-400">Tim Penilai Korwil</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Review Laporan E-Kinerja</h1>
      <p class="text-xs sm:text-sm text-slate-500">Evaluasi dokumen PDF laporan pegawai, tetapkan nilai resmi, atau kirimkan alasan penolakan</p>
    </div>

    <!-- Status Counter -->
    <div class="flex items-center gap-2 text-xs">
      <div class="px-3.5 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 font-semibold flex items-center gap-2">
        <i data-lucide="clock" class="w-4 h-4 text-amber-600"></i>
        <span>Menunggu Review: <b><%= pendingCount %></b></span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-semibold flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
        <span>Disetujui: <b><%= approvedCount %></b></span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 font-semibold flex items-center gap-2">
        <i data-lucide="x-circle" class="w-4 h-4 text-rose-600"></i>
        <span>Ditolak: <b><%= rejectedCount %></b></span>
      </div>
    </div>
  </div>

  <!-- TABBED REVIEW & ARCHIVE QUEUE CARD -->
  <div class="custom-card p-5 sm:p-6 bg-white shadow-xs space-y-6">
    
    <!-- Tab Headers & Filter Toolbar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
      
      <!-- Tab Buttons -->
      <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-2xl w-full sm:w-auto">
        <button type="button" 
                @click="activeTab = 'pending'" 
                :class="activeTab === 'pending' ? 'bg-white text-indigo-600 shadow-sm font-bold' : 'text-slate-600 font-semibold hover:text-slate-900'"
                class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs transition-all">
          <i data-lucide="inbox" class="w-4 h-4"></i>
          <span>Antrean Menunggu</span>
          <span class="px-1.5 py-0.5 rounded-md text-[10px] <%= pendingCount > 0 ? 'bg-amber-100 text-amber-800 font-bold' : 'bg-slate-200 text-slate-600' %>">
            <%= pendingCount %>
          </span>
        </button>

        <button type="button" 
                @click="activeTab = 'history'" 
                :class="activeTab === 'history' ? 'bg-white text-indigo-600 shadow-sm font-bold' : 'text-slate-600 font-semibold hover:text-slate-900'"
                class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs transition-all">
          <i data-lucide="archive" class="w-4 h-4"></i>
          <span>Riwayat & Arsip Selesai</span>
          <span class="px-1.5 py-0.5 rounded-md text-[10px] bg-slate-200 text-slate-600">
            <%= approvedCount + rejectedCount %>
          </span>
        </button>
      </div>

      <!-- Unit Filter (Modern Searchable Dropdown) -->
      <form action="/admin/ekinerja-review" method="GET" class="flex items-center gap-2 relative"
            x-data="{
              open: false,
              search: '',
              selectedVal: '<%= filterUnit %>',
              options: <%= JSON.stringify(units.map(u => ({ value: u.id, label: u.namaUnit }))) %>,
              get filteredOptions() {
                if (!this.search) return this.options;
                return this.options.filter(o => o.label.toLowerCase().includes(this.search.toLowerCase()));
              },
              get selectedLabel() {
                const found = this.options.find(o => o.value === this.selectedVal);
                return found ? found.label : 'Semua Unit Kerja';
              },
              selectOption(val) {
                this.selectedVal = val;
                this.open = false;
                $refs.unitInput.value = val;
                $nextTick(() => { $refs.unitInput.closest('form').submit(); });
              }
            }"
            @click.away="open = false">
        <input type="hidden" name="tab" :value="activeTab">
        <input type="hidden" name="unit" x-ref="unitInput" :value="selectedVal">
        
        <button type="button" 
                @click="open = !open" 
                class="w-48 sm:w-60 flex items-center justify-between px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
          <span class="truncate pr-2" x-text="selectedLabel"></span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
        </button>

        <div x-show="open" 
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 translate-y-1 scale-98"
             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
             x-transition:leave-end="opacity-0 translate-y-1 scale-98"
             class="absolute right-0 top-full mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-1.5 min-w-[240px]"
             style="display: none;"
             @click.stop>
          
          <!-- Search input inside dropdown (Clean without icon, with X on far right) -->
          <div class="relative" style="position: relative;">
            <input type="text" 
                   x-model="search" 
                   placeholder="Ketik nama unit / sekolah..." 
                   class="w-full pl-3 pr-8 py-1.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50 text-slate-800 placeholder:text-slate-400"
                   @click.stop
                   @keydown.stop>
            <button type="button" 
                    x-show="search && search.length > 0" 
                    @click="search = ''" 
                    style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%);"
                    class="text-slate-400 hover:text-slate-600 p-1 flex items-center justify-center z-20">
              <i data-lucide="x" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <div class="max-h-[230px] overflow-y-auto custom-scrollbar space-y-0.5 pt-1">
            <template x-for="item in filteredOptions" :key="item.value">
              <button type="button" 
                      @click="selectOption(item.value)" 
                      class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                      :class="selectedVal === item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                <span class="truncate" x-text="item.label"></span>
                <i data-lucide="check" x-show="selectedVal === item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
              </button>
            </template>
            <div x-show="filteredOptions.length === 0" class="py-3 text-center text-xs text-slate-400">
              Tidak ada unit yang cocok
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- TAB 1: ANTREAN MENUNGGU REVIEW (ONLY PENDING) -->
    <div x-show="activeTab === 'pending'" class="space-y-4">
      
      <!-- Mobile View -->
      <div class="block lg:hidden space-y-4">
        <% if (pendingList.length === 0) { %>
          <div class="p-8 text-center text-slate-400">
            <i data-lucide="check-check" class="w-8 h-8 mx-auto text-emerald-500 mb-2"></i>
            <p class="font-bold text-slate-700 text-sm">Semua antrean laporan telah dinilai!</p>
          </div>
        <% } %>

        <% pendingList.forEach(function(item) { %>
          <div class="p-4 rounded-2xl border border-amber-200 bg-amber-50/20 space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-bold text-sm text-slate-900"><%= item.employee.nama %></h3>
                <p class="text-xs text-slate-500">NIP: <%= item.employee.nip %></p>
                <p class="text-[11px] text-indigo-600 font-medium"><%= item.employee.unitNama %></p>
              </div>
              <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                Menunggu
              </span>
            </div>

            <!-- PDF Badges -->
            <div class="p-3 rounded-xl bg-white border border-slate-200/80 space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Laporan Harian:</span>
                <% if (item.fileHarianUrl) { %>
                  <button type="button" @click="openReview(<%= JSON.stringify(item) %>, 'harian')" class="inline-flex items-center gap-1 text-indigo-600 font-bold hover:underline">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    <span class="truncate max-w-[140px]"><%= item.fileHarianName || 'Lihat & Nilai PDF' %></span>
                  </button>
                <% } else { %>
                  <span class="text-slate-300">-</span>
                <% } %>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Laporan Bulanan:</span>
                <% if (item.fileBulananUrl) { %>
                  <button type="button" @click="openReview(<%= JSON.stringify(item) %>, 'bulanan')" class="inline-flex items-center gap-1 text-emerald-600 font-bold hover:underline">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    <span class="truncate max-w-[140px]"><%= item.fileBulananName || 'Lihat & Nilai PDF' %></span>
                  </button>
                <% } else { %>
                  <span class="text-slate-300">-</span>
                <% } %>
              </div>
            </div>

            <!-- Mobile Action Button -->
            <div class="pt-2 border-t border-slate-200 flex items-center justify-between gap-2">
              <button @click="openDelete(<%= JSON.stringify(item) %>)" class="p-2 rounded-xl text-rose-600 hover:bg-rose-50 border border-rose-200" title="Hapus Laporan">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
              <button @click="openReview(<%= JSON.stringify(item) %>)" class="btn-primary py-2 px-4 text-xs gap-1.5 bg-emerald-600 hover:bg-emerald-700 shadow-emerald-200 flex-1 justify-center font-bold">
                <i data-lucide="award" class="w-3.5 h-3.5"></i>
                <span>Review & Beri Nilai</span>
              </button>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Desktop Table (100% Fit Width with Zero Horizontal Scroll) -->
      <div class="hidden lg:block w-full overflow-hidden">
        <table class="w-full text-left text-xs border-collapse table-auto">
          <thead class="bg-slate-100/80 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="px-3.5 py-3 w-[22%]">Pegawai & NIP</th>
              <th class="px-3 py-3 w-[16%]">Unit Kerja</th>
              <th class="px-2.5 py-3 text-center w-[9%]">Periode</th>
              <th class="px-3 py-3 text-center w-[20%]">Dokumen Laporan</th>
              <th class="px-2.5 py-3 text-center w-[12%]">Waktu Kirim</th>
              <th class="px-3.5 py-3 text-right w-[21%]">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (pendingList.length === 0) { %>
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500">
                  <i data-lucide="check-check" class="w-8 h-8 mx-auto text-emerald-500 mb-2"></i>
                  <p class="font-bold text-sm text-slate-700">Semua antrean laporan telah dinilai!</p>
                </td>
              </tr>
            <% } %>

            <% pendingList.forEach(function(item) { %>
              <tr class="hover:bg-amber-50/30 transition-colors">
                <td class="px-3.5 py-3 align-middle">
                  <div class="font-bold text-slate-900 text-xs leading-tight"><%= item.employee.nama %></div>
                  <div class="text-[11px] text-slate-400 mt-0.5">NIP: <%= item.employee.nip %></div>
                </td>

                <td class="px-3 py-3 text-slate-600 align-middle text-[11px] leading-tight">
                  <%= item.employee.unitNama %>
                </td>

                <td class="px-2.5 py-3 text-center font-semibold text-slate-800 align-middle whitespace-nowrap">
                  <%= item.bulan %> / <%= item.tahun %>
                </td>

                <!-- Laporan Badges (Clickable to open Review Modal) -->
                <td class="px-3 py-3 text-center align-middle whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    <% if (item.fileHarianUrl) { %>
                      <button type="button" @click="openReview(<%= JSON.stringify(item) %>, 'harian')" 
                              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold text-[11px] transition-colors" title="Lihat & Nilai Laporan Harian">
                        <i data-lucide="file-text" class="w-3 h-3"></i>
                        <span>Harian</span>
                      </button>
                    <% } else { %>
                      <span class="text-slate-300 text-[11px]">-</span>
                    <% } %>

                    <% if (item.fileBulananUrl) { %>
                      <button type="button" @click="openReview(<%= JSON.stringify(item) %>, 'bulanan')" 
                              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold text-[11px] transition-colors" title="Lihat & Nilai Laporan Bulanan">
                        <i data-lucide="file-text" class="w-3 h-3"></i>
                        <span>Bulanan</span>
                      </button>
                    <% } else { %>
                      <span class="text-slate-300 text-[11px]">-</span>
                    <% } %>
                  </div>
                </td>

                <td class="px-2.5 py-3 text-center text-slate-400 text-[10px] align-middle whitespace-nowrap">
                  <%= item.submittedAt || '-' %>
                </td>

                <!-- Main Action: Review & Beri Nilai -->
                <td class="px-3.5 py-3 text-right align-middle whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1.5">
                    <button @click="openReview(<%= JSON.stringify(item) %>)" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-colors flex items-center gap-1.5 shadow-xs" title="Buka Dokumen & Nilai Laporan">
                      <i data-lucide="award" class="w-3.5 h-3.5"></i>
                      <span>Review & Beri Nilai</span>
                    </button>
                    <button @click="openDelete(<%= JSON.stringify(item) %>)" class="p-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition-colors" title="Hapus Laporan">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </div>

    <!-- TAB 2: RIWAYAT & ARSIP SELESAI (APPROVED & REJECTED) -->
    <div x-show="activeTab === 'history'" class="space-y-4" style="display: none;">
      
      <!-- Desktop Archive Table -->
      <div class="hidden lg:block w-full overflow-hidden">
        <table class="w-full text-left text-xs border-collapse table-auto">
          <thead class="bg-slate-100/80 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="px-3.5 py-3 w-[20%]">Pegawai & NIP</th>
              <th class="px-3 py-3 w-[15%]">Unit Kerja</th>
              <th class="px-2.5 py-3 text-center w-[8%]">Periode</th>
              <th class="px-2.5 py-3 text-center w-[9%]">Status</th>
              <th class="px-3 py-3 text-center w-[16%]">Dokumen</th>
              <th class="px-2.5 py-3 text-center w-[11%]">Nilai</th>
              <th class="px-2.5 py-3 text-center w-[12%]">Reviewer</th>
              <th class="px-3 py-3 text-right w-[9%]">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (archiveList.length === 0) { %>
              <tr>
                <td colspan="8" class="py-12 text-center text-slate-500">
                  <i data-lucide="archive" class="w-8 h-8 mx-auto text-slate-300 mb-2"></i>
                  <p class="font-bold text-sm text-slate-700">Belum ada riwayat penilaian e-kinerja</p>
                </td>
              </tr>
            <% } %>

            <% archiveList.forEach(function(item) { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-3.5 py-3 align-middle">
                  <div class="font-bold text-slate-900 text-xs leading-tight"><%= item.employee.nama %></div>
                  <div class="text-[11px] text-slate-400 mt-0.5">NIP: <%= item.employee.nip %></div>
                </td>

                <td class="px-3 py-3 text-slate-600 align-middle text-[11px] leading-tight">
                  <%= item.employee.unitNama %>
                </td>

                <td class="px-2.5 py-3 text-center font-semibold text-slate-800 align-middle whitespace-nowrap">
                  <%= item.bulan %> / <%= item.tahun %>
                </td>

                <td class="px-2.5 py-3 text-center align-middle whitespace-nowrap">
                  <% if (item.statusReview === 'APPROVED') { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      Disetujui
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                      Ditolak
                    </span>
                  <% } %>
                </td>

                <!-- Dokumen Badges -->
                <td class="px-3 py-3 text-center align-middle whitespace-nowrap">
                  <div class="inline-flex items-center gap-1">
                    <% if (item.fileHarianUrl) { %>
                      <button type="button" @click="openReview(<%= JSON.stringify(item) %>, 'harian')" 
                              class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-semibold transition-colors" title="Lihat Laporan Harian">
                        <i data-lucide="file-text" class="w-3 h-3 text-indigo-500"></i>
                        <span>Harian</span>
                      </button>
                    <% } %>
                    <% if (item.fileBulananUrl) { %>
                      <button type="button" @click="openReview(<%= JSON.stringify(item) %>, 'bulanan')" 
                              class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-semibold transition-colors" title="Lihat Laporan Bulanan">
                        <i data-lucide="file-text" class="w-3 h-3 text-emerald-500"></i>
                        <span>Bulanan</span>
                      </button>
                    <% } %>
                  </div>
                </td>

                <!-- Nilai H / B -->
                <td class="px-2.5 py-3 text-center align-middle whitespace-nowrap">
                  <% if (item.statusReview === 'APPROVED') { %>
                    <span class="text-[11px] font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100">
                      H: <%= item.nilaiHarian !== undefined ? item.nilaiHarian : '-' %> | B: <%= item.nilaiBulanan !== undefined ? item.nilaiBulanan : '-' %>
                    </span>
                  <% } else { %>
                    <span class="text-rose-600 font-bold text-[10px] bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200" title="<%= item.catatanAdmin || 'Ditolak' %>">
                      Ditolak
                    </span>
                  <% } %>
                </td>

                <td class="px-2.5 py-3 text-center text-slate-500 text-[10px] align-middle whitespace-nowrap">
                  <div class="font-medium text-slate-700"><%= item.reviewedBy || 'Admin' %></div>
                  <div class="text-slate-400 text-[9px] mt-0.5"><%= item.reviewedAt || '-' %></div>
                </td>

                <td class="px-3 py-3 text-right align-middle whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1">
                    <button @click="openReview(<%= JSON.stringify(item) %>)" class="p-1.5 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-colors" title="Buka Detail Review & Edit">
                      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    </button>
                    <button @click="openDelete(<%= JSON.stringify(item) %>)" class="p-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition-colors" title="Hapus dari Riwayat">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </div>

  </div>

  <!-- ALPINE.JS MODAL 1: UNIFIED PDF PREVIEW & SCORING MODAL -->
  <div x-show="reviewModal" 
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/75 backdrop-blur-xs flex items-center justify-center p-2 sm:p-4"
       style="display: none;">
    
    <div @click.away="reviewModal = false"
         class="bg-white rounded-3xl max-w-5xl w-full p-4 sm:p-6 shadow-2xl border border-slate-100 space-y-4 flex flex-col max-h-[95vh]">
      
      <!-- Modal Header -->
      <template x-if="selectedReport">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-extrabold text-base text-slate-900 truncate" x-text="selectedReport.employee.nama"></h3>
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-indigo-50 text-indigo-700" x-text="'Periode ' + selectedReport.bulan + '/' + selectedReport.tahun"></span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5 truncate" x-text="'NIP: ' + selectedReport.employee.nip + ' • ' + selectedReport.employee.unitNama"></p>
          </div>

          <!-- Tab Switcher for Harian vs Bulanan Document -->
          <div class="flex items-center gap-2">
            <div class="flex items-center bg-slate-100 p-1 rounded-xl">
              <button type="button" 
                      @click="activeDocType = 'harian'" 
                      :class="activeDocType === 'harian' ? 'bg-white text-indigo-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                      class="px-3 py-1.5 rounded-lg text-xs flex items-center gap-1.5 transition-all">
                <i data-lucide="file-text" class="w-3.5 h-3.5 text-indigo-600"></i>
                <span>Lap. Harian</span>
              </button>
              <button type="button" 
                      @click="activeDocType = 'bulanan'" 
                      :class="activeDocType === 'bulanan' ? 'bg-white text-emerald-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                      class="px-3 py-1.5 rounded-lg text-xs flex items-center gap-1.5 transition-all">
                <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                <span>Lap. Bulanan</span>
              </button>
            </div>

            <!-- Quick Download & Full Tab Buttons -->
            <template x-if="currentPdfUrl">
              <div class="flex items-center gap-1.5">
                <a :href="currentPdfUrl" :download="currentPdfName" class="btn-secondary py-1.5 px-2.5 text-xs text-indigo-600 hover:text-indigo-700" title="Download PDF yang sedang dilihat">
                  <i data-lucide="download" class="w-3.5 h-3.5"></i>
                </a>
                <a :href="currentPdfUrl" target="_blank" class="btn-secondary py-1.5 px-2.5 text-xs text-slate-600 hover:text-slate-800" title="Buka di Tab Baru Penuh">
                  <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                </a>
              </div>
            </template>

            <button @click="reviewModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>
        </div>
      </template>

      <!-- Modal Body: PDF Viewer (Top) + Review & Scoring Controls (Bottom) -->
      <div class="flex-1 overflow-y-auto space-y-4 pr-0.5 custom-scrollbar">
        
        <!-- PDF Document Iframe Viewer -->
        <div class="w-full bg-slate-100 rounded-2xl overflow-hidden min-h-[42vh] max-h-[50vh] border border-slate-200 relative flex items-center justify-center">
          <template x-if="currentPdfUrl">
            <iframe :src="currentPdfUrl" class="w-full h-full min-h-[42vh] rounded-2xl border-0" allowfullscreen></iframe>
          </template>
          <template x-if="!currentPdfUrl">
            <div class="p-8 text-center text-slate-400">
              <i data-lucide="file-x" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
              <p class="font-bold text-sm text-slate-600">Dokumen PDF belum diunggah untuk bagian ini</p>
              <p class="text-xs text-slate-400 mt-0.5">Pegawai belum mengunggah berkas untuk kategori laporan ini.</p>
            </div>
          </template>
        </div>

        <!-- Integrated Scoring & Decision Form -->
        <template x-if="selectedReport">
          <form :action="'/admin/ekinerja-review/' + selectedReport.id + '/review?tab=' + activeTab" method="POST" class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3.5">
            <input type="hidden" name="statusReview" :value="reviewAction === 'approve' ? 'APPROVED' : 'REJECTED'">

            <!-- Decision Switcher (Beri Nilai & Setujui vs Tolak) -->
            <div class="flex items-center justify-between gap-3 pb-3 border-b border-slate-200/60">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Keputusan Admin:</span>
                <div class="inline-flex rounded-xl p-1 bg-slate-200/80">
                  <button type="button" 
                          @click="reviewAction = 'approve'" 
                          :class="reviewAction === 'approve' ? 'bg-emerald-600 text-white font-bold shadow-xs' : 'text-slate-700 hover:text-slate-900 font-semibold'"
                          class="px-3 py-1 rounded-lg text-xs flex items-center gap-1.5 transition-all">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    <span>Setujui & Beri Nilai</span>
                  </button>
                  <button type="button" 
                          @click="reviewAction = 'reject'" 
                          :class="reviewAction === 'reject' ? 'bg-rose-600 text-white font-bold shadow-xs' : 'text-slate-700 hover:text-slate-900 font-semibold'"
                          class="px-3 py-1 rounded-lg text-xs flex items-center gap-1.5 transition-all">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    <span>Tolak Laporan</span>
                  </button>
                </div>
              </div>

              <div class="hidden sm:block text-right">
                <span class="text-[11px] text-slate-400">Hasil penilaian akan otomatis tercatat ke rekap pegawai</span>
              </div>
            </div>

            <!-- SECTION A: APPROVED -> INPUT 2 SCORES -->
            <div x-show="reviewAction === 'approve'" class="space-y-3">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 rounded-2xl bg-emerald-50/60 border border-emerald-200">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">Nilai Laporan Harian (0–100) *</label>
                  <input type="number" step="0.1" min="0" max="100" name="nilaiHarian" x-model="nilaiHarian" :required="reviewAction === 'approve'" class="form-input text-sm font-extrabold text-center text-emerald-800 bg-white">
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">Nilai Laporan Bulanan (0–100) *</label>
                  <input type="number" step="0.1" min="0" max="100" name="nilaiBulanan" x-model="nilaiBulanan" :required="reviewAction === 'approve'" class="form-input text-sm font-extrabold text-center text-emerald-800 bg-white">
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Catatan Evaluasi Penilai (Opsional)</label>
                <input type="text" name="catatanAdmin" x-model="catatanAdmin" placeholder="Contoh: Laporan kinerja lengkap dan disetujui..." class="form-input text-xs">
              </div>
            </div>

            <!-- SECTION B: REJECTED -> MANDATORY REJECTION REASON -->
            <div x-show="reviewAction === 'reject'" class="space-y-3" style="display: none;">
              <div class="p-3 rounded-2xl bg-rose-50 border border-rose-200 text-[11px] text-rose-800">
                <p class="font-bold flex items-center gap-1 text-rose-700">
                  <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                  <span>Alasan Penolakan Wajib Diisi:</span>
                </p>
                <p class="mt-0.5">Pegawai akan melihat alasan ini untuk segera mengunggah revisi dokumen laporan kinerja.</p>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Alasan Penolakan / Catatan Perbaikan *
                </label>
                <textarea name="catatanAdmin" rows="2" x-model="catatanAdmin" :required="reviewAction === 'reject'" class="form-input text-xs" placeholder="Contoh: Dokumen laporan bulanan belum ditandatangani Kepala Sekolah / Lampiran tidak jelas..."></textarea>
              </div>
            </div>

            <!-- Modal Action Submit Buttons -->
            <div class="pt-2 flex items-center justify-end gap-2.5">
              <button type="button" @click="reviewModal = false" class="btn-secondary py-2 px-4 text-xs">
                Tutup
              </button>
              <button type="submit" 
                      :class="reviewAction === 'approve' ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-200' : 'bg-rose-600 hover:bg-rose-700 text-white shadow-rose-200'"
                      class="btn-primary py-2 px-5 text-xs font-bold gap-2">
                <i :data-lucide="reviewAction === 'approve' ? 'check-circle' : 'x-circle'" class="w-4 h-4"></i>
                <span x-text="reviewAction === 'approve' ? 'Simpan Nilai & Setujui' : 'Konfirmasi Tolak Laporan'"></span>
              </button>
            </div>

          </form>
        </template>

      </div>

    </div>
  </div>

  <!-- ALPINE.JS MODAL 2: DELETE CONFIRMATION -->
  <div x-show="deleteModal" 
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
       style="display: none;">
    
    <div @click.away="deleteModal = false"
         class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
      
      <div class="flex items-center gap-2.5 text-rose-600 pb-3 border-b border-slate-100">
        <i data-lucide="trash-2" class="w-5 h-5"></i>
        <h3 class="font-bold text-base text-slate-900">Hapus Laporan E-Kinerja</h3>
      </div>

      <template x-if="selectedReport">
        <form :action="'/admin/ekinerja-review/' + selectedReport.id + '/delete?tab=' + activeTab" method="POST" class="space-y-3">
          <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-xs space-y-1">
            <p class="font-bold text-slate-900" x-text="selectedReport.employee.nama"></p>
            <p class="text-slate-600" x-text="'Periode: ' + selectedReport.bulan + '/' + selectedReport.tahun"></p>
            <p class="text-rose-700 text-[11px] font-semibold mt-1">
              ⚠️ Peringatan: Menghapus laporan ini akan menghapus data pengajuan dan penilaian dari sistem.
            </p>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2">
            <button type="button" @click="deleteModal = false" class="btn-secondary py-2 px-3.5 text-xs">
              Batal
            </button>
            <button type="submit" class="btn-danger py-2 px-4 text-xs font-bold">
              Ya, Hapus Sekarang
            </button>
          </div>
        </form>
      </template>

    </div>
  </div>

</main>

<%- include('../partials/admin-footer') %>
