<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full space-y-6"
      x-data="{
        selectedFiles: [],
        selectAll: false,
        uploadModal: false,
        renameModal: false,
        renameOldName: '',
        renameNewName: '',
        deleteModal: false,
        deleteTargetName: '',
        bulkDeleteModal: false,
        pdfModal: false,
        pdfUrl: '',
        pdfTitle: '',
        pdfFileName: '',

        toggleSelectAll(allNames) {
          if (this.selectAll) {
            this.selectedFiles = [...allNames];
          } else {
            this.selectedFiles = [];
          }
        },

        openPreview(url, title, filename) {
          this.pdfUrl = url;
          this.pdfTitle = title;
          this.pdfFileName = filename;
          this.pdfModal = true;
        },

        openRename(filename) {
          this.renameOldName = filename;
          this.renameNewName = filename;
          this.renameModal = true;
        },

        openDelete(filename) {
          this.deleteTargetName = filename;
          this.deleteModal = true;
        }
      }">

  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-200/80">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider rounded-md bg-rose-50 text-rose-700 border border-rose-200">
          Super Admin Only
        </span>
        <span class="text-xs text-slate-400">&bull; Master Data & CMS</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
        <i data-lucide="folder-archive" class="w-7 h-7 text-indigo-600"></i>
        <span>Manajemen Berkas Upload</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">
        Pusat kontrol dan arsip seluruh berkas fisik hasil upload (Laporan Kinerja, Bukti Klarifikasi, dan Rekap Absensi) di server VPS.
      </p>
    </div>

    <!-- Right Header Actions -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Upload Manual Button -->
      <button type="button" 
              @click="uploadModal = true"
              class="btn-primary py-2 px-3.5 text-xs gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs">
        <i data-lucide="upload-cloud" class="w-4 h-4"></i>
        <span>Upload Berkas</span>
      </button>

      <!-- Download All Full Backup -->
      <a href="/admin/files/download-all" 
         class="btn-secondary py-2 px-3.5 text-xs gap-1.5 text-slate-700 hover:text-indigo-600 hover:border-indigo-200 shadow-xs"
         title="Download seluruh berkas fisik di server dalam 1 arsip paket .tar.gz">
        <i data-lucide="archive" class="w-4 h-4 text-amber-500"></i>
        <span>Download Semua (Full Backup)</span>
      </a>
    </div>
  </div>

  <!-- Toast Notification -->
  <% if (toast) { %>
    <div class="p-4 rounded-2xl flex items-center justify-between gap-3 shadow-xs border <%= toast.type === 'success' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-rose-50 text-rose-800 border-rose-200' %>">
      <div class="flex items-center gap-2 text-sm font-semibold">
        <i data-lucide="<%= toast.type === 'success' ? 'check-circle-2' : 'alert-circle' %>" class="w-5 h-5 shrink-0"></i>
        <span><%= toast.message %></span>
      </div>
    </div>
  <% } %>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    <!-- Total Files -->
    <div class="card p-4 flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 shadow-2xs">
        <i data-lucide="files" class="w-5 h-5"></i>
      </div>
      <div class="min-w-0">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Berkas</p>
        <p class="text-xl font-black text-slate-900 mt-0.5"><%= stats.totalFiles %></p>
      </div>
    </div>

    <!-- Disk Storage Size -->
    <div class="card p-4 flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 shadow-2xs">
        <i data-lucide="hard-drive" class="w-5 h-5"></i>
      </div>
      <div class="min-w-0">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Ukuran Disk</p>
        <p class="text-xl font-black text-slate-900 mt-0.5"><%= stats.totalSizeFormatted %></p>
      </div>
    </div>

    <!-- Ekinerja Files -->
    <div class="card p-4 flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 shadow-2xs">
        <i data-lucide="file-check-2" class="w-5 h-5"></i>
      </div>
      <div class="min-w-0">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">E-Kinerja</p>
        <p class="text-xl font-black text-slate-900 mt-0.5"><%= stats.countEkinerja %></p>
      </div>
    </div>

    <!-- Klarifikasi Files -->
    <div class="card p-4 flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 shadow-2xs">
        <i data-lucide="file-text" class="w-5 h-5"></i>
      </div>
      <div class="min-w-0">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Klarifikasi</p>
        <p class="text-xl font-black text-slate-900 mt-0.5"><%= stats.countKlarifikasi %></p>
      </div>
    </div>

    <!-- Absensi Excel Files -->
    <div class="card p-4 flex items-center gap-3.5 col-span-2 sm:col-span-1">
      <div class="w-11 h-11 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0 shadow-2xs">
        <i data-lucide="file-spreadsheet" class="w-5 h-5"></i>
      </div>
      <div class="min-w-0">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Rekap Excel</p>
        <p class="text-xl font-black text-slate-900 mt-0.5"><%= stats.countAbsensi %></p>
      </div>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="card p-4 sm:p-5 space-y-4">
    <form method="GET" action="/admin/files" class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
      
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <i data-lucide="search" class="w-4 h-4"></i>
        </div>
        <input type="text" 
               name="search" 
               value="<%= filters.search %>"
               placeholder="Cari nama berkas, nama pegawai, unit kerja..." 
               class="w-full pl-10 pr-4 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-indigo-500 transition-all">
      </div>

      <!-- Filters Row -->
      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Kategori Filter -->
        <select name="kategori" 
                class="px-3 py-2 text-xs font-semibold rounded-xl border border-slate-200 bg-white text-slate-700 focus:outline-none focus:border-indigo-500 shadow-2xs">
          <option value="all" <%= filters.kategori === 'all' ? 'selected' : '' %>>Semua Kategori</option>
          <option value="ekinerja" <%= filters.kategori === 'ekinerja' ? 'selected' : '' %>>Laporan E-Kinerja</option>
          <option value="klarifikasi" <%= filters.kategori === 'klarifikasi' ? 'selected' : '' %>>Bukti Klarifikasi</option>
          <option value="absensi" <%= filters.kategori === 'absensi' ? 'selected' : '' %>>Rekap Absensi / Excel</option>
          <option value="lainnya" <%= filters.kategori === 'lainnya' ? 'selected' : '' %>>Lainnya</option>
        </select>

        <!-- Bulan Filter -->
        <select name="bulan" 
                class="px-3 py-2 text-xs font-semibold rounded-xl border border-slate-200 bg-white text-slate-700 focus:outline-none focus:border-indigo-500 shadow-2xs">
          <option value="0" <%= filters.bulan === 0 ? 'selected' : '' %>>Semua Bulan</option>
          <% const bulanArr = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember']; %>
          <% bulanArr.forEach((bName, idx) => { %>
            <option value="<%= idx + 1 %>" <%= filters.bulan === (idx + 1) ? 'selected' : '' %>><%= bName %></option>
          <% }); %>
        </select>

        <!-- Tahun Filter -->
        <select name="tahun" 
                class="px-3 py-2 text-xs font-semibold rounded-xl border border-slate-200 bg-white text-slate-700 focus:outline-none focus:border-indigo-500 shadow-2xs">
          <option value="0" <%= filters.tahun === 0 ? 'selected' : '' %>>Semua Tahun</option>
          <% const currentYr = new Date().getFullYear(); %>
          <% for (let y = currentYr; y >= currentYr - 3; y--) { %>
            <option value="<%= y %>" <%= filters.tahun === y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>

        <button type="submit" class="btn-primary py-2 px-3 text-xs gap-1.5 shadow-2xs">
          <i data-lucide="filter" class="w-3.5 h-3.5"></i>
          <span>Filter</span>
        </button>

        <% if (filters.search || filters.kategori !== 'all' || filters.bulan > 0 || filters.tahun > 0) { %>
          <a href="/admin/files" class="p-2 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100 transition-colors" title="Reset Filter">
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          </a>
        <% } %>
      </div>
    </form>

    <!-- Bulk Actions Floating Strip (Visible when files selected) -->
    <div x-show="selectedFiles.length > 0" 
         x-transition
         class="p-3 bg-indigo-50/90 border border-indigo-200 rounded-2xl flex flex-wrap items-center justify-between gap-3"
         style="display: none;">
      <div class="flex items-center gap-2 text-xs font-bold text-indigo-900">
        <i data-lucide="check-square" class="w-4 h-4 text-indigo-600"></i>
        <span x-text="`${selectedFiles.length} berkas dipilih`"></span>
      </div>

      <div class="flex items-center gap-2">
        <!-- Download Selected Form -->
        <form method="POST" action="/admin/files/download-selected" target="_blank" class="inline">
          <input type="hidden" name="filenames" :value="JSON.stringify(selectedFiles)">
          <button type="submit" class="btn-primary py-1.5 px-3 text-xs gap-1.5 bg-indigo-600 hover:bg-indigo-700 shadow-xs">
            <i data-lucide="download" class="w-3.5 h-3.5"></i>
            <span>Download Terpilih (ZIP)</span>
          </button>
        </form>

        <!-- Bulk Delete Button -->
        <button type="button" 
                @click="bulkDeleteModal = true"
                class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-rose-700 hover:bg-rose-50 hover:border-rose-300">
          <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-600"></i>
          <span>Hapus Terpilih</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Files Table Card -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="py-3 px-4 w-10 text-center">
              <input type="checkbox" 
                     x-model="selectAll" 
                     @change="toggleSelectAll(<%= JSON.stringify(files.map(f => f.filename)) %>)"
                     class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500/20 cursor-pointer">
            </th>
            <th class="py-3 px-4">Nama Berkas</th>
            <th class="py-3 px-4">Kategori</th>
            <th class="py-3 px-4">Terkait Pegawai / Unit</th>
            <th class="py-3 px-4">Ukuran</th>
            <th class="py-3 px-4">Waktu Modifikasi</th>
            <th class="py-3 px-4 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (files.length === 0) { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-slate-400">
                <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-300">
                  <i data-lucide="folder-open" class="w-6 h-6"></i>
                </div>
                <p class="font-semibold text-slate-600">Tidak ada berkas yang ditemukan</p>
                <p class="text-[11px] text-slate-400 mt-1">Coba sesuaikan kata kunci pencarian atau filter kategori Anda.</p>
              </td>
            </tr>
          <% } else { %>
            <% files.forEach(file => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                <!-- Checkbox -->
                <td class="py-3 px-4 text-center">
                  <input type="checkbox" 
                         value="<%= file.filename %>" 
                         x-model="selectedFiles"
                         class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500/20 cursor-pointer">
                </td>

                <!-- Filename & Icon -->
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 <%= file.ext === '.pdf' ? 'bg-rose-50 text-rose-600' : 'bg-teal-50 text-teal-600' %>">
                      <i data-lucide="<%= file.ext === '.pdf' ? 'file-text' : 'file-spreadsheet' %>" class="w-4 h-4"></i>
                    </div>
                    <div class="min-w-0 max-w-xs sm:max-w-md">
                      <p class="font-bold text-slate-800 truncate" title="<%= file.filename %>"><%= file.originalName %></p>
                      <p class="text-[10px] text-slate-400 truncate font-mono mt-0.5"><%= file.filename %></p>
                    </div>
                  </div>
                </td>

                <!-- Category Badge -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <span class="px-2.5 py-1 text-[10px] font-bold rounded-lg border <%= file.badgeColor %>">
                    <%= file.kategoriLabel %>
                  </span>
                </td>

                <!-- Associated Employee / Unit -->
                <td class="py-3 px-4">
                  <% if (file.pegawaiNama) { %>
                    <p class="font-bold text-slate-800 truncate max-w-[180px]"><%= file.pegawaiNama %></p>
                    <p class="text-[10px] text-slate-400 truncate max-w-[180px]"><%= file.unitNama || '-' %> <%= file.periode ? `(${file.periode})` : '' %></p>
                  <% } else { %>
                    <span class="text-slate-400 text-[11px]">-</span>
                  <% } %>
                </td>

                <!-- File Size -->
                <td class="py-3 px-4 whitespace-nowrap font-medium text-slate-700">
                  <%= file.sizeFormatted %>
                </td>

                <!-- Modification Time -->
                <td class="py-3 px-4 whitespace-nowrap text-[11px] text-slate-500">
                  <%= new Date(file.mtime).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
                </td>

                <!-- Action Buttons -->
                <td class="py-3 px-4 text-center whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    <!-- Preview Modal (Only for PDF) -->
                    <% if (file.ext === '.pdf') { %>
                      <button type="button" 
                              @click="openPreview('<%= file.url %>', '<%= file.originalName %>', '<%= file.filename %>')"
                              class="p-1.5 rounded-lg text-indigo-600 hover:bg-indigo-50 transition-colors"
                              title="Preview PDF">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                      </button>
                    <% } %>

                    <!-- Download Single -->
                    <a href="<%= file.url %>" 
                       download="<%= file.filename %>"
                       class="p-1.5 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 transition-colors"
                       title="Download Berkas">
                      <i data-lucide="download" class="w-4 h-4"></i>
                    </a>

                    <!-- Rename File -->
                    <button type="button" 
                            @click="openRename('<%= file.filename %>')"
                            class="p-1.5 rounded-lg text-amber-600 hover:bg-amber-50 transition-colors"
                            title="Ubah Nama Berkas">
                      <i data-lucide="edit-3" class="w-4 h-4"></i>
                    </button>

                    <!-- Delete File -->
                    <button type="button" 
                            @click="openDelete('<%= file.filename %>')"
                            class="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 transition-colors"
                            title="Hapus Berkas">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <% if (pagination.totalPages > 1) { %>
      <div class="px-4 py-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <p>Menampilkan <b><%= files.length %></b> dari <b><%= pagination.totalRecords %></b> berkas</p>
        <div class="flex items-center gap-1">
          <% if (pagination.hasPrevPage) { %>
            <a href="/admin/files?page=<%= pagination.currentPage - 1 %>&kategori=<%= filters.kategori %>&search=<%= filters.search %>&bulan=<%= filters.bulan %>&tahun=<%= filters.tahun %>"
               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold">
              Sebelumnya
            </a>
          <% } %>
          <span class="px-3 py-1.5 font-bold text-slate-800">
            Halaman <%= pagination.currentPage %> / <%= pagination.totalPages %>
          </span>
          <% if (pagination.hasNextPage) { %>
            <a href="/admin/files?page=<%= pagination.currentPage + 1 %>&kategori=<%= filters.kategori %>&search=<%= filters.search %>&bulan=<%= filters.bulan %>&tahun=<%= filters.tahun %>"
               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold">
              Selanjutnya
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- =========================================================
       MODAL 1: PREVIEW PDF (USING CERTIFIED h-[92vh] max-h-[92vh])
       ========================================================= -->
  <template x-teleport="body">
    <div x-show="pdfModal" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="pdfModal = false"
           class="bg-white rounded-3xl max-w-3xl w-full p-4 sm:p-5 shadow-2xl border border-slate-100 flex flex-col h-[92vh] max-h-[92vh]">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 shrink-0">
          <div class="flex items-center gap-2.5 min-w-0 pr-4">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
              <i data-lucide="file-text" class="w-5 h-5"></i>
            </div>
            <div class="min-w-0">
              <h3 class="font-bold text-sm sm:text-base text-slate-900 truncate" x-text="pdfTitle"></h3>
              <p class="text-[11px] text-slate-400 font-mono truncate" x-text="pdfFileName"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a :href="pdfUrl" :download="pdfFileName || 'dokumen.pdf'" class="btn-primary py-1.5 px-3 text-xs gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs" title="Unduh Berkas PDF">
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span class="hidden sm:inline">Download</span>
            </a>
            <a :href="pdfUrl" target="_blank" class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-slate-700 hover:text-slate-900" title="Buka Dokumen di Tab Baru">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
              <span class="hidden sm:inline">Tab Baru</span>
            </a>
            <button @click="pdfModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>
        </div>

        <!-- Inline PDF Viewer Container -->
        <div class="flex-1 w-full h-full bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 flex flex-col">
          <iframe :src="pdfUrl ? (pdfUrl.includes('#') ? pdfUrl : pdfUrl + '#toolbar=1&navpanes=0&view=FitH') : ''" 
                  class="w-full h-full flex-1 rounded-2xl border-0" 
                  allowfullscreen></iframe>
        </div>

        <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 shrink-0">
          <span class="text-slate-400">Gunakan Tab Baru jika ingin mencetak atau melihat layar penuh.</span>
          <button type="button" @click="pdfModal = false" class="btn-secondary py-2 px-4 text-xs font-semibold">
            Tutup
          </button>
        </div>

      </div>
    </div>
  </template>

  <!-- =========================================================
       MODAL 2: UPLOAD MANUAL BERKAS
       ========================================================= -->
  <template x-teleport="body">
    <div x-show="uploadModal" 
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="uploadModal = false"
           class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 space-y-5">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <i data-lucide="upload-cloud" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="font-bold text-base text-slate-900">Upload Berkas ke Server</h3>
              <p class="text-xs text-slate-400">Unggah berkas fisik langsung ke direktori public/uploads</p>
            </div>
          </div>
          <button @click="uploadModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>

        <form method="POST" action="/admin/files/upload" enctype="multipart/form-data" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">
              Pilih Berkas (PDF / Excel / CSV)
            </label>
            <input type="file" 
                   name="files" 
                   multiple 
                   required
                   class="w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 border border-slate-200 rounded-2xl p-2 bg-slate-50">
            <p class="text-[11px] text-slate-400 mt-1.5">Maksimal 15MB per berkas. Bisa memilih beberapa berkas sekaligus.</p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" @click="uploadModal = false" class="btn-secondary py-2 px-4 text-xs font-semibold">
              Batal
            </button>
            <button type="submit" class="btn-primary py-2 px-4 text-xs font-semibold gap-1.5">
              <i data-lucide="upload" class="w-3.5 h-3.5"></i>
              <span>Mulai Unggah</span>
            </button>
          </div>
        </form>

      </div>
    </div>
  </template>

  <!-- =========================================================
       MODAL 3: RENAME BERKAS
       ========================================================= -->
  <template x-teleport="body">
    <div x-show="renameModal" 
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="renameModal = false"
           class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-5">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
              <i data-lucide="edit-3" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="font-bold text-base text-slate-900">Ubah Nama Berkas</h3>
              <p class="text-xs text-slate-400">Ganti nama file fisik di server VPS</p>
            </div>
          </div>
          <button @click="renameModal = false" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>

        <form method="POST" action="/admin/files/rename" class="space-y-4">
          <input type="hidden" name="oldFilename" :value="renameOldName">

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Nama Lama</label>
            <p class="text-xs font-mono text-slate-600 bg-slate-100 p-2.5 rounded-xl break-all" x-text="renameOldName"></p>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Nama Baru</label>
            <input type="text" 
                   name="newFilename" 
                   x-model="renameNewName" 
                   required
                   class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 font-mono">
            <p class="text-[11px] text-slate-400 mt-1">Ekstensi file (.pdf, .xlsx) akan tetap dipertahankan secara otomatis.</p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" @click="renameModal = false" class="btn-secondary py-2 px-4 text-xs font-semibold">
              Batal
            </button>
            <button type="submit" class="btn-primary py-2 px-4 text-xs font-semibold gap-1.5 bg-amber-600 hover:bg-amber-700">
              <i data-lucide="check" class="w-3.5 h-3.5"></i>
              <span>Simpan Nama Baru</span>
            </button>
          </div>
        </form>

      </div>
    </div>
  </template>

  <!-- =========================================================
       MODAL 4: HAPUS BERKAS SATUAN
       ========================================================= -->
  <template x-teleport="body">
    <div x-show="deleteModal" 
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="deleteModal = false"
           class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-5">
        
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
            <i data-lucide="alert-triangle" class="w-6 h-6"></i>
          </div>
          <div>
            <h3 class="font-bold text-base text-slate-900">Konfirmasi Hapus Berkas</h3>
            <p class="text-xs text-slate-400 mt-0.5">Tindakan ini tidak dapat dibatalkan</p>
          </div>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed">
          Apakah Anda yakin ingin menghapus berkas fisik <b class="text-slate-900 font-mono break-all" x-text="deleteTargetName"></b> dari server? Jika berkas ini terkait laporan e-kinerja atau klarifikasi, tautan berkas di database juga akan dibersihkan.
        </p>

        <form method="POST" action="/admin/files/delete" class="pt-2 flex items-center justify-end gap-2">
          <input type="hidden" name="filename" :value="deleteTargetName">
          <button type="button" @click="deleteModal = false" class="btn-secondary py-2 px-4 text-xs font-semibold">
            Batal
          </button>
          <button type="submit" class="btn-primary py-2 px-4 text-xs font-semibold bg-rose-600 hover:bg-rose-700 gap-1.5 shadow-xs">
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            <span>Ya, Hapus Berkas</span>
          </button>
        </form>

      </div>
    </div>
  </template>

  <!-- =========================================================
       MODAL 5: HAPUS BERKAS MASSAL (BULK DELETE)
       ========================================================= -->
  <template x-teleport="body">
    <div x-show="bulkDeleteModal" 
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
      
      <div @click.away="bulkDeleteModal = false"
           class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-5">
        
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
            <i data-lucide="trash-2" class="w-6 h-6"></i>
          </div>
          <div>
            <h3 class="font-bold text-base text-slate-900">Hapus Berkas Terpilih</h3>
            <p class="text-xs text-slate-400 mt-0.5">Penghapusan massal beberapa berkas</p>
          </div>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed">
          Apakah Anda yakin ingin menghapus sebanyak <b class="text-rose-600 font-bold" x-text="selectedFiles.length"></b> berkas fisik terpilih secara permanen dari server?
        </p>

        <form method="POST" action="/admin/files/bulk-delete" class="pt-2 flex items-center justify-end gap-2">
          <input type="hidden" name="filenames" :value="JSON.stringify(selectedFiles)">
          <button type="button" @click="bulkDeleteModal = false" class="btn-secondary py-2 px-4 text-xs font-semibold">
            Batal
          </button>
          <button type="submit" class="btn-primary py-2 px-4 text-xs font-semibold bg-rose-600 hover:bg-rose-700 gap-1.5 shadow-xs">
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            <span>Hapus Semua Terpilih</span>
          </button>
        </form>

      </div>
    </div>
  </template>

</main>

<%- include('../partials/admin-footer') %>
