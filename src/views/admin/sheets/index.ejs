<%- include('../../partials/head') %>
<%- include('../../partials/admin-nav') %>
<%- include('../../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">
          Modul Spreadsheet Dinamis
        </span>
        <span class="text-xs text-slate-400">• Multi-Tenant & Paralel</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Spreadsheet Builder</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        Buat format lembar kerja mirip Google Sheet / Excel untuk pengisian data massal, paralel per unit sekolah, atau terproteksi NIP.
      </p>
    </div>

    <div class="flex items-center gap-2.5">
      <a href="/admin/sheets/create" class="btn-primary bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 px-4 text-xs font-bold gap-2 shadow-sm rounded-xl">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Buat Spreadsheet Baru</span>
      </a>
    </div>
  </div>

  <!-- Stats Overview -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Sheet</div>
      <div class="text-2xl font-extrabold text-slate-900 mt-1"><%= sheets.length %></div>
      <div class="text-[11px] text-slate-500 mt-0.5">Spreadsheet terdaftar</div>
    </div>
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Status Aktif</div>
      <div class="text-2xl font-extrabold text-emerald-600 mt-1">
        <%= sheets.filter(s => s.status === 'ACTIVE').length %>
      </div>
      <div class="text-[11px] text-emerald-700/80 mt-0.5">Menerima pengisian</div>
    </div>
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Target Sekolah</div>
      <div class="text-2xl font-extrabold text-indigo-600 mt-1">
        <%= sheets.filter(s => s.targetType === 'UNIT').length %>
      </div>
      <div class="text-[11px] text-indigo-700/80 mt-0.5">Per-unit kerja sekolah</div>
    </div>
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Target Pegawai</div>
      <div class="text-2xl font-extrabold text-amber-600 mt-1">
        <%= sheets.filter(s => s.targetType === 'PEGAWAI').length %>
      </div>
      <div class="text-[11px] text-amber-700/80 mt-0.5">Proteksi NIP per baris</div>
    </div>
  </div>

  <!-- Sheets Grid List -->
  <% if (sheets.length === 0) { %>
    <div class="custom-card p-12 text-center bg-white border border-slate-200/80 rounded-3xl shadow-2xs space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto border border-emerald-100 shadow-2xs">
        <i data-lucide="table" class="w-8 h-8"></i>
      </div>
      <div class="max-w-md mx-auto space-y-1.5">
        <h3 class="text-base font-bold text-slate-900">Belum Ada Spreadsheet</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Mulai buat template spreadsheet online untuk menghimpun data sekolah atau seluruh pegawai tanpa ribet mengirim file Excel terpisah.
        </p>
      </div>
      <a href="/admin/sheets/create" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-700 transition shadow-sm">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Buat Spreadsheet Sekarang</span>
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <% sheets.forEach(sheet => { %>
        <% const cols = Array.isArray(sheet.columns) ? sheet.columns : [] %>
        <div class="custom-card bg-white border border-slate-200/80 rounded-3xl shadow-2xs p-5 sm:p-6 flex flex-col justify-between hover:shadow-md transition-all space-y-4">
          
          <!-- Card Header -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <!-- Target Type Badge -->
              <% if (sheet.targetType === 'UNIT') { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-700 font-bold text-[10px]">
                  <i data-lucide="school" class="w-3 h-3"></i>
                  <span>Per Unit Sekolah</span>
                </span>
              <% } else if (sheet.targetType === 'PEGAWAI') { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 font-bold text-[10px]">
                  <i data-lucide="users" class="w-3 h-3"></i>
                  <span>Per Pegawai</span>
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px]">
                  <i data-lucide="table" class="w-3 h-3"></i>
                  <span>Tabel Bebas</span>
                </span>
              <% } %>

              <!-- Status Pill -->
              <% if (sheet.status === 'ACTIVE') { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px] border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>Dibuka</span>
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 font-extrabold text-[10px] border border-rose-200">
                  <span>Ditutup</span>
                </span>
              <% } %>
            </div>

            <!-- Title & Description -->
            <div>
              <h2 class="text-base font-extrabold text-slate-900 tracking-tight line-clamp-1">
                <%= sheet.title %>
              </h2>
              <p class="text-xs text-slate-500 line-clamp-2 mt-1 min-h-[32px]">
                <%= sheet.description || 'Tidak ada keterangan khusus.' %>
              </p>
            </div>

            <!-- Access Mode Info Pill -->
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-medium">Akses Pengisian:</span>
              <% if (sheet.accessMode === 'PROTECTED_NIP') { %>
                <span class="font-bold text-amber-700 flex items-center gap-1">
                  <i data-lucide="lock" class="w-3 h-3"></i> Proteksi NIP
                </span>
              <% } else if (sheet.accessMode === 'OPEN_EDIT') { %>
                <span class="font-bold text-teal-700 flex items-center gap-1">
                  <i data-lucide="edit-3" class="w-3 h-3"></i> Edit Bebas
                </span>
              <% } else { %>
                <span class="font-bold text-slate-700 flex items-center gap-1">
                  <i data-lucide="eye" class="w-3 h-3"></i> Hanya Lihat
                </span>
              <% } %>
            </div>

            <!-- Metadata Stats -->
            <div class="grid grid-cols-2 gap-2 text-center text-xs pt-1">
              <div class="p-2 bg-slate-50 rounded-xl border border-slate-100">
                <div class="text-[10px] font-bold text-slate-400 uppercase">Jumlah Baris</div>
                <div class="font-mono font-extrabold text-slate-900 mt-0.5"><%= sheet._count.rows %> Baris</div>
              </div>
              <div class="p-2 bg-slate-50 rounded-xl border border-slate-100">
                <div class="text-[10px] font-bold text-slate-400 uppercase">Kolom Khusus</div>
                <div class="font-mono font-extrabold text-slate-900 mt-0.5"><%= cols.length %> Kolom</div>
              </div>
            </div>
          </div>

          <!-- Card Actions -->
          <div class="pt-3 border-t border-slate-100 space-y-2">
            <div class="flex items-center gap-2">
              <a href="/admin/sheets/<%= sheet.id %>/manage" 
                 class="btn-primary flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2 text-xs font-bold gap-1.5 rounded-xl shadow-2xs text-center justify-center">
                <i data-lucide="table" class="w-3.5 h-3.5"></i>
                <span>Buka & Kelola Grid</span>
              </a>
              <a href="/sheet/<%= sheet.slug %>" target="_blank"
                 title="Buka Tampilan Publik di Tab Baru"
                 class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition cursor-pointer">
                <i data-lucide="external-link" class="w-4 h-4"></i>
              </a>
              <a href="/admin/sheets/<%= sheet.id %>/export" 
                 title="Unduh Rekap Excel (.xlsx)"
                 class="p-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition cursor-pointer">
                <i data-lucide="download" class="w-4 h-4"></i>
              </a>
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
              <a href="/admin/sheets/<%= sheet.id %>/edit" class="text-slate-500 hover:text-indigo-600 font-semibold flex items-center gap-1">
                <i data-lucide="settings" class="w-3.5 h-3.5"></i>
                <span>Pengaturan</span>
              </a>

              <div class="flex items-center gap-3">
                <form action="/admin/sheets/<%= sheet.id %>/toggle-status" method="POST" class="inline">
                  <button type="submit" class="text-xs font-bold transition cursor-pointer <%= sheet.status === 'ACTIVE' ? 'text-amber-600 hover:text-amber-700' : 'text-emerald-600 hover:text-emerald-700' %>">
                    <%= sheet.status === 'ACTIVE' ? 'Tutup Sheet' : 'Buka Sheet' %>
                  </button>
                </form>

                <form action="/admin/sheets/<%= sheet.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus spreadsheet ini beserta seluruh data barisnya?')">
                  <button type="submit" class="text-rose-500 hover:text-rose-700 font-semibold transition cursor-pointer">
                    Hapus
                  </button>
                </form>
              </div>
            </div>
          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</main>

<%- include('../../partials/admin-footer') %>
