<%- include('../../partials/head') %>
<%- include('../../partials/admin-nav') %>
<%- include('../../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">
          Modul Spreadsheet Dinamis
        </span>
        <span class="text-xs text-slate-400">• Multi-Tenant & Paralel</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Spreadsheet Builder</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        Buat format lembar kerja mirip Google Sheet / Excel untuk pengisian data massal, paralel per unit sekolah, atau terproteksi NIP.
      </p>
    </div>

    <div class="flex items-center gap-2.5">
      <a href="/admin/sheets/create" class="btn-primary bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 px-4 text-xs font-bold gap-2 shadow-sm rounded-xl">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Buat Spreadsheet Baru</span>
      </a>
    </div>
  </div>

  <!-- Stats Overview -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Sheet</div>
      <div class="text-2xl font-extrabold text-slate-900 mt-1"><%= sheets.length %></div>
      <div class="text-[11px] text-slate-500 mt-0.5">Spreadsheet terdaftar</div>
    </div>
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Status Aktif</div>
      <div class="text-2xl font-extrabold text-emerald-600 mt-1">
        <%= sheets.filter(s => s.status === 'ACTIVE').length %>
      </div>
      <div class="text-[11px] text-emerald-700/80 mt-0.5">Menerima pengisian</div>
    </div>
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Target Sekolah</div>
      <div class="text-2xl font-extrabold text-indigo-600 mt-1">
        <%= sheets.filter(s => s.targetType === 'UNIT').length %>
      </div>
      <div class="text-[11px] text-indigo-700/80 mt-0.5">Per-unit kerja sekolah</div>
    </div>
    <div class="custom-card p-4 bg-white border border-slate-200/80 rounded-2xl shadow-2xs">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Target Pegawai</div>
      <div class="text-2xl font-extrabold text-amber-600 mt-1">
        <%= sheets.filter(s => s.targetType === 'PEGAWAI').length %>
      </div>
      <div class="text-[11px] text-amber-700/80 mt-0.5">Proteksi NIP per baris</div>
    </div>
  </div>

  <!-- Sheets Grid List -->
  <% if (sheets.length === 0) { %>
    <div class="custom-card p-12 text-center bg-white border border-slate-200/80 rounded-3xl shadow-2xs space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto border border-emerald-100 shadow-2xs">
        <i data-lucide="table" class="w-8 h-8"></i>
      </div>
      <div class="max-w-md mx-auto space-y-1.5">
        <h3 class="text-base font-bold text-slate-900">Belum Ada Spreadsheet</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Mulai buat template spreadsheet online untuk menghimpun data sekolah atau seluruh pegawai tanpa ribet mengirim file Excel terpisah.
        </p>
      </div>
      <a href="/admin/sheets/create" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-700 transition shadow-sm">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Buat Spreadsheet Sekarang</span>
      </a>
    </div>
  <% } else { %>
    <div class="space-y-3" x-data="{
      copiedSlug: null,
      copyLink(slug) {
        const url = window.location.origin + '/sheet/' + slug;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(() => {
            this.copiedSlug = slug;
            setTimeout(() => { if (this.copiedSlug === slug) this.copiedSlug = null; }, 2000);
          }).catch(() => {
            prompt('Salin link spreadsheet publik berikut:', url);
          });
        } else {
          prompt('Salin link spreadsheet publik berikut:', url);
        }
      }
    }">
      <% sheets.forEach(sheet => { %>
        <% const cols = Array.isArray(sheet.columns) ? sheet.columns : [] %>
        <div class="custom-card bg-white border border-slate-200/90 hover:border-indigo-300 rounded-2xl shadow-2xs hover:shadow-xs transition-all p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Info Column -->
          <div class="flex items-start gap-3.5 min-w-0 flex-1">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 mt-0.5 <%= sheet.status === 'ACTIVE' ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' : 'bg-slate-100 text-slate-500 border border-slate-200' %>">
              <i data-lucide="table" class="w-5 h-5"></i>
            </div>
            
            <div class="min-w-0 flex-1 space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-bold text-slate-900 text-sm sm:text-base tracking-tight truncate max-w-xl">
                  <%= sheet.title %>
                </h3>
                
                <!-- Status Badge -->
                <% if (sheet.status === 'ACTIVE') { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10.5px] border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Dibuka</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 font-extrabold text-[10.5px] border border-rose-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                    <span>Ditutup</span>
                  </span>
                <% } %>

                <!-- Target Type Badge -->
                <% if (sheet.targetType === 'UNIT') { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-indigo-50 border border-indigo-200 text-indigo-700 font-bold text-[10px]">
                    <i data-lucide="school" class="w-3 h-3"></i>
                    <span>Per Unit</span>
                  </span>
                <% } else if (sheet.targetType === 'PEGAWAI') { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-50 border border-amber-200 text-amber-800 font-bold text-[10px]">
                    <i data-lucide="users" class="w-3 h-3"></i>
                    <span>Per Pegawai</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 border border-slate-200 text-slate-600 font-bold text-[10px]">
                    <i data-lucide="layout-grid" class="w-3 h-3"></i>
                    <span>Tabel Bebas</span>
                  </span>
                <% } %>
              </div>

              <% if (sheet.description) { %>
                <p class="text-xs text-slate-500 line-clamp-1 max-w-2xl">
                  <%= sheet.description %>
                </p>
              <% } %>

              <!-- Meta specs row -->
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-400 font-medium pt-0.5">
                <span class="text-slate-600 font-mono font-bold"><%= sheet._count.rows %> Baris</span>
                <span>•</span>
                <span class="text-slate-600 font-mono font-bold"><%= cols.length %> Kolom</span>
                <span>•</span>
                <span>Slug: <span class="font-mono text-slate-600">/sheet/<%= sheet.slug %></span></span>
                <span>•</span>
                <span><%= new Date(sheet.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </div>
            </div>
          </div>

          <!-- Actions Group (Tombol Tutup, Buka Link, Salin Link, Kelola Grid, dll) -->
          <div class="flex flex-wrap items-center gap-2 pt-3 lg:pt-0 border-t lg:border-t-0 border-slate-100 shrink-0">
            <!-- 1. Tombol Tutup / Buka Sheet -->
            <form action="/admin/sheets/<%= sheet.id %>/toggle-status" method="POST" class="inline">
              <% if (sheet.status === 'ACTIVE') { %>
                <button type="submit" 
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200/90 transition shadow-2xs cursor-pointer"
                        title="Tutup lembar kerja agar tidak menerima perubahan data baru">
                  <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-600"></i>
                  <span>Tutup Sheet</span>
                </button>
              <% } else { %>
                <button type="submit" 
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/90 transition shadow-2xs cursor-pointer"
                        title="Buka kembali lembar kerja untuk menerima pengisian">
                  <i data-lucide="unlock" class="w-3.5 h-3.5 text-emerald-600"></i>
                  <span>Buka Sheet</span>
                </button>
              <% } %>
            </form>

            <!-- 2. Tombol Buka Link -->
            <a href="/sheet/<%= sheet.slug %>" target="_blank"
               class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 transition shadow-2xs cursor-pointer"
               title="Buka Tampilan Publik di Tab Baru">
              <i data-lucide="external-link" class="w-3.5 h-3.5 text-indigo-600"></i>
              <span>Buka Link</span>
            </a>

            <!-- 3. Tombol Salin Link -->
            <button type="button" 
                    @click="copyLink('<%= sheet.slug %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
                    :class="copiedSlug === '<%= sheet.slug %>' ? 'bg-emerald-50 text-emerald-700 border border-emerald-300' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200'"
                    title="Salin tautan formulir publik ke clipboard">
              <span x-show="copiedSlug === '<%= sheet.slug %>'" class="inline-flex items-center gap-1.5 text-emerald-700">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i>
                <span>Tersalin!</span>
              </span>
              <span x-show="copiedSlug !== '<%= sheet.slug %>'" class="inline-flex items-center gap-1.5">
                <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500"></i>
                <span>Salin Link</span>
              </span>
            </button>

            <!-- 4. Tombol Buka & Kelola Grid -->
            <a href="/admin/sheets/<%= sheet.id %>/manage" 
               class="btn-primary bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-3.5 text-xs font-bold gap-1.5 rounded-xl shadow-2xs">
              <i data-lucide="table" class="w-3.5 h-3.5"></i>
              <span>Kelola Grid</span>
            </a>

            <!-- Dropdown / Extra Action Buttons -->
            <div class="flex items-center gap-1 pl-1">
              <a href="/admin/sheets/<%= sheet.id %>/edit" 
                 class="p-2 rounded-xl text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition cursor-pointer"
                 title="Pengaturan Kolom & Builder">
                <i data-lucide="settings" class="w-4 h-4"></i>
              </a>

              <a href="/admin/sheets/<%= sheet.id %>/export" 
                 class="p-2 rounded-xl text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 transition cursor-pointer"
                 title="Unduh Rekap Excel (.xlsx)">
                <i data-lucide="download" class="w-4 h-4"></i>
              </a>

              <form action="/admin/sheets/<%= sheet.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus spreadsheet ini beserta seluruh data barisnya?')">
                <button type="submit" 
                        class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                        title="Hapus Spreadsheet">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </form>
            </div>

          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</main>

<%- include('../../partials/admin-footer') %>
