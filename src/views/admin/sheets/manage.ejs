  <!-- MODAL: Konfirmasi Hapus Baris -->
  <div x-show="showDeleteModal"
       x-cloak
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl space-y-4 text-center border border-slate-100"
         @click.away="showDeleteModal = false">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
        <i data-lucide="alert-triangle" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="font-extrabold text-slate-900 text-base">Hapus Baris Ini?</h3>
        <p class="text-xs text-slate-500 mt-1">
          Baris <b class="text-slate-800" x-text="rowToDelete?.label"></b> beserta seluruh data yang telah diisikan akan dihapus permanen.
        </p>
      </div>
      <div class="pt-2 flex items-center justify-center gap-2">
        <button type="button"
                @click="showDeleteModal = false"
                class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold text-xs">
          Batal
        </button>
        <button type="button"
                @click="submitDeleteRow()"
                :disabled="isSaving"
                class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-bold text-xs shadow-sm">
          Ya, Hapus Baris
        </button>
      </div>
    </div>
  </div>

</main>

<script>
  function adminSpreadsheetManager() {
    let config = { sheetId: '', slug: '', columns: [], initialRows: [] };
    try {
      const dataEl = document.getElementById('sheet-data');
      if (dataEl) {
        config = JSON.parse(dataEl.textContent);
      }
    } catch (e) {
      console.error('Failed to parse sheet data:', e);
    }

    // Load columns and DB hidden status
    const initialColumns = (config.columns || []).map(c => ({
      ...c,
      hidden: !!c.hidden
    }));
    const dbHidden = initialColumns.filter(c => c.hidden).map(c => c.key);

    return {
      sheetId: config.sheetId,
      slug: config.slug,
      columns: initialColumns,
      showAllInAdmin: true,
      hiddenColKeys: dbHidden,
      rows: (config.initialRows || []).map(r => {
        let d = r.data;
        if (typeof d === 'string') {
          try { d = JSON.parse(d); } catch (e) { d = {}; }
        }
        return { ...r, data: d || {} };
      }),
      searchQuery: '',
      pageSize: '50',
      currentPage: 1,
      isSaving: false,
      saveStatus: '',
      showAddModal: false,
      showDeleteModal: false,
      showAddColModal: false,
      showDeleteColModal: false,
      rowToDelete: null,
      colToDelete: null,
      newRow: { label: '', identifier: '', subLabel: '' },
      newCol: { label: '', type: 'text', rawOptions: '' },

      init() {
        if (window.lucide) {
          this.$nextTick(() => window.lucide.createIcons());
        }
      },

      get allColumns() {
        return this.columns;
      },

      get visibleColumns() {
        if (this.showAllInAdmin) {
          return this.columns;
        }
        return this.columns.filter(c => !this.hiddenColKeys.includes(c.key));
      },

      get visibleColumnsCount() {
        return this.visibleColumns.length;
      },

      get publicColumnsCount() {
        return this.columns.filter(c => !this.hiddenColKeys.includes(c.key)).length;
      },

      isColumnVisible(key) {
        return !this.hiddenColKeys.includes(key);
      },

      async toggleColumnVisibility(key) {
        const col = this.columns.find(c => c.key === key);
        const colLabel = col ? col.label : key;

        if (this.hiddenColKeys.includes(key)) {
          this.hiddenColKeys = this.hiddenColKeys.filter(k => k !== key);
        } else {
          this.hiddenColKeys.push(key);
        }

        const isNowHidden = this.hiddenColKeys.includes(key);
        this.columns.forEach(c => {
          c.hidden = this.hiddenColKeys.includes(c.key);
        });

        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });

        await this.syncVisibilityToServer(colLabel, isNowHidden);
      },

      async hideColumn(key) {
        if (!this.hiddenColKeys.includes(key)) {
          await this.toggleColumnVisibility(key);
        }
      },

      async showAllColumns() {
        this.hiddenColKeys = [];
        this.columns.forEach(c => { c.hidden = false; });
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
        await this.syncVisibilityToServer('Semua kolom', false);
      },

      async syncVisibilityToServer(label = '', isHidden = false) {
        try {
          this.isSaving = true;
          this.saveStatus = 'Menyimpan visibilitas...';

          const res = await fetch(`/admin/sheets/${this.sheetId}/columns/visibility`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hiddenKeys: this.hiddenColKeys })
          });
          const result = await res.json();
          this.isSaving = false;

          if (result.success) {
            this.saveStatus = isHidden ? `Kolom '${label}' disembunyikan dari publik!` : `Kolom '${label}' ditampilkan ke publik!`;
            setTimeout(() => { this.saveStatus = ''; }, 3000);
          } else {
            this.saveStatus = 'Gagal menyimpan!';
            alert(result.message || 'Gagal menyimpan visibilitas kolom');
          }
        } catch (err) {
          this.isSaving = false;
          this.saveStatus = 'Error koneksi';
          console.error('[syncVisibilityToServer] Error:', err);
        }
      },

      isFieldDefinedInSheet(field) {
        const q = field.toLowerCase();
        return this.columns.some(c => (c.key && c.key.toLowerCase() === q) || (c.label && c.label.toLowerCase() === q));
      },

      hasCustomColumnFor(field) {
        return this.isFieldDefinedInSheet(field);
      },

      get filteredRows() {
        if (!this.searchQuery.trim()) return this.rows;
        const q = this.searchQuery.toLowerCase();
        return this.rows.filter(r => {
          if (r.label && r.label.toLowerCase().includes(q)) return true;
          if (r.identifier && r.identifier.toLowerCase().includes(q)) return true;
          if (r.subLabel && r.subLabel.toLowerCase().includes(q)) return true;
          const d = r.data || {};
          return Object.values(d).some(v => v !== null && v !== undefined && String(v).toLowerCase().includes(q));
        });
      },

      get totalPages() {
        if (this.pageSize === 'all') return 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return Math.max(1, Math.ceil(this.filteredRows.length / size));
      },

      get paginatedRows() {
        if (this.pageSize === 'all') return this.filteredRows;
        const size = parseInt(this.pageSize, 10) || 50;
        const start = (this.currentPage - 1) * size;
        return this.filteredRows.slice(start, start + size);
      },

      get startRowNumber() {
        if (this.filteredRows.length === 0) return 0;
        if (this.pageSize === 'all') return 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return (this.currentPage - 1) * size + 1;
      },

      get endRowNumber() {
        if (this.filteredRows.length === 0) return 0;
        if (this.pageSize === 'all') return this.filteredRows.length;
        const size = parseInt(this.pageSize, 10) || 50;
        return Math.min(this.currentPage * size, this.filteredRows.length);
      },

      getRowGlobalIndex(rowIdx) {
        if (this.pageSize === 'all') return rowIdx + 1;
        const size = parseInt(this.pageSize, 10) || 50;
        return (this.currentPage - 1) * size + rowIdx + 1;
      },

      goToPage(p) {
        if (p < 1) p = 1;
        if (p > this.totalPages) p = this.totalPages;
        this.currentPage = p;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      get filledCount() {
        return this.rows.filter(r => {
          const d = r.data || {};
          return this.columns.some(col => d[col.key] !== undefined && d[col.key] !== '' && d[col.key] !== null);
        }).length;
      },

      get fillPercentage() {
        if (this.rows.length === 0) return 0;
        return Math.round((this.filledCount / this.rows.length) * 100);
      },

      getCellValue(row, key) {
        if (row.data && row.data[key] !== undefined && row.data[key] !== null) {
          return row.data[key];
        }
        if (key === 'nama' || key === 'label') return row.label || '';
        if (key === 'nip' || key === 'identifier') return row.identifier || '';
        if (key === 'unitKerja' || key === 'subLabel') return row.subLabel || '';
        return '';
      },

      isRowFilled(row) {
        const d = row.data || {};
        return this.columns.some(col => {
          if (['nama', 'nip', 'unitKerja', 'label', 'identifier', 'subLabel'].includes(col.key)) return false;
          const val = d[col.key];
          return val !== undefined && val !== '' && val !== null && String(val).trim() !== '-';
        });
      },

      isCellFilled(row, colKey) {
        if (['nama', 'nip', 'unitKerja', 'label', 'identifier', 'subLabel'].includes(colKey)) {
          return false;
        }
        const val = this.getCellValue(row, colKey);
        if (val === undefined || val === null) return false;
        if (typeof val === 'boolean') return val;
        const str = String(val).trim();
        return str !== '' && str !== '-';
      },

      isRowComplete(row) {
        if (this.columns.length === 0) return false;
        const d = row.data || {};
        return this.columns.every(col => {
          const val = this.getCellValue(row, col.key);
          return val !== undefined && val !== '' && val !== null;
        });
      },

      formatDate(dateStr) {
        if (!dateStr) return '-';
        const d = new Date(dateStr);
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
      },

      async updateCell(row, key, value) {
        if (!row.data) row.data = {};
        row.data[key] = value;
        if (key === 'nama' || key === 'label') row.label = value;
        if (key === 'nip' || key === 'identifier') row.identifier = value;
        if (key === 'unitKerja' || key === 'subLabel') row.subLabel = value;
        await this.syncRowToServer(row);
      },

      async saveRowMeta(row) {
        await this.syncRowToServer(row);
      },

      async syncRowToServer(row) {
        this.isSaving = true;
        this.saveStatus = 'Menyimpan...';

        try {
          const res = await fetch(`/admin/sheets/${this.sheetId}/rows/${row.id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              label: row.label,
              identifier: row.identifier,
              subLabel: row.subLabel,
              data: row.data
            })
          });

          const result = await res.json();
          if (result.success) {
            row.lastUpdatedAt = new Date().toISOString();
            row.lastUpdatedBy = 'Admin';
            this.saveStatus = 'Tersimpan';
            setTimeout(() => { this.saveStatus = ''; }, 2000);
          } else {
            alert('Gagal menyimpan: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Error saving row:', err);
          alert('Terjadi kesalahan jaringan saat menyimpan.');
        } finally {
          this.isSaving = false;
        }
      },

      // --- COLUMN MANAGEMENT ---
      openAddColumnModal() {
        this.newCol = { label: '', type: 'text', rawOptions: '' };
        this.showAddColModal = true;
        this.$nextTick(() => window.lucide?.createIcons());
      },

      async submitAddColumn() {
        if (!this.newCol.label.trim()) return;
        this.isSaving = true;

        const options = this.newCol.type === 'select'
          ? (this.newCol.rawOptions ? this.newCol.rawOptions.split(',').map(s => s.trim()).filter(Boolean) : [])
          : [];

        try {
          const res = await fetch(`/admin/sheets/${this.sheetId}/columns`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              label: this.newCol.label.trim(),
              type: this.newCol.type,
              options: options
            })
          });

          const result = await res.json();
          if (result.success && result.columns) {
            this.columns = result.columns;
            this.showAddColModal = false;
            this.$nextTick(() => window.lucide?.createIcons());
          } else {
            alert('Gagal menambah kolom: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Add column error:', err);
          alert('Gagal menghubungi server.');
        } finally {
          this.isSaving = false;
        }
      },

      confirmDeleteColumn(col) {
        this.colToDelete = col;
        this.showDeleteColModal = true;
        this.$nextTick(() => window.lucide?.createIcons());
      },

      async submitDeleteColumn() {
        if (!this.colToDelete) return;
        this.isSaving = true;

        try {
          const res = await fetch(`/admin/sheets/${this.sheetId}/columns/${this.colToDelete.key}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const result = await res.json();
          if (result.success && result.columns) {
            this.columns = result.columns;
            this.hiddenColKeys = this.hiddenColKeys.filter(k => k !== this.colToDelete.key);
            this.showDeleteColModal = false;
            this.colToDelete = null;
            this.$nextTick(() => window.lucide?.createIcons());
          } else {
            alert('Gagal menghapus kolom: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Delete col error:', err);
          alert('Gagal menghubungi server.');
        } finally {
          this.isSaving = false;
        }
      },

      // --- ROW MANAGEMENT ---
      openAddRowModal() {
        this.newRow = { label: '', identifier: '', subLabel: '' };
        this.showAddModal = true;
        this.$nextTick(() => window.lucide?.createIcons());
      },

      async submitAddRow() {
        if (!this.newRow.label.trim()) return;
        this.isSaving = true;

        try {
          const res = await fetch(`/admin/sheets/${this.sheetId}/rows`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              label: this.newRow.label.trim(),
              identifier: this.newRow.identifier.trim(),
              subLabel: this.newRow.subLabel.trim(),
              data: {}
            })
          });

          const result = await res.json();
          if (result.success && result.row) {
            let d = result.row.data;
            if (typeof d === 'string') {
              try { d = JSON.parse(d); } catch (e) { d = {}; }
            }
            result.row.data = d || {};
            this.rows.push(result.row);
            this.showAddModal = false;
            this.$nextTick(() => window.lucide?.createIcons());
          } else {
            alert('Gagal menambah baris: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Add row error:', err);
          alert('Gagal menghubungi server.');
        } finally {
          this.isSaving = false;
        }
      },

      confirmDeleteRow(row) {
        this.rowToDelete = row;
        this.showDeleteModal = true;
        this.$nextTick(() => window.lucide?.createIcons());
      },

      async submitDeleteRow() {
        if (!this.rowToDelete) return;
        this.isSaving = true;

        try {
          const res = await fetch(`/admin/sheets/${this.sheetId}/rows/${this.rowToDelete.id}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const result = await res.json();
          if (result.success) {
            this.rows = this.rows.filter(r => r.id !== this.rowToDelete.id);
            this.showDeleteModal = false;
            this.rowToDelete = null;
          } else {
            alert('Gagal menghapus baris: ' + (result.message || 'Kesalahan server'));
          }
        } catch (err) {
          console.error('Delete row error:', err);
          alert('Gagal menghubungi server.');
        } finally {
          this.isSaving = false;
        }
      },

      // Handle Excel paste (Ctrl+V) directly into the grid
      async handleGridPaste(event) {
        const clipboard = (event.clipboardData || window.clipboardData).getData('text');
        if (!clipboard || !clipboard.includes('\t') && !clipboard.includes('\n')) {
          return;
        }

        event.preventDefault();

        const targetTd = event.target.closest('td[data-col-key]');
        if (!targetTd) return;

        const startRowId = targetTd.getAttribute('data-row-id');
        const startColKey = targetTd.getAttribute('data-col-key');

        const startRowIndex = this.filteredRows.findIndex(r => r.id === startRowId);
        const startColIndex = this.visibleColumns.findIndex(c => c.key === startColKey);

        if (startRowIndex === -1 || startColIndex === -1) return;

        const pasteRows = clipboard.split(/\r?\n/).filter(line => line.trim().length > 0);
        const updates = [];

        for (let rIdx = 0; rIdx < pasteRows.length; rIdx++) {
          const targetRow = this.filteredRows[startRowIndex + rIdx];
          if (!targetRow) break;

          const cellValues = pasteRows[rIdx].split('\t');
          if (!targetRow.data) targetRow.data = {};

          for (let cIdx = 0; cIdx < cellValues.length; cIdx++) {
            const targetCol = this.visibleColumns[startColIndex + cIdx];
            if (!targetCol) break;

            let val = cellValues[cIdx].trim();
            if (targetCol.type === 'number' || targetCol.type === 'currency') {
              val = val === '' ? null : Number(val.replace(/[^0-9.-]+/g,""));
            } else if (targetCol.type === 'checkbox') {
              val = ['true', '1', 'ya', 'yes', 'v', 'x'].includes(val.toLowerCase());
            }

            targetRow.data[targetCol.key] = val;
            if (targetCol.key === 'nama' || targetCol.key === 'label') targetRow.label = val;
            if (targetCol.key === 'nip' || targetCol.key === 'identifier') targetRow.identifier = val;
            if (targetCol.key === 'unitKerja' || targetCol.key === 'subLabel') targetRow.subLabel = val;
          }

          updates.push({
            rowId: targetRow.id,
            label: targetRow.label,
            identifier: targetRow.identifier,
            subLabel: targetRow.subLabel,
            data: targetRow.data
          });
        }

        if (updates.length > 0) {
          this.isSaving = true;
          this.saveStatus = `Menyimpan ${updates.length} baris dari Excel...`;

          try {
            const res = await fetch(`/admin/sheets/${this.sheetId}/bulk-save`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates })
            });

            const result = await res.json();
            if (result.success) {
              this.saveStatus = `Berhasil paste & simpan ${updates.length} baris!`;
              setTimeout(() => { this.saveStatus = ''; }, 3000);
            } else {
              alert('Gagal menyimpan hasil paste: ' + (result.message || 'Kesalahan server'));
            }
          } catch (e) {
            console.error('Bulk save error:', e);
            alert('Terjadi kesalahan saat memproses paste dari Excel.');
          } finally {
            this.isSaving = false;
          }
        }
      }
    };
  }
</script>

