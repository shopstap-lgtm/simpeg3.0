<%- include('../../partials/head') %>
<%- include('../../partials/admin-nav') %>
<%- include('../../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-5xl mx-auto space-y-6"
      x-data="sheetBuilderApp()">

  <!-- Top Breadcrumb & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div class="flex items-center gap-3">
      <a href="/admin/sheets" class="p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors">
        <i data-lucide="arrow-left" class="w-5 h-5"></i>
      </a>
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">
            <%= isEdit ? 'Mode Edit Spreadsheet' : 'Spreadsheet Baru' %>
          </span>
          <span class="text-xs text-slate-400 font-mono">/sheets/<%= isEdit ? sheet.slug : 'builder' %></span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-0.5">
          <%= isEdit ? 'Ubah Konfigurasi: ' + sheet.title : 'Buat Spreadsheet Baru' %>
        </h1>
      </div>
    </div>

    <div>
      <button type="button" @click="submitForm()" class="btn-primary bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 px-5 text-xs font-bold gap-2 shadow-sm rounded-xl cursor-pointer">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span><%= isEdit ? 'Simpan Perubahan' : 'Terbitkan Spreadsheet' %></span>
      </button>
    </div>
  </div>

  <form id="sheet-builder-form" action="<%= isEdit ? '/admin/sheets/' + sheet.id + '/edit' : '/admin/sheets/create' %>" method="POST" class="space-y-6">
    <input type="hidden" name="columns" id="columns-json-input" value="">

    <!-- SECTION 1: INFORMASI DASAR -->
    <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 rounded-3xl shadow-2xs space-y-4">
      <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
        <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
          <i data-lucide="file-text" class="w-4 h-4"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">1. Informasi Utama Lembar Kerja</h2>
          <p class="text-[11px] text-slate-400">Judul dan petunjuk pengisian bagi responden</p>
        </div>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Judul Spreadsheet *
          </label>
          <input type="text" 
                 name="title" 
                 x-model="title" 
                 required 
                 placeholder="Contoh: Pendataan Aktivasi TTE atau Kebutuhan Sarpras"
                 class="form-input text-xs font-semibold py-2.5 px-3.5 w-full rounded-xl">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Deskripsi / Petunjuk Pengisian
          </label>
          <textarea name="description" 
                    x-model="description" 
                    rows="2" 
                    placeholder="Tuliskan petunjuk pengisian, format yang diharapkan, atau batas akhir pengisian bagi sekolah..."
                    class="form-textarea text-xs py-2.5 px-3.5 w-full rounded-xl"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Status Pengisian
            </label>
            <select name="status" x-model="status" class="form-select text-xs font-semibold py-2 px-3 rounded-xl w-full bg-white border-slate-200">
              <option value="ACTIVE">Aktif (Menerima Pengisian Data)</option>
              <option value="CLOSED">Ditutup (Hanya Lihat / Selesai)</option>
              <option value="DRAFT">Draf (Hanya Admin yang Bisa Buka)</option>
            </select>
          </div>

          <div class="flex items-center gap-4 pt-5">
            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" name="allowPublicExport" value="true" x-model="allowPublicExport" class="rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4">
              <span class="text-xs font-semibold text-slate-700">Izinkan Unduh Excel Publik (.xlsx)</span>
            </label>
            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" name="allowBulkPaste" value="true" x-model="allowBulkPaste" class="rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4">
              <span class="text-xs font-semibold text-slate-700">Izinkan Paste dari Excel</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 2: TARGET ENTITAS DATA -->
    <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 rounded-3xl shadow-2xs space-y-4">
      <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
        <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
          <i data-lucide="target" class="w-4 h-4"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">2. Target Entitas Baris Spreadsheet</h2>
          <p class="text-[11px] text-slate-400">Pilih apakah data berorientasi pada unit sekolah, pegawai, atau tabel bebas</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        
        <!-- Pilihan 1: UNIT -->
        <label class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex flex-col justify-between space-y-3"
               :class="targetType === 'UNIT' ? 'bg-indigo-50/50 border-indigo-600 ring-2 ring-indigo-500/20 shadow-2xs' : 'bg-white border-slate-200 hover:border-slate-300'"
               @click="selectTargetType('UNIT')">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold">
                <i data-lucide="school" class="w-4 h-4"></i>
              </span>
              <input type="radio" name="targetType" value="UNIT" x-model="targetType" class="text-indigo-600 focus:ring-indigo-500">
            </div>
            <div class="text-xs font-extrabold text-slate-900">Per Unit Sekolah</div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Tiap baris merepresentasikan 1 sekolah (48 unit sekolah Cibitung). Cocok untuk laporan sarpras, dana BOS, akreditasi, dll.
            </p>
          </div>
        </label>

        <!-- Pilihan 2: PEGAWAI -->
        <label class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex flex-col justify-between space-y-3"
               :class="targetType === 'PEGAWAI' ? 'bg-amber-50/50 border-amber-600 ring-2 ring-amber-500/20 shadow-2xs' : 'bg-white border-slate-200 hover:border-slate-300'"
               @click="selectTargetType('PEGAWAI')">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xs font-bold">
                <i data-lucide="users" class="w-4 h-4"></i>
              </span>
              <input type="radio" name="targetType" value="PEGAWAI" x-model="targetType" class="text-amber-600 focus:ring-amber-500">
            </div>
            <div class="text-xs font-extrabold text-slate-900">Semua Pegawai</div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Memuat seluruh 1.061 pegawai lengkap dengan NIP, Nama, Unit Sekolah, Jabatan, Status, NIK, No HP, & NPWP.
            </p>
          </div>
        </label>

        <!-- Pilihan 3: CUSTOM -->
        <label class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex flex-col justify-between space-y-3"
               :class="targetType === 'CUSTOM' ? 'bg-emerald-50/50 border-emerald-600 ring-2 ring-emerald-500/20 shadow-2xs' : 'bg-white border-slate-200 hover:border-slate-300'"
               @click="selectTargetType('CUSTOM')">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">
                <i data-lucide="table" class="w-4 h-4"></i>
              </span>
              <input type="radio" name="targetType" value="CUSTOM" x-model="targetType" class="text-emerald-600 focus:ring-emerald-500">
            </div>
            <div class="text-xs font-extrabold text-slate-900">Tabel Bebas / Fleksibel</div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Tabel kosong tanpa daftar awal. Pengisi dapat menambah baris bebas atau langsung paste massal puluhan baris dari Excel.
            </p>
          </div>
        </label>

      </div>

      <% if (!isEdit) { %>
        <!-- Prefill Option on Create -->
        <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
          <div class="flex items-center gap-2">
            <i data-lucide="sparkles" class="w-4 h-4 text-amber-500 shrink-0"></i>
            <span class="font-medium text-slate-700">Otomatis buatkan baris awal sesuai target yang dipilih di atas beserta data profilnya</span>
          </div>
          <label class="inline-flex items-center gap-2 cursor-pointer select-none shrink-0">
            <input type="checkbox" name="autoPrefill" value="true" checked class="rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4">
            <span class="font-bold text-slate-800">Ya, Prefill Otomatis</span>
          </label>
        </div>
      <% } %>
    </div>

    <!-- SECTION 3: MODE AKSES & KEAMANAN PENGISIAN -->
    <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 rounded-3xl shadow-2xs space-y-4">
      <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
        <div class="w-8 h-8 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">3. Mode Akses & Pengisian Responden</h2>
          <p class="text-[11px] text-slate-400">Atur siapa dan bagaimana pengguna mengisi sel baris</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        
        <!-- Pilihan 1: PROTECTED_NIP -->
        <label class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex flex-col justify-between space-y-3"
               :class="accessMode === 'PROTECTED_NIP' ? 'bg-amber-50/50 border-amber-600 ring-2 ring-amber-500/20 shadow-2xs' : 'bg-white border-slate-200 hover:border-slate-300'">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center text-xs font-bold">
                <i data-lucide="lock" class="w-4 h-4"></i>
              </span>
              <input type="radio" name="accessMode" value="PROTECTED_NIP" x-model="accessMode" class="text-amber-600 focus:ring-amber-500">
            </div>
            <div class="text-xs font-extrabold text-slate-900">Proteksi Kredensial NIP</div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Baris terkunci secara default. Responden harus memvalidasi NIP untuk membuka kunci baris miliknya sendiri. Sangat aman dari risiko tertimpa.
            </p>
          </div>
        </label>

        <!-- Pilihan 2: PUBLIC_VIEW -->
        <label class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex flex-col justify-between space-y-3"
               :class="accessMode === 'PUBLIC_VIEW' ? 'bg-indigo-50/50 border-indigo-600 ring-2 ring-indigo-500/20 shadow-2xs' : 'bg-white border-slate-200 hover:border-slate-300'">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold">
                <i data-lucide="eye" class="w-4 h-4"></i>
              </span>
              <input type="radio" name="accessMode" value="PUBLIC_VIEW" x-model="accessMode" class="text-indigo-600 focus:ring-indigo-500">
            </div>
            <div class="text-xs font-extrabold text-slate-900">Bisa Dilihat Umum (Read Only)</div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Semua orang dapat melihat tabel secara transparan di publik. Hanya admin yang berhak menginput atau mengedit data.
            </p>
          </div>
        </label>

        <!-- Pilihan 3: OPEN_EDIT -->
        <label class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex flex-col justify-between space-y-3"
               :class="accessMode === 'OPEN_EDIT' ? 'bg-emerald-50/50 border-emerald-600 ring-2 ring-emerald-500/20 shadow-2xs' : 'bg-white border-slate-200 hover:border-slate-300'">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">
                <i data-lucide="edit-3" class="w-4 h-4"></i>
              </span>
              <input type="radio" name="accessMode" value="OPEN_EDIT" x-model="accessMode" class="text-emerald-600 focus:ring-emerald-500">
            </div>
            <div class="text-xs font-extrabold text-slate-900">Kolaboratif Bebas</div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Persis seperti Google Sheet publik terbuka. Siapa pun dengan tautan dapat langsung mengklik sel dan mengedit data baris.
            </p>
          </div>
        </label>

      </div>

      <!-- Extra PIN check option when in PROTECTED_NIP -->
      <div x-show="accessMode === 'PROTECTED_NIP'" class="p-3 bg-amber-50/60 rounded-2xl border border-amber-200 text-xs flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i data-lucide="key-round" class="w-4 h-4 text-amber-600"></i>
          <span class="font-medium text-amber-900">Wajibkan verifikasi 4-digit PIN selain NIP untuk keamanan ganda</span>
        </div>
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" name="requirePin" value="true" x-model="requirePin" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4">
          <span class="font-bold text-amber-900">Wajibkan PIN</span>
        </label>
      </div>
    </div>

    <!-- SECTION 4: STRUKTUR KOLOM SPREADSHEET -->
    <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 rounded-3xl shadow-2xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
            <i data-lucide="columns" class="w-4 h-4"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-900">4. Rancang Kolom Spreadsheet</h2>
            <p class="text-[11px] text-slate-400">Atur kolom atribut dan kolom isian yang ada di spreadsheet</p>
          </div>
        </div>

        <!-- Quick Column Actions -->
        <div class="flex flex-wrap items-center gap-2">
          <template x-if="targetType === 'PEGAWAI'">
            <button type="button" 
                    @click="loadEmployeeColumns()" 
                    class="py-1.5 px-3 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 hover:bg-amber-100 rounded-xl cursor-pointer flex items-center gap-1.5"
                    title="Muat 8 kolom atribut lengkap pegawai (NIP, Nama, Unit, Jabatan, Status, NIK, No HP, NPWP)">
              <i data-lucide="users" class="w-3.5 h-3.5"></i>
              <span>Muat Atribut Pegawai Lengkap</span>
            </button>
          </template>

          <template x-if="targetType === 'UNIT'">
            <button type="button" 
                    @click="loadUnitColumns()" 
                    class="py-1.5 px-3 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 hover:bg-indigo-100 rounded-xl cursor-pointer flex items-center gap-1.5"
                    title="Muat kolom atribut profil sekolah (Nama Sekolah, Jenjang, Kategori, Kepsek, Operator)">
              <i data-lucide="school" class="w-3.5 h-3.5"></i>
              <span>Muat Atribut Profil Sekolah</span>
            </button>
          </template>

          <button type="button" @click="addColumn()" class="btn-secondary py-1.5 px-3.5 text-xs font-bold gap-1.5 text-indigo-700 bg-indigo-50 border-indigo-200 hover:bg-indigo-100 rounded-xl cursor-pointer">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            <span>Tambah Kolom Kustom</span>
          </button>
        </div>
      </div>

      <!-- Info Banner -->
      <div class="p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs text-slate-600 flex items-center justify-between gap-2.5">
        <div class="flex items-center gap-2">
          <i data-lucide="info" class="w-4 h-4 text-indigo-600 shrink-0"></i>
          <span>
            Total <b class="text-slate-800" x-text="columns.length"></b> kolom terdaftar. Anda dapat menghapus kolom yang tidak dibutuhkan atau menambah kolom kustom baru di bawah.
          </span>
        </div>
        <div class="text-[11px] text-slate-400 hidden sm:block">
          Kolom juga dapat disembunyikan kapan saja langsung di tabel spreadsheet.
        </div>
      </div>

      <!-- Column List (Dynamic Repeater) -->
      <div class="space-y-3">
        <template x-for="(col, index) in columns" :key="col.key">
          <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-2xs space-y-3 hover:border-slate-300 transition">
            
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 font-mono font-bold text-xs flex items-center justify-center" x-text="index + 1"></span>
                <span class="text-xs font-extrabold text-slate-900" x-text="col.label || ('Kolom ' + (index + 1))"></span>
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-600" x-text="col.type"></span>
                <span class="text-[10px] font-mono text-slate-400" x-text="'[' + col.key + ']'"></span>
              </div>

              <!-- Reorder & Delete -->
              <div class="flex items-center gap-1">
                <button type="button" @click="moveColumn(index, -1)" :disabled="index === 0" class="p-1 text-slate-400 hover:text-slate-600 disabled:opacity-30 cursor-pointer" title="Geser ke kiri / atas">
                  <i data-lucide="chevron-up" class="w-4 h-4"></i>
                </button>
                <button type="button" @click="moveColumn(index, 1)" :disabled="index === columns.length - 1" class="p-1 text-slate-400 hover:text-slate-600 disabled:opacity-30 cursor-pointer" title="Geser ke kanan / bawah">
                  <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </button>
                <button type="button" @click="removeColumn(index)" :disabled="columns.length <= 1" class="p-1 text-rose-400 hover:text-rose-600 disabled:opacity-30 cursor-pointer" title="Hapus kolom ini">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
            </div>

            <!-- Form Row -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-start">
              <!-- Label Kolom -->
              <div class="sm:col-span-4">
                <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Nama / Judul Kolom *</label>
                <input type="text" x-model="col.label" required placeholder="Contoh: NIP, Nama Lengkap, Status..." class="form-input text-xs py-2 px-3 rounded-xl w-full">
              </div>

              <!-- Tipe Data -->
              <div class="sm:col-span-3">
                <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Tipe Isian</label>
                <select x-model="col.type" class="form-select text-xs font-semibold py-2 px-3 rounded-xl w-full bg-white border-slate-200">
                  <option value="text">Teks Biasa</option>
                  <option value="number">Angka / Nilai</option>
                  <option value="currency">Mata Uang (Nominal Rp)</option>
                  <option value="select">Pilihan Dropdown (Select)</option>
                  <option value="date">Tanggal</option>
                  <option value="checkbox">Centang (Ya / Tidak)</option>
                  <option value="textarea">Area Teks Panjang</option>
                </select>
              </div>

              <!-- Placeholder / Petunjuk -->
              <div class="sm:col-span-3">
                <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Placeholder</label>
                <input type="text" x-model="col.placeholder" placeholder="Contoh: Masukkan data..." class="form-input text-xs py-2 px-3 rounded-xl w-full">
              </div>

              <!-- Wajib Diisi -->
              <div class="sm:col-span-2 pt-5">
                <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs select-none">
                  <input type="checkbox" x-model="col.required" class="rounded text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5">
                  <span class="font-semibold text-slate-700">Wajib Diisi</span>
                </label>
              </div>
            </div>

            <!-- Dropdown Options Box (shown if type === select) -->
            <div x-show="col.type === 'select'" class="p-3.5 bg-purple-50/70 rounded-2xl border border-purple-200/80 space-y-2">
              <div class="flex items-center justify-between">
                <label class="block text-[10px] font-bold uppercase text-purple-900">
                  Pilihan Dropdown (Ketik bebas dan pisahkan dengan tanda koma <span class="font-mono text-purple-700 font-black">,</span>)
                </label>
                <span class="text-[10px] text-purple-600 font-semibold">Tanda koma otomatis memisahkan opsi</span>
              </div>
              
              <!-- Fixed input that allows typing commas freely! -->
              <input type="text" 
                     x-model="col.rawOptions"
                     placeholder="Contoh: PNS, PPPK, PPPK_PW, OUTSOURCING" 
                     class="form-input text-xs py-2 px-3 rounded-xl w-full bg-white border-purple-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20">

              <!-- Live preview tags of the options -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="text-[10px] font-bold text-purple-700">Pratinjau Opsi Menu:</span>
                <template x-for="opt in getParsedOptions(col)" :key="opt">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[10px] font-bold bg-white text-purple-700 border border-purple-200 shadow-2xs" x-text="opt"></span>
                </template>
                <template x-if="getParsedOptions(col).length === 0">
                  <span class="text-[10px] text-purple-400 italic">Belum ada pilihan diketik</span>
                </template>
              </div>
            </div>

            <!-- Column Advanced Options: Protect, Filter, Visibility -->
            <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
              <div class="flex flex-wrap items-center gap-4">
                <!-- Protect Column Option -->
                <label class="inline-flex items-center gap-2 cursor-pointer select-none" title="Nilai kolom TETAP DITAMPILKAN ke publik, namun hanya Admin yang dapat mengubah isinya (Read-Only bagi responden publik)">
                  <input type="checkbox" x-model="col.isProtected" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4 cursor-pointer">
                  <span class="font-bold text-slate-800 flex items-center gap-1.5">
                    <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-600"></i>
                    <span>Proteksi Kolom (Nilai Tetap Tampil, Read-Only Publik)</span>
                  </span>
                </label>

                <!-- Filterable Option -->
                <label class="inline-flex items-center gap-2 cursor-pointer select-none" title="Aktifkan tombol filter & sort pada header kolom di spreadsheet">
                  <input type="checkbox" x-model="col.filterable" class="rounded text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer">
                  <span class="font-bold text-slate-800 flex items-center gap-1.5">
                    <i data-lucide="filter" class="w-3.5 h-3.5 text-indigo-600"></i>
                    <span>Filter di Header</span>
                  </span>
                </label>

                <!-- Column Visibility Option -->
                <label class="inline-flex items-center gap-2 cursor-pointer select-none" title="Sembunyikan kolom ini sepenuhnya dari pengunjung publik">
                  <input type="checkbox" x-model="col.hidden" class="rounded text-slate-600 focus:ring-slate-500 w-4 h-4 cursor-pointer">
                  <span class="font-semibold text-slate-600">Hidden Publik</span>
                </label>
              </div>

              <!-- Status Badges Preview -->
              <div class="flex flex-wrap items-center gap-1.5 shrink-0">
                <template x-if="col.isProtected">
                  <span class="text-[10px] font-extrabold text-amber-800 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200 flex items-center gap-1 shadow-2xs">
                    <i data-lucide="lock" class="w-3 h-3 text-amber-600"></i>
                    <span>Protected</span>
                  </span>
                </template>
                <template x-if="col.filterable !== false">
                  <span class="text-[10px] font-extrabold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-200 flex items-center gap-1 shadow-2xs">
                    <i data-lucide="filter" class="w-3 h-3 text-indigo-600"></i>
                    <span>Filter Aktif</span>
                  </span>
                </template>
                <template x-if="col.hidden">
                  <span class="text-[10px] font-extrabold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200 shadow-2xs">
                    ✕ Hidden
                  </span>
                </template>
              </div>
            </div>

          </div>
        </template>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-between pt-4 border-t border-slate-200">
      <a href="/admin/sheets" class="btn-secondary py-2.5 px-5 text-xs font-bold rounded-xl">
        Batal
      </a>
      <button type="button" @click="submitForm()" class="btn-primary bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 px-6 text-xs font-bold gap-2 shadow-sm rounded-xl cursor-pointer">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span><%= isEdit ? 'Simpan Perubahan' : 'Terbitkan Spreadsheet' %></span>
      </button>
    </div>

  </form>

</main>

<script>
function sheetBuilderApp() {
  const existingSheet = <%- JSON.stringify(sheet || null) %>;

  const defaultEmployeeCols = [
    { key: 'nip', label: 'NIP', type: 'text', required: true, isProtected: true, filterable: true, placeholder: '1985...', width: 170 },
    { key: 'nama', label: 'Nama Lengkap', type: 'text', required: true, isProtected: true, filterable: true, placeholder: 'Nama Guru/Pegawai', width: 220 },
    { key: 'unitKerja', label: 'Unit Sekolah', type: 'text', required: false, isProtected: true, filterable: true, placeholder: 'SDN...', width: 200 },
    { key: 'jabatan', label: 'Jabatan', type: 'text', required: false, isProtected: true, filterable: true, placeholder: 'Guru Kelas / Ops...', width: 180 },
    { key: 'statusKepegawaian', label: 'Status Kepegawaian', type: 'select', options: ['PNS', 'PPPK', 'PPPK_PW', 'OUTSOURCING'], rawOptions: 'PNS, PPPK, PPPK_PW, OUTSOURCING', required: false, isProtected: true, filterable: true, placeholder: '', width: 160 },
    { key: 'nik', label: 'NIK', type: 'text', required: false, isProtected: true, filterable: true, placeholder: '3216...', width: 160 },
    { key: 'noHp', label: 'No. HP / WA', type: 'text', required: false, isProtected: true, filterable: true, placeholder: '0812...', width: 140 },
    { key: 'npwp', label: 'NPWP', type: 'text', required: false, isProtected: true, filterable: true, placeholder: '16 digit...', width: 160 },
    { key: 'col_status', label: 'Status Verifikasi', type: 'select', options: ['Sesuai', 'Perlu Perbaikan', 'Belum Lengkap'], rawOptions: 'Sesuai, Perlu Perbaikan, Belum Lengkap', required: false, isProtected: false, filterable: true, placeholder: '', width: 160 },
    { key: 'col_catatan', label: 'Catatan / Keterangan', type: 'text', required: false, isProtected: false, filterable: true, placeholder: 'Catatan tambahan...', width: 220 }
  ];

  const defaultUnitCols = [
    { key: 'namaUnit', label: 'Nama Unit Sekolah', type: 'text', required: true, isProtected: true, filterable: true, placeholder: 'SDN...', width: 220 },
    { key: 'jenjang', label: 'Jenjang', type: 'select', options: ['SD', 'SMP', 'PAUD/TK', 'LAINNYA'], rawOptions: 'SD, SMP, PAUD/TK, LAINNYA', required: false, isProtected: true, filterable: true, placeholder: '', width: 120 },
    { key: 'kategori', label: 'Kategori', type: 'select', options: ['NEGERI', 'SWASTA'], rawOptions: 'NEGERI, SWASTA', required: false, isProtected: true, filterable: true, placeholder: '', width: 120 },
    { key: 'kepalaSekolah', label: 'Kepala Sekolah', type: 'text', required: false, isProtected: false, filterable: true, placeholder: 'Nama Kepala Sekolah', width: 180 },
    { key: 'kontakKepalaSekolah', label: 'No. HP Kepala Sekolah', type: 'text', required: false, isProtected: false, filterable: true, placeholder: '0812...', width: 150 },
    { key: 'operatorSekolah', label: 'Operator Sekolah', type: 'text', required: false, isProtected: false, filterable: true, placeholder: 'Nama Operator', width: 180 },
    { key: 'kontakOperator', label: 'No. HP Operator', type: 'text', required: false, isProtected: false, filterable: true, placeholder: '0812...', width: 150 },
    { key: 'col_status', label: 'Status Verifikasi', type: 'select', options: ['Lengkap', 'Belum Lengkap', 'Proses'], rawOptions: 'Lengkap, Belum Lengkap, Proses', required: false, isProtected: false, filterable: true, placeholder: '', width: 160 }
  ];

  let initialCols = [];
  if (existingSheet && Array.isArray(existingSheet.columns) && existingSheet.columns.length > 0) {
    initialCols = existingSheet.columns.map(c => ({
      ...c,
      hidden: !!c.hidden,
      isProtected: !!c.isProtected,
      filterable: c.filterable !== undefined ? !!c.filterable : true,
      rawOptions: Array.isArray(c.options) ? c.options.join(', ') : (c.rawOptions || '')
    }));
  } else {
    // Default new sheet columns
    initialCols = defaultEmployeeCols.map(c => ({ ...c, hidden: false }));
  }

  return {
    title: existingSheet?.title || '',
    description: existingSheet?.description || '',
    status: existingSheet?.status || 'ACTIVE',
    targetType: existingSheet?.targetType || 'PEGAWAI',
    accessMode: existingSheet?.accessMode || 'PROTECTED_NIP',
    allowBulkPaste: existingSheet?.allowBulkPaste !== undefined ? existingSheet.allowBulkPaste : true,
    allowPublicExport: existingSheet?.allowPublicExport !== undefined ? existingSheet.allowPublicExport : true,
    requirePin: existingSheet?.requirePin !== undefined ? existingSheet.requirePin : false,

    columns: initialCols,

    init() {
      if (window.lucide) {
        this.$nextTick(() => lucide.createIcons());
      }
    },

    selectTargetType(type) {
      this.targetType = type;
      if (!existingSheet) {
        if (type === 'PEGAWAI') {
          this.loadEmployeeColumns();
        } else if (type === 'UNIT') {
          this.loadUnitColumns();
        }
      }
    },

    loadEmployeeColumns() {
      this.columns = defaultEmployeeCols.map(c => ({ ...c }));
      this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
    },

    loadUnitColumns() {
      this.columns = defaultUnitCols.map(c => ({ ...c }));
      this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
    },

    getParsedOptions(col) {
      if (col.rawOptions !== undefined && col.rawOptions !== null) {
        return col.rawOptions.split(',').map(s => s.trim()).filter(Boolean);
      }
      return Array.isArray(col.options) ? col.options : [];
    },

    addColumn() {
      const idx = this.columns.length + 1;
      this.columns.push({
        key: 'col_' + Date.now() + '_' + idx,
        label: 'Kolom ' + idx,
        type: 'text',
        options: [],
        rawOptions: '',
        required: false,
        hidden: false,
        isProtected: false,
        filterable: true,
        placeholder: '',
        width: 170
      });
      this.$nextTick(() => {
        if (window.lucide) lucide.createIcons();
      });
    },

    removeColumn(index) {
      if (this.columns.length <= 1) {
        alert('Minimal harus ada 1 kolom pada spreadsheet.');
        return;
      }
      this.columns.splice(index, 1);
    },

    moveColumn(index, direction) {
      const targetIndex = index + direction;
      if (targetIndex < 0 || targetIndex >= this.columns.length) return;
      const item = this.columns.splice(index, 1)[0];
      this.columns.splice(targetIndex, 0, item);
      this.$nextTick(() => {
        if (window.lucide) lucide.createIcons();
      });
    },

    submitForm() {
      if (!this.title.trim()) {
        alert('Judul spreadsheet wajib diisi.');
        return;
      }
      if (this.columns.length === 0) {
        alert('Minimal harus ada 1 kolom.');
        return;
      }

      // Sync rawOptions to options array
      const preparedColumns = this.columns.map(col => {
        const copy = { ...col };
        if (copy.type === 'select') {
          if (copy.rawOptions !== undefined) {
            copy.options = copy.rawOptions.split(',').map(s => s.trim()).filter(Boolean);
          }
        }
        copy.hidden = !!copy.hidden;
        copy.isProtected = !!copy.isProtected;
        copy.filterable = copy.filterable !== undefined ? !!copy.filterable : true;
        delete copy.rawOptions;
        return copy;
      });

      document.getElementById('columns-json-input').value = JSON.stringify(preparedColumns);
      document.getElementById('sheet-builder-form').submit();
    }
  };
}
</script>

<%- include('../../partials/footer') %>
