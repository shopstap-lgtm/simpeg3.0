<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-8"
      x-data="{
        isDragging: false,
        excelFileList: [],
        resetModal: false,
        handleFiles(files) {
          if (!files) return;
          this.excelFileList = Array.from(files).map(f => f.name);
        },
        clearFiles() {
          this.excelFileList = [];
          document.getElementById('excelFileInput').value = '';
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200/80">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Upload Rekap Absensi Bisma (Excel)</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        Sinkronisasi rekapitulasi kehadiran presensi pegawai dari file export Absen Bisma ke database SIMPEG
      </p>
    </div>

    <!-- Quick Stats Pill & Action -->
    <div class="flex items-center flex-wrap gap-2">
      <div class="px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700 flex items-center gap-2">
        <i data-lucide="users" class="w-3.5 h-3.5 text-indigo-600"></i>
        <span><%= totalEmployees %> Pegawai Aktif</span>
      </div>
      <div class="px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700 flex items-center gap-2">
        <i data-lucide="building-2" class="w-3.5 h-3.5 text-emerald-600"></i>
        <span><%= totalUnits %> Unit Kerja</span>
      </div>
      <% if (totalDays > 0) { %>
        <button type="button" 
                @click="resetModal = true" 
                class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold transition-all flex items-center gap-1.5 shadow-2xs cursor-pointer">
          <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-600"></i>
          <span>Kosongkan Presensi</span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- STATS OVERVIEW CARDS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="custom-card p-4 sm:p-5 bg-white border-slate-200/80 shadow-2xs flex items-center gap-3.5 rounded-2xl">
      <div class="w-11 h-11 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
        <i data-lucide="file-check-2" class="w-5 h-5"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Record Presensi</p>
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-0.5"><%= totalDays %> Record</h3>
        <p class="text-xs text-teal-600 font-medium">Tersimpan di database SIMPEG</p>
      </div>
    </div>

    <div class="custom-card p-4 sm:p-5 bg-white border-slate-200/80 shadow-2xs flex items-center gap-3.5 rounded-2xl">
      <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
        <i data-lucide="calendar-range" class="w-5 h-5"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Periode Aktif</p>
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-0.5"><%= periods.length %> Bulan</h3>
        <p class="text-xs text-indigo-600 font-medium">Tersinkronisasi dari file Bisma</p>
      </div>
    </div>
  </div>

  <!-- UPLOAD DROPZONE & FORM -->
  <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 shadow-2xs rounded-2xl space-y-5">
    <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
      <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
        <i data-lucide="upload-cloud" class="w-4 h-4"></i>
      </div>
      <div>
        <h2 class="text-sm sm:text-base font-bold text-slate-900">Formulir Sinkronisasi File Rekap Presensi</h2>
        <p class="text-xs text-slate-500">Pilih atau seret berkas Excel export presensi (.xlsx / .xls)</p>
      </div>
    </div>

    <form action="/admin/upload-absensi" method="POST" enctype="multipart/form-data" class="space-y-4">
      
      <!-- Multi-file Dropzone -->
      <div class="border-2 border-dashed rounded-2xl p-6 sm:p-8 text-center cursor-pointer transition-all bg-slate-50/70 relative"
           :class="isDragging ? 'border-teal-500 bg-teal-50/40 ring-4 ring-teal-500/10' : 'border-slate-300 hover:border-teal-500 hover:bg-slate-50'"
           @dragover.prevent="isDragging = true"
           @dragleave.prevent="isDragging = false"
           @drop.prevent="isDragging = false; handleFiles($event.dataTransfer.files)">
        
        <input type="file" 
               id="excelFileInput"
               name="excelFiles" 
               multiple 
               accept=".xlsx, .xls, .csv" 
               required
               @change="handleFiles($event.target.files)"
               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        
        <div class="space-y-2 pointer-events-none">
          <div class="w-12 h-12 mx-auto rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shadow-xs">
            <i data-lucide="file-spreadsheet" class="w-6 h-6"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-800">Klik atau seret file Excel ke area ini</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Mendukung format Microsoft Excel (.xlsx / .xls) hingga 60 file sekaligus</p>
          </div>
        </div>
      </div>

      <!-- File List Preview -->
      <template x-if="excelFileList.length > 0">
        <div class="p-3.5 rounded-xl bg-teal-50/70 border border-teal-200 text-xs space-y-2">
          <div class="flex items-center justify-between font-bold text-teal-900">
            <span class="flex items-center gap-1.5">
              <i data-lucide="file-check-2" class="w-4 h-4 text-teal-600"></i>
              <span x-text="excelFileList.length + ' File Excel Terpilih & Siap Diproses:'"></span>
            </span>
            <button type="button" @click="clearFiles()" class="text-rose-600 hover:text-rose-800 text-[11px] font-semibold flex items-center gap-1">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              <span>Batal Pilih</span>
            </button>
          </div>
          
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-700">
            <template x-for="(name, index) in excelFileList" :key="index">
              <li class="flex items-center gap-2 p-2 rounded-lg bg-white border border-teal-100 shadow-2xs truncate">
                <span class="w-5 h-5 rounded-md bg-teal-600 text-white font-bold text-[10px] flex items-center justify-center shrink-0" x-text="index + 1"></span>
                <span class="truncate font-medium text-slate-800" x-text="name"></span>
              </li>
            </template>
          </ul>
        </div>
      </template>

      <!-- Submit Action Button -->
      <div class="flex items-center justify-end pt-1">
        <button type="submit" class="btn-primary py-2 px-5 text-xs gap-2 bg-teal-600 hover:bg-teal-700 shadow-2xs">
          <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
          <span>Proses Sinkronisasi Excel</span>
        </button>
      </div>

    </form>
  </div>

  <!-- Registered Attendance Periods Card -->
  <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 shadow-2xs rounded-2xl space-y-4">
    <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
      <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <i data-lucide="calendar" class="w-4 h-4"></i>
      </div>
      <div>
        <h3 class="font-bold text-sm text-slate-900">Daftar Periode Presensi Terdaftar</h3>
        <p class="text-xs text-slate-500">Histori periode bulan dan jumlah catatan kehadiran yang tersimpan</p>
      </div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200/80">
      <table class="w-full text-xs text-left">
        <thead class="bg-slate-50 font-bold text-slate-700 border-b border-slate-200/80">
          <tr>
            <th class="px-4 py-2.5">Periode Presensi</th>
            <th class="px-4 py-2.5 text-center">Total Catatan Presensi</th>
            <th class="px-4 py-2.5 text-right">Terdaftar Sejak</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (!periods || periods.length === 0) { %>
            <tr>
              <td colspan="3" class="px-4 py-4 text-center text-slate-400">Belum ada periode presensi terdaftar.</td>
            </tr>
          <% } else { %>
            <% periods.forEach(function(p) { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-4 py-2.5 font-bold text-slate-900 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span><%= p.namaBulan %> <%= p.tahun %></span>
                </td>
                <td class="px-4 py-2.5 text-center">
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-teal-50 text-teal-700 border border-teal-200">
                    <%= p.totalRecords %> Data
                  </span>
                </td>
                <td class="px-4 py-2.5 text-right font-mono text-slate-600 text-[11px]">
                  <%= p.createdAt || '-' %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL KONFIRMASI KOSONGKAN PRESENSI -->
  <div x-show="resetModal" 
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs"
       style="display: none;"
       @keydown.escape.window="resetModal = false">
    
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 border border-slate-100"
         @click.away="resetModal = false">
      <div class="flex items-center gap-3 text-rose-600">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center shrink-0">
          <i data-lucide="alert-triangle" class="w-6 h-6 text-rose-600"></i>
        </div>
        <div>
          <h3 class="font-bold text-base text-slate-900">Kosongkan Data Presensi?</h3>
          <p class="text-xs text-slate-500">Tindakan ini akan menghapus seluruh data kehadiran</p>
        </div>
      </div>

      <div class="p-3.5 rounded-2xl bg-rose-50/70 border border-rose-200 text-xs text-rose-900 space-y-1">
        <p class="font-bold">Perhatian:</p>
        <p>Seluruh <b><%= totalDays %> record kehadiran</b> dan periode presensi yang tersimpan saat ini akan dihapus permanen dan total record akan kembali menjadi <b>0 record</b>.</p>
      </div>

      <form action="/admin/upload-absensi/reset" method="POST" class="flex items-center justify-end gap-2 pt-2">
        <button type="button" 
                @click="resetModal = false"
                class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-bold text-xs hover:bg-slate-50 transition-colors cursor-pointer">
          Batal
        </button>
        <button type="submit" 
                class="px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
          <span>Ya, Kosongkan Sekarang</span>
        </button>
      </form>
    </div>
  </div>

</main>

<%- include('../partials/admin-footer') %>
