<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-8"
      x-data="{
        isDragging: false,
        excelFileList: [],
        handleFiles(files) {
          if (!files) return;
          this.excelFileList = Array.from(files).map(f => f.name);
        },
        clearFiles() {
          this.excelFileList = [];
          document.getElementById('excelFileInput').value = '';
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-slate-200/80">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-200/60 text-xs font-semibold mb-2">
        <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i>
        <span>Operasional Absensi</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Upload Rekap Absensi (Excel)</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Sinkronisasi rekapitulasi data kehadiran presensi pegawai dari file export e-absensi ke dalam database SIMPEG.
      </p>
    </div>

    <!-- Quick Stats Pill -->
    <div class="flex items-center gap-2">
      <div class="px-4 py-2 rounded-2xl bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700 flex items-center gap-2">
        <i data-lucide="users" class="w-4 h-4 text-indigo-600"></i>
        <span><%= totalEmployees %> Pegawai Aktif</span>
      </div>
      <div class="px-4 py-2 rounded-2xl bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700 flex items-center gap-2">
        <i data-lucide="building-2" class="w-4 h-4 text-emerald-600"></i>
        <span><%= totalUnits %> Unit Kerja</span>
      </div>
    </div>
  </div>

  <!-- STATS OVERVIEW CARDS -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
    <div class="custom-card p-5 bg-white border-slate-200 shadow-2xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
        <i data-lucide="file-check-2" class="w-6 h-6"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Record Presensi</p>
        <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= totalDays %></h3>
        <p class="text-xs text-teal-600 font-medium">Tersimpan di database</p>
      </div>
    </div>

    <div class="custom-card p-5 bg-white border-slate-200 shadow-2xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
        <i data-lucide="calendar-range" class="w-6 h-6"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Periode Aktif</p>
        <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= periods.length %> Bulan</h3>
        <p class="text-xs text-indigo-600 font-medium">Tersinkronisasi</p>
      </div>
    </div>

    <div class="custom-card p-5 bg-white border-slate-200 shadow-2xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <i data-lucide="layers" class="w-6 h-6"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Metode Sinkronisasi</p>
        <h3 class="text-base font-extrabold text-slate-900 mt-0.5">Multi-File Batch (Up to 40)</h3>
        <p class="text-xs text-amber-600 font-medium">Export e-Absensi Otomatis</p>
      </div>
    </div>
  </div>

  <!-- UPLOAD DROPZONE & FORM -->
  <div class="custom-card p-6 sm:p-8 bg-white border-slate-200 shadow-xs space-y-6">
    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
      <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center">
        <i data-lucide="upload-cloud" class="w-5 h-5"></i>
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold text-slate-900">Formulir Sinkronisasi File Rekap Presensi</h2>
        <p class="text-xs text-slate-500">Pilih atau seret satu atau beberapa berkas Excel export presensi (hingga 40 file sekaligus)</p>
      </div>
    </div>

    <form action="/admin/upload-absensi" method="POST" enctype="multipart/form-data" class="space-y-5">
      
      <!-- Multi-file Dropzone -->
      <div class="border-2 border-dashed rounded-3xl p-8 sm:p-10 text-center cursor-pointer transition-all bg-slate-50/70 relative"
           :class="isDragging ? 'border-teal-500 bg-teal-50/40 ring-4 ring-teal-500/10' : 'border-slate-300 hover:border-teal-500 hover:bg-slate-50'"
           @dragover.prevent="isDragging = true"
           @dragleave.prevent="isDragging = false"
           @drop.prevent="isDragging = false; handleFiles($event.dataTransfer.files)">
        
        <input type="file" 
               id="excelFileInput"
               name="excelFiles" 
               multiple 
               accept=".xlsx, .xls, .csv" 
               required
               @change="handleFiles($event.target.files)"
               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        
        <div class="space-y-3 pointer-events-none">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center shadow-xs">
            <i data-lucide="file-spreadsheet" class="w-7 h-7"></i>
          </div>
          <div>
            <h3 class="text-sm sm:text-base font-bold text-slate-800">Klik atau seret file Excel ke area ini</h3>
            <p class="text-xs text-slate-500 mt-1">Mendukung format Microsoft Excel (.xlsx / .xls) hingga 40 file sekaligus</p>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-200/80 text-[11px] font-semibold text-slate-700">
            <i data-lucide="shield-check" class="w-3.5 h-3.5 text-teal-600"></i>
            <span>Format nama: Export_eabsensi_DDMMYYYY_HHMMSS.xlsx</span>
          </div>
        </div>
      </div>

      <!-- File List Preview -->
      <template x-if="excelFileList.length > 0">
        <div class="p-4 rounded-2xl bg-teal-50/70 border border-teal-200 text-xs space-y-2.5">
          <div class="flex items-center justify-between font-bold text-teal-900">
            <span class="flex items-center gap-1.5">
              <i data-lucide="file-check-2" class="w-4 h-4 text-teal-600"></i>
              <span x-text="excelFileList.length + ' File Excel Terpilih & Siap Diproses:'"></span>
            </span>
            <button type="button" @click="clearFiles()" class="text-rose-600 hover:text-rose-800 text-[11px] font-semibold flex items-center gap-1">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              <span>Batal Pilih</span>
            </button>
          </div>
          
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-700">
            <template x-for="(name, index) in excelFileList" :key="index">
              <li class="flex items-center gap-2 p-2 rounded-xl bg-white border border-teal-100 shadow-2xs truncate">
                <span class="w-5 h-5 rounded-lg bg-teal-600 text-white font-bold text-[10px] flex items-center justify-center shrink-0" x-text="index + 1"></span>
                <span class="truncate font-medium text-slate-800" x-text="name"></span>
              </li>
            </template>
          </ul>
        </div>
      </template>

      <!-- Submit & Reset Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
        <div class="text-xs text-slate-500 flex items-center gap-1.5">
          <i data-lucide="info" class="w-4 h-4 text-indigo-500 shrink-0"></i>
          <span>Data absensi yang sudah ada pada tanggal & NIP yang sama akan otomatis diperbarui.</span>
        </div>

        <button type="submit" class="btn-primary py-2.5 px-6 gap-2 bg-teal-600 hover:bg-teal-700 shadow-teal-200 w-full sm:w-auto">
          <i data-lucide="refresh-cw" class="w-4 h-4"></i>
          <span>Proses Sinkronisasi Excel</span>
        </button>
      </div>

    </form>
  </div>

  <!-- GUIDELINES & FORMAT CARD -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Guidelines Card -->
    <div class="custom-card p-5 sm:p-6 bg-white shadow-xs space-y-4">
      <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
        <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
        </div>
        <h3 class="font-bold text-sm text-slate-900">Petunjuk Format File & Kolom</h3>
      </div>

      <div class="text-xs text-slate-600 space-y-3 leading-relaxed">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
          <p class="font-bold text-slate-800">1. Ketentuan Nama File:</p>
          <p class="font-mono text-indigo-600 font-semibold mt-1">Export_eabsensi_DDMMYYYY_HHMMSS.xlsx</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Contoh: <span class="font-mono text-slate-700">Export_eabsensi_13082026_131053.xlsx</span> $\rightarrow$ Tanggal 13 Agustus 2026.</p>
        </div>

        <p class="font-bold text-slate-800">2. Kolom yang Dibaca dari File:</p>
        <div class="overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-[11px] text-left">
            <thead class="bg-slate-100 font-bold text-slate-700">
              <tr>
                <th class="px-3 py-2">Nama Kolom</th>
                <th class="px-3 py-2">Kode Status</th>
                <th class="px-3 py-2">Hasil di SIMPEG</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="px-3 py-2 font-mono font-bold text-indigo-600">NIP</td>
                <td class="px-3 py-2 font-mono text-slate-700">19850315...</td>
                <td class="px-3 py-2 text-slate-500">Mencocokkan Pegawai</td>
              </tr>
              <tr>
                <td class="px-3 py-2 font-mono font-bold text-teal-600" rowspan="4">Verifikasi SKPD</td>
                <td class="px-3 py-2 font-mono font-bold text-emerald-700">NL</td>
                <td class="px-3 py-2 text-emerald-700 font-semibold">Hadir Normal (H)</td>
              </tr>
              <tr>
                <td class="px-3 py-2 font-mono font-bold text-blue-700">DL</td>
                <td class="px-3 py-2 text-blue-700 font-semibold">DL Biru (Sesuai)</td>
              </tr>
              <tr>
                <td class="px-3 py-2 font-mono font-bold text-amber-700">DL-K</td>
                <td class="px-3 py-2 text-amber-700 font-semibold">DL Kuning (Belum Sesuai)</td>
              </tr>
              <tr>
                <td class="px-3 py-2 font-mono font-bold text-rose-700">TK / A</td>
                <td class="px-3 py-2 text-rose-700 font-semibold">Tanpa Keterangan (TK)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Registered Attendance Periods Card -->
    <div class="custom-card p-5 sm:p-6 bg-white shadow-xs space-y-4">
      <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
        <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <i data-lucide="calendar" class="w-4 h-4"></i>
        </div>
        <h3 class="font-bold text-sm text-slate-900">Daftar Periode Presensi Terdaftar</h3>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full text-[11px] text-left">
          <thead class="bg-slate-100 font-bold text-slate-700">
            <tr>
              <th class="px-3 py-2">Periode</th>
              <th class="px-3 py-2 text-center">Total Presensi</th>
              <th class="px-3 py-2 text-right">Terdaftar Sejak</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (!periods || periods.length === 0) { %>
              <tr>
                <td colspan="3" class="px-3 py-4 text-center text-slate-400">Belum ada periode presensi terdaftar.</td>
              </tr>
            <% } else { %>
              <% periods.forEach(function(p) { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-3 py-2 font-semibold text-slate-900">
                    <%= p.namaBulan %> <%= p.tahun %>
                  </td>
                  <td class="px-3 py-2 text-center">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-700 border border-teal-200">
                      <%= p.totalRecords %> Data
                    </span>
                  </td>
                  <td class="px-3 py-2 text-right font-mono text-slate-600">
                    <%= p.createdAt || '-' %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

</main>

<%- include('../partials/admin-footer') %>
