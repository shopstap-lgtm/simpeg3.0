        // Computed Filtered & Searched Rows (Instant in-memory lookup)
        get displayedRows() {
          let list = this.rows;

          // Keyword Search across all cells
          if (this.searchQuery.trim()) {
            const q = this.searchQuery.toLowerCase().trim();
            list = list.filter(r => {
              const vals = Object.values(r.data || {});
              return vals.some(v => String(v || '').toLowerCase().includes(q));
            });
          }

          // Column Filter
          if (this.activeFilterCol) {
            const colId = this.activeFilterCol;
            if (this.activeFilterMode === 'filled') {
              list = list.filter(r => (r.data?.[colId] || '').toString().trim() !== '');
            } else if (this.activeFilterMode === 'empty') {
              list = list.filter(r => !(r.data?.[colId] || '').toString().trim());
            }
          }

          return list;
        },

        init() {
          try {
            const saved = sessionStorage.getItem('sheet_unlocked_' + this.sheetData.id);
            if (saved) {
              const arr = JSON.parse(saved);
              if (Array.isArray(arr)) {
                this.unlockedRowIds = new Set(arr);
              }
            }
          } catch(e) {}

          this.$watch('searchQuery', () => { this.currentPage = 1; });

          this.windowWidth = window.innerWidth;
          window.addEventListener('resize', () => {
            this.windowWidth = window.innerWidth;
          });

          try {
            const savedFit = localStorage.getItem('smart_sheet_fit_window_' + this.sheetData.id);
            if (savedFit !== null) {
              this.isFitWindow = (savedFit === '1');
            } else {
              this.isFitWindow = (this.visibleColumns.length <= 14);
            }
          } catch(e) {}

          this.initRowLockSettings();
          if (window.lucide) window.lucide.createIcons();
          window.addEventListener('beforeunload', (e) => {
            if (this.saveState === 'dirty') e.returnValue = 'Menyimpan perubahan...';
          });

          // Keyboard shortcut: Esc to cancel selection
          window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              if (this.showBulkEditModal) {
                this.showBulkEditModal = false;
              } else if (this.selectedRowCount > 0 || this.selectedColCount > 0) {
                this.clearRowSelection();
                this.clearColSelection();
              }
            }
          });
        },

        // ==========================================
        // REALTIME AUTOSAVE (Google Sheets Style)
        // ==========================================
        triggerAutoSave() {
          this.saveState = 'dirty';
          clearTimeout(this.saveTimer);
          this.saveTimer = setTimeout(() => {
            this.saveImmediately();
          }, 600);
        },

        async saveImmediately() {
          clearTimeout(this.saveTimer);
          this.saveState = 'saving';
          try {
            const payload = {
              title: this.sheetData.title,
              description: this.sheetData.description || '',
              columns: this.sheetData.columns,
              rows: this.rows
            };

            const endpoint = this.isSuperAdmin 
              ? `/admin/smart-sheets/${this.sheetData.id}/save`
              : `/smart-sheet/${this.sheetData.id}/save`;

            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (data.success) {
              this.saveState = 'saved';
            } else {
              console.warn('[SmartSheet] Autosave error:', data.message);
              this.saveState = 'error';
            }
          } catch (e) {
            console.error('[SmartSheet] Autosave exception:', e);
            this.saveState = 'error';
          }
        },

        // ==========================================
        // CELL FILE UPLOAD
        // ==========================================
        triggerCellUpload(row, colId) {
          this.activeUploadRow = row;
          this.activeUploadColId = colId;
          this.$refs.cellFileInput.value = '';
          this.$refs.cellFileInput.click();
        },

        async onCellFileSelected(e) {
          const file = e.target.files?.[0];
          if (!file || !this.activeUploadRow || !this.activeUploadColId) return;

          const row = this.activeUploadRow;
          const colId = this.activeUploadColId;
          const cellKey = row.id + '_' + colId;
          this.uploadingCellKey = cellKey;

          const formData = new FormData();
          formData.append('file', file);

          try {
            const endpoint = this.isSuperAdmin 
              ? `/admin/smart-sheets/${this.sheetData.id}/upload-cell`
              : `/smart-sheet/${this.sheetData.id}/upload-cell`;

            const res = await fetch(endpoint, {
              method: 'POST',
              body: formData
            });
            const data = await res.json();

            if (data.success && data.fileUrl) {
              row.data[colId] = data.fileUrl;
              await this.saveImmediately();
              this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            } else {
              alert(data.message || 'Gagal mengunggah berkas');
            }
          } catch (err) {
            alert('Kesalahan saat mengunggah berkas');
          } finally {
            this.uploadingCellKey = null;
            this.activeUploadRow = null;
            this.activeUploadColId = null;
          }
        },

        removeCellFile(row, colId) {
          if (!confirm('Hapus berkas dari baris ini?')) return;
          row.data[colId] = '';
          this.triggerAutoSave();
        },

        extractFileName(url) {
          if (!url) return '';
          const parts = url.split('/');
          const raw = parts[parts.length - 1];
          return raw.replace(/^sheet-\d+-/, '');
        },

        // ==========================================
        // FILTER HELPER
        // ==========================================
        resetFilter() {
          this.activeFilterCol = '';
          this.activeFilterMode = 'all';
          this.currentPage = 1;
        },

        // ==========================================
        // SHARE MODAL
        // ==========================================
        openShareModal() {
          this.showShareModal = true;
          this.copyShareLink();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        async copyShareLink() {
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(this.shareUrl);
            } else {
              const ta = document.createElement('textarea');
              ta.value = this.shareUrl;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            this.copied = true;
            this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            setTimeout(() => {
              this.copied = false;
              this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            }, 3000);
          } catch (e) {
            console.error('Copy failed:', e);
          }
        },

        // ==========================================
        // DATABASE IMPORT (SuperAdmin Only)
        // ==========================================
        async runImport() {
          if (this.isImporting) return;
          const activeFields = this.importForm.source === 'PEGAWAI' ? this.importForm.pegawaiFields : this.importForm.unitFields;
          if (!activeFields || activeFields.length === 0) {
            alert('Pilih minimal 1 atribut kolom untuk diimpor!');
            return;
          }
          this.isImporting = true;
          try {
            const payload = {
              source: this.importForm.source,
              mode: this.importForm.mode,
              selectedFields: activeFields
            };
            const res = await fetch(`/admin/smart-sheets/${this.sheetData.id}/import`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              alert(data.message || 'Gagal import data');
              this.isImporting = false;
            }
          } catch (e) {
            alert('Terjadi kesalahan jaringan');
            this.isImporting = false;
          }
        },

        // ==========================================
        // COLUMN & ROW CONTROLS (SuperAdmin Only)
        // ==========================================
        addColumn() {
          if (!this.isSuperAdmin) return;
          const newId = 'c_' + Date.now();
          this.sheetData.columns.push({ 
            id: newId, 
            name: 'Kolom Baru', 
            type: 'text', 
            width: 180, 
            options: [],
            isLocked: false,
            isCredential: false,
            requiresAuth: false,
            isMasked: false,
            isHidden: false,
            isFrozen: false
          });
          this.rows.forEach(r => { if (r.data) r.data[newId] = ''; });
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        addRows(count = 10) {
          if (!this.isSuperAdmin) return;
          const maxRowIdx = this.rows.length > 0 ? Math.max(...this.rows.map(r => r.rowIndex || 0)) : -1;
          for (let i = 0; i < count; i++) {
            const newRow = { id: 'new_' + Date.now() + '_' + i, _localId: 'new_' + Date.now() + '_' + i, rowIndex: maxRowIdx + 1 + i, data: {} };
            this.sheetData.columns.forEach(c => newRow.data[c.id] = '');
            this.rows.push(newRow);
          }
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        // Custom Dropdown Options Helper & State
        activeColOptionsText: '',

        getColOptions(col) {
          if (!col) return [];
          if (Array.isArray(col.options) && col.options.length > 0) {
            return col.options;
          }
          if (typeof col.options === 'string' && col.options.trim()) {
            return col.options.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
          }
          return ['Pilihan 1', 'Pilihan 2', 'Pilihan 3'];
        },

        updateActiveColOptions() {
          if (!this.activeCol) return;
          const parsed = (this.activeColOptionsText || '')
            .split(/[\n,]+/)
            .map(s => s.trim())
            .filter(Boolean);
          this.activeCol.options = parsed;
          this.triggerAutoSave();
        },

        openColMenu(idx) {
          if (!this.isSuperAdmin) return;
          this.activeColIdx = idx;
          this.activeCol = this.sheetData.columns[idx]; 
          const opts = this.activeCol.options;
          if (Array.isArray(opts)) {
            this.activeColOptionsText = opts.join(', ');
          } else if (typeof opts === 'string') {
            this.activeColOptionsText = opts;
          } else {
            this.activeColOptionsText = '';
          }
          this.showColMenu = true;
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        openColMenuByColId(colId) {
          if (!this.isSuperAdmin) return;
          const idx = this.sheetData.columns.findIndex(c => c.id === colId);
          if (idx !== -1) {
            this.openColMenu(idx);
          }
        },

        deleteActiveCol() {
          if (!this.isSuperAdmin) return;
          if (this.sheetData.columns.length <= 1) return alert('Minimal harus ada 1 kolom!');
          if (!confirm('Yakin hapus kolom ini beserta seluruh datanya?')) return;
          
          const colId = this.sheetData.columns[this.activeColIdx].id;
          this.sheetData.columns.splice(this.activeColIdx, 1);
          this.rows.forEach(r => { if (r.data) delete r.data[colId]; });
          
          this.showColMenu = false;
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        }
      };
    }
  </script>
</body>
</html>
