          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        // Freeze Columns Helpers
        get hasFrozenColumns() {
          return (this.visibleColumns || []).some(c => c.isFrozen);
        },

        get frozenCount() {
          return (this.visibleColumns || []).filter(c => c.isFrozen).length;
        },

        freezeUpTo(visibleIdx) {
          for (let i = 0; i < this.visibleColumns.length; i++) {
            this.visibleColumns[i].isFrozen = (i <= visibleIdx);
          }
          this.closeHeaderMenu();
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        freezeCount(count) {
          for (let i = 0; i < this.visibleColumns.length; i++) {
            this.visibleColumns[i].isFrozen = (i < count);
          }
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        unfreezeAll() {
          (this.sheetData.columns || []).forEach(c => c.isFrozen = false);
          this.closeHeaderMenu();
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        getFrozenLeft(colIdx) {
          if (this.isFitWindow && !this.isMobile) return 'auto';
          const base = this.hasCredentialLock ? 140 : 44;
          let offset = base;
          for (let i = 0; i < colIdx; i++) {
            const c = this.visibleColumns[i];
            if (c && c.isFrozen) {
              offset += (c.width || 180);
            }
          }
          return offset + 'px';
        },

        isColFrozen(colIdx) {
          if (this.isFitWindow && !this.isMobile) return false;
          if (this.isMobile) return false; // Pada mobile, biarkan tabel scroll alami agar kolom beku tidak menutupi layar HP
          const col = this.visibleColumns[colIdx];
          return !!(col && col.isFrozen);
        },

        isLastFrozenCol(colIdx) {
          if (this.isFitWindow && !this.isMobile) return false;
          if (this.isMobile) return false;
          if (!this.isColFrozen(colIdx)) return false;
          const nextCol = this.visibleColumns[colIdx + 1];
          return !nextCol || !nextCol.isFrozen;
        },

        getColHeaderStyle(col, colIdx) {
          let style = '';
          // Di layar mobile (< 768px), biarkan kolom berukuran cukup dan scroll horizontal alami
          if (this.isMobile) {
            const w = col.width || 160;
            style += `width: ${w}px; min-width: ${Math.max(130, w)}px;`;
            if (this.isColFrozen(colIdx)) {
              style += ` left: ${this.getFrozenLeft(colIdx)};`;
            }
          } else if (this.isFitWindow) {
            // Di desktop/tablet, bagi proporsional pas selebar layar
            const totalWeights = this.visibleColumns.reduce((sum, c) => sum + (c.width || 180), 0) || 1;
            const pct = (((col.width || 180) / totalWeights) * 100).toFixed(2);
            style += `width: ${pct}%; min-width: 70px;`;
          } else {
            style += `width: ${col.width || 180}px; min-width: ${col.width || 180}px;`;
            if (this.isColFrozen(colIdx)) {
              style += ` left: ${this.getFrozenLeft(colIdx)};`;
            }
          }
          return style;
        },

        toggleFitWindow() {
          this.isFitWindow = !this.isFitWindow;
          try {
            localStorage.setItem('smart_sheet_fit_window_' + this.sheetData.id, this.isFitWindow ? '1' : '0');
          } catch(e) {}
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        // Floating Header Menu
        showHeaderMenu: false,
        activeMenuColIdx: -1,
        activeMenuCol: {},
        headerMenuPos: { top: '0px', left: '0px' },

        openHeaderMenu(colIdx, event) {
          this.activeMenuColIdx = colIdx;
          this.activeMenuCol = this.visibleColumns[colIdx];
          if (!this.activeMenuCol) return;
          const rect = event.currentTarget.getBoundingClientRect();
          this.headerMenuPos = {
            top: Math.min(rect.bottom + 4, window.innerHeight - 340) + 'px',
            left: Math.max(10, Math.min(rect.left - 60, window.innerWidth - 270)) + 'px'
          };
          this.showHeaderMenu = true;
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        closeHeaderMenu() {
          this.showHeaderMenu = false;
        },

        sortByCol(colId, dir) {
          const unitCol = (this.sheetData.columns || []).find(c => 
            c.id === 'c_unit' || (c.name && c.name.toLowerCase().includes('unit'))
          );
          const pegCol = (this.sheetData.columns || []).find(c => 
            c.id === 'c_nama' || (c.name && (c.name.toLowerCase().includes('nama') || c.name.toLowerCase().includes('pegawai')))
          );

          this.rows.sort((a, b) => {
            const valA = (a.data?.[colId] || '').toString().trim().toLowerCase();
            const valB = (b.data?.[colId] || '').toString().trim().toLowerCase();
            const numA = parseFloat(valA);
            const numB = parseFloat(valB);
            let comp = 0;
            if (!isNaN(numA) && !isNaN(numB) && valA !== '' && valB !== '') {
              comp = dir === 'asc' ? numA - numB : numB - numA;
            } else {
              comp = dir === 'asc' ? valA.localeCompare(valB, 'id', { numeric: true }) : valB.localeCompare(valA, 'id', { numeric: true });
            }

            // Jika mengurutkan kolom unit kerja dan nilainya sama, urutkan pegawai A-Z
            if (comp === 0 && unitCol && colId === unitCol.id && pegCol) {
              const pA = (a.data?.[pegCol.id] || '').toString().trim().toLowerCase();
              const pB = (b.data?.[pegCol.id] || '').toString().trim().toLowerCase();
              return pA.localeCompare(pB, 'id', { numeric: true });
            }

            return comp;
          });
          this.currentPage = 1;
          this.closeHeaderMenu();
          this.saveImmediately();
        },

        filterColMode(colId, mode) {
          this.activeFilterCol = colId;
          this.activeFilterMode = mode;
          this.currentPage = 1;
          this.closeHeaderMenu();
        },

        moveColumn(visibleIdx, direction) {
          if (!this.isSuperAdmin) return;
          const col = this.visibleColumns[visibleIdx];
          if (!col) return;
          const originalIdx = this.sheetData.columns.findIndex(c => c.id === col.id);
          const targetOriginalIdx = originalIdx + direction;
          if (targetOriginalIdx < 0 || targetOriginalIdx >= this.sheetData.columns.length) return;
          
          const movedCol = this.sheetData.columns.splice(originalIdx, 1)[0];
          this.sheetData.columns.splice(targetOriginalIdx, 0, movedCol);
          
          // Tetap buka popup menu dan update index aktif agar bisa digeser berkali-kali
          const newVisibleIdx = this.visibleColumns.findIndex(c => c.id === col.id);
          this.activeMenuColIdx = newVisibleIdx;
          this.activeMenuCol = col;
          
          this.saveImmediately();

          this.$nextTick(() => {
            // Reposisi popup agar tetap menempel pada header kolom yang bergeser
            const thList = document.querySelectorAll('thead th[data-col-id]');
            for (const th of thList) {
              if (th.getAttribute('data-col-id') === col.id) {
                const rect = th.getBoundingClientRect();
                this.headerMenuPos = {
                  top: Math.min(rect.bottom + 4, window.innerHeight - 340) + 'px',
                  left: Math.max(10, Math.min(rect.left - 40, window.innerWidth - 270)) + 'px'
                };
                break;
              }
            }
            if (window.lucide) window.lucide.createIcons();
          });
        },

        toggleHideColumn(visibleIdx) {
          if (!this.isSuperAdmin) return;
          const col = this.visibleColumns[visibleIdx];
          if (!col) return;
          col.isHidden = !col.isHidden;
          this.closeHeaderMenu();
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        hideColumn(visibleIdx) {
          this.toggleHideColumn(visibleIdx);
        },

        deleteColFromMenu(visibleIdx) {
          if (!this.isSuperAdmin) return;
          if (this.sheetData.columns.length <= 1) return alert('Minimal harus ada 1 kolom!');
          const col = this.visibleColumns[visibleIdx];
          if (!col) return;
          if (!confirm(`Yakin hapus kolom "${col.name}" beserta seluruh datanya?`)) return;
          
          const originalIdx = this.sheetData.columns.findIndex(c => c.id === col.id);
          const colId = col.id;
          this.sheetData.columns.splice(originalIdx, 1);
          this.rows.forEach(r => { if (r.data) delete r.data[colId]; });
          this.closeHeaderMenu();
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        openColSettingsFromMenu() {
          const col = this.visibleColumns[this.activeMenuColIdx];
          this.closeHeaderMenu();
          if (col) {
            const originalIdx = this.sheetData.columns.findIndex(c => c.id === col.id);
            this.openColMenu(originalIdx);
          }
