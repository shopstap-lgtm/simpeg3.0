        // Row Credential Lock & Privacy Masking
        unlockedRowIds: new Set(),
        showRowLockSettings: false,
        tempRowLockEnabled: false,
        tempCredentialColId: '',
        tempMaskedColIds: [],

        showAuthModal: false,
        authModalRow: null,
        authInput: '',
        authError: '',

        get hasCredentialLock() {
          return (this.sheetData.columns || []).some(c => c.isCredential);
        },

        get credentialCol() {
          return (this.sheetData.columns || []).find(c => c.isCredential) || 
                 (this.sheetData.columns || []).find(c => c.type === 'nip') || 
                 this.sheetData.columns[0];
        },

        isRowUnlocked(row) {
          if (this.isSuperAdmin) return true;
          if (!this.hasCredentialLock) return true;
          const rowKey = String(row.id || row._localId);
          return this.unlockedRowIds.has(rowKey);
        },

        isCellMasked(row, col) {
          if (this.isSuperAdmin) return false;
          if (!this.hasCredentialLock) return false;
          if (!col.isMasked && !col.requiresAuth) return false;
          if (this.isRowUnlocked(row)) return false;
          const val = row.data?.[col.id];
          return !!(val && String(val).trim().length > 0);
        },

        canEditCell(row, col) {
          if (this.isSuperAdmin) return true;
          if (col.isLocked) return false;
          // Kolom yang bersifat privasi / butuh otorisasi kredensial (requiresAuth atau isMasked)
          // hanya bisa diedit jika baris sudah dibuka (unlocked)
          if (this.hasCredentialLock && (col.requiresAuth || col.isMasked)) {
            return this.isRowUnlocked(row);
          }
          // Kolom umum lainnya bebas diedit oleh publik tanpa kredensial!
          return true;
        },

        openRowAuthModal(row) {
          this.authModalRow = row;
          this.authInput = '';
          this.authError = '';
          this.showAuthModal = true;
          this.$nextTick(() => {
            const inp = document.getElementById('auth-nip-input');
            if (inp) inp.focus();
            if (window.lucide) window.lucide.createIcons();
          });
        },

        verifyRowAuth() {
          if (!this.authModalRow) return;
          const targetCol = this.credentialCol;
          if (!targetCol) return;
          const expectedVal = (this.authModalRow.data?.[targetCol.id] || '').toString().trim().toLowerCase();
          const inputVal = (this.authInput || '').trim().toLowerCase();
          if (!inputVal) {
            this.authError = `Silakan masukkan ${targetCol.name}`;
            return;
          }
          const isNip = targetCol.type === 'nip' || (targetCol.name || '').toLowerCase().includes('nip');
          const normExpected = isNip ? expectedVal.replace(/\D/g, '') : expectedVal;
          const normInput = isNip ? inputVal.replace(/\D/g, '') : inputVal;
          if (normExpected && normInput && normExpected === normInput) {
            const rowKey = String(this.authModalRow.id || this.authModalRow._localId);
            this.unlockedRowIds.add(rowKey);
            try {
              sessionStorage.setItem('sheet_unlocked_' + this.sheetData.id, JSON.stringify(Array.from(this.unlockedRowIds)));
            } catch(e) {}
            this.showAuthModal = false;
            this.authModalRow = null;
            this.authInput = '';
            this.authError = '';
            this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
          } else {
            this.authError = `${targetCol.name} yang dimasukkan tidak sesuai!`;
          }
        },

        initRowLockSettings() {
          this.tempRowLockEnabled = this.hasCredentialLock;
          this.tempCredentialColId = this.credentialCol?.id || this.sheetData.columns[0]?.id || '';
          this.tempMaskedColIds = this.sheetData.columns.filter(c => c.isMasked || c.requiresAuth).map(c => c.id);
        },

        saveRowLockSettings() {
          if (!this.tempRowLockEnabled) {
            this.sheetData.columns.forEach(c => {
              c.isCredential = false;
              c.isMasked = false;
              c.requiresAuth = false;
            });
          } else {
            this.sheetData.columns.forEach(c => {
              c.isCredential = (c.id === this.tempCredentialColId);
              const isProtected = this.tempMaskedColIds.includes(c.id);
              c.isMasked = isProtected;
              c.requiresAuth = isProtected;
            });
          }
          this.showRowLockSettings = false;
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

