        windowWidth: typeof window !== 'undefined' ? window.innerWidth : 1200,
        get isMobile() {
          return this.windowWidth < 768;
        },

        // Fit Window mode: secara default true agar otomatis pas di layar, dapat ditoggle ke normal
        isFitWindow: true,
        
