  <!-- ==========================================
       7. Alpine.js Component Script
       ========================================== -->
  <script>
    function smartGridViewer() {
      let raw = {};
      try {
        const el = document.getElementById('sheet-data');
        raw = JSON.parse(el ? (el.textContent || el.value || '{}') : '{}');
      } catch(e) {
        console.error('Failed to parse sheet data:', e);
      }

      const parsedRows = (raw.rows || []).map((r, idx) => {
        let d = r.data;
        if(typeof d === 'string') try { d = JSON.parse(d); } catch(e){ d = {}; }
        return {
          id: r.id || ('local_' + Date.now() + '_' + idx),
          ...r,
          data: d || {}
        };
      });

      // Default Sort: Jika ada kolom unit kerja, urutkan berdasarkan Unit Kerja dulu, lalu Pegawai
      const unitCol = (raw.columns || []).find(c => 
        c.id === 'c_unit' || (c.name && c.name.toLowerCase().includes('unit'))
      );
      const pegCol = (raw.columns || []).find(c => 
        c.id === 'c_nama' || (c.name && (c.name.toLowerCase().includes('nama') || c.name.toLowerCase().includes('pegawai')))
      );

      if (unitCol) {
        parsedRows.sort((a, b) => {
          const uA = (a.data?.[unitCol.id] || '').toString().trim().toLowerCase();
          const uB = (b.data?.[unitCol.id] || '').toString().trim().toLowerCase();
          const comp = uA.localeCompare(uB, 'id', { numeric: true });
          if (comp !== 0) return comp;
          if (pegCol) {
            const pA = (a.data?.[pegCol.id] || '').toString().trim().toLowerCase();
            const pB = (b.data?.[pegCol.id] || '').toString().trim().toLowerCase();
            return pA.localeCompare(pB, 'id', { numeric: true });
          }
          return 0;
        });
      }

      return {
        sheetData: {
          id: raw.id,
          title: raw.title || 'Spreadsheet',
          description: raw.description || '',
          slug: raw.slug || '',
          columns: (raw.columns || []).map(c => ({
            id: c.id,
            name: c.name || 'Kolom',
            type: c.type || 'text',
            width: c.width || 180,
            options: Array.isArray(c.options) ? c.options : (typeof c.options === 'string' ? c.options.split(/[\n,]+/).map(s=>s.trim()).filter(Boolean) : []),
            isLocked: !!c.isLocked,
            isCredential: !!c.isCredential,
            requiresAuth: !!c.requiresAuth || !!c.isMasked,
            isMasked: !!c.isMasked || !!c.requiresAuth,
            isHidden: !!c.isHidden,
            isFrozen: !!c.isFrozen
          }))
        },
        rows: parsedRows,
        isSuperAdmin: !!raw.isSuperAdmin,

        // Selection & Blok Massal Baris & Kolom
        selectedRowMap: {},
        lastClickedRowId: null,
        selectedColMap: {},
        lastClickedColIdx: null,

        // Bulk Edit Modal State
        showBulkEditModal: false,
        bulkEditColId: '',
        bulkEditValue: '',

        get selectedRowCount() {
          return Object.keys(this.selectedRowMap).length;
        },

        get selectedColCount() {
          return Object.keys(this.selectedColMap).length;
        },

        get isAllDisplayedSelected() {
          const list = this.displayedRows;
          if (list.length === 0) return false;
          return list.every(r => this.selectedRowMap[r.id]);
        },

        isRowSelected(row) {
          return !!this.selectedRowMap[row.id];
        },

        isColSelected(col) {
          return !!this.selectedColMap[col.id];
        },

        handleRowHeaderClick(row, event) {
          const rowId = row.id;
          const isShift = event && event.shiftKey;
          const isCtrl = event && (event.ctrlKey || event.metaKey);

          if (isShift && this.lastClickedRowId) {
            const list = this.displayedRows;
            const idx1 = list.findIndex(r => r.id === this.lastClickedRowId);
            const idx2 = list.findIndex(r => r.id === rowId);

            if (idx1 !== -1 && idx2 !== -1) {
              const start = Math.min(idx1, idx2);
              const end = Math.max(idx1, idx2);
              const newMap = { ...this.selectedRowMap };
              for (let i = start; i <= end; i++) {
                newMap[list[i].id] = true;
              }
              this.selectedRowMap = newMap;
            } else {
              this.selectedRowMap = { ...this.selectedRowMap, [rowId]: true };
            }
          } else if (isCtrl) {
            const newMap = { ...this.selectedRowMap };
            if (newMap[rowId]) {
              delete newMap[rowId];
            } else {
              newMap[rowId] = true;
            }
            this.selectedRowMap = newMap;
            this.lastClickedRowId = rowId;
          } else {
            if (this.selectedRowMap[rowId] && this.selectedRowCount === 1) {
              this.selectedRowMap = {};
              this.lastClickedRowId = null;
            } else {
              this.selectedRowMap = { [rowId]: true };
              this.lastClickedRowId = rowId;
            }
          }
        },

        toggleSelectAllRows() {
          if (this.isAllDisplayedSelected) {
            this.selectedRowMap = {};
            this.lastClickedRowId = null;
          } else {
            const newMap = {};
            this.displayedRows.forEach(r => newMap[r.id] = true);
            this.selectedRowMap = newMap;
          }
        },

        clearRowSelection() {
          this.selectedRowMap = {};
          this.lastClickedRowId = null;
        },

        bulkDeleteSelectedRows() {
          if (!this.isSuperAdmin) return;
          const count = this.selectedRowCount;
          if (count === 0) return;
          if (!confirm(`Yakin ingin menghapus ${count} baris terpilih secara permanen? Data yang dihapus tidak dapat dikembalikan.`)) return;

          const selectedIds = new Set(Object.keys(this.selectedRowMap));
          this.rows = this.rows.filter(r => !selectedIds.has(r.id));
          this.selectedRowMap = {};
          this.lastClickedRowId = null;
          
          this.rows.forEach((r, idx) => { r.rowIndex = idx; });

          this.saveImmediately();
        },

        bulkClearSelectedRows() {
          const count = this.selectedRowCount;
          if (count === 0) return;
          if (!confirm(`Kosongkan semua isi data pada ${count} baris terpilih? (Baris tidak dihapus, hanya isinya yang dikosongkan).`)) return;

          const selectedIds = new Set(Object.keys(this.selectedRowMap));
          this.rows.forEach(r => {
            if (selectedIds.has(r.id)) {
              this.sheetData.columns.forEach(c => {
                if (this.canEditCell(r, c)) {
                  r.data[c.id] = '';
                }
              });
            }
          });

          this.saveImmediately();
        },

        toggleSelectCol(col, event) {
          const isShift = event && event.shiftKey;
          const isCtrl = event && (event.ctrlKey || event.metaKey);
          const colIdx = this.visibleColumns.findIndex(c => c.id === col.id);

          if (isShift && this.lastClickedColIdx !== null) {
            const start = Math.min(this.lastClickedColIdx, colIdx);
            const end = Math.max(this.lastClickedColIdx, colIdx);
            const newMap = { ...this.selectedColMap };
            for (let i = start; i <= end; i++) {
              newMap[this.visibleColumns[i].id] = true;
            }
            this.selectedColMap = newMap;
          } else if (isCtrl) {
            const newMap = { ...this.selectedColMap };
            if (newMap[col.id]) delete newMap[col.id];
            else newMap[col.id] = true;
            this.selectedColMap = newMap;
            this.lastClickedColIdx = colIdx;
          } else {
            if (this.selectedColMap[col.id] && this.selectedColCount === 1) {
              this.selectedColMap = {};
              this.lastClickedColIdx = null;
            } else {
              this.selectedColMap = { [col.id]: true };
              this.lastClickedColIdx = colIdx;
            }
          }
        },

        clearColSelection() {
          this.selectedColMap = {};
          this.lastClickedColIdx = null;
        },

        bulkDeleteSelectedCols() {
          if (!this.isSuperAdmin) return;
          const count = this.selectedColCount;
          if (count === 0) return;
          if (this.sheetData.columns.length - count < 1) {
            return alert('Spreadsheet harus menyisakan minimal 1 kolom!');
          }
          if (!confirm(`Yakin ingin menghapus ${count} kolom terpilih beserta seluruh datanya?`)) return;

          const colIdsToDelete = new Set(Object.keys(this.selectedColMap));
          this.sheetData.columns = this.sheetData.columns.filter(c => !colIdsToDelete.has(c.id));
          this.rows.forEach(r => {
            if (r.data) {
              colIdsToDelete.forEach(cid => delete r.data[cid]);
            }
          });
          this.selectedColMap = {};
          this.lastClickedColIdx = null;
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        bulkClearSelectedCols() {
          const count = this.selectedColCount;
          if (count === 0) return;
          if (!confirm(`Kosongkan semua data pada ${count} kolom terpilih untuk seluruh baris?`)) return;

          const colIdsToClear = new Set(Object.keys(this.selectedColMap));
          this.rows.forEach(r => {
            if (r.data) {
              colIdsToClear.forEach(cid => {
                const col = this.sheetData.columns.find(c => c.id === cid);
                if (!col || this.canEditCell(r, col)) {
                  r.data[cid] = '';
                }
              });
            }
          });
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        clearSingleCol(colId) {
          const col = this.sheetData.columns.find(c => c.id === colId);
          if (!col) return;
          if (!confirm(`Kosongkan semua data pada kolom "${col.name}" untuk seluruh baris?`)) return;
          this.rows.forEach(r => {
            if (r.data && this.canEditCell(r, col)) {
              r.data[colId] = '';
            }
          });
          this.closeHeaderMenu();
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        openBulkEditModal() {
          if (this.selectedRowCount === 0) return;
          if (this.visibleColumns.length > 0) {
            this.bulkEditColId = this.visibleColumns[0].id;
          }
          this.bulkEditValue = '';
          this.showBulkEditModal = true;
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        getActiveBulkEditCol() {
          return this.sheetData.columns.find(c => c.id === this.bulkEditColId) || null;
        },

        applyBulkEdit() {
          if (!this.bulkEditColId) return;
          const col = this.sheetData.columns.find(c => c.id === this.bulkEditColId);
          if (!col) return;

          const selectedIds = new Set(Object.keys(this.selectedRowMap));
          let count = 0;
          this.rows.forEach(r => {
            if (selectedIds.has(r.id) && this.canEditCell(r, col)) {
              r.data[col.id] = this.bulkEditValue;
              count++;
            }
          });

          this.showBulkEditModal = false;
          this.saveImmediately();
          this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },
        
        // Deskripsi Banner & Modal State
