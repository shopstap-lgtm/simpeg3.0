<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= sheet.title %> - Smart Sheets</title>
  <link rel="stylesheet" href="/css/styles.css?v=20261007_grid">
  <script src="/js/lucide.min.js"></script>
  <script defer src="/js/alpine.min.js"></script>
  <style>
    /* Spreadsheet Grid Scroller */
    .grid-scroller {
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }
    .grid-scroller::-webkit-scrollbar { width: 8px; height: 8px; }
    .grid-scroller::-webkit-scrollbar-track { background: #f8fafc; }
    .grid-scroller::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .grid-scroller::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    /* Spreadsheet Cell Styles */
    .cell-input {
      width: 100%; height: 100%;
      background: transparent;
      outline: none;
      padding: 0.375rem 0.625rem;
      font-size: 0.8125rem;
      border: 1.5px solid transparent;
      transition: background-color 0.15s, border-color 0.15s;
    }
    .cell-input:focus {
      border-color: #4f46e5; 
      background: #ffffff;
      box-shadow: inset 0 0 0 1px #4f46e5;
    }
    .cell-readonly {
      background-color: #f8fafc;
      cursor: default;
      color: #475569;
    }
    .cell-wrap {
      position: relative;
      height: 100%;
      min-height: 34px;
    }
    /* Fit Window Table Compact Styling */
    .fit-window-table .cell-input {
      font-size: 0.75rem;
      padding: 0.25rem 0.375rem;
    }
    .fit-window-table select.cell-input {
      font-size: 0.75rem;
      padding: 0.25rem 0.25rem;
    }
    .fit-window-table th {
      padding-left: 0.25rem !important;
      padding-right: 0.25rem !important;
    }
    /* Mobile Responsive: Izinkan scroll horizontal agar tabel tetap lega dan terbaca */
    @media (max-width: 767px) {
      .grid-scroller {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
      }
      .grid-scroller table,
      .fit-window-table {
        width: max-content !important;
        min-width: 100% !important;
      }
      .grid-scroller table th,
      .grid-scroller table td,
      .fit-window-table th,
      .fit-window-table td {
        min-width: 130px !important;
      }
      .grid-scroller table th.col-index,
      .grid-scroller table td.col-index,
      .fit-window-table th.col-index,
      .fit-window-table td.col-index {
        width: 44px !important;
        min-width: 44px !important;
        max-width: 44px !important;
      }
      .grid-scroller table th.col-auth,
      .grid-scroller table td.col-auth,
      .fit-window-table th.col-auth,
      .fit-window-table td.col-auth {
        width: 96px !important;
        min-width: 96px !important;
        max-width: 96px !important;
      }
      .grid-scroller table th.col-add,
      .fit-window-table th.col-add {
        width: 44px !important;
        min-width: 44px !important;
        max-width: 44px !important;
      }
    }
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans h-screen flex flex-col overflow-hidden select-none" x-data="smartGridViewer()">
  <script type="application/json" id="sheet-data"><%- JSON.stringify({ ...sheet, isSuperAdmin: typeof isSuperAdmin !== 'undefined' ? isSuperAdmin : false }) %></script>

  <!-- Hidden File Input for Cell Uploads -->
  <input type="file" x-ref="cellFileInput" @change="onCellFileSelected($event)" class="hidden">

  <!-- ==========================================
       1. Top Navigation Bar (Header)
       ========================================== -->
  <header class="bg-white border-b border-slate-200 px-3 sm:px-5 py-2.5 flex items-center justify-between shrink-0 shadow-2xs z-30">
    <div class="flex items-center gap-3 min-w-0">
      <a href="/admin/smart-sheets" class="p-2 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors shrink-0" title="Kembali ke Dashboard">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
      </a>

      <div class="min-w-0">
        <!-- Title & Description Container -->
        <div class="flex items-center gap-2">
          <!-- Title: Editable for SuperAdmin, Static for others -->
          <template x-if="isSuperAdmin">
            <input type="text" 
                   x-model="sheetData.title" 
                   @input="triggerAutoSave()" 
                   class="font-extrabold text-base text-slate-900 border-b border-transparent hover:border-slate-300 focus:border-indigo-600 outline-none px-1 py-0.5 bg-transparent transition-colors truncate max-w-xs sm:max-w-md" 
                   placeholder="Nama Lembar Kerja">
          </template>
          <template x-if="!isSuperAdmin">
            <h1 class="font-extrabold text-base text-slate-900 px-1 py-0.5 truncate max-w-xs sm:max-w-md" x-text="sheetData.title"></h1>
          </template>

          <!-- Tombol Buka Modal Deskripsi & Petunjuk -->
          <button type="button" 
                  @click="showDescModal = true" 
                  :class="sheetData.description ? 'text-indigo-600 hover:text-indigo-700 bg-indigo-50 border-indigo-200' : 'text-slate-400 hover:text-slate-600 bg-slate-50 border-slate-200'"
                  class="p-1 rounded-lg border transition-colors shrink-0 shadow-2xs cursor-pointer flex items-center gap-1 text-[11px] font-semibold px-2"
                  :title="isSuperAdmin ? 'Edit Deskripsi & Petunjuk Spreadsheet' : 'Lihat Deskripsi & Petunjuk Spreadsheet'">
            <i data-lucide="info" class="w-3.5 h-3.5"></i>
            <span class="hidden sm:inline" x-text="sheetData.description ? 'Deskripsi' : (isSuperAdmin ? '+ Deskripsi' : '')"></span>
          </button>
        </div>

        <!-- Realtime Cloud Sync Status & Description Snippet -->
        <div class="flex items-center gap-2 text-[11px] text-slate-400 px-1 mt-0.5">
          <template x-if="saveState === 'saving'">
            <span class="text-indigo-600 flex items-center gap-1 font-medium">
              <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i> Menyimpan...
            </span>
          </template>
          <template x-if="saveState === 'saved'">
            <span class="text-emerald-600 flex items-center gap-1 font-medium">
              <i data-lucide="cloud-check" class="w-3 h-3"></i> Tersimpan otomatis
            </span>
          </template>
          <template x-if="saveState === 'dirty'">
            <span class="text-amber-600 flex items-center gap-1 font-medium">
              <i data-lucide="circle-dot" class="w-2.5 h-2.5"></i> Menyimpan perubahan...
            </span>
          </template>
          <template x-if="saveState === 'error'">
            <span class="text-rose-600 flex items-center gap-1 font-medium">
              <i data-lucide="alert-circle" class="w-3 h-3"></i> Gagal menyimpan otomatis
            </span>
          </template>

          <!-- Inline Description Snippet (Jika ada) -->
          <template x-if="sheetData.description">
            <span class="text-slate-500 truncate max-w-xs sm:max-w-sm hidden md:inline-flex items-center gap-1 cursor-pointer hover:text-indigo-600 transition"
                  @click="showDescModal = true"
                  :title="sheetData.description">
              <span>•</span>
              <span class="truncate" x-text="sheetData.description"></span>
            </span>
          </template>
        </div>
      </div>
    </div>

    <!-- Right Header Actions -->
    <div class="flex items-center gap-2 shrink-0">
      <button type="button" 
              @click="openShareModal()" 
              class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition cursor-pointer shadow-2xs">
        <i data-lucide="share-2" class="w-3.5 h-3.5 text-indigo-600"></i>
        <span>Bagikan</span>
      </button>
    </div>
  </header>

  <!-- ==========================================
       2. Compact Toolbar (Clean & Sederhana)
       ========================================== -->
  <div class="bg-white border-b border-slate-200 px-3 sm:px-4 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0 z-20">
    <div class="flex items-center gap-2 flex-wrap">
      
      <!-- Realtime Keyword Search Input -->
      <div class="relative w-44 sm:w-64">
        <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        <input type="text" 
               x-model="searchQuery" 
               placeholder="Cari kata kunci..." 
               class="w-full pl-8 pr-7 py-1.5 text-xs bg-slate-100 hover:bg-slate-100/80 focus:bg-white border border-slate-200/60 focus:border-indigo-500 rounded-xl outline-none transition-all text-slate-800">
        <button type="button" 
                x-show="searchQuery" 
                @click="searchQuery = ''" 
                class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-3 h-3"></i>
        </button>
      </div>

      <!-- Filter Button & Dropdown -->
      <div class="relative" x-data="{ open: false }">
        <button type="button" 
                @click="open = !open" 
                :class="activeFilterCol ? 'bg-indigo-50 text-indigo-700 border-indigo-200 font-bold' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'"
                class="px-2.5 py-1.5 rounded-xl border text-xs flex items-center gap-1.5 transition cursor-pointer">
          <i data-lucide="filter" class="w-3.5 h-3.5"></i>
          <span>Filter</span>
          <span x-show="activeFilterCol" class="w-2 h-2 rounded-full bg-indigo-600"></span>
        </button>

        <!-- Filter Popover -->
        <div x-show="open" 
             @click.outside="open = false" 
             x-cloak 
             class="absolute left-0 mt-1 w-64 bg-white rounded-2xl shadow-xl border border-slate-200 p-3 z-50 space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2">
            <span class="text-xs font-bold text-slate-800">Filter Kolom</span>
            <button type="button" @click="resetFilter(); open = false;" class="text-[10px] text-rose-600 hover:underline">Reset</button>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-500 mb-1">Pilih Kolom:</label>
            <select x-model="activeFilterCol" class="w-full text-xs p-1.5 bg-slate-50 border border-slate-200 rounded-lg outline-none">
              <option value="">Semua Kolom</option>
              <template x-for="c in sheetData.columns" :key="c.id">
                <option :value="c.id" x-text="c.name"></option>
              </template>
            </select>
          </div>
          <div x-show="activeFilterCol">
            <label class="block text-[11px] font-semibold text-slate-500 mb-1">Kondisi:</label>
            <select x-model="activeFilterMode" class="w-full text-xs p-1.5 bg-slate-50 border border-slate-200 rounded-lg outline-none">
              <option value="all">Tampilkan Semua</option>
              <option value="filled">Hanya yang Terisi</option>
              <option value="empty">Hanya yang Kosong</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Freeze Columns Dropdown in Toolbar -->
      <div class="relative" x-data="{ open: false }">
        <button type="button" 
                @click="open = !open" 
                :class="hasFrozenColumns ? 'bg-sky-50 text-sky-700 border-sky-300 font-bold' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'"
                class="px-2.5 py-1.5 rounded-xl border text-xs flex items-center gap-1.5 transition cursor-pointer shadow-2xs">
          <i data-lucide="snowflake" class="w-3.5 h-3.5" :class="hasFrozenColumns ? 'text-sky-600' : 'text-slate-400'"></i>
          <span x-text="hasFrozenColumns ? `Bekukan: ${frozenCount} Kolom` : 'Bekukan Kolom'"></span>
          <span x-show="hasFrozenColumns" class="w-2 h-2 rounded-full bg-sky-500"></span>
        </button>

        <div x-show="open" 
             @click.outside="open = false" 
             x-cloak 
             class="absolute left-0 mt-1 w-52 bg-white rounded-2xl shadow-xl border border-slate-200 p-2 z-50 space-y-1">
          <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 flex items-center justify-between">
            <span>Bekukan Kolom (Freeze)</span>
            <i data-lucide="snowflake" class="w-3 h-3 text-sky-500"></i>
          </div>
          <button type="button" 
                  @click="unfreezeAll(); open = false;" 
                  class="w-full text-left px-2 py-1.5 rounded-lg text-xs hover:bg-slate-100 flex items-center justify-between text-slate-700 transition cursor-pointer">
            <span>Tidak Ada (Cairkan)</span>
            <span x-show="!hasFrozenColumns" class="text-sky-600 font-bold">✓</span>
          </button>
          <button type="button" 
                  @click="freezeCount(1); open = false;" 
                  class="w-full text-left px-2 py-1.5 rounded-lg text-xs hover:bg-slate-100 flex items-center justify-between text-slate-700 transition cursor-pointer">
            <span>1 Kolom Pertama</span>
            <span x-show="frozenCount === 1" class="text-sky-600 font-bold">✓</span>
          </button>
          <button type="button" 
                  @click="freezeCount(2); open = false;" 
                  class="w-full text-left px-2 py-1.5 rounded-lg text-xs hover:bg-slate-100 flex items-center justify-between text-slate-700 transition cursor-pointer">
            <span>2 Kolom Pertama</span>
            <span x-show="frozenCount === 2" class="text-sky-600 font-bold">✓</span>
          </button>
          <button type="button" 
                  @click="freezeCount(3); open = false;" 
                  class="w-full text-left px-2 py-1.5 rounded-lg text-xs hover:bg-slate-100 flex items-center justify-between text-slate-700 transition cursor-pointer">
            <span>3 Kolom Pertama</span>
            <span x-show="frozenCount === 3" class="text-sky-600 font-bold">✓</span>
          </button>
        </div>
      </div>

      <!-- Fit Window (Paskan Layar) Toggle: Tampil di layar tablet/desktop -->
      <button type="button" 
              @click="toggleFitWindow()" 
              :class="isFitWindow ? 'bg-indigo-50 text-indigo-700 border-indigo-300 font-bold' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'"
              class="hidden sm:flex px-2.5 py-1.5 rounded-xl border text-xs items-center gap-1.5 transition cursor-pointer shadow-2xs"
              :title="isFitWindow ? 'Mode Paskan Layar aktif (klik untuk ukuran bebas/scroll)' : 'Paskan tabel ke layar (kecilkan kolom otomatis agar muat tanpa scroll)'">
        <i :data-lucide="isFitWindow ? 'minimize-2' : 'maximize-2'" class="w-3.5 h-3.5" :class="isFitWindow ? 'text-indigo-600' : 'text-slate-400'"></i>
        <span x-text="isFitWindow ? 'Paskan Layar' : 'Ukuran Bebas'"></span>
        <span x-show="isFitWindow" class="w-2 h-2 rounded-full bg-indigo-500"></span>
      </button>

      <!-- Super Admin Actions: Kunci Kredensial Baris & Import Database -->
      <template x-if="isSuperAdmin">
        <div class="flex items-center gap-1.5">
          <button type="button" 
                  @click="initRowLockSettings(); showRowLockSettings = true;" 
                  :class="hasCredentialLock ? 'bg-amber-50 border-amber-300 text-amber-800 font-bold' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'"
                  class="border px-2.5 py-1.5 rounded-xl text-xs flex items-center gap-1.5 transition cursor-pointer shadow-2xs"
                  title="Atur Kunci Kredensial Baris & Penyamaran Kolom">
            <i data-lucide="shield-check" class="w-3.5 h-3.5" :class="hasCredentialLock ? 'text-amber-600' : 'text-indigo-600'"></i>
            <span>Kunci Kredensial Baris</span>
            <span x-show="hasCredentialLock" class="w-2 h-2 rounded-full bg-amber-500"></span>
          </button>

          <button type="button" 
                  @click="showImportModal = true" 
                  class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 px-2.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer shadow-2xs">
            <i data-lucide="database" class="w-3.5 h-3.5 text-indigo-600"></i>
            <span>Import Database</span>
          </button>
        </div>
      </template>

      <!-- Tombol Tampilkan Semua Kolom ke Publik (Super Admin) -->
      <template x-if="isSuperAdmin && hasHiddenColumns">
        <button type="button" 
                @click="unhideAllColumns()" 
                class="bg-amber-50 border border-amber-200 hover:bg-amber-100 text-amber-800 px-2.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer shadow-2xs">
          <i data-lucide="eye" class="w-3.5 h-3.5 text-amber-600"></i>
          <span>Tampilkan Semua Kolom ke Publik</span>
        </button>
      </template>
    </div>

    <!-- Info counter -->
    <div class="text-[11px] text-slate-500 flex items-center gap-2">
      <span x-text="`${displayedRows.length.toLocaleString()} Baris`"></span>
      <span x-show="hasCredentialLock" class="text-amber-600 font-semibold">• Kredensial Aktif</span>
      <span x-show="searchQuery || activeFilterCol" class="text-indigo-600 font-semibold">• Terfilter</span>
      <span class="sm:hidden text-[10px] text-slate-400 font-normal">← Geser tabel →</span>
    </div>
  </div>

  <!-- ==========================================
       3. Main Spreadsheet Table (Data Grid)
       ========================================== -->
  <main class="flex-1 overflow-hidden flex flex-col relative bg-slate-100">
    <!-- Collapsible Description / Petunjuk Banner -->
    <template x-if="sheetData.description && showDescBanner">
      <div class="bg-indigo-50/80 border-b border-indigo-200/90 px-4 py-2 flex items-start justify-between gap-3 text-xs text-indigo-950 shrink-0">
        <div class="flex items-start gap-2.5 min-w-0">
          <i data-lucide="info" class="w-4 h-4 text-indigo-600 shrink-0 mt-0.5"></i>
          <div class="min-w-0">
            <span class="font-bold text-indigo-900 block text-[11px] uppercase tracking-wider">Petunjuk & Deskripsi Spreadsheet:</span>
            <p class="text-slate-700 text-xs leading-relaxed whitespace-pre-line mt-0.5" x-text="sheetData.description"></p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <template x-if="isSuperAdmin">
            <button type="button" @click="showDescModal = true" class="text-indigo-700 hover:text-indigo-900 text-[11px] font-bold underline cursor-pointer">Edit</button>
          </template>
          <button type="button" @click="showDescBanner = false" class="text-slate-400 hover:text-slate-600 p-0.5 rounded cursor-pointer" title="Tutup pemberitahuan ini">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>
    </template>
    <div class="flex-1 overflow-auto grid-scroller relative bg-white">
      <table class="border-collapse table-fixed bg-white transition-all duration-150"
             :class="(isFitWindow && !isMobile) ? 'w-full min-w-full fit-window-table' : 'w-max'">
        <!-- Table Headers -->
        <thead class="sticky top-0 z-20 bg-slate-50 shadow-2xs select-none">
          <tr>
            <!-- Row Index Corner Header (Klik untuk Pilih / Blok Semua Baris) -->
            <th class="col-index w-10 sm:w-12 border border-slate-300 text-center font-mono text-[10px] z-30 transition-colors select-none cursor-pointer"
                :class="[
                  (!isFitWindow || isMobile) ? 'sticky left-0' : '',
                  isAllDisplayedSelected ? 'bg-indigo-600 text-white font-bold' : (selectedRowCount > 0 ? 'bg-indigo-100 text-indigo-800 font-bold' : 'bg-slate-100 text-slate-500 hover:bg-slate-200')
                ]"
                style="width: 44px; min-width: 44px;"
                @click="toggleSelectAllRows()"
                :title="isAllDisplayedSelected ? 'Batalkan pilihan semua baris (Esc)' : 'Pilih / Blok semua baris'">
              <div class="flex items-center justify-center h-full">
                <!-- Checkmark saat SEMUA baris terpilih -->
                <svg x-show="isAllDisplayedSelected" class="w-3.5 h-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <!-- Tanda strip tunggal (indeterminate) saat SEBAGIAN baris terpilih -->
                <svg x-show="!isAllDisplayedSelected && selectedRowCount > 0" class="w-3.5 h-3.5 text-indigo-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/>
                </svg>
                <!-- Tanda pagar biasa saat TIDAK ADA baris terpilih -->
                <span x-show="selectedRowCount === 0" class="font-bold">#</span>
              </div>
            </th>
            
            <!-- Sticky Row Credential Access Column Header (jika Kunci Kredensial Baris Aktif) -->
            <template x-if="hasCredentialLock">
              <th class="col-auth w-24 bg-slate-100 border border-slate-300 text-center text-slate-600 font-bold text-[11px] z-30"
                  :class="(!isFitWindow || isMobile) ? 'sticky left-11' : ''"
                  style="width: 96px; min-width: 92px;"
                  title="Status Akses Baris Pegawai">
                <span class="flex items-center justify-center gap-1">
                  <i data-lucide="shield" class="w-3 h-3 text-amber-600"></i> Akses
                </span>
              </th>
            </template>

            <!-- Dynamic Headers (Mendukung Blok Kolom, Freeze & Fit Window) -->
            <template x-for="(col, colIdx) in visibleColumns" :key="col.id">
              <th :data-col-id="col.id" 
                  class="border transition-colors relative group select-none text-center cursor-pointer"
                  :class="{
                    'sticky z-25 shadow-2xs': isColFrozen(colIdx),
                    'border-r-2 border-r-slate-400 shadow-[2px_0_5px_-1px_rgba(0,0,0,0.12)]': isLastFrozenCol(colIdx),
                    'bg-indigo-100/90 border-indigo-400 text-indigo-950 font-black ring-1 ring-inset ring-indigo-400': isColSelected(col),
                    'bg-slate-50 hover:bg-slate-100 border-slate-300 text-slate-700': !isColSelected(col)
                  }"
                  :style="getColHeaderStyle(col, colIdx)"
                  @click="toggleSelectCol(col, $event)"
                  :title="'Klik untuk blok kolom ' + col.name + ' (Tahan Shift untuk blok rentang)'">
                <div class="py-1.5 flex items-center justify-center relative min-h-[34px] pl-2 pr-7">
                  <!-- Centered Title (SuperAdmin: Klik nama kolom untuk buka Pengaturan Kolom) -->
                  <div class="flex items-center justify-center gap-1 truncate min-w-0 w-full"
                       @click.stop="isSuperAdmin ? openColMenuByColId(col.id) : toggleSelectCol(col, $event)"
                       :title="isSuperAdmin ? 'Klik untuk Pengaturan Kolom ' + col.name : 'Kolom ' + col.name">
                    <span class="text-xs font-bold truncate text-center transition" 
                          :class="isSuperAdmin ? 'hover:text-indigo-600 hover:underline cursor-pointer' : (isColSelected(col) ? 'text-indigo-900 font-black' : 'text-slate-700')"
                          x-text="col.name"></span>
                    
                    <!-- Indikator Kolom Dibekukan (Freeze) -->
                    <template x-if="col.isFrozen">
                      <i data-lucide="snowflake" class="w-3 h-3 text-sky-500 shrink-0" title="Kolom Dibekukan (Freeze)"></i>
                    </template>

                    <!-- Indikator Khusus Admin jika kolom disembunyikan dari publik -->
                    <template x-if="isSuperAdmin && col.isHidden">
                      <span class="px-1 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded text-[9px] font-semibold inline-flex items-center gap-0.5 shrink-0" title="Disembunyikan dari publik">
                        <i data-lucide="eye-off" class="w-2.5 h-2.5"></i>
                        <span>Privat</span>
                      </span>
                    </template>
                  </div>

                  <!-- Tombol Filter di Pojok Kanan Header (Tampil Jelas, Tegas, dan Selalu Terlihat) -->
                  <button type="button" 
                          @click.stop="openHeaderMenu(colIdx, $event)" 
                          class="absolute right-1 top-1/2 -translate-y-1/2 w-5.5 h-5.5 rounded-md flex items-center justify-center transition shrink-0 cursor-pointer z-10 shadow-2xs border"
                          :class="activeFilterCol === col.id 
                            ? 'bg-indigo-600 text-white border-indigo-700 shadow-xs' 
                            : 'bg-white hover:bg-indigo-50 text-slate-500 hover:text-indigo-600 border-slate-300 hover:border-indigo-400'"
                          title="Filter, Urutkan & Opsi Kolom">
                    <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                    </svg>
                  </button>
                </div>
              </th>
            </template>
            
            <!-- Super Admin: Add Column Button -->
            <template x-if="isSuperAdmin">
              <th class="col-add w-10 sm:w-12 border border-slate-300 bg-slate-50 hover:bg-slate-100 cursor-pointer"
                  style="width: 44px; min-width: 40px;"
                  @click="addColumn()" 
                  title="Tambah Kolom Baru">
                <div class="flex items-center justify-center h-full">
                  <i data-lucide="plus" class="w-4 h-4 text-slate-500"></i>
                </div>
              </th>
            </template>
          </tr>
        </thead>
        
        <!-- Table Body (Ultra Lightweight: Paginated 60 FPS) -->
        <tbody>
          <!-- Empty State jika kolom belum dibuat sama sekali -->
          <template x-if="visibleColumns.length === 0">
            <tr>
              <td :colspan="(hasCredentialLock ? 2 : 1) + (isSuperAdmin ? 1 : 0)" class="py-14 px-6 text-center bg-slate-50/40">
                <div class="max-w-md mx-auto space-y-2.5">
                  <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shadow-2xs">
                    <i data-lucide="columns" class="w-6 h-6"></i>
                  </div>
                  <div class="text-sm font-black text-slate-800">Spreadsheet Masih Kosong</div>
                  <p class="text-xs text-slate-500 leading-relaxed">
                    Spreadsheet ini baru dibuat dengan kolom kosong. Klik tombol <b class="text-indigo-600 font-bold">+ (Tambah Kolom)</b> di kanan atas tabel atau tombol <b class="text-slate-700 font-bold">Import Database</b> pada toolbar untuk mulai mengisi data.
                  </p>
                  <template x-if="isSuperAdmin">
                    <div class="pt-2">
                      <button type="button" @click="addColumn()" class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold inline-flex items-center gap-1.5 shadow-xs cursor-pointer transition">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Tambah Kolom Pertama
                      </button>
                    </div>
                  </template>
                </div>
              </td>
            </tr>
          </template>

          <template x-for="(row, rowIdx) in paginatedRows" :key="row.id || row._localId">
            <tr class="transition-colors"
                :class="{
                  'bg-indigo-50/70 ring-1 ring-inset ring-indigo-300': isRowSelected(row),
                  'hover:bg-slate-50/60': !isRowSelected(row)
                }">
              <!-- Row Index Sticky Column (Klik / Shift+Klik utk Blok Baris) -->
              <td class="col-index border border-slate-300 text-center font-mono text-[10px] w-10 sm:w-12 cursor-pointer transition-colors select-none"
                  :class="[
                    (!isFitWindow || isMobile) ? 'sticky left-0 z-10' : '',
                    isRowSelected(row) ? 'bg-indigo-600 text-white font-bold shadow-2xs' : 'bg-slate-100 text-slate-500 hover:bg-indigo-100 hover:text-indigo-700'
                  ]"
                  style="width: 44px; min-width: 44px;"
                  @click="handleRowHeaderClick(row, $event)"
                  :title="'Klik untuk blok baris ' + getRowNumber(row, rowIdx) + ' (Tahan Shift untuk blok rentang baris)'">
                <div class="flex items-center justify-center">
                  <span x-show="!isRowSelected(row)" x-text="getRowNumber(row, rowIdx)"></span>
                  <svg x-show="isRowSelected(row)" class="w-3.5 h-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
              </td>
              
              <!-- Sticky Row Auth Button Column (jika Kunci Kredensial Baris Aktif) -->
              <template x-if="hasCredentialLock">
                <td class="col-auth bg-slate-50 border border-slate-300 px-1 py-1 text-center w-24"
                    :class="(!isFitWindow || isMobile) ? 'sticky left-11 z-10' : ''"
                    style="width: 96px; min-width: 92px;">
                  <!-- SuperAdmin: Selalu Terbuka / Admin -->
                  <template x-if="isSuperAdmin">
                    <span class="text-[10px] text-indigo-700 font-bold bg-indigo-50 border border-indigo-200 px-1.5 py-0.5 rounded-full inline-flex items-center justify-center gap-1 shadow-2xs max-w-full truncate">
                      <i data-lucide="shield-check" class="w-3 h-3 text-indigo-600 shrink-0"></i> 
                      <span class="truncate">Admin</span>
                    </span>
                  </template>

                  <!-- Pengunjung Publik -->
                  <template x-if="!isSuperAdmin">
                    <div class="w-full flex items-center justify-center">
                      <template x-if="isRowUnlocked(row)">
                        <span class="text-[10px] text-emerald-700 font-bold bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded-full inline-flex items-center justify-center gap-1 shadow-2xs max-w-full truncate">
                          <i data-lucide="unlock" class="w-2.5 h-2.5 text-emerald-600 shrink-0"></i> 
                          <span class="truncate">Terbuka</span>
                        </span>
                      </template>
                      <template x-if="!isRowUnlocked(row)">
                        <button type="button" 
                                @click="openRowAuthModal(row)" 
                                class="w-full max-w-[90px] px-1.5 py-1 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 rounded-lg text-[10px] font-bold inline-flex items-center justify-center gap-1 transition cursor-pointer shadow-2xs hover:shadow-xs truncate"
                                title="Buka Akses Baris">
                          <i data-lucide="lock" class="w-2.5 h-2.5 text-amber-600 shrink-0"></i> 
                          <span class="truncate whitespace-nowrap">Buka Akses</span>
                        </button>
                      </template>
                    </div>
                  </template>
                </td>
              </template>

              <!-- Dynamic Cells (Mendukung Freeze & Highlight Blok) -->
              <template x-for="(col, colIdx) in visibleColumns" :key="col.id">
                <td class="border border-slate-200 p-0 relative transition-colors" 
                    :class="{
                      'bg-indigo-50/60': isColSelected(col) || isRowSelected(row),
                      'bg-slate-50/70': !isColSelected(col) && !isRowSelected(row) && !canEditCell(row, col) && !isColFrozen(colIdx),
                      'sticky z-10 bg-white': isColFrozen(colIdx) && canEditCell(row, col) && !isRowSelected(row) && !isColSelected(col),
                      'sticky z-10 bg-slate-50': isColFrozen(colIdx) && !canEditCell(row, col) && !isRowSelected(row) && !isColSelected(col),
                      'sticky z-10 bg-indigo-50': isColFrozen(colIdx) && (isRowSelected(row) || isColSelected(col)),
                      'border-r-2 border-r-slate-400 shadow-[2px_0_5px_-1px_rgba(0,0,0,0.12)]': isLastFrozenCol(colIdx)
                    }"
                    :style="isColFrozen(colIdx) ? `left: ${getFrozenLeft(colIdx)};` : ''">
                  <div class="cell-wrap flex items-center">
                    
                    <!-- KONDISI 1: CELL DISAMARKAN (MASKED: Tampilkan Ceklis Sudah) -->
                    <template x-if="isCellMasked(row, col)">
                      <div class="px-2 py-1.5 flex items-center justify-center w-full h-full select-none bg-slate-50/70 cursor-pointer hover:bg-emerald-50/50 transition-colors"
                           @click="!isSuperAdmin && !isRowUnlocked(row) && openRowAuthModal(row)"
                           title="Data sudah diisi dan terkunci privasi. Klik untuk buka akses jika ini baris Anda.">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-bold shadow-2xs">
                          <i data-lucide="check-circle-2" class="w-3 h-3 text-emerald-600"></i> Sudah
                        </span>
                      </div>
                    </template>

                    <!-- KONDISI 2: CELL NORMAL (TIDAK DISAMARKAN) -->
                    <template x-if="!isCellMasked(row, col)">
                      <div class="w-full h-full flex items-center">
                        <!-- 1. Text & NIP Type -->
                        <template x-if="col.type === 'text' || col.type === 'nip'">
                          <div class="w-full h-full flex items-center" 
                               @click="if(!canEditCell(row, col) && hasCredentialLock && (col.requiresAuth || col.isMasked)) openRowAuthModal(row)">
                            <input type="text" 
                                   x-model="row.data[col.id]" 
                                   @input="triggerAutoSave()" 
                                   @blur="saveImmediately()"
                                   class="cell-input" 
                                   :class="{'cell-readonly': !canEditCell(row, col), 'cursor-pointer hover:bg-amber-50/40': !canEditCell(row, col) && hasCredentialLock && (col.requiresAuth || col.isMasked)}"
                                   :readonly="!canEditCell(row, col)"
                                   :placeholder="!canEditCell(row, col) ? (hasCredentialLock && (col.requiresAuth || col.isMasked) && !isRowUnlocked(row) ? 'Terkunci (Perlu Akses)' : '') : '...'">
                          </div>
                        </template>
                        
                        <!-- 2. Select Type -->
                        <template x-if="col.type === 'select'">
                          <div class="w-full h-full flex items-center"
                               @click="if(!canEditCell(row, col) && hasCredentialLock && (col.requiresAuth || col.isMasked)) openRowAuthModal(row)">
                            <select x-model="row.data[col.id]" 
                                    @change="triggerAutoSave(); saveImmediately();" 
                                    class="cell-input cursor-pointer" 
                                    :disabled="!canEditCell(row, col)"
                                    :class="{'opacity-60 bg-slate-50 cursor-pointer': !canEditCell(row, col)}">
                              <option value="">- Pilih -</option>
                              <template x-for="opt in getColOptions(col)" :key="opt">
                                <option :value="opt" x-text="opt"></option>
                              </template>
                            </select>
                          </div>
                        </template>
                        
                        <!-- 3. File Upload Cell -->
                        <template x-if="col.type === 'file'">
                          <div class="px-2 py-1 flex items-center justify-between w-full h-full group">
                            <!-- File already uploaded -->
                            <template x-if="row.data[col.id]">
                              <div class="flex items-center gap-1.5 w-full min-w-0">
                                <a :href="row.data[col.id]" 
                                   target="_blank" 
                                   class="px-2 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-[11px] font-semibold rounded-lg flex items-center gap-1.5 truncate max-w-full transition-colors" 
                                   title="Buka Berkas">
                                  <i data-lucide="file-text" class="w-3 h-3 shrink-0"></i>
                                  <span class="truncate" x-text="extractFileName(row.data[col.id])"></span>
                                </a>
                                <template x-if="canEditCell(row, col)">
                                  <button type="button" 
                                          @click="removeCellFile(row, col.id)" 
                                          class="opacity-0 group-hover:opacity-100 text-slate-400 hover:text-rose-600 p-0.5 rounded transition-opacity shrink-0 cursor-pointer" 
                                          title="Hapus Berkas">
                                    <i data-lucide="x" class="w-3 h-3"></i>
                                  </button>
                                </template>
                              </div>
                            </template>

                            <!-- File empty: Upload Button -->
                            <template x-if="!row.data[col.id]">
                              <div>
                                <template x-if="uploadingCellKey === (row.id + '_' + col.id)">
                                  <span class="text-[10px] text-indigo-600 font-medium flex items-center gap-1 px-1">
                                    <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i> Mengunggah...
                                  </span>
                                </template>
                                <template x-if="uploadingCellKey !== (row.id + '_' + col.id)">
                                  <button type="button" 
                                          @click="canEditCell(row, col) ? triggerCellUpload(row, col.id) : (hasCredentialLock && (col.requiresAuth || col.isMasked) ? openRowAuthModal(row) : null)" 
                                          :disabled="!canEditCell(row, col) && !(hasCredentialLock && (col.requiresAuth || col.isMasked))"
                                          class="text-[11px] flex items-center gap-1 border border-dashed px-2.5 py-1 rounded-lg transition-colors cursor-pointer"
                                          :class="canEditCell(row, col) 
                                            ? 'text-slate-500 hover:text-indigo-600 border-slate-300 hover:border-indigo-400 hover:bg-indigo-50/40' 
                                            : (hasCredentialLock && (col.requiresAuth || col.isMasked) 
                                                ? 'text-amber-700 bg-amber-50/60 border-amber-300 hover:bg-amber-100/70 hover:border-amber-400' 
                                                : 'text-slate-300 border-slate-200 cursor-not-allowed opacity-50')">
                                    <i data-lucide="upload" class="w-3 h-3" :class="!canEditCell(row, col) && hasCredentialLock && (col.requiresAuth || col.isMasked) ? 'text-amber-600' : ''"></i> 
                                    <span x-text="(!canEditCell(row, col) && hasCredentialLock && (col.requiresAuth || col.isMasked)) ? 'Perlu Akses' : 'Upload'"></span>
                                  </button>
                                </template>
                              </div>
                            </template>
                          </div>
                        </template>
                      </div>
                    </template>

                  </div>
                </td>
              </template>
              
              <!-- Extra Cell for SuperAdmin Add Column Header match -->
              <template x-if="isSuperAdmin">
                <td class="w-10 sm:w-12 border border-slate-200 border-l-0 bg-transparent"
                    style="width: 44px; min-width: 40px;"></td>
              </template>
            </tr>
          </template>
          
          <!-- Super Admin: Add Rows Area -->
          <template x-if="isSuperAdmin">
            <tr>
              <td class="bg-slate-100 border border-slate-300"></td>
              <td :colspan="visibleColumns.length + (hasCredentialLock ? 2 : 1)" class="p-2.5 bg-slate-50 border-t border-slate-300">
                <button type="button" 
                        @click="addRows(10)" 
                        class="text-xs text-slate-600 hover:text-slate-900 font-bold flex items-center gap-1.5 px-3 py-1.5 hover:bg-slate-200/70 rounded-xl transition-colors cursor-pointer">
                  <i data-lucide="plus" class="w-3.5 h-3.5"></i> Tambah 10 Baris
                </button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Clean Sticky Pagination Bar (Google Sheets Style: 60 FPS Performance) -->
    <div class="bg-white border-t border-slate-200 px-3 sm:px-5 py-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600 shrink-0 z-20 select-none">
      <div class="flex items-center gap-2">
        <span class="font-medium text-slate-700" x-text="paginationInfo"></span>
        <span x-show="searchQuery || activeFilterCol" class="text-indigo-600 font-semibold">• Terfilter</span>
      </div>

      <div class="flex items-center gap-3">
        <!-- Page size selector -->
        <div class="flex items-center gap-1.5">
          <span class="text-slate-400 text-[11px]">Tampilkan:</span>
          <select x-model="pageSize" @change="currentPage = 1" class="border border-slate-200 rounded-lg px-2 py-1 text-xs bg-slate-50 outline-none cursor-pointer">
            <option value="25">25 baris</option>
            <option value="50">50 baris</option>
            <option value="100">100 baris</option>
            <option value="250">250 baris</option>
            <option value="all">Semua baris</option>
          </select>
        </div>

        <!-- Page buttons -->
        <div class="flex items-center gap-1">
          <button type="button" @click="currentPage = 1" :disabled="currentPage <= 1" class="px-2 py-1 border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold" title="Halaman Pertama">«</button>
          <button type="button" @click="currentPage--" :disabled="currentPage <= 1" class="px-2.5 py-1 border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold" title="Sebelumnya">‹</button>
          <span class="px-2 text-xs font-bold text-slate-800" x-text="`${currentPage} / ${totalPages}`"></span>
          <button type="button" @click="currentPage++" :disabled="currentPage >= totalPages" class="px-2.5 py-1 border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold" title="Berikutnya">›</button>
          <button type="button" @click="currentPage = totalPages" :disabled="currentPage >= totalPages" class="px-2 py-1 border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold" title="Halaman Terakhir">»</button>
        </div>
      </div>
    </div>
  </main>

  <!-- ==========================================
       4. Modal: Bagikan Spreadsheet
       ========================================== -->
  <div x-show="showShareModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 backdrop-blur-xs p-4">
    <div @click.outside="showShareModal = false"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden">
      
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
          <i data-lucide="share-2" class="w-4 h-4 text-indigo-600"></i>
          Bagikan Spreadsheet
        </h3>
        <button type="button" @click="showShareModal = false" class="text-slate-400 hover:text-slate-600 transition-colors">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="p-5 space-y-3">
        <p class="text-xs text-slate-500">Tautan akses pengisian publik untuk lembar kerja ini:</p>
        <div class="flex items-center gap-2">
          <input type="text" readonly :value="shareUrl" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-700 select-all outline-none focus:border-indigo-500">
          <button type="button" @click="copyShareLink()" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 cursor-pointer">
            <i :data-lucide="copied ? 'check' : 'copy'" class="w-3.5 h-3.5"></i>
            <span x-text="copied ? 'Tersalin' : 'Salin Link'"></span>
          </button>
        </div>
        <div x-show="copied" x-transition class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1">
          <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
          <span>Tautan berhasil disalin ke clipboard!</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================
       5. Modal: Import Database (SuperAdmin Only)
       ========================================== -->
  <div x-show="showImportModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 backdrop-blur-xs p-4">
    <div @click.outside="if(!isImporting) showImportModal = false"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
      
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between shrink-0">
        <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
          <i data-lucide="database" class="w-4 h-4 text-indigo-600"></i>
          Import dari Database SIMPEG
        </h3>
        <button type="button" @click="showImportModal = false" :disabled="isImporting" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="p-5 space-y-4 overflow-y-auto flex-1">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2">Pilih Sumber Data:</label>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center gap-2.5 p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors" :class="importForm.source === 'PEGAWAI' ? 'border-indigo-600 bg-indigo-50/40 ring-1 ring-indigo-500' : ''">
              <input type="radio" value="PEGAWAI" x-model="importForm.source" class="text-indigo-600">
              <div>
                <div class="text-xs font-bold text-slate-800">Data Pegawai</div>
                <div class="text-[10px] text-slate-400">Guru & Tenaga Kerja</div>
              </div>
            </label>
            <label class="flex items-center gap-2.5 p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors" :class="importForm.source === 'UNIT' ? 'border-indigo-600 bg-indigo-50/40 ring-1 ring-indigo-500' : ''">
              <input type="radio" value="UNIT" x-model="importForm.source" class="text-indigo-600">
              <div>
                <div class="text-xs font-bold text-slate-800">Data Unit Kerja</div>
                <div class="text-[10px] text-slate-400">Sekolah & Lembaga</div>
              </div>
            </label>
          </div>
        </div>

        <!-- PILIHAN ATRIBUT KOLOM YANG INGIN DIIMPORT -->
        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2.5">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800">
              Pilih Atribut Kolom:
              <span class="text-[11px] font-normal text-slate-500">(<span x-text="selectedImportFieldsCount"></span> dipilih)</span>
            </label>
            <div class="flex items-center gap-2">
              <button type="button" @click="selectAllImportFields()" class="text-[11px] font-semibold text-indigo-600 hover:text-indigo-700 hover:underline cursor-pointer">Pilih Semua</button>
              <span class="text-slate-300">•</span>
              <button type="button" @click="deselectAllImportFields()" class="text-[11px] font-semibold text-slate-500 hover:text-slate-700 hover:underline cursor-pointer">Batal Semua</button>
            </div>
          </div>

          <!-- Atribut Pegawai -->
          <div x-show="importForm.source === 'PEGAWAI'" class="grid grid-cols-2 gap-2 text-xs">
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="nip" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">NIP / Identitas</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="nama" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Nama Pegawai</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="unit" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Unit Kerja</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="jabatan" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Jabatan</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="statusKepegawaian" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Status Kepegawaian</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="nik" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">NIK</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="noHp" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">No. HP / WA</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="npwp" x-model="importForm.pegawaiFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">NPWP</span>
            </label>
          </div>

          <!-- Atribut Unit Kerja -->
          <div x-show="importForm.source === 'UNIT'" class="grid grid-cols-2 gap-2 text-xs">
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer col-span-2">
              <input type="checkbox" value="namaUnit" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Nama Unit Kerja / Sekolah</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="jenjang" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Jenjang</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="kategori" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Kategori</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="kepalaSekolah" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Kepala Sekolah</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="kontakKepalaSekolah" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Kontak Kepala Sekolah</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="operatorSekolah" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Operator Sekolah</span>
            </label>
            <label class="flex items-center gap-2 p-2 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer">
              <input type="checkbox" value="kontakOperator" x-model="importForm.unitFields" class="rounded text-indigo-600">
              <span class="text-slate-700 font-medium">Kontak Operator</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2">Mode Penyisipan:</label>
          <div class="flex items-center gap-4 text-xs">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" value="append" x-model="importForm.mode" class="text-indigo-600">
              <span class="text-slate-700">Tambah ke Bawah</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" value="replace" x-model="importForm.mode" class="text-indigo-600">
              <span class="text-slate-700">Gantikan Semua Baris</span>
            </label>
          </div>
        </div>
      </div>

      <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2 shrink-0">
        <button type="button" @click="showImportModal = false" :disabled="isImporting" class="px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-200 rounded-xl cursor-pointer">Batal</button>
        <button type="button" @click="runImport()" :disabled="isImporting || selectedImportFieldsCount === 0" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white rounded-xl text-xs font-bold flex items-center gap-2 cursor-pointer">
          <span x-show="isImporting"><i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i></span>
          <span x-text="isImporting ? 'Mengimpor...' : 'Mulai Import'"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ==========================================
       6. Modal: Pengaturan Kolom (SuperAdmin Only)
       ========================================== -->
  <div x-show="showColMenu" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 backdrop-blur-xs p-4">
    <div @click.outside="showColMenu = false"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="bg-white rounded-2xl shadow-xl border border-slate-200 w-80 overflow-hidden flex flex-col">
      <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <h3 class="font-bold text-sm text-slate-800">Pengaturan Kolom</h3>
        <button type="button" @click="showColMenu = false" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="p-4 space-y-3.5">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Nama Kolom</label>
          <input type="text" x-model="activeCol.name" @input="triggerAutoSave()" class="w-full px-3 py-1.5 border border-slate-300 rounded-xl text-xs focus:border-indigo-500 outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Tipe Data</label>
          <select x-model="activeCol.type" 
                  @change="if(activeCol.type === 'select' && (!activeCol.options || activeCol.options.length === 0)) { activeColOptionsText = 'PNS, PPPK, HONORER'; updateActiveColOptions(); } triggerAutoSave();" 
                  class="w-full px-3 py-1.5 border border-slate-300 rounded-xl text-xs focus:border-indigo-500 outline-none">
            <option value="text">Teks Bebas</option>
            <option value="nip">NIP / Identitas (Kunci)</option>
            <option value="select">Pilihan (Dropdown)</option>
            <option value="file">Upload File / Berkas</option>
          </select>
        </div>

        <!-- Pilihan Dropdown Kustom -->
        <div x-show="activeCol.type === 'select'" class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl space-y-1.5">
          <label class="block text-xs font-bold text-slate-700">Daftar Pilihan Dropdown:</label>
          <textarea x-model="activeColOptionsText" 
                    @input="updateActiveColOptions()" 
                    rows="3" 
                    class="w-full px-2.5 py-1.5 border border-slate-300 rounded-lg text-xs focus:border-indigo-500 outline-none bg-white font-mono" 
                    placeholder="Contoh: PNS, PPPK, HONORER (pisahkan dengan koma atau baris baru)"></textarea>
          <p class="text-[10px] text-slate-400 leading-tight">Tulis pilihan opsi dropdown di atas (pisahkan dengan koma atau baris baru).</p>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Lebar Kolom (px)</label>
          <input type="number" x-model.number="activeCol.width" @input="triggerAutoSave()" class="w-full px-3 py-1.5 border border-slate-300 rounded-xl text-xs focus:border-indigo-500 outline-none">
        </div>
        <div class="pt-2 border-t border-slate-100 space-y-2.5">
          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="isLocked" x-model="activeCol.isLocked" @change="triggerAutoSave()" class="rounded text-indigo-600 mt-0.5">
            <div>
              <span class="text-xs font-bold text-slate-700 block">Kunci Kolom (Read-Only Publik)</span>
              <span class="text-[10px] text-slate-400 block mt-0.5 leading-tight">Responden publik tidak bisa mengedit atau mengupload di kolom ini.</span>
            </div>
          </label>

          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="isCredential" x-model="activeCol.isCredential" @change="triggerAutoSave()" class="rounded text-amber-600 mt-0.5">
            <div>
              <span class="text-xs font-bold text-slate-700 block">Jadikan Kunci Kredensial Baris</span>
              <span class="text-[10px] text-slate-400 block mt-0.5 leading-tight">Pengunjung wajib mencocokkan nilai kolom ini untuk membuka akses baris.</span>
            </div>
          </label>

          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="isMasked" x-model="activeCol.isMasked" @change="activeCol.requiresAuth = activeCol.isMasked; triggerAutoSave();" class="rounded text-emerald-600 mt-0.5">
            <div>
              <span class="text-xs font-bold text-slate-700 block">Wajib Buka Akses & Samarkan Privasi</span>
              <span class="text-[10px] text-slate-400 block mt-0.5 leading-tight">Pengunjung wajib buka akses untuk mengisi kolom ini. Data disamarkan ("✓ Sudah") bagi pengunjung umum.</span>
            </div>
          </label>
        </div>
        
        <div class="flex items-center justify-between pt-3 border-t border-slate-100">
          <button type="button" @click="deleteActiveCol()" class="text-xs text-rose-600 font-bold hover:underline cursor-pointer">Hapus Kolom</button>
          <button type="button" @click="showColMenu = false; saveImmediately();" class="bg-indigo-600 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold hover:bg-indigo-700 cursor-pointer">Selesai</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================
       7. Floating Header Menu (SORT, FILTER, GESER, SEMBUNYIKAN, HAPUS)
       ========================================== -->
  <div x-show="showHeaderMenu" 
       x-cloak 
       @click.outside="closeHeaderMenu()"
       class="fixed z-50 bg-white rounded-2xl shadow-xl border border-slate-200 w-64 py-1.5 text-xs select-none"
       :style="`top: ${headerMenuPos.top}; left: ${headerMenuPos.left};`">
    
    <!-- Title / Column Name -->
    <div class="px-3.5 py-2 border-b border-slate-100 flex items-center justify-between bg-slate-50/80">
      <div class="truncate min-w-0 pr-2">
        <span class="text-[10px] text-slate-400 block uppercase font-bold tracking-wider">Opsi Kolom</span>
        <span class="font-bold text-slate-800 text-xs truncate block" x-text="activeMenuCol.name"></span>
      </div>
      <button type="button" @click="closeHeaderMenu()" class="text-slate-400 hover:text-slate-600 p-0.5"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>

    <!-- 1. SORT SECTION -->
    <div class="p-1 border-b border-slate-100">
      <div class="px-2.5 py-0.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Urutkan (Sort)</div>
      <button type="button" 
              @click="sortByCol(activeMenuCol.id, 'asc')"
              class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 flex items-center gap-2 transition cursor-pointer">
        <i data-lucide="arrow-up-a-z" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
        <span>Urutkan A → Z (Menaik)</span>
      </button>
      <button type="button" 
              @click="sortByCol(activeMenuCol.id, 'desc')"
              class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 flex items-center gap-2 transition cursor-pointer">
        <i data-lucide="arrow-down-z-a" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
        <span>Urutkan Z → A (Menurun)</span>
      </button>
    </div>

    <!-- 2. FILTER SECTION -->
    <div class="p-1 border-b border-slate-100">
      <div class="px-2.5 py-0.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Filter Data</div>
      <button type="button" 
              @click="filterColMode(activeMenuCol.id, 'all')"
              :class="activeFilterCol === activeMenuCol.id && activeFilterMode === 'all' ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-100'"
              class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between transition cursor-pointer">
        <span class="flex items-center gap-2">
          <i data-lucide="list" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
          <span>Tampilkan Semua</span>
        </span>
        <span x-show="!activeFilterCol || (activeFilterCol === activeMenuCol.id && activeFilterMode === 'all')">✓</span>
      </button>
      <button type="button" 
              @click="filterColMode(activeMenuCol.id, 'filled')"
              :class="activeFilterCol === activeMenuCol.id && activeFilterMode === 'filled' ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-100'"
              class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between transition cursor-pointer">
        <span class="flex items-center gap-2">
          <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i>
          <span>Hanya yang Terisi</span>
        </span>
        <span x-show="activeFilterCol === activeMenuCol.id && activeFilterMode === 'filled'">✓</span>
      </button>
      <button type="button" 
              @click="filterColMode(activeMenuCol.id, 'empty')"
              :class="activeFilterCol === activeMenuCol.id && activeFilterMode === 'empty' ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-100'"
              class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between transition cursor-pointer">
        <span class="flex items-center gap-2">
          <i data-lucide="circle-slash" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
          <span>Hanya yang Kosong</span>
        </span>
        <span x-show="activeFilterCol === activeMenuCol.id && activeFilterMode === 'empty'">✓</span>
      </button>
    </div>

    <!-- BEKUKAN KOLOM (FREEZE) -->
    <div class="p-1 border-b border-slate-100">
      <div class="px-2.5 py-0.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Bekukan (Freeze)</div>
      <template x-if="!activeMenuCol.isFrozen">
        <button type="button" 
                @click="freezeUpTo(activeMenuColIdx)"
                class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 flex items-center gap-2 transition cursor-pointer">
          <i data-lucide="snowflake" class="w-3.5 h-3.5 text-sky-600 shrink-0"></i>
          <span>Bekukan Hingga Kolom Ini</span>
        </button>
      </template>
      <template x-if="activeMenuCol.isFrozen">
        <button type="button" 
                @click="unfreezeAll()"
                class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-sky-50 text-sky-700 font-semibold flex items-center gap-2 transition cursor-pointer">
          <i data-lucide="snowflake" class="w-3.5 h-3.5 text-sky-600 shrink-0"></i>
          <span>Batal Bekukan Kolom (Cairkan)</span>
        </button>
      </template>
    </div>

    <!-- 3. GESER KOLOM HORIZONTAL (SuperAdmin) -->
    <template x-if="isSuperAdmin">
      <div class="p-1 border-b border-slate-100">
        <div class="px-2.5 py-0.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Geser Kolom</div>
        <div class="grid grid-cols-2 gap-1 px-1 py-0.5">
          <button type="button" 
                  @click.stop="moveColumn(activeMenuColIdx, -1)" 
                  :disabled="activeMenuColIdx <= 0"
                  class="px-2 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-700 flex items-center justify-center gap-1 disabled:opacity-40 disabled:cursor-not-allowed transition text-xs font-semibold cursor-pointer">
            <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i> Kiri
          </button>
          <button type="button" 
                  @click.stop="moveColumn(activeMenuColIdx, 1)" 
                  :disabled="activeMenuColIdx >= visibleColumns.length - 1"
                  class="px-2 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-700 flex items-center justify-center gap-1 disabled:opacity-40 disabled:cursor-not-allowed transition text-xs font-semibold cursor-pointer">
            Kanan <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>
    </template>

    <!-- 4. SEMBUNYIKAN & PENGATURAN (Super Admin) -->
    <template x-if="isSuperAdmin">
      <div class="p-1">
        <button type="button" 
                @click="toggleHideColumn(activeMenuColIdx)"
                class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 flex items-center justify-between transition cursor-pointer">
          <span class="flex items-center gap-2">
            <i data-lucide="eye-off" class="w-3.5 h-3.5 text-slate-500 shrink-0" x-show="!activeMenuCol.isHidden"></i>
            <i data-lucide="eye" class="w-3.5 h-3.5 text-indigo-600 shrink-0" x-show="activeMenuCol.isHidden"></i>
            <span x-text="activeMenuCol.isHidden ? 'Tampilkan ke Publik' : 'Sembunyikan dari Publik'"></span>
          </span>
          <span x-show="activeMenuCol.isHidden" class="text-[10px] text-amber-600 font-bold bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200">Privat</span>
        </button>

        <!-- Blok / Sorot Kolom Ini -->
        <button type="button" 
                @click="toggleSelectCol(activeMenuCol, $event); closeHeaderMenu();"
                class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 flex items-center gap-2 transition cursor-pointer mt-0.5">
          <i data-lucide="layers" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
          <span x-text="isColSelected(activeMenuCol) ? 'Batalkan Blok Kolom' : 'Blok / Pilih Kolom Ini'"></span>
        </button>

        <!-- Kosongkan Seluruh Isi Kolom Ini -->
        <button type="button" 
                @click="clearSingleCol(activeMenuCol.id)"
                class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 flex items-center gap-2 transition cursor-pointer mt-0.5">
          <i data-lucide="eraser" class="w-3.5 h-3.5 text-amber-500 shrink-0"></i>
          <span>Kosongkan Seluruh Isi Kolom</span>
        </button>
        
        <button type="button" 
                @click="deleteColFromMenu(activeMenuColIdx)"
                class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-rose-50 text-rose-600 flex items-center gap-2 transition cursor-pointer mt-0.5">
          <i data-lucide="trash-2" class="w-3.5 h-3.5 shrink-0"></i>
          <span>Hapus Kolom</span>
        </button>
      </div>
    </template>

  </div>

  <!-- ==========================================
       8. Modal: Pengaturan Kunci Kredensial Baris (SuperAdmin Only)
       ========================================== -->
  <div x-show="showRowLockSettings" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 backdrop-blur-xs p-4">
    <div @click.outside="showRowLockSettings = false"
         class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden flex flex-col">
      <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-2">
          <i data-lucide="shield-check" class="w-4 h-4 text-indigo-600"></i>
          <h3 class="font-bold text-sm text-slate-800">Kunci Kredensial & Privasi Baris</h3>
        </div>
        <button type="button" @click="showRowLockSettings = false" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div class="p-4 space-y-4">
        <!-- Toggle Status -->
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200/80">
          <div>
            <span class="text-xs font-bold text-slate-800 block">Aktifkan Kunci Kredensial Baris</span>
            <span class="text-[10px] text-slate-500 block">Pengunjung wajib memasukkan kredensial untuk membuka & mengisi baris miliknya.</span>
          </div>
          <input type="checkbox" x-model="tempRowLockEnabled" class="rounded text-indigo-600 scale-125 cursor-pointer">
        </div>

        <!-- Pilihan Kolom Kredensial -->
        <div x-show="tempRowLockEnabled">
          <label class="block text-xs font-bold text-slate-700 mb-1">Kolom yang Dijadikan Kredensial Pembuka:</label>
          <select x-model="tempCredentialColId" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs bg-white focus:border-indigo-500 outline-none cursor-pointer">
            <template x-for="c in sheetData.columns" :key="c.id">
              <option :value="c.id" x-text="`${c.name} (${c.type.toUpperCase()})`"></option>
            </template>
          </select>
          <p class="text-[10px] text-slate-400 mt-1">Pengunjung harus memasukkan nilai yang cocok dari kolom ini (contoh: NIP) untuk membuka baris.</p>
        </div>

