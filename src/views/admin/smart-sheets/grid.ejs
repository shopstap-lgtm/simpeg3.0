        saveState: 'saved',
        saveTimer: null,

        // Search & Filter
        searchQuery: '',
        activeFilterCol: '',
        activeFilterMode: 'all',

        // Pagination & High Performance
        pageSize: 50,
        currentPage: 1,

        get totalPages() {
          if (this.pageSize === 'all') return 1;
          const sz = parseInt(this.pageSize) || 50;
          return Math.max(1, Math.ceil(this.displayedRows.length / sz));
        },

        get paginatedRows() {
          const list = this.displayedRows;
          if (this.pageSize === 'all') return list;
          const sz = parseInt(this.pageSize) || 50;
          const start = (this.currentPage - 1) * sz;
          return list.slice(start, start + sz);
        },

        get paginationInfo() {
          const total = this.displayedRows.length;
          if (total === 0) return '0 baris';
          if (this.pageSize === 'all') return `Menampilkan semua ${total.toLocaleString()} baris`;
          const sz = parseInt(this.pageSize) || 50;
          const start = (this.currentPage - 1) * sz + 1;
          const end = Math.min(total, this.currentPage * sz);
          return `Menampilkan ${start.toLocaleString()} - ${end.toLocaleString()} dari ${total.toLocaleString()} baris`;
        },

        getRowNumber(row, rowIdx) {
          if (this.pageSize === 'all') return (row.rowIndex !== undefined ? (row.rowIndex + 1) : (rowIdx + 1));
          const sz = parseInt(this.pageSize) || 50;
          return (this.currentPage - 1) * sz + rowIdx + 1;
        },

        // Visible Columns: Admin selalu melihat semua kolom, Publik hanya melihat kolom yang tidak disembunyikan
        get visibleColumns() {
          if (this.isSuperAdmin) {
            return this.sheetData.columns || [];
          }
          return (this.sheetData.columns || []).filter(c => !c.isHidden);
        },

