<%- include('../../partials/head') %>
<%- include('../../partials/admin-nav', { page: 'admin-smart-sheets' }) %>
<%- include('../../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6" x-data="smartSheetManager()">
  <!-- Page Header: Clean & Sederhana -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Smart Sheets</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Kelola lembar kerja dan data tabel interaktif.</p>
    </div>
    <div>
      <button @click="showCreateModal = true" class="btn-primary py-2.5 px-4 text-xs font-bold gap-2 shadow-sm rounded-xl">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Buat Spreadsheet Baru</span>
      </button>
    </div>
  </div>

  <!-- Sheets List -->
  <% if (sheets && sheets.length > 0) { %>
    <div class="space-y-3">
      <% sheets.forEach(sheet => { %>
        <div class="custom-card bg-white border border-slate-200/90 hover:border-indigo-300 rounded-2xl shadow-2xs hover:shadow-xs transition-all p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Info Column -->
          <div class="flex items-start gap-3.5 min-w-0 flex-1">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 mt-0.5 <%= sheet.status === 'ACTIVE' ? 'bg-indigo-50 text-indigo-600 border border-indigo-200' : 'bg-slate-100 text-slate-500 border border-slate-200' %>">
              <i data-lucide="table-2" class="w-5 h-5"></i>
            </div>
            
            <div class="min-w-0 flex-1 space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-bold text-slate-900 text-sm sm:text-base tracking-tight truncate max-w-xl">
                  <%= sheet.title %>
                </h3>
                
                <!-- Status Badge -->
                <% if (sheet.status === 'ACTIVE') { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10.5px] border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Dibuka</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 font-extrabold text-[10.5px] border border-rose-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                    <span>Ditutup</span>
                  </span>
                <% } %>
              </div>

              <% if (sheet.description) { %>
                <p class="text-xs text-slate-500 line-clamp-1 max-w-2xl">
                  <%= sheet.description %>
                </p>
              <% } %>

              <!-- Meta specs row -->
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-400 font-medium pt-0.5">
                <span class="text-slate-600 font-mono font-bold"><%= sheet._count ? sheet._count.rows : (sheet.rows ? sheet.rows.length : 0) %> Baris</span>
                <span>•</span>
                <span>Slug: <span class="font-mono text-slate-600">/smart-sheet/<%= sheet.slug %></span></span>
                <span>•</span>
                <span><%= new Date(sheet.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </div>
            </div>
          </div>

          <!-- Actions Group (Tombol Tutup, Buka Link, Salin Link, Buka Grid, dll) -->
          <div class="flex flex-wrap items-center gap-2 pt-3 lg:pt-0 border-t lg:border-t-0 border-slate-100 shrink-0">
            <!-- 1. Tombol Tutup / Buka Sheet -->
            <form action="/admin/smart-sheets/<%= sheet.id %>/toggle-status" method="POST" class="inline">
              <% if (sheet.status === 'ACTIVE') { %>
                <button type="submit" 
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200/90 transition shadow-2xs cursor-pointer"
                        title="Tutup lembar kerja agar tidak menerima perubahan data baru">
                  <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-600"></i>
                  <span>Tutup Sheet</span>
                </button>
              <% } else { %>
                <button type="submit" 
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/90 transition shadow-2xs cursor-pointer"
                        title="Buka kembali lembar kerja untuk menerima pengisian">
                  <i data-lucide="unlock" class="w-3.5 h-3.5 text-emerald-600"></i>
                  <span>Buka Sheet</span>
                </button>
              <% } %>
            </form>

            <!-- 2. Tombol Buka Link -->
            <a href="/smart-sheet/<%= sheet.slug %>" target="_blank"
               class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 transition shadow-2xs cursor-pointer"
               title="Buka Tampilan Publik di Tab Baru">
              <i data-lucide="external-link" class="w-3.5 h-3.5 text-indigo-600"></i>
              <span>Buka Link</span>
            </a>

            <!-- 3. Tombol Salin Link -->
            <button type="button" 
                    @click="copyLink('<%= sheet.slug %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
                    :class="copiedSlug === '<%= sheet.slug %>' ? 'bg-emerald-50 text-emerald-700 border border-emerald-300' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200'"
                    title="Salin tautan spreadsheet publik ke clipboard">
              <span x-show="copiedSlug === '<%= sheet.slug %>'" class="inline-flex items-center gap-1.5 text-emerald-700">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i>
                <span>Tersalin!</span>
              </span>
              <span x-show="copiedSlug !== '<%= sheet.slug %>'" class="inline-flex items-center gap-1.5">
                <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500"></i>
                <span>Salin Link</span>
              </span>
            </button>

            <!-- 4. Tombol Buka Grid -->
            <a href="/admin/smart-sheets/<%= sheet.slug %>" 
               class="btn-primary bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-3.5 text-xs font-bold gap-1.5 rounded-xl shadow-2xs">
              <i data-lucide="table" class="w-3.5 h-3.5"></i>
              <span>Buka Grid</span>
            </a>

            <!-- Extra Action Buttons -->
            <div class="flex items-center gap-1 pl-1">
              <a href="/admin/smart-sheets/<%= sheet.id %>/export" 
                 class="p-2 rounded-xl text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 transition cursor-pointer"
                 title="Unduh Rekap Excel (.xlsx)">
                <i data-lucide="download" class="w-4 h-4"></i>
              </a>

              <button @click="deleteSheet('<%= sheet.id %>')" 
                      class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                      title="Hapus Spreadsheet">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>

          </div>

        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl border border-slate-200/80 p-12 text-center shadow-2xs">
      <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-2xl mx-auto flex items-center justify-center mb-3">
        <i data-lucide="table-2" class="w-6 h-6"></i>
      </div>
      <h3 class="text-base font-bold text-slate-800 mb-1">Belum Ada Spreadsheet</h3>
      <p class="text-slate-400 text-xs mb-5">Mulai dengan membuat spreadsheet baru.</p>
      <button @click="showCreateModal = true" class="btn-primary py-2 px-4 text-xs font-bold gap-2 rounded-xl">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Buat Spreadsheet</span>
      </button>
    </div>
  <% } %>

  <!-- Modal Buat Spreadsheet -->
  <div x-show="showCreateModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 backdrop-blur-xs p-4">
    <div @click.outside="if(!isSubmitting) showCreateModal = false"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden">
      
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-base text-slate-900">Buat Spreadsheet Baru</h3>
        <button @click="showCreateModal = false" :disabled="isSubmitting" class="text-slate-400 hover:text-slate-600 transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Judul Spreadsheet <span class="text-rose-500">*</span></label>
          <input type="text" x-model="form.title" @keydown.enter="createSheet()" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" placeholder="Contoh: Pendataan Pegawai 2026">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Deskripsi (Opsional)</label>
          <textarea x-model="form.description" rows="2" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all resize-none" placeholder="Keterangan singkat..."></textarea>
        </div>
      </div>

      <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2">
        <button @click="showCreateModal = false" :disabled="isSubmitting" class="btn-secondary py-2 px-3 text-xs font-semibold rounded-xl">Batal</button>
        <button @click="createSheet()" :disabled="!form.title.trim() || isSubmitting" class="btn-primary py-2 px-4 text-xs font-bold gap-2 rounded-xl">
          <span x-show="isSubmitting"><i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i></span>
          <span x-text="isSubmitting ? 'Membuat...' : 'Buat Spreadsheet'"></span>
        </button>
      </div>
    </div>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.lucide) window.lucide.createIcons();
  });

  function smartSheetManager() {
    return {
      showCreateModal: false,
      isSubmitting: false,
      form: { title: '', description: '' },
      copiedSlug: null,

      copyLink(slug) {
        const url = window.location.origin + '/smart-sheet/' + slug;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(() => {
            this.copiedSlug = slug;
            setTimeout(() => { if (this.copiedSlug === slug) this.copiedSlug = null; }, 2000);
          }).catch(() => {
            prompt('Salin link spreadsheet publik berikut:', url);
          });
        } else {
          prompt('Salin link spreadsheet publik berikut:', url);
        }
      },

      async createSheet() {
        if (!this.form.title.trim() || this.isSubmitting) return;
        this.isSubmitting = true;
        try {
          const res = await fetch('/admin/smart-sheets', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.form)
          });
          const data = await res.json();
          if (data.success) {
            window.location.href = `/admin/smart-sheets/${data.slug}`;
          } else {
            alert('Gagal membuat: ' + (data.message || 'Terjadi kesalahan'));
            this.isSubmitting = false;
          }
        } catch (e) {
          alert('Terjadi kesalahan koneksi.');
          this.isSubmitting = false;
        }
      },

      async deleteSheet(id) {
        if (!confirm('Hapus spreadsheet ini? Data di dalamnya tidak dapat dikembalikan.')) return;
        try {
          const res = await fetch(`/admin/smart-sheets/${id}/delete`, { method: 'POST' });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Gagal menghapus');
          }
        } catch (e) {
          alert('Error menghapus spreadsheet');
        }
      }
    };
  }
</script>

<%- include('../../partials/admin-footer') %>
