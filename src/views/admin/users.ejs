<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6"
      x-data="{
        addUserModal: false,
        editUserModal: false,
        username: '',
        email: '',
        namaLengkap: '',
        password: '',
        role: 'ADMIN_KORWIL',
        editUserData: {
          id: '',
          username: '',
          namaLengkap: '',
          email: '',
          role: 'ADMIN_KORWIL',
          password: ''
        },
        openEdit(admin) {
          this.editUserData = {
            id: admin.id,
            username: admin.username,
            namaLengkap: admin.namaLengkap,
            email: admin.email || '',
            role: admin.role,
            password: ''
          };
          this.editUserModal = true;
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Kelola Admin</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Manajemen akun dan hak akses Super Admin, Admin Korwil, dan Admin Dinas</p>
    </div>
  </div>

  <!-- Master Data Overview Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
        <i data-lucide="users" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Total Pegawai Terdaftar</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= totalEmployees || 0 %> Pegawai</p>
      </div>
    </div>

    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <i data-lucide="building-2" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Unit Kerja / Sekolah</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= totalUnits || 0 %> Unit</p>
      </div>
    </div>

    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <i data-lucide="shield-check" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Akun Administrator</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= admins.length %> Akun Aktif</p>
      </div>
    </div>
  </div>

  <!-- Users Table / Cards Card -->
  <div class="custom-card p-5 sm:p-6 bg-white shadow-xs space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
          <i data-lucide="shield" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900">Daftar Akun Pengelola Portal</h2>
          <p class="text-xs text-slate-500">Super Admin, Admin Korwil, dan Admin Dinas</p>
        </div>
      </div>

      <!-- Tambah Admin Baru Button -->
      <button @click="addUserModal = true" class="btn-primary gap-1.5 text-xs shadow-indigo-100 self-start sm:self-auto">
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        <span>Tambah Admin Baru</span>
      </button>
    </div>

    <!-- MOBILE VIEW: Stacked Cards (sm and down) -->
    <div class="block lg:hidden space-y-4">
      <% admins.forEach(function(admin) { 
          let roleBadgeClass = 'bg-indigo-100 text-indigo-800';
          let roleLabel = 'Admin Korwil';
          if (admin.role === 'SUPER_ADMIN') {
            roleBadgeClass = 'bg-amber-100 text-amber-800 border-amber-200';
            roleLabel = 'Super Admin';
          } else if (admin.role === 'ADMIN_DINAS') {
            roleBadgeClass = 'bg-purple-100 text-purple-800 border-purple-200';
            roleLabel = 'Admin Dinas';
          } else {
            roleBadgeClass = 'bg-blue-100 text-blue-800 border-blue-200';
            roleLabel = 'Admin Korwil';
          }
      %>
        <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/50 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white font-bold flex items-center justify-center text-sm">
                <%= admin.namaLengkap.charAt(0) %>
              </div>
              <div>
                <h3 class="font-bold text-sm text-slate-900"><%= admin.namaLengkap %></h3>
                <p class="text-xs text-indigo-600 font-semibold">@<%= admin.username %></p>
              </div>
            </div>

            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold border <%= roleBadgeClass %>">
              <%= roleLabel %>
            </span>
          </div>

          <div class="p-3 rounded-xl bg-white border border-slate-200 text-xs space-y-1.5">
            <div class="flex items-center justify-between text-slate-600">
              <span class="text-slate-400">Email:</span>
              <span class="font-semibold text-slate-800"><%= admin.email || '-' %></span>
            </div>
            <div class="flex items-center justify-between text-slate-600">
              <span class="text-slate-400">Dibuat:</span>
              <span class="text-slate-700"><%= admin.createdAt %></span>
            </div>
          </div>

          <!-- Actions -->
          <div class="pt-2 border-t border-slate-200 flex items-center justify-end gap-2">
            <button type="button" 
                    @click="openEdit(<%= JSON.stringify(admin) %>)" 
                    class="btn-secondary py-1.5 px-3 text-xs gap-1">
              <i data-lucide="edit-3" class="w-3.5 h-3.5 text-indigo-600"></i>
              <span>Edit</span>
            </button>

            <% if (admin.role !== 'SUPER_ADMIN' || admin.username !== 'superadmin') { %>
              <form action="/admin/users/<%= admin.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus akun ini?');" class="inline">
                <button type="submit" class="btn-danger py-1.5 px-3 text-xs gap-1">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  <span>Hapus</span>
                </button>
              </form>
            <% } else { %>
              <span class="text-[11px] text-slate-400 italic">Akun Utama</span>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- DESKTOP VIEW: Clean Modern Table (lg and up) -->
    <div class="hidden lg:block overflow-x-auto custom-scrollbar">
      <table class="w-full text-left text-xs border-collapse">
        <thead class="bg-slate-100/80 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-5 py-3.5 min-w-[220px]">Pengguna</th>
            <th class="px-4 py-3.5 min-w-[140px]">Username</th>
            <th class="px-4 py-3.5 min-w-[180px]">Email Resmi</th>
            <th class="px-4 py-3.5 text-center min-w-[160px]">Peran / Akses</th>
            <th class="px-4 py-3.5 text-center">Tanggal Dibuat</th>
            <th class="px-5 py-3.5 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% admins.forEach(function(admin) { 
              let roleBadgeClass = 'bg-indigo-100 text-indigo-800';
              let roleLabel = 'Admin Korwil';
              if (admin.role === 'SUPER_ADMIN') {
                roleBadgeClass = 'bg-amber-100 text-amber-800 border-amber-200';
                roleLabel = 'Super Admin';
              } else if (admin.role === 'ADMIN_DINAS') {
                roleBadgeClass = 'bg-purple-100 text-purple-800 border-purple-200';
                roleLabel = 'Admin Dinas';
              } else {
                roleBadgeClass = 'bg-blue-100 text-blue-800 border-blue-200';
                roleLabel = 'Admin Korwil';
              }
          %>
            <tr class="hover:bg-slate-50/80 transition-colors">
              
              <!-- Pengguna -->
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white font-bold flex items-center justify-center text-xs shadow-xs">
                    <%= admin.namaLengkap.charAt(0) %>
                  </div>
                  <div>
                    <div class="font-bold text-slate-900 text-xs"><%= admin.namaLengkap %></div>
                    <div class="text-[11px] text-slate-400">ID: <%= admin.id.substring(0, 8) %>...</div>
                  </div>
                </div>
              </td>

              <!-- Username -->
              <td class="px-4 py-3.5 font-mono text-slate-700 font-semibold">
                @<%= admin.username %>
              </td>

              <!-- Email -->
              <td class="px-4 py-3.5 text-slate-600">
                <%= admin.email || '-' %>
              </td>

              <!-- Role -->
              <td class="px-4 py-3.5 text-center whitespace-nowrap">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold border <%= roleBadgeClass %>">
                  <%= roleLabel %>
                </span>
              </td>

              <!-- Tanggal Dibuat -->
              <td class="px-4 py-3.5 text-center text-slate-500 text-[11px]">
                <%= admin.createdAt %>
              </td>

              <!-- Aksi -->
              <td class="px-5 py-3.5 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-1.5">
                  <!-- Edit Button -->
                  <button type="button" 
                          @click="openEdit(<%= JSON.stringify(admin) %>)" 
                          class="p-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 text-indigo-600 transition-colors" 
                          title="Ubah Akun Admin">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                  </button>

                  <!-- Delete Button -->
                  <% if (admin.role !== 'SUPER_ADMIN' || admin.username !== 'superadmin') { %>
                    <form action="/admin/users/<%= admin.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus akun ini?');" class="inline">
                      <button type="submit" class="p-1.5 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors shadow-2xs" title="Hapus Akun">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-slate-400 text-xs italic px-1">Permanen</span>
                  <% } %>
                </div>
              </td>

            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>

  <% const isSuperAdmin = (locals.currentAdmin && locals.currentAdmin.role === 'SUPER_ADMIN') || (locals.user && locals.user.role === 'SUPER_ADMIN'); %>
  <% if (isSuperAdmin) { %>
  <!-- Role Menu Visibility Configuration Card (Khusus Super Admin) -->
  <div class="custom-card p-5 sm:p-6 bg-white shadow-xs space-y-6"
       x-data="{
         toggleAll(role, state) {
           const checkboxes = document.querySelectorAll('input[data-role=\'' + role + '\']');
           checkboxes.forEach(cb => {
             if (!cb.disabled) {
               cb.checked = state;
             }
           });
         }
       }">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center shrink-0">
          <i data-lucide="sliders" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900">Pengaturan Tampilan Menu Admin per Role</h2>
          <p class="text-xs text-slate-500">Centang atau hilangkan centang menu yang ingin dimunculkan di sidebar navigasi masing-masing peran</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-violet-50 text-violet-700 border border-violet-200">
          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
          Khusus Super Admin
        </span>
      </div>
    </div>

    <!-- Info Banner -->
    <div class="p-3.5 rounded-xl bg-blue-50/70 border border-blue-200/70 text-blue-900 flex items-start gap-3 text-xs leading-relaxed">
      <i data-lucide="info" class="w-4 h-4 text-blue-600 shrink-0 mt-0.5"></i>
      <div>
        <span class="font-bold">Info Hak Akses:</span> Menu yang tidak dicentang otomatis disembunyikan dari sidebar navigasi dan diblokir dari akses rute langsung. Menu <span class="font-semibold text-slate-900">Kelola Admin</span> untuk peran <span class="font-semibold text-amber-700">Super Admin</span> dikunci permanen agar Super Admin tidak kehilangan kontrol sistem.
      </div>
    </div>

    <form action="/admin/users/menu-permissions" method="POST" class="space-y-6">
      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-100/80 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="px-5 py-3.5 min-w-[240px]">Menu Navigasi Sidebar</th>
              
              <!-- Super Admin Column -->
              <th class="px-4 py-3.5 text-center min-w-[170px]">
                <div class="flex flex-col items-center gap-1">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border bg-amber-100 text-amber-800 border-amber-200">
                    Super Admin
                  </span>
                  <div class="flex items-center gap-1.5 text-[10px] font-normal text-slate-500 lowercase">
                    <button type="button" @click="toggleAll('SUPER_ADMIN', true)" class="hover:text-indigo-600 underline">semua</button>
                    <span>/</span>
                    <button type="button" @click="toggleAll('SUPER_ADMIN', false)" class="hover:text-rose-600 underline">batal</button>
                  </div>
                </div>
              </th>

              <!-- Admin Korwil Column -->
              <th class="px-4 py-3.5 text-center min-w-[170px]">
                <div class="flex flex-col items-center gap-1">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border bg-blue-100 text-blue-800 border-blue-200">
                    Admin Korwil
                  </span>
                  <div class="flex items-center gap-1.5 text-[10px] font-normal text-slate-500 lowercase">
                    <button type="button" @click="toggleAll('ADMIN_KORWIL', true)" class="hover:text-indigo-600 underline">semua</button>
                    <span>/</span>
                    <button type="button" @click="toggleAll('ADMIN_KORWIL', false)" class="hover:text-rose-600 underline">batal</button>
                  </div>
                </div>
              </th>

              <!-- Admin Dinas Column -->
              <th class="px-4 py-3.5 text-center min-w-[170px]">
                <div class="flex flex-col items-center gap-1">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border bg-purple-100 text-purple-800 border-purple-200">
                    Admin Dinas
                  </span>
                  <div class="flex items-center gap-1.5 text-[10px] font-normal text-slate-500 lowercase">
                    <button type="button" @click="toggleAll('ADMIN_DINAS', true)" class="hover:text-indigo-600 underline">semua</button>
                    <span>/</span>
                    <button type="button" @click="toggleAll('ADMIN_DINAS', false)" class="hover:text-rose-600 underline">batal</button>
                  </div>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% (menuConfig || []).forEach(function(item) { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <!-- Menu Info -->
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center shrink-0">
                      <i data-lucide="<%= item.icon %>" class="w-4 h-4"></i>
                    </div>
                    <div>
                      <div class="font-bold text-slate-900 text-xs flex items-center gap-1.5">
                        <%= item.label %>
                        <span class="text-[10px] font-mono text-slate-400 font-normal"><%= item.path %></span>
                      </div>
                      <div class="text-[11px] text-slate-500"><%= item.description %></div>
                    </div>
                  </div>
                </td>

                <!-- Super Admin Checkbox -->
                <td class="px-4 py-3.5 text-center">
                  <% if (item.id === 'users') { %>
                    <div class="inline-flex flex-col items-center gap-0.5">
                      <input type="checkbox" checked disabled class="w-4 h-4 rounded text-indigo-600 border-slate-300 opacity-75 cursor-not-allowed">
                      <input type="hidden" name="perm_SUPER_ADMIN_users" value="on">
                      <span class="text-[9px] font-semibold text-slate-400">Terkunci</span>
                    </div>
                  <% } else { %>
                    <% const isCheckedSuper = (menuPermissions['SUPER_ADMIN'] || []).includes(item.id); %>
                    <label class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 cursor-pointer transition-colors">
                      <input type="checkbox" 
                             data-role="SUPER_ADMIN" 
                             name="perm_SUPER_ADMIN_<%= item.id %>" 
                             class="w-4 h-4 rounded text-indigo-600 border-slate-300 focus:ring-indigo-500 cursor-pointer"
                             <%= isCheckedSuper ? 'checked' : '' %>>
                    </label>
                  <% } %>
                </td>

                <!-- Admin Korwil Checkbox -->
                <td class="px-4 py-3.5 text-center">
                  <% const isCheckedKorwil = (menuPermissions['ADMIN_KORWIL'] || []).includes(item.id); %>
                  <label class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 cursor-pointer transition-colors">
                    <input type="checkbox" 
                           data-role="ADMIN_KORWIL" 
                           name="perm_ADMIN_KORWIL_<%= item.id %>" 
                           class="w-4 h-4 rounded text-indigo-600 border-slate-300 focus:ring-indigo-500 cursor-pointer"
                           <%= isCheckedKorwil ? 'checked' : '' %>>
                  </label>
                </td>

                <!-- Admin Dinas Checkbox -->
                <td class="px-4 py-3.5 text-center">
                  <% const isCheckedDinas = (menuPermissions['ADMIN_DINAS'] || []).includes(item.id); %>
                  <label class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 cursor-pointer transition-colors">
                    <input type="checkbox" 
                           data-role="ADMIN_DINAS" 
                           name="perm_ADMIN_DINAS_<%= item.id %>" 
                           class="w-4 h-4 rounded text-indigo-600 border-slate-300 focus:ring-indigo-500 cursor-pointer"
                           <%= isCheckedDinas ? 'checked' : '' %>>
                  </label>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-100">
        <button type="button" 
                @click="if (confirm('Kembalikan hak akses semua menu ke pengaturan default sistem?')) { $refs.resetPermissionsForm.submit(); }"
                class="btn-secondary text-rose-600 hover:bg-rose-50 border-rose-200 text-xs py-2 px-4 gap-1.5 w-full sm:w-auto justify-center">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          <span>Kembalikan ke Default</span>
        </button>

        <div class="flex items-center gap-2.5 w-full sm:w-auto">
          <button type="submit" class="btn-primary py-2 px-5 text-xs gap-2 shadow-indigo-100 w-full sm:w-auto justify-center">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Simpan Hak Akses Menu</span>
          </button>
        </div>
      </div>
    </form>

    <!-- Hidden form for reset -->
    <form x-ref="resetPermissionsForm" action="/admin/users/menu-permissions/reset" method="POST" class="hidden"></form>
  </div>
  <% } %>

  <!-- ALPINE.JS MODAL 1: TAMBAH ADMIN BARU (3 ROLES) -->
  <template x-teleport="body">
    <div x-show="addUserModal" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 !m-0 !mt-0 modal-overlay z-modal overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
         style="display: none; margin: 0 !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; z-index: 999999 !important;">
    
    <div @click.away="addUserModal = false"
         class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl border border-slate-100 space-y-5">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <i data-lucide="user-plus" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900">Tambah Administrator Baru</h3>
            <p class="text-xs text-slate-500">Pilih salah satu dari 3 hak akses peran</p>
          </div>
        </div>
        <button @click="addUserModal = false" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Add Form -->
      <form action="/admin/users/create" method="POST" class="space-y-3.5">
        
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Username *</label>
          <input type="text" name="username" required class="form-input text-xs font-bold" placeholder="Contoh: adminkorwil">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Nama Lengkap</label>
          <input type="text" name="namaLengkap" class="form-input text-xs" placeholder="Contoh: Rahmat Hidayat, S.Pd.">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Email Resmi (Opsional)</label>
          <input type="email" name="email" class="form-input text-xs" placeholder="Boleh dikosongkan">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Kata Sandi Awal *</label>
          <input type="password" name="password" required class="form-input text-xs" placeholder="••••••••">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Peran Akses (3 Pilihan Role) *</label>
          <select name="role" class="form-select text-xs font-semibold">
