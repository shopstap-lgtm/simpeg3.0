<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6"
      x-data="{
        addModal: false,
        editModal: false,
        deleteModal: false,
        bulkDeleteModal: false,
        selectedUnits: [],
        selectAll: false,
        toggleSelectAll(ids) {
          if (this.selectAll) {
            this.selectedUnits = [...ids];
          } else {
            this.selectedUnits = [];
          }
        },
        addKategori: 'NEGERI',
        addJenjang: 'SD',
        editData: { id: '', namaUnit: '', kategori: 'NEGERI', jenjang: 'SD', kepalaSekolah: '', kontakKepalaSekolah: '', operatorSekolah: '', kontakOperator: '' },
        deleteData: { id: '', namaUnit: '' },
        openEdit(unit) {
          this.editData = {
            id: unit.id,
            namaUnit: unit.namaUnit,
            kategori: unit.kategori || 'NEGERI',
            jenjang: unit.jenjang || 'SD',
            kepalaSekolah: unit.kepalaSekolah || '',
            kontakKepalaSekolah: unit.kontakKepalaSekolah || '',
            operatorSekolah: unit.operatorSekolah || '',
            kontakOperator: unit.kontakOperator || ''
          };
          this.editModal = true;
        },
        openDelete(unit) {
          this.deleteData = { id: unit.id, namaUnit: unit.namaUnit };
          this.deleteModal = true;
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Unit Kerja / Sekolah</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Kelola daftar sekolah negeri dan swasta beserta informasi kepala sekolah & operator di Korwil Cibitung</p>
    </div>
    <button @click="addModal = true"
            id="btn-tambah-unit"
            class="btn-primary py-2.5 px-4 text-xs gap-2 shadow-xs self-start md:self-auto">
      <i data-lucide="plus" class="w-4 h-4"></i>
      <span>Tambah Unit Kerja</span>
    </button>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center shrink-0">
        <i data-lucide="building-2" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Total Unit</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= totalUnits %> Unit</p>
      </div>
    </div>
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
        <i data-lucide="school" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Sekolah Negeri</span>
        <p class="text-xl font-extrabold text-indigo-700 mt-0.5"><%= typeof totalNegeri !== 'undefined' ? totalNegeri : units.filter(u => u.kategori === 'NEGERI').length %> Unit</p>
      </div>
    </div>
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <i data-lucide="landmark" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Sekolah Swasta</span>
        <p class="text-xl font-extrabold text-amber-600 mt-0.5"><%= typeof totalSwasta !== 'undefined' ? totalSwasta : units.filter(u => u.kategori === 'SWASTA').length %> Unit</p>
      </div>
    </div>
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <i data-lucide="users" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Total Pegawai</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= units.reduce((sum, u) => sum + u.totalPegawaiAktif, 0) %> Orang</p>
      </div>
    </div>
  </div>

  <!-- Search & Table -->
  <div class="custom-card bg-white overflow-hidden shadow-xs">
    <!-- Toolbar: Category Filter Tabs & Search Bar -->
    <div class="p-4 sm:p-5 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-3.5">
      <!-- Category Filter Tabs -->
      <div class="inline-flex p-1 rounded-2xl bg-slate-100 border border-slate-200/80 text-xs font-semibold shrink-0">
        <a href="/admin/unit-kerja?kategori=all<%= search ? '&search=' + encodeURIComponent(search) : '' %>"
           class="px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5 <%= (!kategori || kategori === 'all') ? 'bg-white text-slate-900 shadow-xs font-bold' : 'text-slate-500 hover:text-slate-800' %>">
          <span>Semua</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] <%= (!kategori || kategori === 'all') ? 'bg-slate-200/70 text-slate-800' : 'bg-slate-200 text-slate-600' %>"><%= totalUnits %></span>
        </a>
        <a href="/admin/unit-kerja?kategori=NEGERI<%= search ? '&search=' + encodeURIComponent(search) : '' %>"
           class="px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5 <%= kategori === 'NEGERI' ? 'bg-indigo-600 text-white shadow-xs font-bold' : 'text-slate-500 hover:text-slate-800' %>">
          <i data-lucide="school" class="w-3.5 h-3.5"></i>
          <span>Negeri</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] <%= kategori === 'NEGERI' ? 'bg-indigo-700 text-white' : 'bg-slate-200 text-slate-600' %>"><%= typeof totalNegeri !== 'undefined' ? totalNegeri : units.filter(u => u.kategori === 'NEGERI').length %></span>
        </a>
        <a href="/admin/unit-kerja?kategori=SWASTA<%= search ? '&search=' + encodeURIComponent(search) : '' %>"
           class="px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5 <%= kategori === 'SWASTA' ? 'bg-amber-500 text-white shadow-xs font-bold' : 'text-slate-500 hover:text-slate-800' %>">
          <i data-lucide="landmark" class="w-3.5 h-3.5"></i>
          <span>Swasta</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] <%= kategori === 'SWASTA' ? 'bg-amber-600 text-white' : 'bg-slate-200 text-slate-600' %>"><%= typeof totalSwasta !== 'undefined' ? totalSwasta : units.filter(u => u.kategori === 'SWASTA').length %></span>
        </a>
      </div>

      <!-- Search Bar -->
      <form action="/admin/unit-kerja" method="GET" class="flex gap-2.5 items-center w-full md:w-auto">
        <% if (typeof kategori !== 'undefined' && kategori && kategori !== 'all') { %>
          <input type="hidden" name="kategori" value="<%= kategori %>">
        <% } %>
        <div class="relative flex-1 md:w-64">
          <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
          <input type="text"
                 name="search"
                 value="<%= search %>"
                 placeholder="Cari nama sekolah / kepala / operator..."
                 class="w-full pl-9 pr-4 py-2 text-xs font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 placeholder:text-slate-400 transition-all">
        </div>
        <button type="submit" class="btn-secondary py-2 px-3.5 text-xs gap-1.5">
          <i data-lucide="search" class="w-3.5 h-3.5"></i>
          <span>Cari</span>
        </button>
        <% if (search) { %>
          <a href="/admin/unit-kerja<%= kategori && kategori !== 'all' ? '?kategori=' + kategori : '' %>" class="btn-secondary py-2 px-2.5 text-xs gap-1 text-rose-600 border-rose-200 hover:bg-rose-50" title="Reset Pencarian">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </a>
        <% } %>
      </form>
    </div>

    <!-- Bulk Actions Floating Strip -->
    <div x-show="selectedUnits.length > 0" 
         x-transition
         class="p-3 bg-amber-50/95 border border-amber-200 rounded-2xl flex flex-wrap items-center justify-between gap-3 shadow-xs m-4 mb-2"
         style="display: none;">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-900">
        <i data-lucide="check-square" class="w-4 h-4 text-amber-600"></i>
        <span x-text="`${selectedUnits.length} unit kerja dipilih`"></span>
      </div>

      <div class="flex items-center flex-wrap gap-2">
        <!-- Form Bulk Set Negeri -->
        <form method="POST" action="/admin/unit-kerja/bulk-kategori" class="inline">
          <input type="hidden" name="ids" :value="JSON.stringify(selectedUnits)">
          <input type="hidden" name="kategori" value="NEGERI">
          <button type="submit" class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-indigo-700 hover:bg-indigo-50 hover:border-indigo-300">
            <i data-lucide="school" class="w-3.5 h-3.5 text-indigo-600"></i>
            <span>Set ke Negeri</span>
          </button>
        </form>

        <!-- Form Bulk Set Swasta -->
        <form method="POST" action="/admin/unit-kerja/bulk-kategori" class="inline">
          <input type="hidden" name="ids" :value="JSON.stringify(selectedUnits)">
          <input type="hidden" name="kategori" value="SWASTA">
          <button type="submit" class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-amber-700 hover:bg-amber-100 hover:border-amber-300">
            <i data-lucide="landmark" class="w-3.5 h-3.5 text-amber-600"></i>
            <span>Set ke Swasta</span>
          </button>
        </form>

        <!-- Bulk Delete Button -->
        <button type="button" 
                @click="bulkDeleteModal = true"
                class="btn-secondary py-1.5 px-3 text-xs gap-1.5 text-rose-700 hover:bg-rose-50 hover:border-rose-300">
          <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-600"></i>
          <span>Hapus</span>
        </button>

        <!-- Batal -->
        <button type="button" 
                @click="selectedUnits = []; selectAll = false;"
                class="py-1.5 px-2.5 text-xs text-slate-500 hover:text-slate-700 font-medium">
          Batal
        </button>
      </div>
    </div>

    <!-- Desktop Table -->
    <div class="hidden sm:block overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead class="bg-slate-50 text-slate-600 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
          <tr class="h-10">
            <th class="py-3 px-3 w-10 text-center">
              <input type="checkbox" 
                     x-model="selectAll" 
                     @change="toggleSelectAll(<%= JSON.stringify(units.map(u => u.id)) %>)"
                     class="w-4 h-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500/20 cursor-pointer">
            </th>
            <th class="px-3 py-3 w-10">No</th>
            <th class="px-4 py-3">Nama Unit Kerja / Sekolah</th>
            <th class="px-4 py-3 text-center w-24">Jenjang</th>
            <th class="px-4 py-3 text-center w-28">Kategori</th>
            <th class="px-4 py-3">Kepala Sekolah / Unit</th>
            <th class="px-4 py-3">TU / Operator Sekolah</th>
            <th class="px-4 py-3 text-center w-24">Pegawai</th>
            <th class="px-4 py-3 text-right w-32">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (units.length === 0) { %>
            <tr>
              <td colspan="9" class="py-16 text-center text-slate-500">
                <i data-lucide="building-2" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
                <p class="font-bold text-slate-700">
                  <% if (search) { %>Tidak ada unit yang cocok dengan "<%= search %>"<% } else { %>Belum ada unit kerja terdaftar untuk kategori ini<% } %>
                </p>
                <% if (!search) { %><p class="text-xs text-slate-400 mt-1">Klik tombol "Tambah Unit Kerja" untuk mulai menambahkan data</p><% } %>
              </td>
            </tr>
          <% } %>
          <% units.forEach(function(unit, idx) { %>
            <tr class="hover:bg-amber-50/30 transition-colors">
              <td class="py-3 px-3 text-center">
                <input type="checkbox" 
                       :value="'<%= unit.id %>'" 
                       x-model="selectedUnits" 
                       class="w-4 h-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500/20 cursor-pointer">
              </td>
              <td class="px-3 py-3 text-slate-400 font-mono text-[11px]"><%= idx + 1 %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl <%= unit.kategori === 'SWASTA' ? 'bg-amber-100 text-amber-600' : 'bg-indigo-100 text-indigo-600' %> flex items-center justify-center shrink-0">
                    <i data-lucide="<%= unit.kategori === 'SWASTA' ? 'landmark' : 'school' %>" class="w-4 h-4"></i>
                  </div>
                  <div>
                    <p class="font-bold text-slate-900 text-xs"><%= unit.namaUnit %></p>
                    <p class="text-[10px] text-slate-400 mt-0.5">ID: <span class="font-mono"><%= unit.id.substring(0, 8) %>...</span></p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-center">
                <% 
                  let jenjangColor = 'bg-blue-50 text-blue-700 border-blue-200';
                  const j = (unit.jenjang || 'SD').toUpperCase();
                  if (j === 'SMP') jenjangColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                  else if (j === 'SMA') jenjangColor = 'bg-violet-50 text-violet-700 border-violet-200';
                  else if (j === 'SMK') jenjangColor = 'bg-orange-50 text-orange-700 border-orange-200';
                  else if (j.includes('TK') || j.includes('PAUD')) jenjangColor = 'bg-pink-50 text-pink-700 border-pink-200';
                  else if (j === 'SLB') jenjangColor = 'bg-teal-50 text-teal-700 border-teal-200';
                %>
                <span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-bold <%= jenjangColor %> border shadow-2xs">
                  <%= unit.jenjang || 'SD' %>
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <% if (unit.kategori === 'SWASTA') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-extrabold bg-amber-50 text-amber-700 border border-amber-200 shadow-2xs">
                    <i data-lucide="landmark" class="w-3 h-3"></i>
                    <span>Swasta</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-extrabold bg-indigo-50 text-indigo-700 border border-indigo-200 shadow-2xs">
                    <i data-lucide="school" class="w-3 h-3"></i>
                    <span>Negeri</span>
                  </span>
                <% } %>
              </td>
              <td class="px-4 py-3">
                <% if (unit.kepalaSekolah) { %>
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                      <i data-lucide="user" class="w-3.5 h-3.5"></i>
                    </div>
                    <div>
                      <span class="font-semibold text-slate-800"><%= unit.kepalaSekolah %></span>
                      <% if (unit.kontakKepalaSekolah) { %>
                        <div class="flex items-center gap-1 text-[11px] text-emerald-600 mt-0.5">
                          <i data-lucide="phone" class="w-3 h-3"></i>
                          <a href="https://wa.me/<%= unit.kontakKepalaSekolah.replace(/[^0-9]/g, '') %>" target="_blank" class="hover:underline font-mono">
                            <%= unit.kontakKepalaSekolah %>
                          </a>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% } else { %>
                  <span class="text-slate-400 italic text-[11px]">— Belum diisi —</span>
                <% } %>
              </td>
              <td class="px-4 py-3">
                <% if (unit.operatorSekolah) { %>
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                      <i data-lucide="user-cog" class="w-3.5 h-3.5"></i>
                    </div>
                    <div>
                      <span class="font-semibold text-slate-800"><%= unit.operatorSekolah %></span>
                      <% if (unit.kontakOperator) { %>
                        <div class="flex items-center gap-1 text-[11px] text-emerald-600 mt-0.5">
                          <i data-lucide="phone" class="w-3 h-3"></i>
                          <a href="https://wa.me/<%= unit.kontakOperator.replace(/[^0-9]/g, '') %>" target="_blank" class="hover:underline font-mono">
                            <%= unit.kontakOperator %>
                          </a>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% } else { %>
                  <span class="text-slate-400 italic text-[11px]">— Belum diisi —</span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="px-2 py-1 rounded-lg text-xs font-bold
                  <%= unit.totalPegawaiAktif > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= unit.totalPegawaiAktif %>
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1.5">
                  <button @click="openEdit(<%= JSON.stringify(unit) %>)"
                          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors"
                          title="Edit Unit Kerja">
                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                    <span>Edit</span>
                  </button>
                  <button @click="openDelete(<%= JSON.stringify(unit) %>)"
                          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors"
                          <%= unit.totalPegawaiAktif > 0 ? 'title="Tidak dapat dihapus, masih ada pegawai terdaftar"' : 'title="Hapus Unit Kerja"' %>>
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    <span>Hapus</span>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View -->
    <div class="sm:hidden divide-y divide-slate-100">
      <% if (units.length === 0) { %>
        <div class="p-8 text-center text-slate-500">
          <i data-lucide="building-2" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
          <p class="font-bold text-slate-700">Belum ada unit kerja terdaftar</p>
        </div>
      <% } %>
      <% units.forEach(function(unit) { %>
        <div class="p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3 flex-1 min-w-0">
              <input type="checkbox" 
                     :value="'<%= unit.id %>'" 
                     x-model="selectedUnits" 
                     class="w-4 h-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500/20 cursor-pointer mt-3 shrink-0">
              <div class="w-10 h-10 rounded-xl <%= unit.kategori === 'SWASTA' ? 'bg-amber-100 text-amber-600' : 'bg-indigo-100 text-indigo-600' %> flex items-center justify-center shrink-0 mt-0.5">
                <i data-lucide="<%= unit.kategori === 'SWASTA' ? 'landmark' : 'school' %>" class="w-5 h-5"></i>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <p class="font-bold text-sm text-slate-900"><%= unit.namaUnit %></p>
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-extrabold <%= unit.kategori === 'SWASTA' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-indigo-50 text-indigo-700 border border-indigo-200' %>">
                    <%= unit.kategori === 'SWASTA' ? 'Swasta' : 'Negeri' %>
                  </span>
                  <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                    <%= unit.jenjang || 'SD' %>
                  </span>
                </div>
                <div class="text-xs text-slate-600 mt-1 space-y-0.5">
                  <p>
                    <span class="text-slate-400">Kepala:</span> 
                    <span class="font-semibold text-slate-800"><%= unit.kepalaSekolah || '—' %></span>
                    <% if (unit.kontakKepalaSekolah) { %>
                      <a href="https://wa.me/<%= unit.kontakKepalaSekolah.replace(/[^0-9]/g, '') %>" target="_blank" class="text-emerald-600 font-mono hover:underline">(<%= unit.kontakKepalaSekolah %>)</a>
                    <% } %>
                  </p>
                  <% if (unit.operatorSekolah) { %>
                    <p>
                      <span class="text-slate-400">Operator:</span> 
                      <span class="font-semibold text-slate-800"><%= unit.operatorSekolah %></span>
                      <% if (unit.kontakOperator) { %>
                        <span class="text-emerald-600 font-mono">(<%= unit.kontakOperator %>)</span>
                      <% } %>
                    </p>
                  <% } %>
                </div>
                <span class="mt-1.5 inline-block px-2 py-0.5 rounded-md text-[10px] font-bold
                  <%= unit.totalPegawaiAktif > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= unit.totalPegawaiAktif %> Pegawai Aktif
                </span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button @click="openEdit(<%= JSON.stringify(unit) %>)"
                    class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors">
              <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
              Edit
            </button>
            <button @click="openDelete(<%= JSON.stringify(unit) %>)"
