<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6"
      x-data="{
        addModal: false,
        editModal: false,
        deleteModal: false,
        editData: { id: '', namaUnit: '', kepalaSekolah: '' },
        deleteData: { id: '', namaUnit: '' },
        openEdit(unit) {
          this.editData = { id: unit.id, namaUnit: unit.namaUnit, kepalaSekolah: unit.kepalaSekolah || '' };
          this.editModal = true;
        },
        openDelete(unit) {
          this.deleteData = { id: unit.id, namaUnit: unit.namaUnit };
          this.deleteModal = true;
        }
      }">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 text-xs font-bold uppercase tracking-wider border border-amber-100">Super Admin Only</span>
        <span class="text-xs text-slate-400">Master Data</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Data Unit Kerja / Sekolah</h1>
      <p class="text-xs sm:text-sm text-slate-500">Kelola daftar unit kerja / sekolah beserta informasi kepala sekolah</p>
    </div>
    <button @click="addModal = true"
            id="btn-tambah-unit"
            class="btn-primary py-2.5 px-4 text-xs gap-2 shadow-sm">
      <i data-lucide="plus" class="w-4 h-4"></i>
      <span>Tambah Unit Kerja</span>
    </button>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="custom-card p-4 bg-white flex items-center gap-3.5 col-span-2 sm:col-span-1">
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <i data-lucide="building-2" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Total Unit</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= totalUnits %> Unit</p>
      </div>
    </div>
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
        <i data-lucide="user-check" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Terisi Kepala</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= units.filter(u => u.kepalaSekolah).length %> Unit</p>
      </div>
    </div>
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
        <i data-lucide="user-x" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Belum Ada Kepala</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= units.filter(u => !u.kepalaSekolah).length %> Unit</p>
      </div>
    </div>
    <div class="custom-card p-4 bg-white flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <i data-lucide="users" class="w-6 h-6"></i>
      </div>
      <div>
        <span class="text-xs text-slate-400 font-semibold block uppercase">Total Pegawai</span>
        <p class="text-xl font-extrabold text-slate-900 mt-0.5"><%= units.reduce((sum, u) => sum + u.totalPegawaiAktif, 0) %> Orang</p>
      </div>
    </div>
  </div>

  <!-- Search & Table -->
  <div class="custom-card bg-white overflow-hidden shadow-xs">
    <!-- Search Bar -->
    <div class="p-4 sm:p-5 border-b border-slate-100">
      <form action="/admin/unit-kerja" method="GET" class="flex gap-3 items-center">
        <div class="relative flex-1 max-w-xs">
          <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
          <input type="text"
                 name="search"
                 value="<%= search %>"
                 placeholder="Cari nama unit / kepala sekolah..."
                 class="w-full pl-9 pr-4 py-2.5 text-xs font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 placeholder:text-slate-400 transition-all">
        </div>
        <button type="submit" class="btn-secondary py-2.5 px-4 text-xs gap-1.5">
          <i data-lucide="search" class="w-3.5 h-3.5"></i>
          Cari
        </button>
        <% if (search) { %>
          <a href="/admin/unit-kerja" class="btn-secondary py-2.5 px-3 text-xs gap-1.5 text-rose-600 border-rose-200 hover:bg-rose-50">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
            Reset
          </a>
        <% } %>
      </form>
    </div>

    <!-- Desktop Table -->
    <div class="hidden sm:block overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead class="bg-slate-50 text-slate-600 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
          <tr class="h-10">
            <th class="px-4 py-3 w-10">No</th>
            <th class="px-4 py-3">Nama Unit Kerja / Sekolah</th>
            <th class="px-4 py-3">Kepala Sekolah / Unit</th>
            <th class="px-4 py-3 text-center w-28">Jml Pegawai</th>
            <th class="px-4 py-3 text-right w-36">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (units.length === 0) { %>
            <tr>
              <td colspan="5" class="py-16 text-center text-slate-500">
                <i data-lucide="building-2" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
                <p class="font-bold text-slate-700">
                  <% if (search) { %>Tidak ada unit yang cocok dengan "<%= search %>"<% } else { %>Belum ada unit kerja terdaftar<% } %>
                </p>
                <% if (!search) { %><p class="text-xs text-slate-400 mt-1">Klik tombol "Tambah Unit Kerja" untuk mulai menambahkan data</p><% } %>
              </td>
            </tr>
          <% } %>
          <% units.forEach(function(unit, idx) { %>
            <tr class="hover:bg-amber-50/30 transition-colors">
              <td class="px-4 py-3 text-slate-400 font-mono text-[11px]"><%= idx + 1 %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                    <i data-lucide="building-2" class="w-4 h-4"></i>
                  </div>
                  <div>
                    <p class="font-bold text-slate-900 text-xs"><%= unit.namaUnit %></p>
                    <p class="text-[10px] text-slate-400 mt-0.5">ID: <span class="font-mono"><%= unit.id.substring(0, 8) %>...</span></p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3">
                <% if (unit.kepalaSekolah) { %>
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                      <i data-lucide="user" class="w-3.5 h-3.5"></i>
                    </div>
                    <span class="font-semibold text-slate-800"><%= unit.kepalaSekolah %></span>
                  </div>
                <% } else { %>
                  <span class="text-slate-400 italic text-[11px]">— Belum diisi —</span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold
                  <%= unit.totalPegawaiAktif > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= unit.totalPegawaiAktif %> Pegawai
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-2">
                  <button @click="openEdit(<%= JSON.stringify(unit) %>)"
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors">
                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                    Edit
                  </button>
                  <button @click="openDelete(<%= JSON.stringify(unit) %>)"
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors"
                          <%= unit.totalPegawaiAktif > 0 ? 'title="Tidak dapat dihapus, masih ada pegawai terdaftar"' : '' %>>
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    Hapus
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View -->
    <div class="sm:hidden divide-y divide-slate-100">
      <% if (units.length === 0) { %>
        <div class="p-8 text-center text-slate-500">
          <i data-lucide="building-2" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
          <p class="font-bold text-slate-700">Belum ada unit kerja terdaftar</p>
        </div>
      <% } %>
      <% units.forEach(function(unit) { %>
        <div class="p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3 flex-1 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0 mt-0.5">
                <i data-lucide="building-2" class="w-5 h-5"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-sm text-slate-900"><%= unit.namaUnit %></p>
                <p class="text-xs text-slate-500 mt-0.5">
                  <% if (unit.kepalaSekolah) { %>
                    Kepala: <span class="font-semibold text-indigo-700"><%= unit.kepalaSekolah %></span>
                  <% } else { %>
                    <span class="italic text-slate-400">Kepala belum diisi</span>
                  <% } %>
                </p>
                <span class="mt-1 inline-block px-2 py-0.5 rounded-md text-[10px] font-bold
                  <%= unit.totalPegawaiAktif > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= unit.totalPegawaiAktif %> Pegawai Aktif
                </span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button @click="openEdit(<%= JSON.stringify(unit) %>)"
                    class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors">
              <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
              Edit
            </button>
            <button @click="openDelete(<%= JSON.stringify(unit) %>)"
                    class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              Hapus
            </button>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Footer -->
    <div class="px-4 py-3 border-t border-slate-100 text-[11px] text-slate-400">
      Menampilkan <b class="text-slate-700"><%= units.length %></b> unit kerja
      <% if (search) { %> untuk pencarian "<%= search %>"<% } %>
      dari total <b class="text-slate-700"><%= totalUnits %></b> unit
    </div>
  </div>

  <!-- =====================================================================
       MODAL: TAMBAH UNIT KERJA
       ===================================================================== -->
  <div x-show="addModal"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm"
       @click.self="addModal = false"
       style="display: none;">
    <div x-transition:enter="transition ease-out duration-200 transform"
         x-transition:enter-start="opacity-0 scale-95 translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         class="bg-white rounded-3xl shadow-2xl w-full max-w-md border border-slate-200">
      <div class="flex items-center justify-between p-5 border-b border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center">
            <i data-lucide="plus-circle" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-900">Tambah Unit Kerja</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Tambah unit kerja / sekolah baru</p>
          </div>
        </div>
        <button @click="addModal = false" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <form action="/admin/unit-kerja/create" method="POST" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">
            Nama Unit Kerja / Sekolah <span class="text-rose-500">*</span>
          </label>
          <input type="text"
                 name="namaUnit"
                 id="add-namaUnit"
                 required
                 placeholder="cth: SDN Cibitung 01"
                 autocomplete="off"
                 class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-800 bg-white focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 placeholder:text-slate-400 transition-all">
        </div>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-bold text-slate-700">
              Nama Kepala Sekolah / Unit
              <span class="text-slate-400 font-normal">(opsional)</span>
            </label>
            <span class="text-[10.5px] text-amber-600 font-medium">Bisa pilih atau ketik manual</span>
          </div>
          
          <div class="space-y-2">
            <% if (typeof employees !== 'undefined' && employees.length > 0) { %>
              <!-- Quick Select from Registered Employees -->
              <select @change="if ($event.target.value) { $el.closest('form').querySelector('input[name=kepalaSekolah]').value = $event.target.value; }"
                      class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-700 bg-slate-50 focus:outline-none focus:border-amber-500 transition-all">
                <option value="">-- Pilih dari Daftar Pegawai (Otomatis Isi) --</option>
                <% employees.forEach(function(emp) { %>
                  <option value="<%= emp.nama %>"><%= emp.nama %> (<%= emp.unitNama %>)</option>
                <% }); %>
              </select>
            <% } %>

            <!-- Text Input (with Datalist Autocomplete & Manual typing) -->
            <input type="text"
                   name="kepalaSekolah"
                   id="add-kepalaSekolah"
                   list="employeeList"
                   placeholder="Ketik nama manual atau pilih dari daftar di atas..."
                   autocomplete="off"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-800 bg-white focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 placeholder:text-slate-400 transition-all">
          </div>
        </div>
        <div class="flex items-center gap-3 pt-1">
          <button type="button" @click="addModal = false"
                  class="flex-1 btn-secondary py-2.5 px-4 text-xs">
            Batal
          </button>
          <button type="submit"
                  class="flex-1 btn-primary py-2.5 px-4 text-xs gap-1.5">
            <i data-lucide="save" class="w-4 h-4"></i>
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- =====================================================================
       MODAL: EDIT UNIT KERJA
       ===================================================================== -->
  <div x-show="editModal"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm"
       @click.self="editModal = false"
       style="display: none;">
    <div x-transition:enter="transition ease-out duration-200 transform"
         x-transition:enter-start="opacity-0 scale-95 translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         class="bg-white rounded-3xl shadow-2xl w-full max-w-md border border-slate-200">
      <div class="flex items-center justify-between p-5 border-b border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center">
            <i data-lucide="pencil" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-900">Edit Unit Kerja</h3>
            <p class="text-[11px] text-slate-500 mt-0.5" x-text="editData.namaUnit"></p>
          </div>
        </div>
        <button @click="editModal = false" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <template x-if="editModal">
        <form :action="`/admin/unit-kerja/${editData.id}/update`" method="POST" class="p-5 space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">
              Nama Unit Kerja / Sekolah <span class="text-rose-500">*</span>
            </label>
            <input type="text"
                   name="namaUnit"
                   :value="editData.namaUnit"
                   required
                   autocomplete="off"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-800 bg-white focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 placeholder:text-slate-400 transition-all">
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-slate-700">
                Nama Kepala Sekolah / Unit
                <span class="text-slate-400 font-normal">(opsional)</span>
              </label>
              <span class="text-[10.5px] text-indigo-600 font-medium">Bisa pilih atau ketik manual</span>
            </div>

            <div class="space-y-2">
              <% if (typeof employees !== 'undefined' && employees.length > 0) { %>
                <!-- Quick Select from Registered Employees -->
                <select @change="if ($event.target.value) { editData.kepalaSekolah = $event.target.value; }"
                        class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-700 bg-slate-50 focus:outline-none focus:border-indigo-500 transition-all">
                  <option value="">-- Pilih dari Daftar Pegawai (Otomatis Isi) --</option>
                  <% employees.forEach(function(emp) { %>
                    <option value="<%= emp.nama %>"><%= emp.nama %> (<%= emp.unitNama %>)</option>
                  <% }); %>
                </select>
              <% } %>

              <!-- Text Input (with Datalist Autocomplete & Manual typing) -->
              <input type="text"
                     name="kepalaSekolah"
                     x-model="editData.kepalaSekolah"
                     list="employeeList"
                     placeholder="Ketik nama manual atau pilih dari daftar di atas..."
                     autocomplete="off"
                     class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-800 bg-white focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 placeholder:text-slate-400 transition-all">
            </div>
          </div>
          <div class="flex items-center gap-3 pt-1">
            <button type="button" @click="editModal = false"
                    class="flex-1 btn-secondary py-2.5 px-4 text-xs">
              Batal
            </button>
            <button type="submit"
                    class="flex-1 btn-primary py-2.5 px-4 text-xs gap-1.5">
              <i data-lucide="save" class="w-4 h-4"></i>
              Simpan Perubahan
            </button>
          </div>
        </form>
      </template>
    </div>
  </div>

  <!-- Shared Global Employee Datalist -->
  <datalist id="employeeList">
    <% if (typeof employees !== 'undefined' && employees.length > 0) { %>
      <% employees.forEach(function(emp) { %>
        <option value="<%= emp.nama %>"><%= emp.nama %> &mdash; <%= emp.unitNama %></option>
      <% }); %>
    <% } %>
  </datalist>

  <!-- =====================================================================
       MODAL: KONFIRMASI HAPUS
       ===================================================================== -->
  <div x-show="deleteModal"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm"
       @click.self="deleteModal = false"
       style="display: none;">
    <div x-transition:enter="transition ease-out duration-200 transform"
         x-transition:enter-start="opacity-0 scale-95 translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         class="bg-white rounded-3xl shadow-2xl w-full max-w-sm border border-slate-200">
      <div class="p-5 text-center space-y-3">
        <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center mx-auto">
          <i data-lucide="trash-2" class="w-7 h-7"></i>
        </div>
        <h3 class="font-bold text-slate-900 text-base">Hapus Unit Kerja?</h3>
        <p class="text-sm text-slate-500">
          Anda akan menghapus unit kerja <b class="text-slate-800" x-text="deleteData.namaUnit"></b>.
          Tindakan ini tidak dapat dibatalkan.
        </p>
      </div>
      <div class="p-5 pt-0 flex items-center gap-3">
        <button type="button" @click="deleteModal = false"
                class="flex-1 btn-secondary py-2.5 px-4 text-xs">
          Batal
        </button>
        <template x-if="deleteModal">
