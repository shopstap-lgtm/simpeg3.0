<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6"
      x-data="{
        heroBadge: '<%= cms.heroBadge %>',
        heroTitle: '<%= cms.heroTitle %>',
        heroSubtitle: '<%= cms.heroSubtitle %>',
        pengumumanText: '<%= cms.pengumumanText %>',
        selectedMonth: <%= cms.selectedMonth %>,
        selectedMonthEkinerja: <%= cms.selectedMonthEkinerja %>,
        selectedYear: <%= cms.selectedYear %>,
        ekinerjaFilterStatus: '<%= (typeof cms.ekinerjaFilterStatus !== 'undefined' && cms.ekinerjaFilterStatus) ? cms.ekinerjaFilterStatus : 'ALL' %>',
        ekinerjaFilterKepegawaian: <%= JSON.stringify(((typeof cms.ekinerjaFilterKepegawaian !== 'undefined' && cms.ekinerjaFilterKepegawaian) ? cms.ekinerjaFilterKepegawaian : 'PNS,PPPK,PPPK_PW').split(',').map(s => s.trim())) %>,
        maintenanceDashboard: <%= (typeof cms.maintenanceDashboard !== 'undefined' && cms.maintenanceDashboard) ? 'true' : 'false' %>,
        maintenanceAbsensi: <%= (typeof cms.maintenanceAbsensi !== 'undefined' && cms.maintenanceAbsensi) ? 'true' : 'false' %>,
        maintenanceEkinerja: <%= (typeof cms.maintenanceEkinerja !== 'undefined' && cms.maintenanceEkinerja) ? 'true' : 'false' %>,
        maintenanceKlarifikasi: <%= (typeof cms.maintenanceKlarifikasi !== 'undefined' && cms.maintenanceKlarifikasi) ? 'true' : 'false' %>,
        maintenanceTitle: '<%= ((typeof cms.maintenanceTitle !== 'undefined' && cms.maintenanceTitle) ? cms.maintenanceTitle : 'Sedang Dalam Pemeliharaan').replace(/'/g, "\\'") %>',
        maintenanceMessage: '<%= ((typeof cms.maintenanceMessage !== 'undefined' && cms.maintenanceMessage) ? cms.maintenanceMessage : 'Halaman ini sedang dalam proses pemeliharaan dan pembaruan data berkala oleh tim admin Korwil Cibitung. Mohon kembali beberapa saat lagi.').replace(/'/g, "\\'") %>'
      }">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider border border-indigo-100">Super Admin Only</span>
        <span class="text-xs text-slate-400">Konfigurasi Tampilan</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">CMS Dashboard & Pengumuman</h1>
      <p class="text-xs sm:text-sm text-slate-500">Kelola banner hero publik, teks pengumuman penting, dan periode aktif default</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Form Settings (7 cols) -->
    <div class="lg:col-span-7 custom-card p-6 sm:p-7 bg-white shadow-xs space-y-6">
      <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
          <i data-lucide="sliders" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900">Pengaturan Teks & Periode</h2>
          <p class="text-xs text-slate-500">Perubahan akan langsung tampil di halaman depan publik</p>
        </div>
      </div>

      <form action="/admin/cms" method="POST" class="space-y-4">
        
        <!-- 1. Hero Title -->
        <div>
          <label for="heroTitle" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Hero Judul Utama
          </label>
          <input type="text" 
                 name="heroTitle" 
                 id="heroTitle" 
                 x-model="heroTitle"
                 required 
                 class="form-input text-xs">
        </div>

        <!-- 3. Hero Subtitle -->
        <div>
          <label for="heroSubtitle" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Hero Deskripsi / Subjudul
          </label>
          <textarea name="heroSubtitle" 
                    id="heroSubtitle" 
                    rows="2" 
                    x-model="heroSubtitle"
                    required 
                    class="form-input text-xs"></textarea>
        </div>

        <!-- 4. Pengumuman Banner Text -->
        <div>
          <label for="pengumumanText" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Teks Banner Pengumuman Penting
          </label>
          <textarea name="pengumumanText" 
                    id="pengumumanText" 
                    rows="3" 
                    x-model="pengumumanText"
                    class="form-input text-xs"></textarea>
          <p class="text-[10px] text-slate-400 mt-1">Kosongkan jika tidak ada pengumuman yang ingin ditampilkan.</p>
        </div>

        <!-- 5. Default Months Selection (Modern Custom Dropdowns) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          
          <!-- Bulan Default Absensi -->
          <div class="relative"
               x-data="{
                 open: false,
                 options: [
                   { value: 1, label: 'Januari' },
                   { value: 2, label: 'Februari' },
                   { value: 3, label: 'Maret' },
                   { value: 4, label: 'April' },
                   { value: 5, label: 'Mei' },
                   { value: 6, label: 'Juni' },
                   { value: 7, label: 'Juli' },
                   { value: 8, label: 'Agustus' },
                   { value: 9, label: 'September' },
                   { value: 10, label: 'Oktober' },
                   { value: 11, label: 'November' },
                   { value: 12, label: 'Desember' }
                 ],
                 get selectedLabel() {
                   const found = this.options.find(o => o.value == selectedMonth);
                   return found ? found.label : 'Januari';
                 },
                 selectOption(val) {
                   selectedMonth = val;
                   this.open = false;
                 }
               }"
               @click.away="open = false">
            
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Bulan Default Absensi
            </label>
            <input type="hidden" name="selectedMonth" :value="selectedMonth">
            
            <button type="button" 
                    @click="open = !open" 
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
              <span class="truncate pr-2" x-text="selectedLabel"></span>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
            </button>

            <div x-show="open" 
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="opacity-0 translate-y-1 scale-98"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                 x-transition:leave-end="opacity-0 translate-y-1 scale-98"
                 class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-0.5 min-w-[160px]"
                 style="display: none;">
              <div class="max-h-[230px] overflow-y-auto custom-scrollbar space-y-0.5">
                <template x-for="item in options" :key="item.value">
                  <button type="button" 
                          @click="selectOption(item.value)" 
                          class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                          :class="selectedMonth == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                    <span x-text="item.label"></span>
                    <i data-lucide="check" x-show="selectedMonth == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                  </button>
                </template>
              </div>
            </div>
          </div>

          <!-- Bulan Default E-Kinerja -->
          <div class="relative"
               x-data="{
                 open: false,
                 options: [
                   { value: 1, label: 'Januari' },
                   { value: 2, label: 'Februari' },
                   { value: 3, label: 'Maret' },
                   { value: 4, label: 'April' },
                   { value: 5, label: 'Mei' },
                   { value: 6, label: 'Juni' },
                   { value: 7, label: 'Juli' },
                   { value: 8, label: 'Agustus' },
                   { value: 9, label: 'September' },
                   { value: 10, label: 'Oktober' },
                   { value: 11, label: 'November' },
                   { value: 12, label: 'Desember' }
                 ],
                 get selectedLabel() {
                   const found = this.options.find(o => o.value == selectedMonthEkinerja);
                   return found ? found.label : 'Januari';
                 },
                 selectOption(val) {
                   selectedMonthEkinerja = val;
                   this.open = false;
                 }
               }"
               @click.away="open = false">
            
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Bulan Default E-Kinerja
            </label>
            <input type="hidden" name="selectedMonthEkinerja" :value="selectedMonthEkinerja">
            
            <button type="button" 
                    @click="open = !open" 
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
              <span class="truncate pr-2" x-text="selectedLabel"></span>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
            </button>

            <div x-show="open" 
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="opacity-0 translate-y-1 scale-98"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                 x-transition:leave-end="opacity-0 translate-y-1 scale-98"
                 class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-0.5 min-w-[160px]"
                 style="display: none;">
              <div class="max-h-[230px] overflow-y-auto custom-scrollbar space-y-0.5">
                <template x-for="item in options" :key="item.value">
                  <button type="button" 
                          @click="selectOption(item.value)" 
                          class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                          :class="selectedMonthEkinerja == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                    <span x-text="item.label"></span>
                    <i data-lucide="check" x-show="selectedMonthEkinerja == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                  </button>
                </template>
              </div>
            </div>
          </div>

          <!-- Tahun Aktif -->
          <div class="relative"
               x-data="{
                 open: false,
                 options: [
                   { value: 2026, label: '2026' },
                   { value: 2025, label: '2025' }
                 ],
                 get selectedLabel() {
                   const found = this.options.find(o => o.value == selectedYear);
                   return found ? found.label : '2026';
                 },
                 selectOption(val) {
                   selectedYear = val;
                   this.open = false;
                 }
               }"
               @click.away="open = false">
            
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Tahun Aktif
            </label>
            <input type="hidden" name="selectedYear" :value="selectedYear">
            
            <button type="button" 
                    @click="open = !open" 
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
              <span class="truncate pr-2" x-text="selectedLabel"></span>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
            </button>

            <div x-show="open" 
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="opacity-0 translate-y-1 scale-98"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                 x-transition:leave-end="opacity-0 translate-y-1 scale-98"
                 class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-2 space-y-0.5 min-w-[140px]"
                 style="display: none;">
              <template x-for="item in options" :key="item.value">
                <button type="button" 
                        @click="selectOption(item.value)" 
                        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs transition-colors text-left"
                        :class="selectedYear == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                  <span x-text="item.label"></span>
                  <i data-lucide="check" x-show="selectedYear == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                </button>
              </template>
            </div>
          </div>

        </div>

        <!-- 6. Pengaturan Filter Tampilan E-Kinerja Publik -->
        <div class="pt-5 border-t border-slate-100 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 border border-blue-100">
              <i data-lucide="filter" class="w-4 h-4"></i>
            </div>
            <div>
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-800">Filter Tampilan E-Kinerja Publik</h3>
              <p class="text-[11px] text-slate-500">Tentukan kriteria pegawai yang otomatis dimuat pada halaman publik <code class="text-indigo-600 font-mono">/ekinerja</code></p>
            </div>
          </div>

          <!-- Pilihan Status Laporan -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">
              Status Pengiriman Laporan E-Kinerja
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              
              <!-- ALL -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-start gap-3"
                     :class="ekinerjaFilterStatus === 'ALL' ? 'bg-indigo-50/70 border-indigo-300 ring-2 ring-indigo-500/20 shadow-xs' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="ALL" x-model="ekinerjaFilterStatus" class="mt-0.5 text-indigo-600 focus:ring-indigo-500">
                <div class="text-xs">
                  <span class="font-bold text-slate-800 block">Semua Status Pegawai</span>
                  <span class="text-[11px] text-slate-500">Tampilkan seluruh pegawai (Default)</span>
                </div>
              </label>

              <!-- BELUM_KIRIM -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-start gap-3"
                     :class="ekinerjaFilterStatus === 'BELUM_KIRIM' ? 'bg-rose-50/70 border-rose-300 ring-2 ring-rose-500/20 shadow-xs' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="BELUM_KIRIM" x-model="ekinerjaFilterStatus" class="mt-0.5 text-rose-600 focus:ring-rose-500">
                <div class="text-xs">
                  <span class="font-bold text-rose-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                    <span>Hanya Belum Kirim Laporan</span>
                  </span>
                  <span class="text-[11px] text-slate-500">Pegawai belum upload atau laporan ditolak/revisi</span>
                </div>
              </label>

              <!-- APPROVED -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-start gap-3"
                     :class="ekinerjaFilterStatus === 'APPROVED' ? 'bg-emerald-50/70 border-emerald-300 ring-2 ring-emerald-500/20 shadow-xs' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="APPROVED" x-model="ekinerjaFilterStatus" class="mt-0.5 text-emerald-600 focus:ring-emerald-500">
                <div class="text-xs">
                  <span class="font-bold text-emerald-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Hanya yang Disetujui</span>
                  </span>
                  <span class="text-[11px] text-slate-500">Laporan kinerja yang sudah diperiksa & disetujui</span>
                </div>
              </label>

              <!-- PENDING -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-start gap-3"
                     :class="ekinerjaFilterStatus === 'PENDING' ? 'bg-amber-50/70 border-amber-300 ring-2 ring-amber-500/20 shadow-xs' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="PENDING" x-model="ekinerjaFilterStatus" class="mt-0.5 text-amber-600 focus:ring-amber-500">
                <div class="text-xs">
                  <span class="font-bold text-amber-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span>Hanya Menunggu Review</span>
                  </span>
                  <span class="text-[11px] text-slate-500">Berkas kinerja yang sedang ditinjau admin</span>
                </div>
              </label>

            </div>
          </div>

          <!-- Checkbox Status Kepegawaian -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">
              Filter Status Kepegawaian (Centang yang Ingin Ditampilkan)
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              
              <!-- PNS -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-center gap-3"
                     :class="ekinerjaFilterKepegawaian.includes('PNS') ? 'bg-indigo-50/60 border-indigo-200 text-indigo-900 font-bold' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <input type="checkbox" 
                       name="ekinerjaFilterKepegawaian" 
                       value="PNS" 
                       x-model="ekinerjaFilterKepegawaian"
                       class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                <div class="text-xs">
                  <span class="block">PNS</span>
                  <span class="text-[10px] text-slate-400 font-normal">Pegawai Negeri Sipil</span>
                </div>
              </label>

              <!-- PPPK -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-center gap-3"
                     :class="ekinerjaFilterKepegawaian.includes('PPPK') ? 'bg-indigo-50/60 border-indigo-200 text-indigo-900 font-bold' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <input type="checkbox" 
                       name="ekinerjaFilterKepegawaian" 
                       value="PPPK" 
                       x-model="ekinerjaFilterKepegawaian"
                       class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                <div class="text-xs">
                  <span class="block">PPPK</span>
                  <span class="text-[10px] text-slate-400 font-normal">Penuh Waktu</span>
                </div>
              </label>

              <!-- PPPK_PW -->
              <label class="p-3 rounded-xl border cursor-pointer transition-all flex items-center gap-3"
                     :class="ekinerjaFilterKepegawaian.includes('PPPK_PW') ? 'bg-indigo-50/60 border-indigo-200 text-indigo-900 font-bold' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <input type="checkbox" 
                       name="ekinerjaFilterKepegawaian" 
                       value="PPPK_PW" 
                       x-model="ekinerjaFilterKepegawaian"
                       class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                <div class="text-xs">
                  <span class="block">PPPK PW</span>
                  <span class="text-[10px] text-slate-400 font-normal">Paruh Waktu</span>
                </div>
              </label>

            </div>
            <p class="text-[11px] text-slate-400 mt-1.5">Pegawai dengan status kepegawaian yang tidak dicentang otomatis disembunyikan dari halaman publik.</p>
          </div>

        </div>

        <!-- Save Button -->
        <div class="pt-4 border-t border-slate-100 flex justify-end">
          <button type="submit" class="btn-primary py-2.5 px-6 gap-2">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Simpan Perubahan CMS</span>
          </button>
        </div>

      </form>
    </div>

    <!-- Right Column: Live Preview Container (5 cols) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500">
        <i data-lucide="eye" class="w-4 h-4 text-indigo-600"></i>
        <span>Pratinjau Langsung (Live Preview)</span>
      </div>

      <!-- Preview Mock Banner -->
      <div class="rounded-3xl bg-gradient-to-b from-indigo-900 via-indigo-800 to-slate-900 text-white p-6 shadow-xl space-y-4 relative overflow-hidden">
        <h3 class="text-xl font-extrabold text-white leading-tight" x-text="heroTitle"></h3>
        <p class="text-xs text-indigo-100/90 leading-relaxed" x-text="heroSubtitle"></p>

        <!-- Preview Announcement -->
        <template x-if="pengumumanText">
          <div class="p-3 rounded-2xl bg-white/10 border border-white/15 text-xs text-slate-100 space-y-1">
            <span class="font-bold text-amber-300 flex items-center gap-1">
              <i data-lucide="megaphone" class="w-3.5 h-3.5"></i>
              <span>PENGUMUMAN:</span>
            </span>
            <p class="text-[11px] text-slate-200" x-text="pengumumanText"></p>
          </div>
        </template>
      </div>

      <div class="p-4 rounded-2xl bg-slate-100/80 border border-slate-200 text-xs text-slate-600 space-y-1">
        <p class="font-bold text-slate-800 flex items-center gap-1.5">
          <i data-lucide="info" class="w-3.5 h-3.5 text-indigo-600"></i>
          <span>Informasi Tambahan:</span>
        </p>
        <p>Bulan default yang Anda tentukan akan otomatis terpilih ketika publik membuka halaman Rekap Absensi dan Laporan E-Kinerja.</p>
      </div>
    </div>

  </div>

  <!-- ========================================== -->
  <!-- PANEL KHUSUS: KONTROL MODE PEMELIHARAAN    -->
  <!-- ========================================== -->
  <div class="custom-card p-6 sm:p-8 bg-white border border-amber-200 shadow-xs space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
      <div class="flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0 border border-amber-500/20">
          <i data-lucide="power" class="w-6 h-6"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight">Kontrol Buka / Tutup Halaman (Maintenance Mode)</h2>
            <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-black uppercase tracking-wider border border-amber-200">
              Super Admin Only
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Tutup sementara akses pengunjung publik pada halaman tertentu. Pengunjung akan dialihkan ke layar pemeliharaan yang elegan.</p>
        </div>
      </div>
    </div>

    <form action="/admin/cms/maintenance" method="POST" class="space-y-6">
      <!-- 4 Switch Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- 1. Dashboard Utama -->
        <div class="p-4 rounded-2xl border transition-all"
             :class="maintenanceDashboard ? 'bg-rose-50/50 border-rose-200 ring-1 ring-rose-300' : 'bg-slate-50/60 border-slate-200'">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i data-lucide="layout-dashboard" class="w-4 h-4 text-indigo-600"></i>
                <span>Dashboard Utama</span>
              </span>
              <p class="text-[11px] text-slate-500">Rute: <code class="text-indigo-600 font-mono">/</code></p>
            </div>
            <!-- Toggle Switch -->
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="maintenanceDashboard" value="true" x-model="maintenanceDashboard" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>
          <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500">Akses Publik:</span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold"
                  :class="maintenanceDashboard ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700'">
              <span class="w-1.5 h-1.5 rounded-full" :class="maintenanceDashboard ? 'bg-rose-500 animate-pulse' : 'bg-emerald-500'"></span>
              <span x-text="maintenanceDashboard ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </span>
          </div>
        </div>

        <!-- 2. Rekap Absensi -->
        <div class="p-4 rounded-2xl border transition-all"
             :class="maintenanceAbsensi ? 'bg-rose-50/50 border-rose-200 ring-1 ring-rose-300' : 'bg-slate-50/60 border-slate-200'">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i data-lucide="calendar-check-2" class="w-4 h-4 text-emerald-600"></i>
                <span>Rekap Absensi</span>
              </span>
              <p class="text-[11px] text-slate-500">Rute: <code class="text-indigo-600 font-mono">/absensi</code></p>
            </div>
            <!-- Toggle Switch -->
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="maintenanceAbsensi" value="true" x-model="maintenanceAbsensi" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>
          <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500">Akses Publik:</span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold"
                  :class="maintenanceAbsensi ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700'">
              <span class="w-1.5 h-1.5 rounded-full" :class="maintenanceAbsensi ? 'bg-rose-500 animate-pulse' : 'bg-emerald-500'"></span>
              <span x-text="maintenanceAbsensi ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </span>
          </div>
        </div>

        <!-- 3. Laporan E-Kinerja -->
        <div class="p-4 rounded-2xl border transition-all"
             :class="maintenanceEkinerja ? 'bg-rose-50/50 border-rose-200 ring-1 ring-rose-300' : 'bg-slate-50/60 border-slate-200'">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i data-lucide="file-check-2" class="w-4 h-4 text-blue-600"></i>
                <span>Laporan E-Kinerja</span>
              </span>
              <p class="text-[11px] text-slate-500">Rute: <code class="text-indigo-600 font-mono">/ekinerja</code></p>
            </div>
            <!-- Toggle Switch -->
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="maintenanceEkinerja" value="true" x-model="maintenanceEkinerja" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>
          <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500">Akses Publik:</span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold"
                  :class="maintenanceEkinerja ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700'">
              <span class="w-1.5 h-1.5 rounded-full" :class="maintenanceEkinerja ? 'bg-rose-500 animate-pulse' : 'bg-emerald-500'"></span>
              <span x-text="maintenanceEkinerja ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </span>
          </div>
        </div>

        <!-- 4. Pengajuan Klarifikasi -->
        <div class="p-4 rounded-2xl border transition-all"
             :class="maintenanceKlarifikasi ? 'bg-rose-50/50 border-rose-200 ring-1 ring-rose-300' : 'bg-slate-50/60 border-slate-200'">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i data-lucide="file-text" class="w-4 h-4 text-purple-600"></i>
                <span>Upload Klarifikasi</span>
              </span>
              <p class="text-[11px] text-slate-500">Form Pengajuan Pegawai</p>
            </div>
            <!-- Toggle Switch -->
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="maintenanceKlarifikasi" value="true" x-model="maintenanceKlarifikasi" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>
          <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500">Akses Publik:</span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold"
                  :class="maintenanceKlarifikasi ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700'">
              <span class="w-1.5 h-1.5 rounded-full" :class="maintenanceKlarifikasi ? 'bg-rose-500 animate-pulse' : 'bg-emerald-500'"></span>
              <span x-text="maintenanceKlarifikasi ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </span>
          </div>
        </div>

      </div>

      <!-- Kustomisasi Judul & Pesan Pemeliharaan -->
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
          <i data-lucide="message-square" class="w-4 h-4 text-amber-600"></i>
          <span>Kustomisasi Teks Layar Pemeliharaan</span>
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-1 space-y-1.5">
            <label for="maintenanceTitle" class="block text-xs font-bold text-slate-600">
              Judul Layar Pemeliharaan
            </label>
            <input type="text" 
                   name="maintenanceTitle" 
                   id="maintenanceTitle" 
                   x-model="maintenanceTitle"
                   placeholder="Sedang Dalam Pemeliharaan"
                   class="form-input text-xs">
          </div>

          <div class="md:col-span-2 space-y-1.5">
            <label for="maintenanceMessage" class="block text-xs font-bold text-slate-600">
              Pesan Penjelasan untuk Pengunjung Publik
            </label>
            <textarea name="maintenanceMessage" 
                      id="maintenanceMessage" 
                      rows="2"
                      x-model="maintenanceMessage"
                      placeholder="Tuliskan alasan penutupan atau estimasi waktu pembukaan..."
                      class="form-input text-xs resize-none"></textarea>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <p class="text-xs text-slate-500 italic">
          * Catatan: Ketika halaman ditutup, Administrator yang sedang login tetap dapat melihat halaman secara normal untuk keperluan pengecekan data.
        </p>
        <button type="submit" class="btn-primary bg-amber-600 hover:bg-amber-700 text-white py-2.5 px-6 gap-2 shrink-0">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Simpan Status Maintenance</span>
        </button>
      </div>
    </form>
  </div>

</main>

<%- include('../partials/admin-footer') %>
