<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/toast') %>

<script>
  function cmsApp() {
    return {
      heroBadge: <%- JSON.stringify(cms.heroBadge || '') %>,
      heroTitle: <%- JSON.stringify(cms.heroTitle || '') %>,
      heroSubtitle: <%- JSON.stringify(cms.heroSubtitle || '') %>,
      pengumumanText: <%- JSON.stringify(cms.pengumumanText || '') %>,
      selectedMonth: <%= cms.selectedMonth %>,
      selectedMonthEkinerja: <%= cms.selectedMonthEkinerja %>,
      selectedYear: <%= cms.selectedYear %>,
      ekinerjaFilterStatus: <%- JSON.stringify((typeof cms.ekinerjaFilterStatus !== 'undefined' && cms.ekinerjaFilterStatus) ? cms.ekinerjaFilterStatus : 'ALL') %>,
      ekinerjaFilterKepegawaian: <%- JSON.stringify(((typeof cms.ekinerjaFilterKepegawaian !== 'undefined' && cms.ekinerjaFilterKepegawaian) ? cms.ekinerjaFilterKepegawaian : 'PNS,PPPK,PPPK_PW').split(',').map(s => s.trim())) %>,
      maintenanceDashboard: <%= (typeof cms.maintenanceDashboard !== 'undefined' && cms.maintenanceDashboard) ? 'true' : 'false' %>,
      maintenanceAbsensi: <%= (typeof cms.maintenanceAbsensi !== 'undefined' && cms.maintenanceAbsensi) ? 'true' : 'false' %>,
      maintenanceCekPresensi: <%= (typeof cms.maintenanceCekPresensi !== 'undefined' && cms.maintenanceCekPresensi) ? 'true' : 'false' %>,
      maintenanceEkinerja: <%= (typeof cms.maintenanceEkinerja !== 'undefined' && cms.maintenanceEkinerja) ? 'true' : 'false' %>,
      maintenanceKlarifikasi: <%= (typeof cms.maintenanceKlarifikasi !== 'undefined' && cms.maintenanceKlarifikasi) ? 'true' : 'false' %>,
      maintenanceTitle: <%- JSON.stringify((typeof cms.maintenanceTitle !== 'undefined' && cms.maintenanceTitle) ? cms.maintenanceTitle : 'Sedang Dalam Pemeliharaan') %>,
      maintenanceMessage: <%- JSON.stringify((typeof cms.maintenanceMessage !== 'undefined' && cms.maintenanceMessage) ? cms.maintenanceMessage : 'Halaman ini sedang dalam proses pemeliharaan dan pembaruan data berkala oleh tim admin Korwil Cibitung. Mohon kembali beberapa saat lagi.') %>,

      // Kebijakan Buka / Tutup Klarifikasi Absensi (NL & PC)
      selectedKlarifikasiMonth: <%= (typeof cms.klarifikasiMonth !== 'undefined' && cms.klarifikasiMonth) ? cms.klarifikasiMonth : (cms.selectedMonth || 7) %>,
      klarifikasiNlEnabled: <%= (typeof cms.klarifikasiNlEnabled !== 'undefined' && cms.klarifikasiNlEnabled) ? 'true' : 'false' %>,
      klarifikasiNlMode: <%- JSON.stringify((typeof cms.klarifikasiNlDates !== 'undefined' && cms.klarifikasiNlDates && cms.klarifikasiNlDates !== "ALL") ? "CUSTOM" : "ALL") %>,
      klarifikasiNlDates: <%- JSON.stringify((typeof cms.klarifikasiNlDates !== 'undefined' && cms.klarifikasiNlDates && cms.klarifikasiNlDates !== "ALL") ? cms.klarifikasiNlDates.split(',').map(d => parseInt(d.trim())).filter(Boolean) : []) %>,

      klarifikasiPcEnabled: <%= (typeof cms.klarifikasiPcEnabled !== 'undefined' && cms.klarifikasiPcEnabled) ? 'true' : 'false' %>,
      klarifikasiPcMode: <%- JSON.stringify((typeof cms.klarifikasiPcDates !== 'undefined' && cms.klarifikasiPcDates && cms.klarifikasiPcDates !== "ALL") ? "CUSTOM" : "ALL") %>,
      klarifikasiPcDates: <%- JSON.stringify((typeof cms.klarifikasiPcDates !== 'undefined' && cms.klarifikasiPcDates && cms.klarifikasiPcDates !== "ALL") ? cms.klarifikasiPcDates.split(',').map(d => parseInt(d.trim())).filter(Boolean) : []) %>,

      getDaysInKlarifikasiMonth() {
        const m = parseInt(this.selectedKlarifikasiMonth) || 7;
        const y = parseInt(this.selectedYear) || 2026;
        return new Date(y, m, 0).getDate();
      },
      getKlarifikasiDaysArray() {
        const count = this.getDaysInKlarifikasiMonth();
        const arr = [];
        for (let i = 1; i <= count; i++) arr.push(i);
        return arr;
      },
      getKlarifikasiMonthStartOffset() {
        const m = parseInt(this.selectedKlarifikasiMonth) || 7;
        const y = parseInt(this.selectedYear) || 2026;
        const day = new Date(y, m - 1, 1).getDay();
        return (day + 6) % 7; // Monday = 0, Sunday = 6
      },
      getKlarifikasiOffsetArray() {
        const offset = this.getKlarifikasiMonthStartOffset();
        const arr = [];
        for (let i = 0; i < offset; i++) arr.push(i);
        return arr;
      },
      getKlarifikasiMonthName() {
        const months = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agt', 'Sep', 'Okt', 'Nov', 'Des'];
        return months[parseInt(this.selectedKlarifikasiMonth)] || 'Bulan ' + this.selectedKlarifikasiMonth;
      },
      getKlarifikasiMonthFullName() {
        const months = ['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        return months[parseInt(this.selectedKlarifikasiMonth)] || 'Bulan ' + this.selectedKlarifikasiMonth;
      },
      onKlarifikasiMonthChange() {
        const maxDays = this.getDaysInKlarifikasiMonth();
        this.klarifikasiNlDates = this.klarifikasiNlDates.filter(d => d <= maxDays);
        this.klarifikasiPcDates = this.klarifikasiPcDates.filter(d => d <= maxDays);
      },

      toggleNlDate(day) {
        const idx = this.klarifikasiNlDates.indexOf(day);
        if (idx > -1) {
          this.klarifikasiNlDates.splice(idx, 1);
        } else {
          this.klarifikasiNlDates.push(day);
          this.klarifikasiNlDates.sort((a, b) => a - b);
        }
      },
      selectAllNlDates() {
        const totalDays = this.getDaysInKlarifikasiMonth();
        const arr = [];
        for (let i = 1; i <= totalDays; i++) arr.push(i);
        this.klarifikasiNlDates = arr;
      },
      clearAllNlDates() {
        this.klarifikasiNlDates = [];
      },

      togglePcDate(day) {
        const idx = this.klarifikasiPcDates.indexOf(day);
        if (idx > -1) {
          this.klarifikasiPcDates.splice(idx, 1);
        } else {
          this.klarifikasiPcDates.push(day);
          this.klarifikasiPcDates.sort((a, b) => a - b);
        }
      },
      selectAllPcDates() {
        const totalDays = this.getDaysInKlarifikasiMonth();
        const arr = [];
        for (let i = 1; i <= totalDays; i++) arr.push(i);
        this.klarifikasiPcDates = arr;
      },
      clearAllPcDates() {
        this.klarifikasiPcDates = [];
      }
    };
  }

  // Ensure cmsApp is available globally and registered with Alpine
  window.cmsApp = cmsApp;
  document.addEventListener('alpine:init', () => {
    Alpine.data('cmsApp', window.cmsApp);
  });
</script>

<main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 w-full max-w-full space-y-6" x-data="cmsApp()">

  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Pengaturan Tampilan (CMS)</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Kelola teks hero, pengumuman, periode aktif, filter publik, dan akses sistem</p>
    </div>
  </div>

  <!-- DUA CARD BERDAMPINGAN: TEKS & PERIODE + FILTER E-KINERJA -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    
    <!-- Card 1: Pengaturan Teks & Periode -->
    <div class="custom-card p-5 sm:p-6 bg-white shadow-2xs border border-slate-200/80 rounded-2xl flex flex-col justify-between">
      <div class="space-y-4">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
          <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
            <i data-lucide="sliders" class="w-4 h-4"></i>
          </div>
          <h2 class="text-sm font-bold text-slate-900">Pengaturan Teks & Periode</h2>
        </div>

        <form action="/admin/cms" method="POST" class="space-y-3" id="form-text-periode">
          <input type="hidden" name="formType" value="text_periode">
          
          <!-- 1. Hero Title -->
          <div>
            <label for="input-hero-title" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
              Hero Judul Utama
            </label>
            <input type="text" 
                   name="heroTitle" 
                   id="input-hero-title" 
                   x-model="heroTitle"
                   value="<%= cms.heroTitle || '' %>"
                   required 
                   class="form-input text-xs py-2">
          </div>

          <!-- 2. Hero Subtitle -->
          <div>
            <label for="input-hero-subtitle" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
              Hero Subjudul / Deskripsi
            </label>
            <input type="text" 
                   name="heroSubtitle" 
                   id="input-hero-subtitle" 
                   x-model="heroSubtitle"
                   value="<%= cms.heroSubtitle || '' %>"
                   required 
                   class="form-input text-xs py-2">
          </div>

          <!-- 3. Pengumuman Banner Text -->
          <div>
            <label for="input-pengumuman-text" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
              Teks Banner Pengumuman
            </label>
            <input type="text" 
                   name="pengumumanText" 
                   id="input-pengumuman-text" 
                   x-model="pengumumanText"
                   value="<%= cms.pengumumanText || '' %>"
                   placeholder="Kosongkan jika tidak ada pengumuman"
                   class="form-input text-xs py-2">
          </div>

          <!-- 4. Default Months Selection -->
          <div class="grid grid-cols-3 gap-2.5 pt-1">
            
            <!-- Bulan Default Absensi -->
            <div class="relative"
                 x-data="{
                   open: false,
                   options: [
                     { value: 1, label: 'Januari' },
                     { value: 2, label: 'Februari' },
                     { value: 3, label: 'Maret' },
                     { value: 4, label: 'April' },
                     { value: 5, label: 'Mei' },
                     { value: 6, label: 'Juni' },
                     { value: 7, label: 'Juli' },
                     { value: 8, label: 'Agustus' },
                     { value: 9, label: 'September' },
                     { value: 10, label: 'Oktober' },
                     { value: 11, label: 'November' },
                     { value: 12, label: 'Desember' }
                   ],
                   get selectedLabel() {
                     const found = this.options.find(o => o.value == selectedMonth);
                     return found ? found.label : 'Januari';
                   },
                   selectOption(val) {
                     selectedMonth = val;
                     this.open = false;
                   }
                 }"
                 @click.away="open = false">
              
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                Bulan Absensi
              </label>
              <input type="hidden" name="selectedMonth" :value="selectedMonth">
              
              <button type="button" 
                      @click="open = !open" 
                      class="w-full flex items-center justify-between px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
                <span class="truncate pr-1" x-text="selectedLabel"></span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
              </button>

              <div x-show="open" 
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0 translate-y-1 scale-98"
                   x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                   x-transition:leave="transition ease-in duration-100"
                   x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                   x-transition:leave-end="opacity-0 translate-y-1 scale-98"
                   class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-1.5 space-y-0.5 min-w-[150px]"
                   style="display: none;">
                <div class="max-h-[200px] overflow-y-auto custom-scrollbar space-y-0.5">
                  <template x-for="item in options" :key="item.value">
                    <button type="button" 
                            @click="selectOption(item.value)" 
                            class="w-full flex items-center justify-between px-2.5 py-1 rounded-lg text-xs transition-colors text-left"
                            :class="selectedMonth == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                      <span x-text="item.label"></span>
                      <i data-lucide="check" x-show="selectedMonth == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                    </button>
                  </template>
                </div>
              </div>
            </div>

            <!-- Bulan Default E-Kinerja -->
            <div class="relative"
                 x-data="{
                   open: false,
                   options: [
                     { value: 1, label: 'Januari' },
                     { value: 2, label: 'Februari' },
                     { value: 3, label: 'Maret' },
                     { value: 4, label: 'April' },
                     { value: 5, label: 'Mei' },
                     { value: 6, label: 'Juni' },
                     { value: 7, label: 'Juli' },
                     { value: 8, label: 'Agustus' },
                     { value: 9, label: 'September' },
                     { value: 10, label: 'Oktober' },
                     { value: 11, label: 'November' },
                     { value: 12, label: 'Desember' }
                   ],
                   get selectedLabel() {
                     const found = this.options.find(o => o.value == selectedMonthEkinerja);
                     return found ? found.label : 'Januari';
                   },
                   selectOption(val) {
                     selectedMonthEkinerja = val;
                     this.open = false;
                   }
                 }"
                 @click.away="open = false">
              
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                Bulan Kinerja
              </label>
              <input type="hidden" name="selectedMonthEkinerja" :value="selectedMonthEkinerja">
              
              <button type="button" 
                      @click="open = !open" 
                      class="w-full flex items-center justify-between px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
                <span class="truncate pr-1" x-text="selectedLabel"></span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
              </button>

              <div x-show="open" 
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0 translate-y-1 scale-98"
                   x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                   x-transition:leave="transition ease-in duration-100"
                   x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                   x-transition:leave-end="opacity-0 translate-y-1 scale-98"
                   class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-1.5 space-y-0.5 min-w-[150px]"
                   style="display: none;">
                <div class="max-h-[200px] overflow-y-auto custom-scrollbar space-y-0.5">
                  <template x-for="item in options" :key="item.value">
                    <button type="button" 
                            @click="selectOption(item.value)" 
                            class="w-full flex items-center justify-between px-2.5 py-1 rounded-lg text-xs transition-colors text-left"
                            :class="selectedMonthEkinerja == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                      <span x-text="item.label"></span>
                      <i data-lucide="check" x-show="selectedMonthEkinerja == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                    </button>
                  </template>
                </div>
              </div>
            </div>

            <!-- Tahun Aktif -->
            <div class="relative"
                 x-data="{
                   open: false,
                   options: [
                     { value: 2026, label: '2026' },
                     { value: 2025, label: '2025' }
                   ],
                   get selectedLabel() {
                     const found = this.options.find(o => o.value == selectedYear);
                     return found ? found.label : '2026';
                   },
                   selectOption(val) {
                     selectedYear = val;
                     this.open = false;
                   }
                 }"
                 @click.away="open = false">
              
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                Tahun
              </label>
              <input type="hidden" name="selectedYear" :value="selectedYear">
              
              <button type="button" 
                      @click="open = !open" 
                      class="w-full flex items-center justify-between px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-xs font-semibold text-slate-800 shadow-2xs transition-all text-left">
                <span class="truncate pr-1" x-text="selectedLabel"></span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-indigo-600' : ''"></i>
              </button>

              <div x-show="open" 
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0 translate-y-1 scale-98"
                   x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                   x-transition:leave="transition ease-in duration-100"
                   x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                   x-transition:leave-end="opacity-0 translate-y-1 scale-98"
                   class="absolute left-0 right-0 mt-1.5 z-50 bg-white rounded-2xl border border-slate-200 shadow-xl p-1.5 space-y-0.5 min-w-[130px]"
                   style="display: none;">
                <template x-for="item in options" :key="item.value">
                  <button type="button" 
                          @click="selectOption(item.value)" 
                          class="w-full flex items-center justify-between px-2.5 py-1 rounded-lg text-xs transition-colors text-left"
                          :class="selectedYear == item.value ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-700 hover:bg-slate-50 font-medium'">
                    <span x-text="item.label"></span>
                    <i data-lucide="check" x-show="selectedYear == item.value" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                  </button>
                </template>
              </div>
            </div>

          </div>

          <!-- Save Button for Card 1 -->
          <div class="pt-2 border-t border-slate-100 flex justify-end">
            <button type="submit" class="btn-primary py-2 px-5 text-xs gap-1.5 shadow-2xs">
              <i data-lucide="save" class="w-3.5 h-3.5"></i>
              <span>Simpan Teks & Periode</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Card 2: Filter Tampilan E-Kinerja Publik -->
    <div class="custom-card p-5 sm:p-6 bg-white shadow-2xs border border-slate-200/80 rounded-2xl flex flex-col justify-between">
      <div class="space-y-4">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
          <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <i data-lucide="filter" class="w-4 h-4"></i>
          </div>
          <h2 class="text-sm font-bold text-slate-900">Filter Tampilan E-Kinerja Publik</h2>
        </div>

        <form action="/admin/cms" method="POST" class="space-y-3.5" id="form-filter-ekinerja">
          <input type="hidden" name="formType" value="filter">

          <!-- Pilihan Status Laporan -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Status Pengiriman Laporan E-Kinerja
            </label>
            <div class="grid grid-cols-2 gap-2">
              
              <!-- ALL -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center gap-2"
                     :class="ekinerjaFilterStatus === 'ALL' ? 'bg-indigo-50/70 border-indigo-300 ring-2 ring-indigo-500/20' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="ALL" x-model="ekinerjaFilterStatus" class="text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5">
                <span class="text-xs font-bold text-slate-800">Semua Pegawai</span>
              </label>

              <!-- BELUM_KIRIM -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center gap-2"
                     :class="ekinerjaFilterStatus === 'BELUM_KIRIM' ? 'bg-rose-50/70 border-rose-300 ring-2 ring-rose-500/20' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="BELUM_KIRIM" x-model="ekinerjaFilterStatus" class="text-rose-600 focus:ring-rose-500 w-3.5 h-3.5">
                <span class="text-xs font-bold text-rose-700">Hanya Belum Kirim</span>
              </label>

              <!-- APPROVED -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center gap-2"
                     :class="ekinerjaFilterStatus === 'APPROVED' ? 'bg-emerald-50/70 border-emerald-300 ring-2 ring-emerald-500/20' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="APPROVED" x-model="ekinerjaFilterStatus" class="text-emerald-600 focus:ring-emerald-500 w-3.5 h-3.5">
                <span class="text-xs font-bold text-emerald-700">Hanya Disetujui</span>
              </label>

              <!-- PENDING -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center gap-2"
                     :class="ekinerjaFilterStatus === 'PENDING' ? 'bg-amber-50/70 border-amber-300 ring-2 ring-amber-500/20' : 'bg-white border-slate-200 hover:bg-slate-50'">
                <input type="radio" name="ekinerjaFilterStatus" value="PENDING" x-model="ekinerjaFilterStatus" class="text-amber-600 focus:ring-amber-500 w-3.5 h-3.5">
                <span class="text-xs font-bold text-amber-700">Menunggu Review</span>
              </label>

            </div>
          </div>

          <!-- Checkbox Status Kepegawaian -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Status Kepegawaian yang Ditampilkan
            </label>
            <div class="grid grid-cols-3 gap-2">
              
              <!-- PNS -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center justify-center gap-2"
                     :class="ekinerjaFilterKepegawaian.includes('PNS') ? 'bg-indigo-50/60 border-indigo-200 text-indigo-900 font-bold' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <input type="checkbox" 
                       name="ekinerjaFilterKepegawaian" 
                       value="PNS" 
                       x-model="ekinerjaFilterKepegawaian"
                       class="w-3.5 h-3.5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                <span class="text-xs font-bold">PNS</span>
              </label>

              <!-- PPPK -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center justify-center gap-2"
                     :class="ekinerjaFilterKepegawaian.includes('PPPK') ? 'bg-indigo-50/60 border-indigo-200 text-indigo-900 font-bold' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <input type="checkbox" 
                       name="ekinerjaFilterKepegawaian" 
                       value="PPPK" 
                       x-model="ekinerjaFilterKepegawaian"
                       class="w-3.5 h-3.5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                <span class="text-xs font-bold">PPPK</span>
              </label>

              <!-- PPPK_PW -->
              <label class="p-2.5 rounded-xl border cursor-pointer transition-all flex items-center justify-center gap-2"
                     :class="ekinerjaFilterKepegawaian.includes('PPPK_PW') ? 'bg-indigo-50/60 border-indigo-200 text-indigo-900 font-bold' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <input type="checkbox" 
                       name="ekinerjaFilterKepegawaian" 
                       value="PPPK_PW" 
                       x-model="ekinerjaFilterKepegawaian"
                       class="w-3.5 h-3.5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                <span class="text-xs font-bold">PPPK PW</span>
              </label>

            </div>
          </div>

          <!-- Save Button for Card 2 -->
          <div class="pt-2 border-t border-slate-100 flex justify-end">
            <button type="submit" class="btn-primary py-2 px-5 text-xs gap-1.5 bg-blue-600 hover:bg-blue-700 shadow-2xs">
              <i data-lucide="save" class="w-3.5 h-3.5"></i>
              <span>Simpan Filter E-Kinerja</span>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <!-- ========================================== -->
  <!-- PANEL KHUSUS: KONTROL MODE PEMELIHARAAN    -->
  <!-- ========================================== -->
  <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 shadow-2xs rounded-2xl space-y-4">
    <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
      <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <i data-lucide="power" class="w-4 h-4"></i>
      </div>
      <h2 class="text-sm font-bold text-slate-900">Kontrol Akses Halaman (Maintenance Mode)</h2>
    </div>

    <form action="/admin/cms/maintenance" method="POST" class="space-y-4">
      <!-- 5 Switch Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-3">
        
        <!-- 1. Dashboard Utama -->
        <div class="p-3 rounded-xl border transition-all flex items-center justify-between"
             :class="maintenanceDashboard ? 'bg-rose-50/60 border-rose-200' : 'bg-slate-50/70 border-slate-200/80'">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                 :class="maintenanceDashboard ? 'bg-rose-100 text-rose-600' : 'bg-white text-indigo-600 border border-slate-200/60'">
              <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-800 block">Dashboard Utama</span>
              <span class="text-[10px] font-semibold" :class="maintenanceDashboard ? 'text-rose-600' : 'text-emerald-600'" x-text="maintenanceDashboard ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </div>
          </div>
          <input type="hidden" name="maintenanceDashboard" :value="maintenanceDashboard ? 'true' : 'false'">
          <button type="button" 
                  @click="maintenanceDashboard = !maintenanceDashboard"
                  role="switch"
                  :aria-checked="maintenanceDashboard ? 'true' : 'false'"
                  class="relative inline-flex items-center cursor-pointer shrink-0 focus:outline-hidden">
            <div class="toggle-track" :class="maintenanceDashboard ? 'bg-rose-600' : 'bg-slate-300'">
              <div class="toggle-thumb" :style="maintenanceDashboard ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
            </div>
          </button>
        </div>

        <!-- 2. Rekap Absensi -->
        <div class="p-3 rounded-xl border transition-all flex items-center justify-between"
             :class="maintenanceAbsensi ? 'bg-rose-50/60 border-rose-200' : 'bg-slate-50/70 border-slate-200/80'">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                 :class="maintenanceAbsensi ? 'bg-rose-100 text-rose-600' : 'bg-white text-emerald-600 border border-slate-200/60'">
              <i data-lucide="calendar-check-2" class="w-4 h-4"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-800 block">Rekap Absensi</span>
              <span class="text-[10px] font-semibold" :class="maintenanceAbsensi ? 'text-rose-600' : 'text-emerald-600'" x-text="maintenanceAbsensi ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </div>
          </div>
          <input type="hidden" name="maintenanceAbsensi" :value="maintenanceAbsensi ? 'true' : 'false'">
          <button type="button" 
                  @click="maintenanceAbsensi = !maintenanceAbsensi"
                  role="switch"
                  :aria-checked="maintenanceAbsensi ? 'true' : 'false'"
                  class="relative inline-flex items-center cursor-pointer shrink-0 focus:outline-hidden">
            <div class="toggle-track" :class="maintenanceAbsensi ? 'bg-rose-600' : 'bg-slate-300'">
              <div class="toggle-thumb" :style="maintenanceAbsensi ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
            </div>
          </button>
        </div>

        <!-- 3. Cek Presensi Pegawai -->
        <div class="p-3 rounded-xl border transition-all flex items-center justify-between"
             :class="maintenanceCekPresensi ? 'bg-rose-50/60 border-rose-200' : 'bg-slate-50/70 border-slate-200/80'">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                 :class="maintenanceCekPresensi ? 'bg-rose-100 text-rose-600' : 'bg-white text-teal-600 border border-slate-200/60'">
              <i data-lucide="user-search" class="w-4 h-4"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-800 block">Cek Presensi Pegawai</span>
              <span class="text-[10px] font-semibold" :class="maintenanceCekPresensi ? 'text-rose-600' : 'text-emerald-600'" x-text="maintenanceCekPresensi ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </div>
          </div>
          <input type="hidden" name="maintenanceCekPresensi" :value="maintenanceCekPresensi ? 'true' : 'false'">
          <button type="button" 
                  @click="maintenanceCekPresensi = !maintenanceCekPresensi"
                  role="switch"
                  :aria-checked="maintenanceCekPresensi ? 'true' : 'false'"
                  class="relative inline-flex items-center cursor-pointer shrink-0 focus:outline-hidden">
            <div class="toggle-track" :class="maintenanceCekPresensi ? 'bg-rose-600' : 'bg-slate-300'">
              <div class="toggle-thumb" :style="maintenanceCekPresensi ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
            </div>
          </button>
        </div>

        <!-- 4. Laporan E-Kinerja -->
        <div class="p-3 rounded-xl border transition-all flex items-center justify-between"
             :class="maintenanceEkinerja ? 'bg-rose-50/60 border-rose-200' : 'bg-slate-50/70 border-slate-200/80'">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                 :class="maintenanceEkinerja ? 'bg-rose-100 text-rose-600' : 'bg-white text-blue-600 border border-slate-200/60'">
              <i data-lucide="file-check-2" class="w-4 h-4"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-800 block">Laporan E-Kinerja</span>
              <span class="text-[10px] font-semibold" :class="maintenanceEkinerja ? 'text-rose-600' : 'text-emerald-600'" x-text="maintenanceEkinerja ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </div>
          </div>
          <input type="hidden" name="maintenanceEkinerja" :value="maintenanceEkinerja ? 'true' : 'false'">
          <button type="button" 
                  @click="maintenanceEkinerja = !maintenanceEkinerja"
                  role="switch"
                  :aria-checked="maintenanceEkinerja ? 'true' : 'false'"
                  class="relative inline-flex items-center cursor-pointer shrink-0 focus:outline-hidden">
            <div class="toggle-track" :class="maintenanceEkinerja ? 'bg-rose-600' : 'bg-slate-300'">
              <div class="toggle-thumb" :style="maintenanceEkinerja ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
            </div>
          </button>
        </div>

        <!-- 5. Upload Klarifikasi -->
        <div class="p-3 rounded-xl border transition-all flex items-center justify-between"
             :class="maintenanceKlarifikasi ? 'bg-rose-50/60 border-rose-200' : 'bg-slate-50/70 border-slate-200/80'">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                 :class="maintenanceKlarifikasi ? 'bg-rose-100 text-rose-600' : 'bg-white text-purple-600 border border-slate-200/60'">
              <i data-lucide="file-text" class="w-4 h-4"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-800 block">Upload Klarifikasi</span>
              <span class="text-[10px] font-semibold" :class="maintenanceKlarifikasi ? 'text-rose-600' : 'text-emerald-600'" x-text="maintenanceKlarifikasi ? 'Ditutup (Maintenance)' : 'Buka (Publik)'"></span>
            </div>
          </div>
          <input type="hidden" name="maintenanceKlarifikasi" :value="maintenanceKlarifikasi ? 'true' : 'false'">
          <button type="button" 
                  @click="maintenanceKlarifikasi = !maintenanceKlarifikasi"
                  role="switch"
                  :aria-checked="maintenanceKlarifikasi ? 'true' : 'false'"
                  class="relative inline-flex items-center cursor-pointer shrink-0 focus:outline-hidden">
            <div class="toggle-track" :class="maintenanceKlarifikasi ? 'bg-rose-600' : 'bg-slate-300'">
              <div class="toggle-thumb" :style="maintenanceKlarifikasi ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
            </div>
          </button>
        </div>

      </div>

      <!-- Kustomisasi Judul & Pesan Pemeliharaan -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
        <div>
          <label for="input-maintenance-title" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
            Judul Pemeliharaan
          </label>
          <input type="text" 
                 name="maintenanceTitle" 
                 id="input-maintenance-title" 
                 x-model="maintenanceTitle"
                 value="<%= (typeof cms.maintenanceTitle !== 'undefined' && cms.maintenanceTitle) ? cms.maintenanceTitle : 'Sedang Dalam Pemeliharaan' %>"
                 placeholder="Sedang Dalam Pemeliharaan"
                 class="form-input text-xs py-2">
        </div>

        <div class="sm:col-span-2">
          <label for="input-maintenance-message" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
            Pesan untuk Pengunjung Publik
          </label>
          <input type="text" 
                 name="maintenanceMessage" 
                 id="input-maintenance-message" 
                 x-model="maintenanceMessage"
                 value="<%= (typeof cms.maintenanceMessage !== 'undefined' && cms.maintenanceMessage) ? cms.maintenanceMessage : '' %>"
                 placeholder="Tuliskan alasan penutupan atau estimasi waktu pembukaan..."
                 class="form-input text-xs py-2">
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex items-center justify-end pt-2 border-t border-slate-100">
        <button type="submit" class="btn-primary bg-amber-600 hover:bg-amber-700 text-white py-2 px-5 text-xs gap-1.5 shadow-2xs">
          <i data-lucide="save" class="w-3.5 h-3.5"></i>
          <span>Simpan Status Maintenance</span>
        </button>
      </div>
    </form>
  </div>

  <!-- =================================================================== -->
  <!-- PANEL KHUSUS: KONTROL BUKA / TUTUP KLARIFIKASI ABSEN (NL, TL & PC) -->
  <!-- =================================================================== -->
  <div class="custom-card p-5 sm:p-6 bg-white border border-slate-200/80 shadow-2xs rounded-2xl space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
          <i data-lucide="calendar-check" class="w-4 h-4"></i>
        </div>
        <h2 class="text-sm font-bold text-slate-900">Kebijakan Klarifikasi Presensi (NL, TL & PC)</h2>
      </div>

      <!-- Inline Month Selector in Header -->
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <span class="text-xs font-bold text-slate-500">Bulan:</span>
        <select id="selectKlarifikasiMonth"
                name="klarifikasiMonth" 
                form="form-klarifikasi-policy"
                x-model="selectedKlarifikasiMonth"
                @change="onKlarifikasiMonthChange()"
                class="form-select text-xs font-bold text-slate-800 bg-white border-slate-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 rounded-xl py-1.5 px-3 shadow-2xs cursor-pointer min-w-[170px]">
          <option value="1">1. Januari</option>
          <option value="2">2. Februari</option>
          <option value="3">3. Maret</option>
          <option value="4">4. April</option>
          <option value="5">5. Mei</option>
          <option value="6">6. Juni</option>
          <option value="7">7. Juli (Aktif)</option>
          <option value="8">8. Agustus</option>
          <option value="9">9. September</option>
          <option value="10">10. Oktober</option>
          <option value="11">11. November</option>
          <option value="12">12. Desember</option>
        </select>
      </div>
    </div>

    <form action="/admin/cms/klarifikasi-policy" method="POST" id="form-klarifikasi-policy" class="space-y-4">
      <input type="hidden" name="klarifikasiMonth" :value="selectedKlarifikasiMonth">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

        <!-- KARTU 1: STATUS HADIR NORMAL (NL) -->
        <div class="p-4 rounded-2xl border transition-all space-y-3.5"
             :class="klarifikasiNlEnabled ? 'bg-emerald-50/30 border-emerald-300 shadow-2xs' : 'bg-slate-50/70 border-slate-200/80'">
          <!-- Header & Switch Toggle -->
          <div class="flex items-center justify-between gap-3 pb-3 border-b border-slate-200/70">
            <div class="flex items-center gap-2.5">
              <span class="px-2.5 py-1 rounded-lg bg-emerald-600 text-white font-mono font-bold text-xs shadow-2xs">NL</span>
              <div>
                <span class="text-xs font-bold text-slate-900 block">Status Hadir Normal</span>
                <span class="text-[11px] font-medium" :class="klarifikasiNlEnabled ? 'text-emerald-700' : 'text-slate-400'"
                      x-text="klarifikasiNlEnabled ? 'Pengajuan Diizinkan (Buka)' : 'Pengajuan Dinonaktifkan (Tutup)'"></span>
              </div>
            </div>

            <!-- Toggle Switch & Status Pill -->
            <div class="inline-flex items-center gap-2.5 shrink-0 select-none">
              <input type="hidden" name="klarifikasiNlEnabled" :value="klarifikasiNlEnabled ? 'true' : 'false'">
              <button type="button" 
                      @click="klarifikasiNlEnabled = !klarifikasiNlEnabled"
                      role="switch"
                      :aria-checked="klarifikasiNlEnabled ? 'true' : 'false'"
                      class="inline-flex items-center gap-2.5 cursor-pointer group focus:outline-hidden">
                <span class="text-[11px] font-extrabold uppercase tracking-wide px-2 py-0.5 rounded-md transition-colors"
                      :class="klarifikasiNlEnabled ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-500'"
                      x-text="klarifikasiNlEnabled ? 'ON' : 'OFF'"></span>
                <div class="toggle-track" :class="klarifikasiNlEnabled ? 'bg-emerald-600' : 'bg-slate-300'">
                  <div class="toggle-thumb" :style="klarifikasiNlEnabled ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
                </div>
              </button>
            </div>
          </div>

          <!-- Notice when disabled -->
          <div x-show="!klarifikasiNlEnabled" class="p-3 rounded-xl bg-slate-100/90 border border-slate-200 text-slate-500 text-xs flex items-center gap-2">
            <i data-lucide="lock" class="w-4 h-4 text-slate-400 shrink-0"></i>
            <span>Klarifikasi status NL untuk bulan terpilih sedang <b>DITUTUP</b>. Aktifkan saklar <b>ON</b> di atas untuk membuka izin pengajuan.</span>
          </div>

          <!-- Date Selection Options (Always rendered) -->
          <div class="space-y-3 transition-opacity"
               :class="!klarifikasiNlEnabled ? 'opacity-50 pointer-events-none' : ''">
            <!-- Segmented Control Mode -->
            <input type="hidden" name="klarifikasiNlMode" :value="klarifikasiNlMode">
            <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200 text-xs w-full">
              <button type="button"
                      @click="klarifikasiNlMode = 'ALL'"
                      class="flex-1 py-1.5 px-3 rounded-lg text-center cursor-pointer font-bold transition-all text-xs"
                      :class="klarifikasiNlMode === 'ALL' ? 'bg-white text-emerald-800 shadow-2xs' : 'text-slate-600 hover:text-slate-900'">
                <span x-text="'Semua Tanggal (1–' + getDaysInKlarifikasiMonth() + ')'"></span>
              </button>
              <button type="button"
                      @click="klarifikasiNlMode = 'CUSTOM'"
                      class="flex-1 py-1.5 px-3 rounded-lg text-center cursor-pointer font-bold transition-all text-xs"
                      :class="klarifikasiNlMode === 'CUSTOM' ? 'bg-white text-emerald-800 shadow-2xs' : 'text-slate-600 hover:text-slate-900'">
                <span>Pilih Tanggal Tertentu</span>
              </button>
            </div>

            <!-- Full-width Responsive Calendar for NL -->
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-2.5 w-full">
              <div class="flex items-center justify-between text-xs pb-1.5 border-b border-slate-100">
                <span class="text-[11px] font-semibold text-slate-500">
                  Tanggal Bulan <span class="font-bold text-emerald-700" x-text="getKlarifikasiMonthFullName()"></span>:
                </span>
                <div class="flex items-center gap-2" x-show="klarifikasiNlMode === 'CUSTOM'">
                  <button type="button" @click="selectAllNlDates()" class="text-[11px] font-bold text-emerald-600 hover:underline">Semua</button>
                  <span class="text-slate-300">•</span>
                  <button type="button" @click="clearAllNlDates()" class="text-[11px] font-bold text-rose-600 hover:underline">Reset</button>
                </div>
                <div x-show="klarifikasiNlMode === 'ALL'" class="text-[11px] font-bold text-emerald-700">
                  Semua Tanggal Dibuka
                </div>
              </div>

              <!-- 7-Column Day Header -->
              <div class="calendar-grid-7" style="display: grid !important; grid-template-columns: repeat(7, minmax(0, 1fr)) !important; gap: 5px !important; text-align: center;">
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Sen</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Sel</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Rab</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Kam</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Jum</span>
                <span class="text-[10px] font-extrabold text-slate-400 uppercase">Sab</span>
                <span class="text-[10px] font-extrabold text-rose-500 uppercase">Min</span>
              </div>

              <!-- 7-Column Calendar Grid -->
              <div class="calendar-grid-7" style="display: grid !important; grid-template-columns: repeat(7, minmax(0, 1fr)) !important; gap: 5px !important;">
                <!-- Empty offset padding -->
                <template x-for="offset in getKlarifikasiOffsetArray()" :key="'nl-offset-' + offset">
                  <div class="h-8 rounded-lg bg-transparent"></div>
                </template>

                <!-- Dates 1..N -->
                <template x-for="day in getKlarifikasiDaysArray()" :key="'nl-day-' + day">
                  <button type="button" 
                          @click="klarifikasiNlMode === 'CUSTOM' ? toggleNlDate(day) : (klarifikasiNlMode = 'CUSTOM', toggleNlDate(day))"
                          :class="klarifikasiNlMode === 'ALL' ? 'bg-emerald-50 text-emerald-800 border-emerald-200 font-bold' : (klarifikasiNlDates.includes(day) ? 'bg-emerald-600 text-white font-bold border-emerald-600 shadow-2xs ring-2 ring-emerald-400/50' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-emerald-50 hover:border-emerald-300 font-semibold')"
                          class="h-8 rounded-lg border text-xs flex items-center justify-center transition-all cursor-pointer">
                    <span x-text="day"></span>
                  </button>
                </template>
              </div>

              <!-- Hidden inputs for form submit -->
              <template x-for="day in (klarifikasiNlMode === 'ALL' ? [] : klarifikasiNlDates)" :key="'nl-hidden-' + day">
                <input type="hidden" name="klarifikasiNlDates" :value="day">
              </template>

              <div class="pt-1.5 border-t border-slate-100 text-[11px] text-slate-600 flex items-center justify-between">
                <span class="font-bold text-slate-500">Izin Klarifikasi:</span>
                <span x-text="klarifikasiNlMode === 'ALL' ? 'Semua Tanggal (1–' + getDaysInKlarifikasiMonth() + ')' : (klarifikasiNlDates.length === 0 ? 'Belum ada tanggal dipilih' : klarifikasiNlDates.length + ' hari terpilih')"
                      :class="klarifikasiNlMode === 'ALL' ? 'text-emerald-700 font-bold' : (klarifikasiNlDates.length === 0 ? 'text-amber-600 font-medium italic' : 'text-emerald-700 font-bold')"></span>
              </div>
            </div>

          </div>
        </div>

        <!-- KARTU 2: STATUS TERLAMBAT & PULANG CEPAT (TL & PC) -->
        <div class="p-4 rounded-2xl border transition-all space-y-3.5"
             :class="klarifikasiPcEnabled ? 'bg-blue-50/30 border-blue-300 shadow-2xs' : 'bg-slate-50/70 border-slate-200/80'">
          <!-- Header & Switch Toggle -->
          <div class="flex items-center justify-between gap-3 pb-3 border-b border-slate-200/70">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-md bg-orange-500 text-white font-mono font-bold text-xs">TL</span>
              <span class="px-2 py-0.5 rounded-md bg-blue-600 text-white font-mono font-bold text-xs">PC</span>
              <div class="ml-1">
                <span class="text-xs font-bold text-slate-900 block">Terlambat & Pulang Cepat</span>
                <span class="text-[11px] font-medium" :class="klarifikasiPcEnabled ? 'text-blue-700' : 'text-slate-400'"
                      x-text="klarifikasiPcEnabled ? 'Pengajuan Diizinkan (Buka)' : 'Pengajuan Dinonaktifkan (Tutup)'"></span>
              </div>
            </div>

            <!-- Toggle Switch & Status Pill -->
            <div class="inline-flex items-center gap-2.5 shrink-0 select-none">
              <input type="hidden" name="klarifikasiPcEnabled" :value="klarifikasiPcEnabled ? 'true' : 'false'">
              <button type="button" 
                      @click="klarifikasiPcEnabled = !klarifikasiPcEnabled"
                      role="switch"
                      :aria-checked="klarifikasiPcEnabled ? 'true' : 'false'"
                      class="inline-flex items-center gap-2.5 cursor-pointer group focus:outline-hidden">
                <span class="text-[11px] font-extrabold uppercase tracking-wide px-2 py-0.5 rounded-md transition-colors"
                      :class="klarifikasiPcEnabled ? 'bg-blue-100 text-blue-800' : 'bg-slate-200 text-slate-500'"
                      x-text="klarifikasiPcEnabled ? 'ON' : 'OFF'"></span>
                <div class="toggle-track" :class="klarifikasiPcEnabled ? 'bg-blue-600' : 'bg-slate-300'">
                  <div class="toggle-thumb" :style="klarifikasiPcEnabled ? 'transform: translateX(20px);' : 'transform: translateX(0);'"></div>
                </div>
              </button>
            </div>
          </div>

          <!-- Notice when disabled -->
          <div x-show="!klarifikasiPcEnabled" class="p-3 rounded-xl bg-slate-100/90 border border-slate-200 text-slate-500 text-xs flex items-center gap-2">
            <i data-lucide="lock" class="w-4 h-4 text-slate-400 shrink-0"></i>
            <span>Klarifikasi status TL & PC untuk bulan terpilih sedang <b>DITUTUP</b>. Aktifkan saklar <b>ON</b> di atas untuk membuka izin pengajuan.</span>
          </div>

          <!-- Date Selection Options (Always rendered) -->
          <div class="space-y-3 transition-opacity"
               :class="!klarifikasiPcEnabled ? 'opacity-50 pointer-events-none' : ''">
            <!-- Segmented Control Mode -->
            <input type="hidden" name="klarifikasiPcMode" :value="klarifikasiPcMode">
            <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200 text-xs w-full">
              <button type="button"
                      @click="klarifikasiPcMode = 'ALL'"
                      class="flex-1 py-1.5 px-3 rounded-lg text-center cursor-pointer font-bold transition-all text-xs"
                      :class="klarifikasiPcMode === 'ALL' ? 'bg-white text-blue-800 shadow-2xs' : 'text-slate-600 hover:text-slate-900'">
                <span x-text="'Semua Tanggal (1–' + getDaysInKlarifikasiMonth() + ')'"></span>
              </button>
              <button type="button"
                      @click="klarifikasiPcMode = 'CUSTOM'"
                      class="flex-1 py-1.5 px-3 rounded-lg text-center cursor-pointer font-bold transition-all text-xs"
                      :class="klarifikasiPcMode === 'CUSTOM' ? 'bg-white text-blue-800 shadow-2xs' : 'text-slate-600 hover:text-slate-900'">
                <span>Pilih Tanggal Tertentu</span>
              </button>
            </div>

            <!-- Full-width Responsive Calendar for TL & PC -->
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-2.5 w-full">
              <div class="flex items-center justify-between text-xs pb-1.5 border-b border-slate-100">
                <span class="text-[11px] font-semibold text-slate-500">
                  Tanggal Bulan <span class="font-bold text-blue-700" x-text="getKlarifikasiMonthFullName()"></span>:
                </span>
                <div class="flex items-center gap-2" x-show="klarifikasiPcMode === 'CUSTOM'">
                  <button type="button" @click="selectAllPcDates()" class="text-[11px] font-bold text-blue-600 hover:underline">Semua</button>
                  <span class="text-slate-300">•</span>
                  <button type="button" @click="clearAllPcDates()" class="text-[11px] font-bold text-rose-600 hover:underline">Reset</button>
                </div>
                <div x-show="klarifikasiPcMode === 'ALL'" class="text-[11px] font-bold text-blue-700">
                  Semua Tanggal Dibuka
                </div>
              </div>

              <!-- 7-Column Day Header -->
              <div class="calendar-grid-7" style="display: grid !important; grid-template-columns: repeat(7, minmax(0, 1fr)) !important; gap: 5px !important; text-align: center;">
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Sen</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Sel</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Rab</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Kam</span>
                <span class="text-[10px] font-extrabold text-slate-500 uppercase">Jum</span>
                <span class="text-[10px] font-extrabold text-slate-400 uppercase">Sab</span>
                <span class="text-[10px] font-extrabold text-rose-500 uppercase">Min</span>
              </div>

              <!-- 7-Column Calendar Grid -->
              <div class="calendar-grid-7" style="display: grid !important; grid-template-columns: repeat(7, minmax(0, 1fr)) !important; gap: 5px !important;">
                <!-- Empty offset padding -->
                <template x-for="offset in getKlarifikasiOffsetArray()" :key="'pc-offset-' + offset">
                  <div class="h-8 rounded-lg bg-transparent"></div>
                </template>

                <!-- Dates 1..N -->
                <template x-for="day in getKlarifikasiDaysArray()" :key="'pc-day-' + day">
                  <button type="button" 
                          @click="klarifikasiPcMode === 'CUSTOM' ? togglePcDate(day) : (klarifikasiPcMode = 'CUSTOM', togglePcDate(day))"
                          :class="klarifikasiPcMode === 'ALL' ? 'bg-blue-50 text-blue-800 border-blue-200 font-bold' : (klarifikasiPcDates.includes(day) ? 'bg-blue-600 text-white font-bold border-blue-600 shadow-2xs ring-2 ring-blue-400/50' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-blue-50 hover:border-blue-300 font-semibold')"
                          class="h-8 rounded-lg border text-xs flex items-center justify-center transition-all cursor-pointer">
                    <span x-text="day"></span>
                  </button>
                </template>
              </div>

              <!-- Hidden inputs for form submit -->
              <template x-for="day in (klarifikasiPcMode === 'ALL' ? [] : klarifikasiPcDates)" :key="'pc-hidden-' + day">
                <input type="hidden" name="klarifikasiPcDates" :value="day">
              </template>

              <div class="pt-1.5 border-t border-slate-100 text-[11px] text-slate-600 flex items-center justify-between">
                <span class="font-bold text-slate-500">Izin Klarifikasi:</span>
                <span x-text="klarifikasiPcMode === 'ALL' ? 'Semua Tanggal (1–' + getDaysInKlarifikasiMonth() + ')' : (klarifikasiPcDates.length === 0 ? 'Belum ada tanggal dipilih' : klarifikasiPcDates.length + ' hari terpilih')"
                      :class="klarifikasiPcMode === 'ALL' ? 'text-blue-700 font-bold' : (klarifikasiPcDates.length === 0 ? 'text-amber-600 font-medium italic' : 'text-blue-700 font-bold')"></span>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Submit Button -->
      <div class="flex items-center justify-end pt-2 border-t border-slate-100">
        <button type="submit" class="btn-primary bg-teal-600 hover:bg-teal-700 text-white py-2 px-5 text-xs gap-1.5 shadow-2xs">
          <i data-lucide="save" class="w-3.5 h-3.5"></i>
          <span>Simpan Kebijakan Klarifikasi</span>
        </button>
      </div>

    </form>
  </div>

</main>

<%- include('../partials/admin-footer') %>
