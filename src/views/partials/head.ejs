<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50 <%= (typeof page !== 'undefined' && page && page.startsWith('admin') && page !== 'admin-login') ? 'overflow-hidden' : '' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title><%= typeof title !== 'undefined' ? title : 'SIMPEG Korwil Cibitung 2.0' %></title>
  
  <!-- Meta SEO & Icons -->
  <meta name="description" content="Sistem Informasi Manajemen Presensi & Kinerja Pegawai Korwil Bidang Pendidikan Kecamatan Cibitung">
  <meta name="theme-color" content="#4f46e5">
  <link rel="icon" type="image/png" href="/img/logo-emblem.png?v=4">
  <link rel="shortcut icon" href="/favicon.ico?v=4">
  <link rel="apple-touch-icon" href="/img/logo-emblem.png?v=4">
  
  <!-- Optimized Font Loading with System Fallbacks (Instant Render) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
  
  <!-- Compiled Local Tailwind CSS (with Cache Busting Version) -->
  <link rel="stylesheet" href="/css/styles.css?v=20260917_refresh_layout">

  <!-- Local Self-Hosted JavaScript Libraries (0ms CDN Latency / Works Offline) -->
  <script src="/js/lucide.min.js"></script>
  <script defer src="/js/alpine.min.js"></script>
  <script defer src="/js/app.js"></script>
</head>
<body class="flex flex-col font-sans text-slate-800 bg-slate-50 antialiased <%= (typeof page !== 'undefined' && page && page.startsWith('admin') && page !== 'admin-login') ? 'h-screen max-h-screen overflow-hidden' : 'min-h-screen' %>">

<% if (typeof user !== 'undefined' && user) { %>
  <!-- Floating Real-Time Online Visitors Pill (Khusus Role Admin di Seluruh Halaman) -->
  <div x-data="adminFloatingOnlineTracker()"
       x-init="initTracker()"
       class="fixed bottom-4 right-4 z-40 select-none font-sans transition-all duration-300 pointer-events-auto"
       style="display: none;"
       x-show="true">
    <div class="flex items-center gap-2 p-1.5 sm:px-3 sm:py-2 rounded-2xl border border-emerald-300/80 bg-slate-900/90 hover:bg-slate-950 text-white text-xs font-semibold shadow-2xl backdrop-blur-md transition-all duration-200">
      
      <!-- Pulsing green indicator -->
      <span class="relative flex h-2.5 w-2.5 shrink-0 ml-1 sm:ml-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>

      <!-- Main count button (clickable to expand/collapse details) -->
      <button type="button" 
              @click="expanded = !expanded" 
              class="flex items-center gap-1.5 focus:outline-none cursor-pointer"
              title="Klik untuk melihat rincian pengguna online">
        <span class="font-black text-emerald-300 tracking-tight" x-text="`${online.total} Online`"></span>
        <span class="text-[10px] text-slate-400 font-medium">
          <i data-lucide="chevron-up" class="w-3.5 h-3.5 inline transition-transform duration-200" :class="expanded ? 'rotate-180' : ''"></i>
        </span>
      </button>

      <!-- Expandable details -->
      <div x-show="expanded" 
           x-transition:enter="transition ease-out duration-150"
           x-transition:enter-start="opacity-0 -translate-x-2"
           x-transition:enter-end="opacity-100 translate-x-0"
           x-transition:leave="transition ease-in duration-100"
           x-transition:leave-start="opacity-100 translate-x-0"
           x-transition:leave-end="opacity-0 -translate-x-2"
           class="flex items-center gap-1.5 pl-1.5 border-l border-slate-700 text-[11px]"
           style="display: none;">
        <span class="px-1.5 py-0.5 rounded-md bg-indigo-500/20 text-indigo-300 font-bold border border-indigo-500/30" 
              x-text="`${online.admin} Admin`"></span>
        <span class="px-1.5 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30" 
              x-text="`${online.public} Tamu`"></span>
      </div>

      <!-- Small Admin Badge Indicator -->
      <div class="hidden sm:block pl-1.5 border-l border-slate-700/80">
        <span class="text-[9px] uppercase tracking-wider font-extrabold px-1.5 py-0.5 rounded-md bg-amber-400/20 text-amber-300 border border-amber-400/30">
          ADMIN
        </span>
      </div>

    </div>
  </div>

  <script>
    function adminFloatingOnlineTracker() {
      return {
        online: { total: 1, admin: 1, public: 0 },
        expanded: false,
        initTracker() {
          this.fetchOnline();
          setInterval(() => this.fetchOnline(), 15000);
          if (window.lucide) {
            this.$nextTick(() => window.lucide.createIcons());
          }
        },
        async fetchOnline() {
          try {
            const res = await fetch('/admin/api/online-users');
            if (res.ok) {
              const data = await res.json();
              if (data.success) {
                this.online = {
                  total: data.total ?? 1,
                  admin: data.admin ?? 1,
                  public: data.public ?? 0
                };
              }
            }
          } catch (e) {
            // ignore network hiccups
          }
        }
      };
    }
  </script>
<% } %>
