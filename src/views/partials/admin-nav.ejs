<div x-data="{
       sidebarCollapsed: localStorage.getItem('simpeg_sidebar_collapsed') === 'true',
       mobileSidebarOpen: false,
       profileDropdown: false,
       toggleSidebar() {
         this.sidebarCollapsed = !this.sidebarCollapsed;
         localStorage.setItem('simpeg_sidebar_collapsed', this.sidebarCollapsed);
       }
     }" 
     class="h-screen max-h-screen min-h-screen w-full flex bg-slate-50 text-slate-800 font-sans antialiased overflow-hidden"
     style="height: 100vh; height: 100dvh; min-height: 100vh; max-height: 100vh;">

  <!-- =========================================================
       1. MOBILE SLIDE-OVER BACKDROP & DRAWER
       ========================================================= -->
  <div x-show="mobileSidebarOpen" 
       x-transition:enter="transition-opacity ease-out duration-300"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition-opacity ease-in duration-200"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs lg:hidden"
       @click="mobileSidebarOpen = false"
       style="display: none;"></div>

  <aside x-show="mobileSidebarOpen"
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="-translate-x-full"
         x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="translate-x-0"
         x-transition:leave-end="-translate-x-full"
         class="fixed inset-y-0 left-0 z-50 w-72 bg-slate-900 text-slate-100 p-5 flex flex-col justify-between shadow-2xl border-r border-slate-800 lg:hidden"
         style="display: none;">
    
    <div class="space-y-6">
      <!-- Mobile Header Brand -->
      <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-950">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <div>
            <h2 class="font-extrabold text-sm text-white tracking-tight">ADMIN PORTAL</h2>
            <p class="text-[11px] text-slate-400">SIMPEG Korwil Cibitung</p>
          </div>
        </div>
        <button @click="mobileSidebarOpen = false" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Mobile Navigation Links -->
      <nav class="space-y-1 text-xs font-semibold">
        <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider px-3 mb-2">Operasional</div>
        
        <a href="/admin/klarifikasi" 
           class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-klarifikasi') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
          <i data-lucide="check-square" class="w-4 h-4 text-indigo-400"></i>
          <span>Klarifikasi Absensi</span>
        </a>

        <a href="/admin/ekinerja-review" 
           class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-ekinerja') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
          <i data-lucide="file-check-2" class="w-4 h-4 text-emerald-400"></i>
          <span>Review E-Kinerja</span>
        </a>

        <% if (typeof user === 'undefined' || user?.role === 'SUPER_ADMIN' || user?.role === 'ADMIN_DINAS') { %>
          <a href="/admin/upload-absensi" 
             class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-upload-absensi') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
            <i data-lucide="file-spreadsheet" class="w-4 h-4 text-teal-400"></i>
            <span>Upload Rekap Absensi</span>
          </a>
        <% } %>

        <% if (typeof user === 'undefined' || user?.role === 'SUPER_ADMIN') { %>
          <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider px-3 mt-5 mb-2">Master Data & CMS</div>

          <a href="/admin/pegawai" 
             class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-pegawai') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
            <i data-lucide="contact" class="w-4 h-4 text-amber-400"></i>
            <span>Data Pegawai</span>
          </a>

          <a href="/admin/unit-kerja" 
             class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-unit-kerja') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
            <i data-lucide="building-2" class="w-4 h-4 text-amber-400"></i>
            <span>Data Unit Kerja</span>
          </a>

          <a href="/admin/cms" 
             class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-cms') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
            <i data-lucide="sliders" class="w-4 h-4 text-purple-400"></i>
            <span>CMS Dashboard</span>
          </a>

          <a href="/admin/users" 
             class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-users') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
            <i data-lucide="users" class="w-4 h-4 text-cyan-400"></i>
            <span>Kelola Admin</span>
          </a>

          <a href="/admin/files" 
             class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all <%= (typeof page !== 'undefined' && page === 'admin-files') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-md shadow-indigo-950 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>">
            <i data-lucide="folder-archive" class="w-4 h-4 text-rose-400"></i>
            <span>Manajemen Berkas</span>
          </a>
        <% } %>
      </nav>
    </div>

    <!-- Mobile Bottom Links -->
    <div class="pt-4 border-t border-slate-800 space-y-2">
      <a href="/" target="_blank" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800">
        <i data-lucide="globe" class="w-4 h-4 text-slate-400"></i>
        <span>Lihat Web Publik</span>
      </a>
      <a href="/admin/logout" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-rose-400 hover:bg-rose-500/10 transition-colors">
        <i data-lucide="log-out" class="w-4 h-4"></i>
        <span>Keluar (Logout)</span>
      </a>
    </div>
  </aside>

  <!-- =========================================================
       2. DESKTOP COLLAPSIBLE LEFT SIDEBAR (GUARANTEED 100VH FULL WINDOW)
       ========================================================= -->
  <aside :class="sidebarCollapsed ? 'w-20' : 'w-64'" 
         class="hidden lg:flex flex-col h-screen max-h-screen min-h-screen shrink-0 bg-slate-900 text-slate-200 border-r border-slate-800/80 transition-[width] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] select-none shadow-xl justify-between overflow-hidden"
         style="height: 100vh; height: 100dvh; min-height: 100vh; max-height: 100vh;">
    
    <!-- Top Part (Header + Menus) -->
    <div class="flex flex-col min-h-0">
      
      <!-- Sidebar Header with extra comfortable padding -->
      <div class="h-16 flex items-center border-b border-slate-800/80 shrink-0 transition-all duration-300 ease-in-out"
           :class="sidebarCollapsed ? 'justify-center px-0' : 'justify-between px-5'">
        
        <!-- Brand Logo & Text (With extra padding on title) -->
        <a href="/admin/klarifikasi" 
           x-show="!sidebarCollapsed"
           x-transition:enter="transition-all ease-out duration-300"
           x-transition:enter-start="opacity-0 -translate-x-3"
           x-transition:enter-end="opacity-100 translate-x-0"
           x-transition:leave="transition-all ease-in duration-150"
           x-transition:leave-start="opacity-100 translate-x-0"
           x-transition:leave-end="opacity-0 -translate-x-3"
           class="flex items-center gap-3.5 overflow-hidden group min-w-0 py-1">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-950 shrink-0 group-hover:scale-105 transition-transform">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <div class="flex flex-col min-w-0 whitespace-nowrap overflow-hidden pl-1.5">
            <span class="font-extrabold text-sm tracking-tight text-white truncate">ADMIN PORTAL</span>
            <span class="text-[10px] text-slate-400 truncate mt-0.5 font-medium">SIMPEG Korwil Cibitung</span>
          </div>
        </a>

        <!-- Collapse / Expand Toggle Button -->
        <button @click="toggleSidebar()" 
                type="button"
                :title="sidebarCollapsed ? 'Perluas Sidebar' : 'Ciutkan Sidebar'"
                class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all duration-200 focus:outline-none shrink-0"
                :class="sidebarCollapsed ? 'w-10 h-10 flex items-center justify-center bg-slate-800/50 hover:bg-slate-800' : 'ml-2'">
          <i data-lucide="panel-left-close" x-show="!sidebarCollapsed" class="w-5 h-5"></i>
          <i data-lucide="panel-left-open" x-show="sidebarCollapsed" class="w-5 h-5" style="display: none;"></i>
        </button>
      </div>

      <!-- Navigation Menu Items (No scrollbar, clean spacing) -->
      <div class="pt-6 pb-5 px-3.5 space-y-5 overflow-hidden">
        
        <!-- Group 1: Operasional -->
        <div class="space-y-1.5">
          <div x-show="!sidebarCollapsed" 
               x-transition:enter="transition-all ease-out duration-300"
               x-transition:enter-start="opacity-0 -translate-x-2"
               x-transition:enter-end="opacity-100 translate-x-0"
               x-transition:leave="transition-all ease-in duration-100"
               x-transition:leave-start="opacity-100 translate-x-0"
               x-transition:leave-end="opacity-0 -translate-x-2"
               class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider px-3.5 mb-2 whitespace-nowrap overflow-hidden">
            Operasional
          </div>

          <!-- Klarifikasi Absensi -->
          <a href="/admin/klarifikasi" 
             class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-klarifikasi') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
             :class="sidebarCollapsed ? 'justify-center px-0' : ''">
            
            <div class="w-5 h-5 flex items-center justify-center shrink-0">
              <i data-lucide="check-square" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-klarifikasi') ? 'text-white' : 'text-indigo-400 group-hover:text-indigo-300' %>"></i>
            </div>
            
            <span x-show="!sidebarCollapsed" 
                  x-transition:enter="transition-all ease-out duration-300"
                  x-transition:enter-start="opacity-0 -translate-x-2"
                  x-transition:enter-end="opacity-100 translate-x-0"
                  x-transition:leave="transition-all ease-in duration-150"
                  x-transition:leave-start="opacity-100 translate-x-0"
                  x-transition:leave-end="opacity-0 -translate-x-2"
                  class="truncate whitespace-nowrap overflow-hidden">
              Klarifikasi Absensi
            </span>

            <!-- Tooltip on Collapsed Hover -->
            <div x-show="sidebarCollapsed" 
                 class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                 style="display: none;">
              Klarifikasi Absensi
            </div>
          </a>

          <!-- Review E-Kinerja -->
          <a href="/admin/ekinerja-review" 
             class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-ekinerja') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
             :class="sidebarCollapsed ? 'justify-center px-0' : ''">
            
            <div class="w-5 h-5 flex items-center justify-center shrink-0">
              <i data-lucide="file-check-2" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-ekinerja') ? 'text-white' : 'text-emerald-400 group-hover:text-emerald-300' %>"></i>
            </div>
            
            <span x-show="!sidebarCollapsed" 
                  x-transition:enter="transition-all ease-out duration-300"
                  x-transition:enter-start="opacity-0 -translate-x-2"
                  x-transition:enter-end="opacity-100 translate-x-0"
                  x-transition:leave="transition-all ease-in duration-150"
                  x-transition:leave-start="opacity-100 translate-x-0"
                  x-transition:leave-end="opacity-0 -translate-x-2"
                  class="truncate whitespace-nowrap overflow-hidden">
              Review E-Kinerja
            </span>

            <!-- Tooltip on Collapsed Hover -->
            <div x-show="sidebarCollapsed" 
                 class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                 style="display: none;">
              Review E-Kinerja
            </div>
          </a>

          <% if (typeof user === 'undefined' || user?.role === 'SUPER_ADMIN' || user?.role === 'ADMIN_DINAS') { %>
            <!-- Upload Rekap Absensi (SUPER_ADMIN & ADMIN_DINAS Only) -->
            <a href="/admin/upload-absensi" 
               class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-upload-absensi') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
               :class="sidebarCollapsed ? 'justify-center px-0' : ''">
              
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <i data-lucide="file-spreadsheet" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-upload-absensi') ? 'text-white' : 'text-teal-400 group-hover:text-teal-300' %>"></i>
              </div>
              
              <span x-show="!sidebarCollapsed" 
                    x-transition:enter="transition-all ease-out duration-300"
                    x-transition:enter-start="opacity-0 -translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    x-transition:leave="transition-all ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-x-0"
                    x-transition:leave-end="opacity-0 -translate-x-2"
                    class="truncate whitespace-nowrap overflow-hidden">
                Upload Rekap Absensi
              </span>

              <!-- Tooltip on Collapsed Hover -->
              <div x-show="sidebarCollapsed" 
                   class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                   style="display: none;">
                Upload Rekap Absensi
              </div>
            </a>
          <% } %>
        </div>

        <!-- Group 2: Super Admin Master Data -->
        <% if (typeof user === 'undefined' || user?.role === 'SUPER_ADMIN') { %>
          <div class="space-y-1">
            <div x-show="!sidebarCollapsed" 
                 x-transition:enter="transition-all ease-out duration-300"
                 x-transition:enter-start="opacity-0 -translate-x-2"
                 x-transition:enter-end="opacity-100 translate-x-0"
                 x-transition:leave="transition-all ease-in duration-100"
                 x-transition:leave-start="opacity-100 translate-x-0"
                 x-transition:leave-end="opacity-0 -translate-x-2"
                 class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider px-3 mb-1.5 whitespace-nowrap overflow-hidden">
              Master Data & CMS
            </div>

            <!-- Data Pegawai -->
            <a href="/admin/pegawai" 
               class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-pegawai') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
               :class="sidebarCollapsed ? 'justify-center px-0' : ''">
              
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <i data-lucide="contact" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-pegawai') ? 'text-white' : 'text-amber-400 group-hover:text-amber-300' %>"></i>
              </div>
              
              <span x-show="!sidebarCollapsed" 
                    x-transition:enter="transition-all ease-out duration-300"
                    x-transition:enter-start="opacity-0 -translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    x-transition:leave="transition-all ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-x-0"
                    x-transition:leave-end="opacity-0 -translate-x-2"
                    class="truncate whitespace-nowrap overflow-hidden">
                Data Pegawai
              </span>

              <!-- Tooltip on Collapsed Hover -->
              <div x-show="sidebarCollapsed" 
                   class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                   style="display: none;">
                Data Pegawai
              </div>
            </a>

            <!-- Data Unit Kerja -->
            <a href="/admin/unit-kerja" 
               class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-unit-kerja') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
               :class="sidebarCollapsed ? 'justify-center px-0' : ''">
              
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <i data-lucide="building-2" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-unit-kerja') ? 'text-white' : 'text-amber-400 group-hover:text-amber-300' %>"></i>
              </div>
              
              <span x-show="!sidebarCollapsed" 
                    x-transition:enter="transition-all ease-out duration-300"
                    x-transition:enter-start="opacity-0 -translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    x-transition:leave="transition-all ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-x-0"
                    x-transition:leave-end="opacity-0 -translate-x-2"
                    class="truncate whitespace-nowrap overflow-hidden">
                Data Unit Kerja
              </span>

              <!-- Tooltip on Collapsed Hover -->
              <div x-show="sidebarCollapsed" 
                   class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                   style="display: none;">
                Data Unit Kerja
              </div>
            </a>

            <!-- CMS Dashboard -->

            <a href="/admin/cms" 
               class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-cms') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
               :class="sidebarCollapsed ? 'justify-center px-0' : ''">
              
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <i data-lucide="sliders" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-cms') ? 'text-white' : 'text-purple-400 group-hover:text-purple-300' %>"></i>
              </div>
              
              <span x-show="!sidebarCollapsed" 
                    x-transition:enter="transition-all ease-out duration-300"
                    x-transition:enter-start="opacity-0 -translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    x-transition:leave="transition-all ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-x-0"
                    x-transition:leave-end="opacity-0 -translate-x-2"
                    class="truncate whitespace-nowrap overflow-hidden">
                CMS Dashboard
              </span>

              <!-- Tooltip on Collapsed Hover -->
              <div x-show="sidebarCollapsed" 
                   class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                   style="display: none;">
                CMS Dashboard
              </div>
            </a>

            <!-- Kelola Admin -->
            <a href="/admin/users" 
               class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-users') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
               :class="sidebarCollapsed ? 'justify-center px-0' : ''">
              
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <i data-lucide="users" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-users') ? 'text-white' : 'text-cyan-400 group-hover:text-cyan-300' %>"></i>
              </div>
              
              <span x-show="!sidebarCollapsed" 
                    x-transition:enter="transition-all ease-out duration-300"
                    x-transition:enter-start="opacity-0 -translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    x-transition:leave="transition-all ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-x-0"
                    x-transition:leave-end="opacity-0 -translate-x-2"
                    class="truncate whitespace-nowrap overflow-hidden">
                Kelola Admin
              </span>

              <!-- Tooltip on Collapsed Hover -->
              <div x-show="sidebarCollapsed" 
                   class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                   style="display: none;">
                Kelola Admin
              </div>
            </a>

            <!-- Manajemen Berkas Upload (Super Admin) -->
            <a href="/admin/files" 
               class="relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group <%= (typeof page !== 'undefined' && page === 'admin-files') ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-900/40 font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
               :class="sidebarCollapsed ? 'justify-center px-0' : ''">
              
              <div class="w-5 h-5 flex items-center justify-center shrink-0">
                <i data-lucide="folder-archive" class="w-4 h-4 <%= (typeof page !== 'undefined' && page === 'admin-files') ? 'text-white' : 'text-rose-400 group-hover:text-rose-300' %>"></i>
              </div>
              
              <span x-show="!sidebarCollapsed" 
                    x-transition:enter="transition-all ease-out duration-300"
                    x-transition:enter-start="opacity-0 -translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    x-transition:leave="transition-all ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-x-0"
                    x-transition:leave-end="opacity-0 -translate-x-2"
                    class="truncate whitespace-nowrap overflow-hidden">
                Manajemen Berkas
              </span>

              <!-- Tooltip on Collapsed Hover -->
              <div x-show="sidebarCollapsed" 
                   class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                   style="display: none;">
                Manajemen Berkas
              </div>
            </a>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Sidebar Bottom User Profile Capsule (Pinned at bottom of sidebar column) -->
    <div class="p-3 border-t border-slate-800/80 bg-slate-950/80 shrink-0 transition-all duration-300">
      <div class="flex items-center justify-between gap-2 p-2 rounded-2xl bg-slate-800/70 border border-slate-700/50 hover:bg-slate-800 transition-all duration-200"
           :class="sidebarCollapsed ? 'justify-center px-0' : ''">
        
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="relative shrink-0 group/avatar">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-600 to-indigo-700 text-white flex items-center justify-center font-bold text-xs shadow-xs">
              <%= (typeof user !== 'undefined' && user?.namaLengkap) ? user.namaLengkap.charAt(0) : 'A' %>
            </div>
            <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 border-2 border-slate-900 rounded-full shadow-2xs"></span>

            <!-- Tooltip for profile when collapsed -->
            <div x-show="sidebarCollapsed" 
                 class="absolute left-full ml-3.5 bottom-0 px-3 py-2 bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-2xl border border-slate-700/80 whitespace-nowrap opacity-0 group-hover/avatar:opacity-100 pointer-events-none transition-opacity duration-200 z-50"
                 style="display: none;">
              <p class="font-bold text-white"><%= (typeof user !== 'undefined' && user?.namaLengkap) ? user.namaLengkap : 'Admin Korwil' %></p>
              <p class="text-[10px] text-slate-400"><%= (typeof user !== 'undefined' && user?.role === 'SUPER_ADMIN') ? 'Super Admin' : 'Admin Korwil' %></p>
            </div>
          </div>

          <div x-show="!sidebarCollapsed" 
               x-transition:enter="transition-all ease-out duration-300"
               x-transition:enter-start="opacity-0 -translate-x-2"
               x-transition:enter-end="opacity-100 translate-x-0"
               x-transition:leave="transition-all ease-in duration-150"
               x-transition:leave-start="opacity-100 translate-x-0"
               x-transition:leave-end="opacity-0 -translate-x-2"
               class="min-w-0 whitespace-nowrap overflow-hidden">
            <p class="text-xs font-bold text-white truncate leading-tight">
              <%= (typeof user !== 'undefined' && user?.namaLengkap) ? user.namaLengkap : 'Admin Korwil' %>
            </p>
            <p class="text-[10px] font-semibold text-slate-400 truncate mt-0.5">
              <%= (typeof user !== 'undefined' && user?.role === 'SUPER_ADMIN') ? 'Super Admin' : 'Admin Korwil' %>
            </p>
          </div>
        </div>

        <a href="/admin/logout" 
           x-show="!sidebarCollapsed"
           x-transition:enter="transition-all ease-out duration-300"
           x-transition:enter-start="opacity-0"
           x-transition:enter-end="opacity-100"
           x-transition:leave="transition-all ease-in duration-100"
           x-transition:leave-start="opacity-100"
           x-transition:leave-end="opacity-0"
           title="Keluar / Logout" 
           class="p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition-colors shrink-0">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>
    </div>

  </aside>

  <!-- =========================================================
       3. MAIN CANVAS & CONTENT AREA (SCROLLABLE RIGHT COLUMN)
       ========================================================= -->
  <div class="flex-1 flex flex-col min-w-0 h-screen max-h-screen min-h-screen overflow-y-auto custom-scrollbar"
       style="height: 100vh; height: 100dvh; min-height: 100vh; max-height: 100vh;">
    
    <!-- Top Header Bar (Sticky at top of scrollable canvas) -->
    <header class="sticky top-0 z-20 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between shadow-2xs shrink-0">
      
      <!-- Left: Mobile Toggle & Breadcrumbs -->
      <div class="flex items-center gap-3">
        <!-- Mobile Menu Toggle Button -->
        <button @click="mobileSidebarOpen = true" 
                type="button" 
                class="lg:hidden p-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>

        <!-- Breadcrumb / Section Header -->
        <div class="flex items-center gap-2 text-xs">
          <span class="text-slate-400 font-medium hidden sm:inline">Panel Admin</span>
          <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-300 hidden sm:inline"></i>
          <span class="font-bold text-slate-800">
            <% if (typeof page !== 'undefined' && page === 'admin-klarifikasi') { %>
              Klarifikasi Absensi
            <% } else if (typeof page !== 'undefined' && page === 'admin-ekinerja') { %>
              Review Laporan E-Kinerja
            <% } else if (typeof page !== 'undefined' && page === 'admin-upload-absensi') { %>
              Upload Rekap Absensi
            <% } else if (typeof page !== 'undefined' && page === 'admin-pegawai') { %>
              Pengelolaan Data Pegawai
            <% } else if (typeof page !== 'undefined' && page === 'admin-cms') { %>
              Pengaturan CMS & Banner
            <% } else if (typeof page !== 'undefined' && page === 'admin-users') { %>
              Kelola Pengguna Admin
            <% } else if (typeof page !== 'undefined' && page === 'admin-files') { %>
              Manajemen Berkas Upload
            <% } else { %>
              Dashboard Admin
            <% } %>
          </span>
        </div>
      </div>

      <!-- Right: Web Link & Profile Pill -->
      <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors flex items-center gap-1.5 border border-slate-200 bg-white shadow-2xs">
          <i data-lucide="globe" class="w-3.5 h-3.5 text-slate-500"></i>
          <span class="hidden sm:inline">Lihat Web Publik</span>
          <i data-lucide="external-link" class="w-3 h-3 text-slate-400"></i>
        </a>

        <!-- Profile Dropdown -->
        <div class="relative" @click.away="profileDropdown = false">
          <button @click="profileDropdown = !profileDropdown" 
                  class="flex items-center gap-2 p-1 sm:px-2.5 sm:py-1.5 rounded-xl hover:bg-slate-100 transition-colors text-left border border-slate-200/80 bg-white">
            <div class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shadow-2xs">
              <%= (typeof user !== 'undefined' && user?.namaLengkap) ? user.namaLengkap.charAt(0) : 'A' %>
            </div>
            <span class="hidden md:inline text-xs font-bold text-slate-800">
              <%= (typeof user !== 'undefined' && user?.namaLengkap) ? user.namaLengkap.split(' ')[0] : 'Admin' %>
            </span>
            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400"></i>
          </button>

          <!-- Dropdown Popup -->
          <div x-show="profileDropdown" 
               x-transition:enter="transition ease-out duration-100"
               x-transition:enter-start="opacity-0 scale-95"
               x-transition:enter-end="opacity-100 scale-100"
               x-transition:leave="transition ease-in duration-75"
               x-transition:leave-start="opacity-100 scale-100"
               x-transition:leave-end="opacity-0 scale-95"
               class="absolute right-0 mt-2 w-52 rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 text-slate-700"
               style="display: none;">
            <div class="px-4 py-2 border-b border-slate-100">
              <p class="text-xs font-bold text-slate-900 truncate"><%= (typeof user !== 'undefined' && user?.namaLengkap) ? user.namaLengkap : 'Admin' %></p>
              <p class="text-[11px] text-slate-400 truncate"><%= (typeof user !== 'undefined' && user?.email) ? user.email : 'admin@cibitung.go.id' %></p>
            </div>
            <a href="/" target="_blank" class="flex items-center gap-2 px-4 py-2 text-xs hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
              <i data-lucide="globe" class="w-4 h-4 text-slate-400"></i>
              <span>Buka Halaman Utama</span>
            </a>
            <a href="/admin/logout" class="flex items-center gap-2 px-4 py-2 text-xs text-rose-600 hover:bg-rose-50 transition-colors">
              <i data-lucide="log-out" class="w-4 h-4"></i>
              <span>Keluar (Logout)</span>
            </a>
          </div>
        </div>
      </div>

    </header>
