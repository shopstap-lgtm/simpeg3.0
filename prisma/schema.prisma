datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model Unit {
  id             String     @id @default(cuid())
  namaUnit       String
  kepalaSekolah  String?
  employees      Employee[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id                 String           @id @default(cuid())
  nip                String           @unique
  nama               String
  jabatan            String?          @default("Guru")
  statusKepegawaian  String           @default("PNS") // PNS | PPPK | PPPK_PW | OUTSOURCING
  unitId             String
  unit               Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  aktif              Boolean          @default(true)

  attendanceDays     AttendanceDay[]
  clarifications     Clarification[]
  ekinerjaReports    EkinerjaReport[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([unitId])
  @@index([statusKepegawaian])
  @@index([aktif])
}

model AttendancePeriod {
  id             String          @id @default(cuid())
  bulan          Int
  tahun          Int
  attendanceDays AttendanceDay[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([bulan, tahun])
  @@index([bulan, tahun])
}

model AttendanceDay {
  id          String           @id @default(cuid())
  employeeId  String
  periodId    String
  tanggal     Int              // 1 to 31
  status      String           @default("HADIR") // HADIR | TK | DL | DL_KUNING | TL | PC | ST | CT | LIBUR | EMPTY
  keterangan  String?

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      AttendancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, periodId, tanggal])
  @@index([periodId, tanggal])
  @@index([employeeId, periodId])
}

model Clarification {
  id               String             @id @default(cuid())
  employeeId       String
  tanggalAbsen     String             // e.g. "2026-07-14" or "2026-07-14 s/d 2026-07-15"
  statusAwal       String             @default("TK")
  statusPengganti  String             @default("DL")
  alasan           String
  fileUrl          String
  fileName         String             @default("Surat_Keterangan.pdf")
  statusVerifikasi String             @default("PENDING") // PENDING | APPROVED | REJECTED
  catatanAdmin     String?
  reviewedBy       String?
  reviewedAt       String?

  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([employeeId])
  @@index([statusVerifikasi])
}

model EkinerjaReport {
  id             String             @id @default(cuid())
  employeeId     String
  bulan          Int
  tahun          Int
  fileHarianUrl  String?
  fileHarianName String?
  fileBulananUrl String?
  fileBulananName String?
  nilaiHarian    Float?
  nilaiBulanan   Float?
  statusReview   String             @default("PENDING") // PENDING | APPROVED | REJECTED
  catatanAdmin   String?
  reviewedBy     String?
  reviewedAt     String?

  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([employeeId, bulan, tahun])
  @@index([bulan, tahun])
  @@index([statusReview])
}

model CmsConfig {
  id                   String   @id @default("cms-main")
  heroBadge            String   @default("Portal Resmi Korwil")
  heroTitle            String   @default("Sistem Informasi Manajemen Pegawai")
  heroSubtitle         String   @default("Wilayah Pendidikan Kecamatan Cibitung - Transparan, Akuntabel, dan Terintegrasi")
  pengumumanText       String   @default("Batas akhir pengunggahan dokumen laporan E-Kinerja dan Klarifikasi Presensi untuk periode bulan berjalan adalah setiap tanggal 25 pukul 23:59 WIB.")
  selectedMonth        Int      @default(7)
  selectedMonthEkinerja Int     @default(7)
  selectedYear         Int      @default(2026)

  // Mode Pemeliharaan (Maintenance Mode)
  maintenanceDashboard   Boolean  @default(false)
  maintenanceAbsensi     Boolean  @default(false)
  maintenanceEkinerja    Boolean  @default(false)
  maintenanceKlarifikasi Boolean  @default(false)
  maintenanceTitle       String   @default("Sedang Dalam Pemeliharaan")
  maintenanceMessage     String   @default("Halaman ini sedang dalam proses pemeliharaan dan pembaruan data berkala oleh tim admin Korwil Cibitung. Mohon kembali beberapa saat lagi.")

  // Pengaturan Filter Tampilan E-Kinerja Publik
  ekinerjaFilterStatus      String   @default("ALL") // ALL | BELUM_KIRIM | APPROVED | PENDING
  ekinerjaFilterKepegawaian  String   @default("PNS,PPPK,PPPK_PW")

  // Kebijakan Buka / Tutup Klarifikasi Absensi NL & PC
  klarifikasiNlEnabled      Boolean  @default(false)
  klarifikasiNlDates        String   @default("ALL") // "ALL" or comma-separated days "1,2,5,15"
  klarifikasiPcEnabled      Boolean  @default(false)
  klarifikasiPcDates        String   @default("ALL") // "ALL" or comma-separated days "10,11,12"

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  email        String?
  namaLengkap  String
  role         String    @default("ADMIN_KORWIL") // SUPER_ADMIN | ADMIN_KORWIL | ADMIN_DINAS
  isActive     Boolean   @default(true)
  lastLogin    String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([username])
}
